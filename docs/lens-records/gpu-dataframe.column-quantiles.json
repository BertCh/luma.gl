sharedFirst[other];","      state[stateOffset + STATE_ACTIVE_COUNT] = distinct;","    let activeCount = state[stateOffset + STATE_ACTIVE_COUNT];","      let prefixValue = key >> 24u;","      var low = 0u;","      var high = activeCount;","      while (low < high) {","        let middle = (low + high) / 2u;","        if (state[stateOffset + STATE_ACTIVE_PREFIX + middle] < prefixValue) {","          low = middle + 1u;","        } else {","          high = middle;","        }","      if (low >= activeCount || state[stateOffset + STATE_ACTIVE_PREFIX + low] != prefixValue) {","      let slot = low;","      let digit = (key >> 16u) & 255u;","    var prefix = state[stateOffset + STATE_PREFIX + targetIndex];","    var remaining = state[stateOffset + STATE_RANK + targetIndex];","    let slot = state[stateOffset + STATE_SLOT + targetIndex];","      let prefixValue = key >> 16u;","      let digit = (key >> 8u) & 255u;","      let prefixValue = key >> 8u;","      let digit = (key >> 0u) & 255u;","@group(0) @binding(0) var<storage, read> state: array<u32>;","@group(0) @binding(1) var<storage, read> params: array<f32>;","const quantilesOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> quantilesOut: array<f32>;","const validCountOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> validCountOut: array<u32>;","const filterBoundsOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> filterBoundsOut: array<f32>;","@compute @workgroup_size(32)","  _ = &quantilesOut;","  _ = &validCountOut;","  _ = &filterBoundsOut;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (!(true)) {","  let validCount = state[stateOffset + STATE_VALID_COUNT];","  if (index < QUANTILE_COUNT) {","    var result = getNaN();","    let p = params[paramsOffset + HEADER_LENGTH + index];","    if (validCount > 0u && isOrderStatisticProbability(p)) {","      let first = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * index]);","      let second = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * index + 1u]);","      result = first;","      let code = u32(params[paramsOffset]);","      // validCount is below 2^24, so this is a runtime zero that blocks multiply-add fusion.","      let zero = validCount >> 31u;","      if (code == 3u) {","        let h = getQuantileHeight(validCount, p);","        result = interpolateOrderStatistic(first, second, h - floor(h), zero);","      } else if (code == 4u) {","        result = getOrderStatisticMidpoint(first, second, zero);","    quantilesOut[quantilesOutOffset + index] = result;","  } else {","    validCountOut[validCountOutOffset] = validCount;","    let hasRows = validCount > 0u;","    let lowerBound = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT]);","    let upperBound = decodeOrderedKey(state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT + 1u]);","    filterBoundsOut[filterBoundsOutOffset] = select(getNaN(), lowerBound, hasRows);","    filterBoundsOut[filterBoundsOutOffset + 1u] = select(getNaN(), upperBound, hasRows);","const filterMaskOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> filterMaskOut: array<u32>;","  _ = &filterMaskOut;","  var inside = 0u;","  let value = values[valuesOffset + index];","  if (state[stateOffset + STATE_VALID_COUNT] > 0u && !isMissingValue(value)) {","    {","      let lowerKey = state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT];","      let upperKey = state[stateOffset + STATE_PREFIX + 2u * QUANTILE_COUNT + 1u];","      inside = select(0u, 1u, key >= lowerKey && key <= upperKey);","  filterMaskOut[filterMaskOutOffset + index] = inside;"],"strings":["column-quantiles-state","column-quantiles-histogram","GPUColumnQuantiles","read_write","read","column-quantiles","compute","poverty150Pct","quantile-parameters","column-quantiles-finish","state","histogram","buffer","column-quantiles-select-0","column-quantiles-select