Step(low * (1.0 - fraction), zero) +","    roundOrderStatisticStep(high * fraction, zero);","fn getOrderStatisticMidpoint(low: f32, high: f32, zero: u32) -> f32 {","  if (low == high) {","  let sum = roundOrderStatisticStep(low + high, zero);","  if ((bitcast<u32>(sum) & 0x7f800000u) != 0x7f800000u) {","    return sum * 0.5;","  return roundOrderStatisticStep(low * 0.5, zero) + roundOrderStatisticStep(high * 0.5, zero);","fn isMissingValue(value: f32) -> bool {","  return (bitcast<u32>(value) & 0x7f800000u) == 0x7f800000u;","const ROW_COUNT: u32 = 791u;","const LOCAL_SLOT_COUNT: u32 = 8u;","const LOCAL_BIN_COUNT: u32 = 2048u;","var<workgroup> localHistogram: array<atomic<u32>, 2048>;","  _ = &values;","  _ = &state;","  ","  for (var bin = localInvocationIndex; bin < LOCAL_BIN_COUNT; bin = bin + 256u) {","    atomicStore(&localHistogram[bin], 0u);","  workgroupBarrier();","  let isEnabled = true;","  if (isEnabled) {","    let activeCount = 1u;","    for (var row = index; row < ROW_COUNT; row = row + INVOCATION_COUNT) {","      let value = values[valuesOffset + row];","      if (isMissingValue(value)) {","        continue;","      }","      ","      let key = getOrderStatisticKey(value);","      let slot = 0u;","      let digit = (key >> 24u) & 255u;","      if (slot < LOCAL_SLOT_COUNT) {","        atomicAdd(&localHistogram[slot * 256u + digit], 1u);","      } else {","        atomicAdd(&histogram[histogramOffset + slot * 256u + digit], 1u);","    }","    for (var bin = localInvocationIndex; bin < LOCAL_BIN_COUNT; bin = bin + 256u) {","      let count = atomicLoad(&localHistogram[bin]);","      if (count != 0u && bin < 2048u) {","        atomicAdd(&histogram[histogramOffset + bin], count);","@group(0) @binding(1) var<storage, read_write> state: array<u32>;","const paramsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> params: array<f32>;","// Round half to even; the fraction h - floor(h) is exact in f32.","fn roundHalfEven(h: f32) -> f32 {","  let whole = floor(h);","  let fraction = h - whole;","  if (fraction < 0.5) {","    return whole;","  if (fraction > 0.5) {","    return whole + 1.0;","  return select(whole, whole + 1.0, (u32(whole) & 1u) == 1u);","// The product is correctly rounded in WGSL, so the CPU oracle matches it with Math.fround.","fn getQuantileHeight(validCount: u32, p: f32) -> f32 {","  return f32(validCount - 1u) * p;","fn getQuantileRanks(validCount: u32, p: f32) -> vec2<u32> {","  let h = getQuantileHeight(validCount, p);","  let lower = floor(h);","  let upper = ceil(h);","  let code = u32(params[paramsOffset]);","  var first = lower;","  var second = lower;","  if (code == 1u) {","    first = upper;","    second = upper;","  } else if (code == 2u) {","    first = roundHalfEven(h);","    second = first;","  } else if (code == 3u) {","    second = min(lower + 1.0, f32(validCount - 1u));","  } else if (code == 4u) {","  return vec2<u32>(u32(first), u32(second));","fn getTargetRank(targetIndex: u32, validCount: u32) -> u32 {","  if (validCount == 0u) {","    return 0u;","  if (targetIndex < 2u * QUANTILE_COUNT) {","    let p = params[paramsOffset + HEADER_LENGTH + targetIndex / 2u];","    if (!isOrderStatisticProbability(p)) {","      return 0u;","    let ranks = getQuantileRanks(validCount, p);","    return select(ranks.x, ranks.y, (targetIndex & 1u) == 1u);","  let lastIndex = f32(validCount - 1u);","  if (targetIndex == 2u * QUANTILE_COUNT) {","    let lowerFraction = params[paramsOffset + 1u];","    let fraction = select(clamp(lowerFraction, 0.0, 1.0), 0.0, isNanBits(lowerFraction));","    return u32(clamp(floor(f32(validCount) * fraction), 0.0, lastIndex));","  let upperFraction = params[paramsOffset + 2u];","  let fraction = select(clamp(upperFraction, 0.0, 1.0), 1.0, isNanBits(upperFraction));","  return u32(clamp(ceil(f32(validCount) * fraction) - 1.0, 0.0, lastIndex));","var<workgroup> sharedPrefix: array<u32, 8>;","var<workgroup> sharedFirst: array<u32, 8>;","var<workgroup> sharedValid