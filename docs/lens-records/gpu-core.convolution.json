PUT_OFFSET: u32 = 0u;","const KERNEL_OFFSET: u32 = 0u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read> kernelValues: array<f32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<f32>;","@compute @workgroup_size(256) fn main(","  @builtin(workgroup_id) workgroupId: vec3u,","  @builtin(local_invocation_index) localInvocationIndex: u32",") {","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 16u + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= ELEMENT_COUNT) {","    return;","  }","  let outputIndex = 0u + index;","  let outputY = outputIndex / WIDTH;","  let outputX = outputIndex - outputY * WIDTH;","  var total = 0.0;","  for (var kernelLocalIndex = 0u; kernelLocalIndex < 9u; kernelLocalIndex++) {","    let kernelIndex = 0u + kernelLocalIndex;","    let kernelY = kernelIndex / KERNEL_WIDTH;","    let kernelX = kernelIndex % KERNEL_WIDTH;","    let sourceY = i32(outputY) - (i32(kernelY) - i32(KERNEL_CENTER_Y));","    let sourceX = i32(outputX) - (i32(kernelX) - i32(KERNEL_CENTER_X));","    let kernelValue = kernelValues[KERNEL_OFFSET + kernelLocalIndex];","    if (sourceX < 0 || sourceX >= i32(WIDTH) || sourceY < 0 || sourceY >= i32(HEIGHT)) {","      continue;","    }","    let sourceIndex = u32(sourceY) * WIDTH + u32(sourceX);","    if (sourceIndex >= 0u &&","        sourceIndex - 0u < 4096u) {","      total += inputValues[INPUT_OFFSET + sourceIndex - 0u] * kernelValue;","  outputValues[OUTPUT_OFFSET + index] = total;","}"],"strings":["terrain-curvature-direct-0","buffer","curvature","elevation","imported","laplacian","read"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","datum","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["keySpace"],[