 takes the maximum of the children (2i+a, 2j+b) of level l that exist, compared with strict > from the empty sentinel -FLT_MAX, in the order (0,0), (1,0), (0,1), (1,1); children past an odd edge are skipped, so an edge cell reduces fewer than four. The minimum is the same tree with < from +FLT_MAX; a cell with no valid pixel keeps the sentinel.","symbols":[{"id":"parent","role":"output","label":"parent maximum","binding":"wgsl:maximumValue"},{"id":"child","role":"input","label":"child maximum","binding":"wgsl:tileMaximum"}]}],"sources":[{"id":"wgsl:298bada8","language":"wgsl","moduleId":"GPURasterExtremaPyramid/level-0","hash":"298bada8","bodyHash":"14c9622c","entryPoint":"main","constants":{"INVOCATION_COUNT":256,"WGSL_KERNEL_DISPATCH_X":1,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,20],0,20,0,0,[21,37],38,[58,3]]},{"id":"wgsl:26141535","language":"wgsl","moduleId":"GPURasterExtremaPyramid/reduce-fused","hash":"26141535","bodyHash":"da90006c","entryPoint":"main","constants":{"INVOCATION_COUNT":256,"WGSL_KERNEL_DISPATCH_X":1,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,4],8,61,10,62,[18,2],[63,7],0,[21,5],[28,8],[70,12],38,[82,3],70,[85,11],57,93,[96,2],57,57,98,92,[99,8],[56,2],107,38,60]}]},"decisions":[],"choices":[{"stage":"support","name":"firstBlockSize","value":4,"sweepable":false},{"stage":"support","name":"footprint","value":"cell","sweepable":false},{"stage":"support","name":"levelCount","value":2,"sweepable":false}],"metrics":[{"schema":"luma.computation-metrics/1","runId":"run-c67034c5","graph":"gpu-raster-raster-extrema-pyramid-compiled","timebase":"ns","encoding":{"coalesced":true,"timestamped":false,"taps":0,"lensTwin":true},"nodes":{}}],"captures":{"schema":"luma.computation-captures/1","runId":"run-c67034c5","snapshots":[{"id":"gpu-raster-raster-extrema-pyramid-snapshots-pyramidMinimumLevel1-0","name":"pyramidMinimumLevel1","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-raster-raster-extrema-pyramid-compile