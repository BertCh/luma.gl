ls: array<f32>;","const WIDTH: u32 = 64u;","const HEIGHT: u32 = 64u;","const BLOCK_SIZE: u32 = 4u;","const FOOTPRINT_EXTRA: u32 = 0u;","const LEVEL_WIDTH: u32 = 16u;","const LEVEL_OFFSET: u32 = 0u;","const EMPTY_MAXIMUM: f32 = -3.4028234663852886e+38;","const EMPTY_MINIMUM: f32 = 3.4028234663852886e+38;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &values;","  _ = &validity;","  _ = &maximumLevels;","  _ = &minimumLevels;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let cellColumn = index % LEVEL_WIDTH;","  let cellRow = index / LEVEL_WIDTH;","  let x0 = cellColumn * BLOCK_SIZE;","  let y0 = cellRow * BLOCK_SIZE;","  let x1 = min(x0 + BLOCK_SIZE + FOOTPRINT_EXTRA, WIDTH);","  let y1 = min(y0 + BLOCK_SIZE + FOOTPRINT_EXTRA, HEIGHT);","  var maximumValue = EMPTY_MAXIMUM;","  var minimumValue = EMPTY_MINIMUM;","  for (var y = y0; y < y1; y++) {","    for (var x = x0; x < x1; x++) {","      let pixel = y * WIDTH + x;","      if (validity[validityOffset + pixel] != 0u) {","        let value = values[valuesOffset + pixel];","        if (isFiniteValue(value)) {","          if (value > maximumValue) { maximumValue = value; }","          if (value < minimumValue) { minimumValue = value; }","        }","      }","    }","  maximumLevels[maximumLevelsOffset + LEVEL_OFFSET + index] = maximumValue;","  minimumLevels[minimumLevelsOffset + LEVEL_OFFSET + index] = minimumValue;","}","@group(0) @binding(0) var<storage, read_write> maximumLevels: array<f32>;","@group(0) @binding(1) var<storage, read_write> minimumLevels: array<f32>;","const BASE_WIDTH: u32 = 16u;","const BASE_HEIGHT: u32 = 16u;","const BASE_OFFSET: u32 = 0u;","const TILES_X: u32 = 1u;","const LEVEL_OFFSET_0: u32 = 256u;","var<workgroup> tileMaximum: array<f32, 256>;","var<workgroup> tileMinimum: array<f32, 256>;","  ","  let tileIndex = (index - localInvocationIndex) / 256u;","  let tileX = tileIndex % TILES_X;","  let tileY = tileIndex / TILES_X;","  let baseColumn = tileX * 16u + localInvocationIndex % 16u;","  let baseRow = tileY * 16u + localInvocationIndex / 16u;","  var baseMaximum = EMPTY_MAXIMUM;","  var baseMinimum = EMPTY_MINIMUM;","  if (baseColumn < BASE_WIDTH && baseRow < BASE_HEIGHT) {","    let baseCell = BASE_OFFSET + baseRow * BASE_WIDTH + baseColumn;","    baseMaximum = maximumLevels[maximumLevelsOffset + baseCell];","    baseMinimum = minimumLevels[minimumLevelsOffset + baseCell];","  tileMaximum[localInvocationIndex] = baseMaximum;","  tileMinimum[localInvocationIndex] = baseMinimum;","  workgroupBarrier();","  // Level 1: 8 x 8 cells per tile.","  {","    let isStageThread = localInvocationIndex < 64u;","    let stageX = localInvocationIndex % 8u;","    let stageY = localInvocationIndex / 8u;","    var maximumValue = EMPTY_MAXIMUM;","    var minimumValue = EMPTY_MINIMUM;","    if (isStageThread) {","      for (var child = 0u; child < 4u; child++) {","      let value = tileMaximum[(2u * stageY + (child >> 1u)) * 16u + 2u * stageX + (child & 1u)];","      if (value > maximumValue) { maximumValue = value; }","      let value = tileMinimum[(2u * stageY + (child >> 1u)) * 16u + 2u * stageX + (child & 1u)];","      if (value < minimumValue) { minimumValue = value; }","    workgroupBarrier();","      tileMaximum[localInvocationIndex] = maximumValue;","      tileMinimum[localInvocationIndex] = minimumValue;","      let cellColumn = tileX * 8u + stageX;","      let cellRow = tileY * 8u + stageY;","      if (cellColumn < 8u && cellRow < 8u) {","        let cellIndex = LEVEL_OFFSET_0 + cellRow * 8u + cellColumn;","        maximumLevels[maximumLevelsOffset + cellIndex] = maximumValue;","        minimumLevels[minimumLevelsOffset + cellIndex] = minimumValue;","    "],"strings":["raster-extrema-pyramid-level-0","pyramidMaximumLevels","pyramidMinimumLevels","raster-extrema-pyramid-elevation","raster-extrema-pyramid-levels-1-1","GPURasterExtremaPyramid","buffer","raster-extrema-pyramid-elevation-validity","raster-extrema-pyramid-elevation-values","read_write","compute","imported","raster-extrema-pyramid","maximumLevels","minimumLevels","pyramidElevation","read","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","reads","writes","attrs"],[],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[["~1","~2"],["~:4","~d","~1","~9","f32",0,320],["~:4","~e","~2","~9","f32",0,320],["~:5",[1,1,1],256,false]]}}
