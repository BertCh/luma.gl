{"schema":"luma.lens-record/1","scenarioId":"gpu-terrain.terrain-rgb-decode","recordedAt":"2026-10-15T00:48:09.147Z","adapterLabel":"apple (unknown)","record":{"schema":"luma.computation/1","id":"gpu-terrain.terrain-rgb-decode","runId":"run-41e8bc9b","createdAt":"2026-10-15T00:48:09.144Z","adapter":{"backend":"webgpu","vendor":"apple","architecture":"metal-3","description":""},"domains":["gpu-terrain"],"graphs":[["~:0","gpu-terrain-terrain-rgb-decode-compiled","compiled","gpu-terrain","Terrarium bytes to elevation in metres",[["~:1","~0","~0","terrain-rgb-decode","compute","~6","wgsl:bfd8e7cd",[256,1,1],[["~:2","inputWords","~5","read","u32",0,1024],["~:2","outputValues","~1","~7","f32",0,1024],["~:2","outputValidity","~2","~7","u32",0,1024]],["~:3",[4,1,1],1024,false],["~5","~1","~2"],["~1","~2"],["~:4","~6","terrarium-buffer",1,4,1024,4096,8192],["~:5"]]],[],[["~:6","~5","~3",4096,"~4","~0","~0"],["~:6","~1","~3",4096,"~4","~0","~0"],["~:6","~2","~3",4096,"~4","~0","~0"]]]],"axes":{"axes":[],"keySpaces":[{"id":"cells","label":"grid cells","size":1024,"indexSpace":"2d","shape":[32,32]}],"relations":[]},"refs":{"formulas":[{"id":"gpu-terrain.terrain-rgb-decode.terrarium","tex":"\\term{code}{N}=65536\\term{red}{R}+256\\term{green}{G}+\\term{blue}{B},\\quad\\term{height}{h}=\\operatorname{f32}(N)\\,2^{-8}-32768","ascii":"Unpack R=word&255, G=(word>>8)&255, B=(word>>16)&255, A=word>>24; Terrarium height=f32((R<<16)|(G<<8)|B)*0.00390625-32768 exactly. Alpha zero (by default), encoded nodata, invalid source or height outside closed validRange [-11000,9000] gives NaN and validity 0; otherwise validity 1. Optional sea clamp maps -12000<h<0 to 0 after validity; disabled here. Mapbox uses f32(i32(N)-100000)*f32(0.1).","derivation":"curated","symbols":[{"id":"code","role":"intermediate","label":"RGB code","binding":"wgsl:code"},{"id":"red","role":"input","label":"red byte","binding":"wgsl:red"},{"id":"green","role":"input","label":"green byte","binding":"wgsl:green"},{"id":"blue","role":"input","label":"blue byte","binding":"wgsl:blue"},{"id":"height","role":"output","label":"decoded height","binding":"wgsl:height"}]}],"sources":[{"id":"wgsl:bfd8e7cd","language":"wgsl","moduleId":"GPUTerrainRGBDecode/terrarium-buffer","hash":"bfd8e7cd","bodyHash":"004cb93f","entryPoint":"main","constants":{"INVOCATION_COUNT":1024,"WGSL_KERNEL_DISPATCH_X":4,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,21],16,[21,2],16,23,14,24,16,0,[25,24],14,[49,5],16]}]},"decisions":[],"choices":[{"stage":"representation","name":"encoding","value":"terrarium","alternatives":["terrarium","mapbox"],"sweepable":false},{"stage":"operator","name":"alphaNoData","value":true,"sweepable":false},{"stage":"operator","name":"clampBathymetry","value":false,"sweepable":false}],"metrics":[{"schema":"luma.computation-metrics/1","runId":"run-41e8bc9b","graph":"gpu-terrain-terrain-rgb-decode-compiled","timebase":"ns","encoding":{"coalesced":true,"timestamped":false,"taps":0,"lensTwin":true},"nodes":{}}],"captures":{"schema":"luma.computation-captures/1","runId":"run-41e8bc9b","snapshots":[{"id":"gpu-terrain-terrain-rgb-decode-snapshots-terrariumRGBA-0","name":"terrariumRGBA","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-terrain-terrain-rgb-decode-compiled","resource":"terrariumRGBA","afterNode":"terrain-rgb-decode-decode","role":"input","meaning":"raw Terrarium RGBA packed little-endian (four bytes per cell)","keySpace":"cells","geometry":{"kind":"raster","shape":[32,32],"coordinateModel":"projected","cellSize":20,"unit":"m"}},{"id":"gpu-terrain-terrain-rgb-decode-snapshots-decodedElevation-0","name":"decodedElevation","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-terrain-terrain-rgb-decode-compiled","resource":"decodedElevation","afterNode":"terrain-rgb-decode-decode","role":"output","meaning":"decoded elevation (m) on the 32×32, 20 m Terrarium grid","keySpace":"cells","geometry":{"kind":"raster","shape":[32,32],"coordinateModel":"projected","cellSize":20,"unit":"m"}},{"id":"gpu-terrain-terrain-rgb-decode-snapshots-decodedValidity-0","name":"decodedValidity","iteration":0,"elementType":"u32","values":"rle:*1024:00000001","provenance":"gpu-readback","graph":"gpu-terrain-terrain-rgb-decode-compiled","resource":"decodedValidity","afterNode":"terrain-rgb-decode-decode","role":"intermediate","meaning":"decoded elevation validity (0 or 1)","keySpace":"cells","geometry":{"kind":"raster","shape":[32,32],"coordinateModel":"projected","cellSize":20,"unit":"m"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const inputWordsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputWords: array<u32>;","const outputValuesOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> outputValues: array<f32>;","const outputValidityOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> outputValidity: array<u32>;","const WIDTH: u32 = 32u;","const HEIGHT: u32 = 32u;","fn isEncodedPixelValid(red: u32, green: u32, blue: u32, alpha: u32) -> bool {","  if (alpha == 0u) { return false; }","  ","  return true;","}","// Integer code N = R * 65536 + G * 256 + B < 2^24, then exactly one float operation sequence.","fn decodeHeight(red: u32, green: u32, blue: u32) -> f32 {","  let code = (red << 16u) | (green << 8u) | blue;","  return f32(code) * 0.00390625 - 32768.0;","fn isHeightInRange(height: f32) -> bool {","  return height >= -11000.0 && height <= 9000.0;","fn applySeaClamp(height: f32) -> f32 {","  return height;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &inputWords;","  _ = &outputValues;","  _ = &outputValidity;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  let pixelIndex = index;","  let word = inputWords[inputWordsOffset + pixelIndex];","  let red = word & 0xffu;","  let green = (word >> 8u) & 0xffu;","  let blue = (word >> 16u) & 0xffu;","  let alpha = word >> 24u;","  var isValid = isEncodedPixelValid(red, green, blue, alpha);","  let height = decodeHeight(red, green, blue);","  isValid = isValid && isHeightInRange(height);","  outputValidity[outputValidityOffset + pixelIndex] = select(0u, 1u, isValid);","  outputValues[outputValuesOffset + pixelIndex] =","    select(bitcast<f32>(0x7fc00000u | (pixelIndex & 0u)), applySeaClamp(height), isValid);"],"strings":["terrain-rgb-decode-decode","decodedElevation","decodedValidity","buffer","imported","terrariumRGBA","GPUTerrainRGBDecode","read_write"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[]}}
