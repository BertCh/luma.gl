2 {","  return recordRowColumns[recordRowColumnsOffset + record];","  _ = &recordKeys;","  _ = &recordRowColumns;","  _ = &segmentFlags;","  _ = &ones;","  var isHead = index == 0u;","  if (!isHead) {","    isHead = getRecordPolygon(index) != getRecordPolygon(index - 1u) ||","      getRecordRowColumn(index) / ROW_STRIDE != getRecordRowColumn(index - 1u) / ROW_STRIDE;","  segmentFlags[segmentFlagsOffset + index] = select(0u, 1u, isHead);","  ones[onesOffset + index] = 1u;","const ELEMENT_COUNT: u32 = 256u;","const SEGMENT_FLAGS_OFFSET: u32 = 0u;","@group(0) @binding(3) var<storage, read> segmentFlags: array<u32>;","var<workgroup> scratch: array<u32, 256>;","var<workgroup> segmentScratch: array<u32, 256>;","  if (workgroupIndex >= BLOCK_COUNT) { return; }","  let lane = localInvocationIndex;","  var inputSegmentFlag = 0u;","    inputSegmentFlag = segmentFlags[SEGMENT_FLAGS_OFFSET + index];","  scratch[lane] = inputValue;","  segmentScratch[lane] = inputSegmentFlag;","  for (var stride = 1u; stride < 256u; stride = stride * 2u) {","    var addend = 0u;","    var addendSegment = 0u;","    if (lane >= stride) {","      addend = scratch[lane - stride];","      addendSegment = segmentScratch[lane - stride];","    workgroupBarrier();","      scratch[lane] = select(addend + scratch[lane], scratch[lane], segmentScratch[lane] != 0u);","      segmentScratch[lane] = addendSegment | segmentScratch[lane];","    var scannedOutput = 0u;","    if (lane > 0u) {","      scannedOutput = scratch[lane - 1u];","    if (inputSegmentFlag != 0u) { scannedOutput = 0u; }","    outputValues[OUTPUT_OFFSET + index] = scannedOutput;","const ranksOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> ranks: array<u32>;","@group(0) @binding(4) var<storage, read> total: array<u32>;","@group(0) @binding(5) var<storage, read> extent: array<f32>;","@group(0) @binding(6) var<storage, read_write> zonesOut: array<atomic<u32>>;","  _ = &ranks;","  if (total[totalOffset] > CAPACITY || (ranks[ranksOffset