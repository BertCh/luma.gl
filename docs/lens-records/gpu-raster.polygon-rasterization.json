,"  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  if (index < CELL_COUNT) {","    zonesOut[zonesOutOffset + index] = 4294967295u;","    boundaryOut[boundaryOutOffset + index] = 0u;","  if (index < CAPACITY) {","    primary[primaryOffset + index] = 16384u;","    secondary[secondaryOffset + index] = 0u;","}","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const ringOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> ringOffsets: array<u32>;","const polygonOffsetsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> polygonOffsets: array<u32>;","const featureOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> featureOffsets: array<u32>;","const extentOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> extent: array<f32>;","const edgeCountsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> edgeCounts: array<u32>;","const edgeNextOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> edgeNext: array<u32>;","const edgePolygonsOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> edgePolygons: array<u32>;","const WIDTH: u32 = 64u;","const HEIGHT: u32 = 64u;","const ROW_STRIDE: u32 = 65u;","const POLYGON_COUNT: u32 = 2u;","const SINGLE_SORT: bool = true;","// Only the single-sort key packs polygons above the row-column bits.","const ROW_COLUMN_BITS: u32 = 13u;","const ROW_COLUMN_LIMIT: u32 = 4160u;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","struct RasterExtent { origin: vec2<f32>, cellSize: vec2<f32>, valid: bool, flipped: bool };","fn getRasterExtent() -> RasterExtent {","  let origin = vec2<f32>(extent[extentOffset], extent[extentOffset + 1u]);","  // A negative cell height means rows advance toward smaller y: the kernels count rows from the","  // smallest y and mirror the row index when they read or write the caller's rasters.","  let signedCellHeight = extent[extentOffset + 3u];","  let cellSize = vec2<f32>(extent[extentOffset + 2u], abs(signedCellHeight));","  let valid = isFiniteValue(origin.x) && isFiniteValue(origin.y) &&","    isFiniteValue(cellSize.x) && isFiniteValue(cellSize.y) && cellSize.x > 0.0 && cellSize.y > 0.0;","  return RasterExtent(origin, cellSize, valid, signedCellHeight < 0.0);","// Stored row of a row counted from the smallest y. Needs a HEIGHT constant.","fn getStoredRow(row: u32, rasterExtent: RasterExtent) -> u32 {","  return select(row, HEIGHT - 1u - row, rasterExtent.flipped);","fn getRowThreshold(y: f32, rasterExtent: RasterExtent) -> u32 {","  // Smallest row whose center line is at or above y.","  let row = ceil((y - rasterExtent.origin.y) / rasterExtent.cellSize.y - 0.5);","  return u32(clamp(row, 0.0, f32(HEIGHT)));","fn loadPosition(vertex: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + vertex * 2u], positions[positionsOffset + vertex * 2u + 1u]);","fn isFinitePosition(position: vec2<f32>) -> bool {","  return isFiniteValue(position.x) && isFiniteValue(position.y);","fn findRing(value: u32) -> u32 {","  // Largest i in [0, rangeCount) with offsets[i] <= value.","  var low = 0u;","  var high = 3u;","  while (low < high) {","    let middle = (low + high) / 2u;","    if (ringOffsets[ringOffsetsOffset + middle] <= value) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  if (low == 0u) {","    return 0xffffffffu;","  let range = low - 1u;","  if (value >= ringOffsets[ringOffsetsOffset + range + 1u]) {","  return range;","fn findPolygon(value: u32) -> u32 {","  var high = 2u;","    if (polygonOffsets[polygonOffsetsOffset + middle] <= value) {","  if (value >= polygonOffsets[polygonOffsetsOffset + range + 1u]) {","fn findFeature(value: u32) -> u32 {","  var high = 1u;","    if (featureOffsets[featureOffsetsOffset + middle] <= value) {","  if (value >= featureOffsets[featureOffsetsOffset + range + 1u]) {","@compute @workgroup_size(64)","  _ = &positions;","  _ = &ringOffsets;","  _ = &polygonOffsets;","  _ = &featureOffsets;","  _ = &extent;","  _ = &edgeCounts;","  _ = &edgeNext;","  _ = &edgePolygons;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  var next = 0xffffffffu;","  var polygon = 0xffffffffu;","  var count = 0u;","  ","  let ring = findRing(index);","  if (ring != 0xffffffffu) {","    polygon = findPolygon(ring);","  if (polygon != 0xffffffffu && findFeature(polygon) != 0xffffffffu) {","    let ringStart = ringOffsets[ringOffsetsOffset + ring];","    let ringEnd = ringOffsets[ringOffsetsOffset + ring + 1u];","    next = select(index + 1u, ringStart, index + 1u >= ringEnd);","    let start = loadPosition(index);","    let end = loadPosition(next);","    let rasterExtent = getRasterExtent();","    if (rasterExtent.valid && isFinitePosition(start) && isFinitePosition(end)) {","      let low = getRowThreshold(min(start.y, end.y), rasterExtent);","      let high = getRowThreshold(max(start.y, end.y), rasterExtent);","      count = high - min(low, high);","      ","      next = 0xffffffffu;","  } else {","    polygon = 0xffffffffu;","  edgeCounts[edgeCountsOffset + index] = count;","  edgeNext[edgeNextOffset + index] = next;","  edgePolygons[edgePolygonsOffset + index] = polygon;","enable subgroups;","requires subgroup_id;","const ELEMENT_COUNT: u32 = 64u;","const BLOCK_COUNT: u32 = 1u;","const INPUT_OFFSET: u32 = 0u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","  if (workgroupIndex >= 16777216u || workgroupIndex >= BLOCK_COUNT) { return; }","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    ","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","@group(0) @binding(1) var<storage, read> extent: array<f32>;","@group(0) @binding(2) var<storage, read> edgeNext: array<u32>;","@group(0) @binding(3) var<storage, read_write> boundaryOut: array<atomic<u32>>;","// Cell padding that keeps the marking conservative under float32 rounding: a fixed part plus","// about 8 ulps of the largest magnitude involved, in cell units.","const BASE_PADDING: f32 = 1e-3;","const RELATIVE_PADDING: f32 = 1e-6;","fn clampCell(value: f32, limit: u32) -> i32 {","  return i32(clamp(floor(value), -1.0, f32(limit)));","  let next = edgeNext[edgeNextOffset + index];","  if (next == 0xffffffffu) {","  let rasterExtent = getRasterExtent();","  let startPosition = loadPosition(index);","  let endPosition = loadPosition(next);","  // Edge in cell units.","  let start = (startPosition - rasterExtent.origin) / rasterExtent.cellSize;","  let end = (endPosition - rasterExtent.origin) / rasterExtent.cellSize;","  let magnitude = (max(abs(startPosition), abs(endPosition)) + abs(rasterExtent.origin)) / rasterExtent.cellSize;","  let padding = BASE_PADDING + RELATIVE_PADDING * max(magnitude.x, magnitude.y);","  let lower = select(end, start, start.y < end.y);","  let upper = select(start, end, start.y < end.y);","  let firstRow = max(clampCell(lower.y - padding, HEIGHT), 0);","  let lastRow = min(clampCell(upper.y + padding, HEIGHT), i32(HEIGHT) - 1);","  for (var row = firstRow; row <= lastRow; row++) {","    // x extent of the segment inside the padded row slab.","    var slabX = vec2<f32>(lower.x, upper.x);","    let deltaY = upper.y - lower.y;","    if (deltaY > 0.0) {","      let t0 = clamp((f32(row) - padding - lower.y) / deltaY, 0.0, 1.0);","      let t1 = clamp((f32(row + 1) + padding - lower.y) / deltaY, 0.0, 1.0);","      slabX = vec2<f32>(lower.x + (upper.x - lower.x) * t0, lower.x + (upper.x - lower.x) * t1);","    let firstColumn = max(clampCell(min(slabX.x, slabX.y) - padding, WIDTH), 0);","    let lastColumn = min(clampCell(max(slabX.x, slabX.y) + padding, WIDTH), i32(WIDTH) - 1);","    for (var column = firstColumn; column <= lastColumn; column++) {","      atomicStore(&boundaryOut[boundaryOutOffset + getStoredRow(u32(row), rasterExtent) * WIDTH + u32(column)], 1u);","const countsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> counts: array<u32>;","const offsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","const totalOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> total: array<u32>;","override ROW_COUNT: u32;","override TOTAL_ROW: u32;","@compute @workgroup_size(32)","  _ = &counts;","  _ = &offsets;","  _ = &total;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  var sum = 0u;","  if (ROW_COUNT > 0u) {","    sum = offsets[offsetsOffset + ROW_COUNT - 1u] + counts[countsOffset + ROW_COUNT - 1u];","  total[totalOffset + TOTAL_ROW] = sum;","@group(0) @binding(2) var<storage, read> edgeCounts: array<u32>;","@group(0) @binding(3) var<storage, read> edgeNext: array<u32>;","@group(0) @binding(4) var<storage, read> edgePolygons: array<u32>;","const edgeOffsetsOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read> edgeOffsets: array<u32>;","@group(0) @binding(6) var<storage, read_write> primary: array<u32>;","@group(0) @binding(7) var<storage, read_write> secondary: array<u32>;","  _ = &edgeOffsets;","  let count = edgeCounts[edgeCountsOffset + index];","  if (count == 0u) {","  let polygon = edgePolygons[edgePolygonsOffset + index];","  let first = loadPosition(index);","  let second = loadPosition(next);","  // Orient bottom to top so both traversal directions compute bitwise identical crossings.","  let lower = select(second, first, first.y < second.y);","  let upper = select(first, second, first.y < second.y);","  let firstRow = getRowThreshold(lower.y, rasterExtent);","  let base = edgeOffsets[edgeOffsetsOffset + index];","  for (var step = 0u; step < count; step++) {","    let slot = base + step;","    if (slot >= CAPACITY) {","      break;","    let row = firstRow + step;","    let centerY = rasterExtent.origin.y + (f32(row) + 0.5) * rasterExtent.cellSize.y;","    let t = clamp((centerY - lower.y) / (upper.y - lower.y), 0.0, 1.0);","    let crossingX = lower.x + (upper.x - lower.x) * t;","    // First column whose center is at or right of the crossing.","    let column = u32(clamp(ceil((crossingX - rasterExtent.origin.x) / rasterExtent.cellSize.x - 0.5), 0.0, f32(WIDTH)));","    let rowColumn = row * ROW_STRIDE + column;","    if (SINGLE_SORT) {","      primary[primaryOffset + slot] = (polygon << ROW_COLUMN_BITS) | rowColumn;","      secondary[secondaryOffset + slot] = rowColumn;","      primary[primaryOffset + slot] = rowColumn;","      secondary[secondaryOffset + slot] = polygon;","@group(0) @binding(2) var<storage, read_write> total: array<atomic<u32>>;","  let offset = offsets[offsetsOffset + index];","  if (offset + counts[countsOffset + index] < offset) {","    atomicStore(&total[totalOffset + TOTAL_ROW], 4294967295u);","const INVALID_INDEX: u32 = 4294967295u;","const LOGICAL_LENGTH: u32 = 256u;","const PADDED_LENGTH: u32 = 256u;","const KEYS_OFFSET: u32 = 0u;","const VALUES_OFFSET: u32 = 0u;","const OUTPUT_KEYS_OFFSET: u32 = 0u;","const OUTPUT_VALUES_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> keys: array<u32>;","@group(0) @binding(1) var<storage, read> values: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputKeys: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","var<workgroup> indices: array<u32, 256>;","var<workgroup> cachedKeys: array<u32, 256>;","fn comes_before(leftIndex: u32, rightIndex: u32) -> bool {","  let leftValid = leftIndex != INVALID_INDEX && leftIndex < LOGICAL_LENGTH;","  let rightValid = rightIndex != INVALID_INDEX && rightIndex < LOGICAL_LENGTH;","  if (leftValid != rightValid) { return leftValid; }","  if (!leftValid) { return false; }","  let leftKey = cachedKeys[leftIndex];","  let rightKey = cachedKeys[rightIndex];","  if (leftKey == rightKey) { return leftIndex < rightIndex; }","  return leftKey < rightKey;","  @builtin(subgroup_id) subgroupId: u32","  var currentIndex = select(INVALID_INDEX, lane, lane < LOGICAL_LENGTH);","  if (lane < LOGICAL_LENGTH) {","    cachedKeys[lane] = keys[KEYS_OFFSET + lane];","    cachedKeys[lane] = 0u;","  for (var blockWidth = 2u; blockWidth <= PADDED_LENGTH; blockWidth <<= 1u) {","    for (var compareStride = blockWidth >> 1u; compareStride > 0u; compareStride >>= 1u) {","      var partnerIndex = INVALID_INDEX;","      if (compareStride < subgroupSize) {","        partnerIndex = subgroupShuffleXor(currentIndex, compareStride);","      } else {","        indices[lane] = currentIndex;","        workgroupBarrier();","        partnerIndex = indices[lane ^ compareStride];