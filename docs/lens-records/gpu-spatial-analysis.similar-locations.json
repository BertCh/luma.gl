,"choices":[{"name":"standardization","label":"Column standardization","stage":"support","alternatives":["zscore","rank"],"sweepable":true,"value":"zscore"},{"name":"resultCount","label":"Rows reported","stage":"presentation","sweepable":false,"value":10},{"name":"direction","label":"Most or least similar","stage":"operator","alternatives":["most","least"],"sweepable":true,"value":"most"},{"name":"excludeReference","stage":"operator","alternatives":[true,false],"sweepable":false,"value":true},{"name":"coordinateModel","stage":"presentation","sweepable":false,"value":"geographic"}],"captures":{"schema":"luma.computation-captures/1","runId":"run-5056d686","snapshots":[{"id":"gpu-spatial-analysis.similar-locations-snapshots-vertices-0","name":"vertices","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"vertices","afterNode":"similar-locations-rank","components":2,"role":"intermediate","keySpace":"vertex"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-ringOffsets-0","name":"ringOffsets","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"ringOffsets","afterNode":"similar-locations-rank","role":"intermediate"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-values-0","name":"values","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"values","afterNode":"similar-locations-rank","role":"intermediate","keySpace":"attribute","meaning":"Poverty %, median income, uninsured %, no-vehicle %, unemployed %, row-major per tract"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-referenceMask-0","name":"referenceMask","iteration":0,"elementType":"u32","values":"rle:*40:00000000,AQAAAA==,*95:00000000","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"referenceMask","afterNode":"similar-locations-rank","role":"intermediate","keySpace":"tract","meaning":"The one reference tract (1); every other tract is compared to it"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-distances-0","name":"distances","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"distances","afterNode":"similar-locations-rank","role":"intermediate","keySpace":"tract","meaning":"Distance to the reference in standardized units; small is similar, the reference is blank"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-distances-0-geometry","name":"distances.geometry","iteration":0,"elementType":"f32","values":"same:snapshots.0","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"vertices","afterNode":"similar-locations-rank","components":2,"role":"output","keySpace":"vertex","meaning":"Distance to the reference in standardized units; small is similar, the reference is blank","geometry":{"kind":"polygons","coordinateModel":"geographic","offsetsCapture":"gpu-spatial-analysis.similar-locations-snapshots-ringOffsets-0","valuesCapture":"gpu-spatial-analysis.similar-locations-snapshots-distances-0"}},{"id":"gpu-spatial-analysis.similar-locations-snapshots-ranks-0","name":"ranks","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"ranks","afterNode":"similar-locations-rank","role":"intermediate","keySpace":"tract","meaning":"Similarity rank, 0 is the most similar; the reference has none"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-topIds-0","name":"topIds","iteration":0,"elementType":"u32","values":"rle:LAAAAC4AAAAZAAAAJQAAADEAAAAvAAAAMAAAACQAAAA8AAAAMwAAAA==,*22:ffffffff","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"topIds","afterNode":"similar-locations-rank","role":"intermediate","keySpace":"top","meaning":"Tract rows of the 10 most similar tracts in rank order"},{"id":"gpu-spatial-analysis.similar-locations-snapshots-topCount-0","name":"topCount","iteration":0,"elementType":"u32","values":"b64:CgAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis.similar-locations-compiled","resource":"topCount","afterNode":"similar-locations-rank","role":"intermediate","keySpace":"status","meaning":"Valid entries of topIds"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const attributesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> attributes: array<f32>;","const validityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> validity: array<u32>;","const ROW_COUNT: u32 = 136u;","const ATTRIBUTE_COUNT: u32 = 5u;","const MAX_RESULTS: u32 = 32u;","const NO_RANK: u32 = 0xffffffffu;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &attributes;","  _ = &validity;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  var isValid = true;","  ","  for (var channel = 0u; channel < ATTRIBUTE_COUNT; channel++) {","    isValid = isValid && isFiniteValue(attributes[attributesOffset + index * ATTRIBUTE_COUNT + channel]);","  validity[validityOffset + index] = select(0u, 1u, isValid);","@group(0) @binding(1) var<storage, read> validity: array<u32>;","const statsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> stats: array<f32>;","const LANES: u32 = 256u;","var<workgroup> floatScratch: array<f32, 256>;","var<workgroup> countScratch: array<u32, 256>;","fn reduceSum(value: f32, lane: u32) -> f32 {","  workgroupBarrier();","  floatScratch[lane] = value;","  for (var stride = LANES / 2u; stride > 0u; stride = stride / 2u) {","    if (lane < stride) {","      floatScratch[lane] += floatScratch[lane + stride];","    }","    workgroupBarrier();","  return floatScratch[0];","fn reduceCount(value: u32, lane: u32) -> u32 {","  countScratch[lane] = value;","      countScratch[lane] += countScratch[lane + stride];","  return countScratch[0];","@compute @workgroup_size(256)","  _ = &stats;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let column = index / LANES;","  let lane = localInvocationIndex;","  var validPartial = 0u;","  var sumPartial = 0.0;","  for (var row = lane; row < ROW_COUNT; row += LANES) {","    if (validity[validityOffset + row] != 0u) {","      validPartial += 1u;","      sumPartial += attributes[attributesOffset + row * ATTRIBUTE_COUNT + column];","  let valid = reduceCount(validPartial, lane);","  let mean = select(0.0, reduceSum(sumPartial, lane) / f32(valid), valid > 0u);","  var squaresPartial = 0.0;","      let delta = attributes[attributesOffset + row * ATTRIBUTE_COUNT + column] - mean;","      squaresPartial += delta * delta;","  let squares = reduceSum(squaresPartial, lane);","  if (lane == 0u) {","    let deviation = select(0.0, sqrt(squares / f32(valid)), valid > 0u);","    stats[statsOffset + 2u * column] = mean;","    stats[statsOffset + 2u * column + 1u] = select(0.0, 1.0 / deviation, deviation > 0.0);","@group(0) @binding(2) var<storage, read> stats: array<f32>;","const standardizedOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> standardized: array<f32>;","  _ = &standardized;","  let row = index / ATTRIBUTE_COUNT;","  let channel = index % ATTRIBUTE_COUNT;","  if (validity[validityOffset + row] == 0u) {","    standardized[standardizedOffset + index] = getNaN();","  standardized[standardizedOffset + index] =","    (attributes[attributesOffset + index] - stats[statsOffset + 2u * channel]) *","    stats[statsOffset + 2u * channel + 1u];","@group(0) @binding(0) var<storage, read> standardized: array<f32>;","const selectionOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> selection: array<u32>;","const referenceOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> reference: array<f32>;","  _ = &selection;","  _ = &reference;","  var countPartial = 0u;","    if (validity[validityOffset + row] != 0u && selection[selectionOffset + row] != 0u) {","      countPartial += 1u;","      sumPartial += standardized[standardizedOffset + row * ATTRIBUTE_COUNT + column];","  let count = reduceCount(countPartial, lane);","  let sum = reduceSum(sumPartial, lane);","    reference[referenceOffset + column] = select(getNaN(), sum / f32(count), count > 0u);","@group(0) @binding(3) var<storage, read> reference: array<f32>;","const paramsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read> params: array<f32>;","const keysOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> keys: array<u32>;","const rowIdsOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> rowIds: array<u32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(7) var<storage, read_write> distances: array<f32>;","  _ = &params;","  _ = &keys;","  _ = &rowIds;","  _ = &distances;","  rowIds[rowIdsOffset + index] = index;","  let isLeast = params[paramsOffset + 1u] > 0.5;","  let excludeReference = params[paramsOffset + 2u] > 0.5;","  var eligible = validity[validityOffset + index] != 0u &&","    !(excludeReference && selection[selectionOffset + index] != 0u);","  var distanceSquared = 0.0;","    let weight = params[paramsOffset + 4u + channel];","    let delta = standardized[standardizedOffset + index * ATTRIBUTE_COUNT + channel] -","      reference[referenceOffset + channel];","    distanceSquared += weight * delta * delta;","  eligible = eligible && isFiniteValue(distanceSquared);","  let distance = sqrt(distanceSquared);","  // Non-negative f32 bit patterns order like the values; the sentinel sorts after every key.","  let bits = bitcast<u32>(distance);","  keys[keysOffset + index] = select(NO_RANK, select(bits, 0xfffffffeu - bits, isLeast), eligible);","  distances[distancesOffset + index] = select(getNaN(), distance, eligible);","enable subgroups;","requires subgroup_id;","const INVALID_INDEX: u32 = 4294967295u;","const LOGICAL_LENGTH: u32 = 136u;","const PADDED_LENGTH: u32 = 256u;","const KEYS_OFFSET: u32 = 0u;","const VALUES_OFFSET: u32 = 0u;","const OUTPUT_KEYS_OFFSET: u32 = 0u;","const OUTPUT_VALUES_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> keys: array<u32>;","@group(0) @binding(1) var<storage, read> values: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputKeys: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","var<workgroup> indices: array<u32, 256>;","var<workgroup> cachedKeys: array<u32, 256>;","fn comes_before(leftIndex: u32, rightIndex: u32) -> bool {","  let leftValid = leftIndex != INVALID_INDEX && leftIndex < LOGICAL_LENGTH;","  let rightValid = rightIndex != INVALID_INDEX && rightIndex < LOGICAL_LENGTH;","  if (leftValid != rightValid) { return leftValid; }","  if (!leftValid) { return false; }","  let leftKey = cachedKeys[leftIndex];","  let rightKey = cachedKeys[rightIndex];","  if (leftKey == rightKey) { return leftIndex < rightIndex; }","  return leftKey < rightKey;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  var currentIndex = select(INVALID_INDEX, lane, lane < LOGICAL_LENGTH);","  if (lane < LOGICAL_LENGTH) {","    cachedKeys[lane] = keys[KEYS_OFFSET + lane];","  } else {","    cachedKeys[lane] = 0u;","  for (var blockWidth = 2u; blockWidth <= PADDED_LENGTH; blockWidth <<= 1u) {","    for (var compareStride = blockWidth >> 1u; compareStride > 0u; compareStride >>= 1u) {","      var partnerIndex = INVALID_INDEX;","      if (compareStride < subgroupSize) {","        partnerIndex = subgroupShuffleXor(currentIndex, compareStride);","      } else {","        indices[lane] = currentIndex;","        workgroupBarrier();","        partnerIndex = indices[lane ^ compareStride];","      }","      let lowerLane = (lane & compareStride) == 0u;","      let leftIndex = select(partnerIndex, currentIndex, lowerLane);","      let rightIndex = select(currentIndex, partnerIndex, lowerLane);","      let ascending = (lane & blockWidth) == 0u;","      let shouldSwap = select(","        comes_before(leftIndex, rightIndex),","        comes_before(rightIndex, leftIndex),","        ascending","      );","      let sortedLeft = select(leftIndex, rightIndex, shouldSwap);","      let sortedRight = select(rightIndex, leftIndex, shouldSwap);","      currentIndex = select(sortedRight, sortedLeft, lowerLane);","      if (compareStride >= subgroupSize) {","    outputKeys[OUTPUT_KEYS_OFFSET + lane] = cachedKeys[currentIndex];","    outputValues[OUTPUT_VALUES_OFFSET + lane] = values[VALUES_OFFSET + currentIndex];","const sortedKeysOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> sortedKeys: array<u32>;","const sortedIdsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> sortedIds: array<u32>;","@group(0) @binding(2) var<storage, read> params: array<f32>;","const ranksOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> ranks: array<u32>;","const topIdsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> topIds: array<u32>;","const resultCountOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> resultCount: array<u32>;","  _ = &sortedKeys;","  _ = &sortedIds;","  _ = &ranks;","  _ = &topIds;","  _ = &resultCount;","  let key = sortedKeys[sortedKeysOffset + index];","  let isEligible = key != NO_RANK;","  let row = sortedIds[sortedIdsOffset + index];","  ranks[ranksOffset + row] = select(NO_RANK, index, isEligible);","  let requested = params[paramsOffset];","  let limit = min(u32(clamp(select(0.0, requested, isFiniteValue(requested)), 0.0, f32(MAX_RESULTS))), MAX_RESULTS);","  // Eligible rows sort first, so the boundary row owns the eligible count.","  let isLast = index + 1u == ROW_COUNT || sortedKeys[sortedKeysOffset + index + 1u] == NO_RANK;","  if (isEligible && isLast) {","    resultCount[resultCountOffset] = min(index + 1u, limit);","  if (index == 0u && !isEligible) {","    resultCount[resultCountOffset] = 0u;","  if (index < MAX_RESULTS) {","    topIds[topIdsOffset + index] = select(NO_RANK, row, isEligible && index < limit);"],"strings":["buffer","read","similar-locations-distance","similar-locations-validity","similar-locations-reference","similar-locations-rank","GPUSimilarLocations","transient","read_write","similar-locations-standardized","similar-locations-sort-bitonic-local","similar-locations-standardize-zscore","similar-locations-validate","values","compute","imported","similar-locations","similar-locations-keys","similar-locations-row-ids","similar-locations-stats","similar-locations-sorted-ids","similar-locations-sorted-keys","distances","parameters","ranks","referenceMask","similar-locations-column-statistics","topIds","validity","topCount","attributes","bitonic-local","reference","standardized","transient-buffer-1","GPUSort","keys","params","selection","stats","transient-buffer-0","transient-buffer-2","transien