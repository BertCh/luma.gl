{"schema":"luma.lens-record/1","scenarioId":"gpu-spatial-analysis.similar-locations","recordedAt":"2026-10-15T01:53:25.330Z","adapterLabel":"apple (unknown)","record":{"schema":"luma.computation/1","id":"gpu-spatial-analysis.similar-locations","runId":"run-5056d686","createdAt":"2026-10-15T01:53:25.251Z","adapter":{"backend":"webgpu","vendor":"apple","architecture":"metal-3","description":""},"domains":["gpu-spatial-analysis"],"graphs":[["~:0","gpu-spatial-analysis.similar-locations-compiled","compiled","gpu-core","gpu-spatial-analysis.similar-locations",[["~:1","~c","~c","~g","~e","~6","wgsl:e13f1bf4",[64,1,1],["~^1",["~:2","~s","~3","~8","u32",0,136]],"~^2",["~d","~3"],["~3"],["~:4","~6","validate",1,3,136,2720,544],["~:5"]],["~:1","~q","~q","~g","~e","~6","wgsl:00ffc853",[256,1,1],["~^1","~^0",["~:2","~13","~j","~8","f32",0,10]],"~^6",["~d","~3","~j"],["~j"],["~:4","~6","column-statistics",1,5,1280,3264,40],["~:5"]],["~:1","~b","~b","~g","~e","~6","wgsl:528eb28f",[64,1,1],["~^1","~^0",["~:2","~13","~j","~1","f32",0,10],["~:2","~x","~9","~8","f32",0,680]],["~:3",[11,1,1],680,false],["~d","~3","~j","~9"],["~9"],["~:4","~6","standardize-zscore",1,11,680,3304,2720],["~:5"]],["~:1","~4","~4","~g","~e","~6","wgsl:3406a11b",[256,1,1],["~^5","~^0","~^4",["~:2","~w","~4","~8","f32",0,5]],"~^6",["~9","~3","~p","~4"],["~4"],["~:4","~6","~w",1,5,1280,3808,20],["~:5"]],["~:1","~2","~2","~g","~e","~6","wgsl:1f816070",[64,1,1],["~^5","~^0","~^4",["~:2","~w","~4","~1","f32",0,5],"~^3",["~:2","~10","~h","~8","u32",0,136],["~:2","rowIds","~i","~8","u32",0,136],["~:2","~m","~m","~8","f32",0,136]],"~^2",["~9","~3","~p","~4","~n","~h","~i","~m"],["~h","~i","~m"],["~:4","~6","distance",1,3,136,3864,1632],["~:5"]],["~:6","~a","~v","~g","~e","~z","~v","wgsl:cb5e55ba",[256,1,1],[["~:2","~10","~h","~1","u32",0,136],["~:2","~d","~i","~1","u32",0,136],["~:2","outputKeys","~l","~18","u32",0,136],["~:2","outputValues","~k","~18","u32",0,136]],["~:3",[1,1,1],136,false],["~h","~i"],["~l","~k"],["~:4","~z","~v",1,1,256,1088,1088],["~:5"]],["~:1","~5","~5","~g","~e","~6","wgsl:02b2fb59",[64,1,1],[["~:2","sortedKeys","~l","~1","u32",0,136],["~:2","sortedIds","~k","~1","u32",0,136],"~^3",["~:2","~o","~o","~8","u32",0,136],["~:2","~r","~r","~8","u32",0,32],["~:2","resultCount","~t","~8","u32",0,1]],"~^2",["~l","~k","~n","~o","~r","~t"],["~o","~r","~t"],["~:4","~6","rank",1,3,136,1124,676],["~:5"]]],[["~:7","~c","~q","raw","~3"],["~:7","~c","~b","raw","~3"],["~:7","~q","~b","raw","~j"],["~:7","~b","~4","raw","~9"],["~:7","~c","~4","raw","~3"],["~:7","~b","~2","raw","~9"],["~:7","~c","~2","raw","~3"],["~:7","~4","~2","raw","~4"],["~:7","~2","~a","raw","~h"],["~:7","~2","~a","raw","~i"],["~:7","~a","~5","raw","~l"],["~:7","~a","~5","raw","~k"]],[["~:8","vertices","~0",13840,"~f"],["~:8","ringOffsets","~0",548,"~f"],["~:8","featureOffsets","~0",548,"~f"],["~:8","polygonOffsets","~0",548,"~f"],["~:9","~d","~0",2720,"~f","~c","~b"],["~:9","~p","~0",544,"~f","~4","~2"],["~:9","~n","~0",36,"~f","~2","~5"],["~:a","~o","~0",544,"~7","~16",544,"~5","~5",true],["~:a","~m","~0",544,"~7","transient-buffer-3",544,"~2","~2",true],["~:a","~r","~0",128,"~7","~17",544,"~5","~5",true],["~:a","~t","~0",4,"~7","~y",40,"~5","~5",true],["~:b","~3","~0",544,"~7","~14",544,"~c","~2"],["~:b","~9","~0",2720,"~7","~15",2720,"~b","~2"],["~:b","~4","~0",20,"~7","~y",40,"~4","~2"],["~:b","~h","~0",544,"~7","~16",544,"~2","~a"],["~:b","~i","~0",544,"~7","~17",544,"~2","~a"],["~:b","~l","~0",544,"~7","~14",544,"~a","~5"],["~:b","~k","~0",544,"~7","~15",2720,"~a","~5"],["~:b","~j","~0",40,"~7","~y",40,"~q","~b"]],["~:c",4]]],"axes":{"axes":[{"id":"entity","label":"Chicago tract","kind":"data","keySpace":"tract","size":136}],"keySpaces":[{"id":"tract","label":"Chicago tract","size":136,"indexSpace":"csr"},{"id":"vertex","label":"Ring vertex","size":1730,"indexSpace":"1d"},{"id":"attribute","label":"Tract attribute value","size":680,"indexSpace":"1d"},{"id":"top","label":"Most similar rank","size":32,"indexSpace":"1d"},{"id":"status","label":"Result count","size":1,"indexSpace":"1d"}],"relations":[]},"refs":{"formulas":[{"id":"similar-locations-distance","derivation":"curated","tex":"\\begin{aligned}\n\\term{standardized}{z_{ic}}&=\\frac{x_{ic}-\\bar{x}_c}{\\term{deviation}{s_c}},\\qquad \\term{reference}{r_c}=\\frac{1}{\\lvert R\\rvert}\\sum_{i\\in R}z_{ic}\\\\\n\\term{distance}{d_i}&=\\sqrt{\\sum_c \\term{weight}{w_c}\\,\\bigl(z_{ic}-r_c\\bigr)^2}\n\\end{aligned}","ascii":"Per attribute column c over the valid rows: z_ic = (x_ic - mean_c) / s_c with s_c the population standard deviation (0 for a constant column); with standardization rank, z is the average-tie percentile rank (rank - 1) / (n - 1) instead. The reference vector r_c is the mean of the standardized values of the selected reference rows R. Distance d_i = sqrt(sum_c w_c (z_ic - r_c)^2) with non-negative column weights w_c. Rows are ranked by d (lowest row on ties; rank 0 is the most similar, or the least with direction least); invalid, masked and reference rows get no rank and a NaN distance.","symbols":[{"id":"standardized","role":"intermediate","binding":"wgsl:standardized"},{"id":"deviation","role":"intermediate","binding":"wgsl:deviation"},{"id":"reference","role":"intermediate","binding":"wgsl:reference"},{"id":"distance","role":"output","binding":"wgsl:distance"},{"id":"weight","role":"parameter","binding":"wgsl:weight"}]}],"sources":[{"id":"wgsl:e13f1bf4","language":"wgsl","moduleId":"GPUSimilarLocations/validate","hash":"e13f1bf4","bodyHash":"2662827b","entryPoint":"main","constants":{"INVOCATION_COUNT":136,"WGSL_KERNEL_DISPATCH_X":3,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,12],0,12,0,0,[13,5],0,0,0,0,[18,20],33,38,17]},{"id":"wgsl:00ffc853","language":"wgsl","moduleId":"GPUSimilarLocations/column-statistics","hash":"00ffc853","bodyHash":"84b87c21","entryPoint":"main","constants":{"INVOCATION_COUNT":1280,"WGSL_KERNEL_DISPATCH_X":5,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,7],[39,3]