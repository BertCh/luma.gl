{"schema":"luma.lens-record/1","scenarioId":"gpu-core.histogram","recordedAt":"2026-10-15T00:48:02.477Z","adapterLabel":"apple (unknown)","record":{"schema":"luma.computation/1","id":"gpu-core.histogram","runId":"run-732bbc24","createdAt":"2026-10-15T00:48:02.474Z","adapter":{"backend":"webgpu","vendor":"apple","architecture":"metal-3","description":""},"domains":["gpu-core"],"graphs":[["~:0","gpu-core-histogram-compiled","compiled","gpu-core","Stations per 20 mm rainfall bin",[["~:1","~3","~3","~9","~6","~2","~^0","wgsl:f2e40613",[256,1,1],[["~:3","~8","~0","write","u32",0,16]],["~:4",[1,1,1],16,false],[],["~0"],["~:5","~2",1,1,256],["~:6"]],["~:7","~1","~1","~9","~6","~2","~^0","gpu-core.histogram","wgsl:a2668968",[256,1,1],[["~:3","inputValues","~4","read","f32",0,1024],["~:3","~8","~0","read_write","u32",0,16]],["~:4",[4,1,1],1024,false],["~4","~0"],["~0"],["~:5","~2",1,4,1024],["~:6"]]],[["~:8","~3","~1","raw","~0"]],[["~:9","~4","~5",4096,"~7","~1","~1"],["~:9","~0","~5",64,"~7","~3","~1"]]]],"axes":{"axes":[{"id":"stations","label":"Station","kind":"data","keySpace":"stations","size":1024},{"id":"bins","label":"20 mm bin","kind":"data","keySpace":"bins","size":16},{"id":"node","label":"Scheduled node","kind":"structure","size":2}],"keySpaces":[{"id":"stations","label":"Station","size":1024,"indexSpace":"1d"},{"id":"bins","label":"20 mm bin","size":16,"indexSpace":"1d"}],"relations":[]},"refs":{"formulas":[{"id":"gpu-core.histogram","tex":"\\term{counts}{H_b}=\\sum_{i\\in S}\\mathbf1[\\operatorname{bin}(\\term{x}{x_i})=b],\\quad\\operatorname{bin}(v)=\\operatorname{min}(B-1,\\lfloor B(v-a)/(z-a)\\rfloor)","ascii":"H[b]=count of finite, mask-selected values in bin b. Reject outside [a,z]. Uniform bins use floor(B*(v-a)/(z-a)), with z in B-1; a=z sends equal values to bin 0. Explicit strictly increasing finite edges use [e[b],e[b+1]), final bin includes last edge; invalid GPU edges yield zeros. Integer uniform binning uses exact multiply/divide floor; float uses f32 arithmetic.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"counts","role":"output","binding":"wgsl:outputCounts"},{"id":"mask","role":"input","binding":"wgsl:selectionMask"},{"id":"edges","role":"parameter","binding":"wgsl:edgeValues"}],"derivation":"curated"}],"sources":[{"id":"wgsl:f2e40613","language":"wgsl","moduleId":"GPUHistogram/clear","hash":"f2e40613","entryPoint":"main","textLines":[[0,13]]},{"id":"wgsl:a2668968","language":"wgsl","moduleId":"GPUHistogram/accumulate/local","hash":"a2668968","entryPoint":"main","textLines":[0,[13,2],1,[15,2],0,0,2,17,0,0,[18,2],0,0,[20,6],12,0,[26,3],12,0,[29,9],12,0,[4,2],[38,2],7,40,[9,2],[41,34],62,75,63,45,[76,2],63,12]}]},"decisions":[],"choices":[],"captures":{"schema":"luma.computation-captures/1","runId":"run-732bbc24","snapshots":[{"id":"gpu-core-histogram-snapshots-rainfall-0","name":"rainfall","iteration":0,"elementType":"f32","values":"b64:MzMTQDMz80AzM+NAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEBAMzOTQDMzjkLNzCxCMzOmQg==","provenance":"gpu-readback","graph":"gpu-core-histogram-compiled","resource":"rainfall","afterNode":"rainfall-histogram-local","role":"input","keySpace":"stations"},{"id":"gpu-core-histogram-snapshots-stationsPerBin-0","name":"stationsPerBin","iteration":0,"elementType":"u32","values":"b64:RAIAAJQAAABJAAAAMQAAAB8AAAAiAAAAHwAAABsAAAARAAAAEgAAAAUAAAACAAAAAwAAAAMAAAABAAAAAgAAAA==","provenance":"gpu-readback","graph":"gpu-core-histogram-compiled","resource":"stationsPerBin","afterNode":"rainfall-histogram-local","role":"output","keySpace":"bins","meaning":"bars edges:0,20,40,60,80,100,120,140,160,180,200,220,240,260,280,300,320","highlight":{"key":0,"label":"modal bin 0–20 mm: 580 stations"}}],"stamps":[],"replays":[]},"metrics":[{"schema":"luma.computation-metrics/1","runId":"run-732bbc24","graph":"gpu-core-histogram-compiled","timebase":"ns","encoding":{"coalesced":true,"timestamped":false,"taps":0,"lensTwin":true,"retained":[]},"nodes":{}}]},"encoding":{"sourceLines":["","const BIN_COUNT: u32 = 16u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputCounts: array<atomic<u32>>;","@compute @workgroup_size(256) fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index < BIN_COUNT) { atomicStore(&outputCounts[OUTPUT_OFFSET + index], 0u); }","}","enable subgroups;","const ELEMENT_COUNT: u32 = 1024u;","const INPUT_OFFSET: u32 = 0u;","const INPUT_STRIDE: u32 = 1u;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read_write> outputCounts: array<atomic<u32>>;","var<workgroup> localCounts: array<atomic<u32>, 16>;","fn getFirstBallotLane(mask: vec4<u32>) -> u32 {","  if (mask.x != 0u) { return firstTrailingBit(mask.x); }","  if (mask.y != 0u) { return 32u + firstTrailingBit(mask.y); }","  if (mask.z != 0u) { return 64u + firstTrailingBit(mask.z); }","  if (mask.w != 0u) { return 96u + firstTrailingBit(mask.w); }","  return 0u;","fn getBallotLaneCount(mask: vec4<u32>) -> u32 {","  return countOneBits(mask.x) + countOneBits(mask.y) +","    countOneBits(mask.z) + countOneBits(mask.w);","fn getBallotPrefixLaneCount(mask: vec4<u32>, invocation: u32) -> u32 {","  let word = invocation >> 5u;","  let bit = invocation & 31u;","  var count = 0u;","  if (word > 0u) { count += countOneBits(mask.x); }","  if (word > 1u) { count += countOneBits(mask.y); }","  if (word > 2u) { count += countOneBits(mask.z); }","  let lowerBits = (1u << bit) - 1u;","  return count + countOneBits(mask[word] & lowerBits);","  @builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 4u + workgroupId.x;","  let lane = localInvocationIndex;","  let minimum: f32 = 0.0;","  let maximum: f32 = 320.0;","  if (lane < BIN_COUNT) { atomicStore(&localCounts[lane], 0u); }","  workgroupBarrier();","  var accepted = false;","  var binIndex = 0u;","  if (index < ELEMENT_COUNT && maximum >= minimum) {","    let value = inputValues[INPUT_OFFSET + index * INPUT_STRIDE];","    if (value == value && abs(value) <= 3.402823466e+38 && value >= minimum && value <= maximum) {","      if (maximum == minimum) {","        accepted = value == minimum;","      } else {","        accepted = true;","        if (value == maximum) {","          binIndex = BIN_COUNT - 1u;","        } else {","          let ratio = (value - minimum) / (maximum - minimum);","          binIndex = min(u32(ratio * f32(BIN_COUNT)), BIN_COUNT - 1u);","        }","      }","    }","  }","  ","  var subgroupPending = accepted;","  for (var subgroupGroup = 0u; subgroupGroup < 16u; subgroupGroup++) {","    let pendingBallot = subgroupBallot(subgroupPending);","    let hasPending = any(pendingBallot != vec4<u32>(0u));","    let leaderInvocation = getFirstBallotLane(pendingBallot);","    let leaderKey = subgroupShuffle(binIndex, leaderInvocation);","    let matchingKey = hasPending && subgroupPending && binIndex == leaderKey;","    let matchingBallot = subgroupBallot(matchingKey);","    if (hasPending && subgroupInvocationId == leaderInvocation) {","      atomicAdd(&localCounts[leaderKey], getBallotLaneCount(matchingBallot));","    subgroupPending = subgroupPending && !matchingKey;","  if (lane < BIN_COUNT) {","    atomicAdd(&outputCounts[OUTPUT_OFFSET + lane], atomicLoad(&localCounts[lane]));"],"strings":["stationsPerBin","rainfall-histogram-local","GPUHistogram","rainfall-histogram-clear","rainfall","buffer","compute","imported","outputCounts","rainfall-histogram","stations"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","datum","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["keySpace"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount"],[],["id","label","namespace","kind","op","datum","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[["~:2","~a"]]}}
