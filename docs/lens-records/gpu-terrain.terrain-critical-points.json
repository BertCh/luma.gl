:"criticalCounts","iteration":0,"elementType":"u32","values":"b64:Qg4AACIAAAAOAAAAkgAAAPwAAAAAAAAA","provenance":"gpu-readback","graph":"gpu-terrain-terrain-critical-points-compiled","resource":"criticalCounts","afterNode":"terrain-critical-points-classify","role":"intermediate","meaning":"cells per class (regular, peak, pit, saddle, boundary, nodata); not a terrain raster","keySpace":"critical-classes","geometry":{"kind":"raster","shape":[6,1],"coordinateModel":"unknown"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &fillTarget;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  fillTarget[fillTargetOffset + index] = 0u;","}","const elevationValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> elevationValues: array<f32>;","const elevationValidityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> elevationValidity: array<u32>;","const classValuesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> classValues: array<u32>;","const signChangeValuesOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> signChangeValues: array<u32>;","const classCountsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> classCounts: array<atomic<u32>>;","const WIDTH: u32 = 64u;","const HEIGHT: u32 = 64u;","const RING_COUNT: u32 = 8u;","const REGULAR: u32 = 0u;","const PEAK: u32 = 1u;","const PIT: u32 = 2u;","const SADDLE: u32 = 3u;","const BOUNDARY: u32 = 4u;","const NO_DATA: u32 = 5u;","// 1 when the neighbor is higher (simulation of simplicity), 0 when lower, 2 when it is invalid.","// The neighbor is always inside the grid because edge pixels return earlier.","fn getSide(column: u32, row: u32, columnOffset: i32, rowOffset: i32, centerHeight: f32, centerIndex: u32) -> u32 {","  let neighborIndex = u32(i32(row) + rowOffset) * WIDTH + u32(i32(column) + columnOffset);","  if (elevationValidity[elevationValidityOffset + neighborIndex] == 0u) { return 2u; }","  let neighborHeight = elevationValues[elevationValuesOffset + neighborIndex];","  return select(0u, 1u, neighborHeight > centerHeight || (neighborHeight == centerHeight && neighborIndex > centerIndex));","@compute @workgroup_size(256)","  _ = &elevationValues;","  _ = &elevationValidity;","  _ = &classValues;","  _ = &signChangeValues;","  _ = &classCounts;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let column = index % WIDTH;","  let row = index / WIDTH;","  var classCode = NO_DATA;","  var changeCount = 0u;","  if (elevationValidity[elevationValidityOffset + index] != 0u) {","    if (column == 0u || row == 0u || column == WIDTH - 1u || row == HEIGHT - 1u) {","      classCode = BOUNDARY;","    } else {","      let centerHeight = elevationValues[elevationValuesOffset + index];","      let side0 = getSide(column, row, 1, 0, centerHeight, index);","  let side1 = getSide(column, row, 1, -1, centerHeight, index);","  let side2 = getSide(column, row, 0, -1, centerHeight, index);","  let side3 = getSide(column, row, -1, -1, centerHeight, index);","  let side4 = getSide(column, row, -1, 0, centerHeight, index);","  let side5 = getSide(column, row, -1, 1, centerHeight, index);","  let side6 = getSide(column, row, 0, 1, centerHeight, index);","  let side7 = getSide(column, row, 1, 1, centerHeight, index);","      if (side0 == 2u || side1 == 2u || side2 == 2u || side3 == 2u || side4 == 2u || side5 == 2u || side6 == 2u || side7 == 2u) {","        classCode = BOUNDARY;","      } else {","        changeCount = select(0u, 1u, side0 != side1) +","    select(0u, 1u, side1 != side2) +","    select(0u, 1u, side2 != side3) +","    select(0u, 1u, side3 != side4) +","    select(0u, 1u, side4 != side5) +","    select(0u, 1u, side5 != side6) +","    select(0u, 1u, side6 != side7) +","    select(0u, 1u, side7 != side0);","        let higherCount = side0 + side1 + side2 + side3 + side4 + side5 + side6 + side7;","        classCode = select(SADDLE, REGULAR, changeCount == 2u);","        if (changeCount == 0u) {","          classCode = select(PEAK, PIT, higherCount == RING_COUNT);","        }","      }","    }","  classValues[classValuesOffset + index] = classCode;","  signChangeValues[signChangeValuesOffset + index] = changeCount;","  atomicAdd(&classCounts[classCountsOffset + classCode], 1u);"],"strings":["terrain-critical-points-classify","criticalCounts","terrain-critical-points-elevation","buffer","GPUTerrainCriticalPoints","terrain-critical-points-elevation-validity","terrain-critical-points-elevation-values","criticalClasses","criticalSignChanges","imported","read_write","terrain-critical-points-clear-counts","compute","terrain-critical-points","read","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","reads","writes","attrs"],[],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["from","to","kind","resource"],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode"]],"lists":[]}}
