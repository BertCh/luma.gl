ed cross-products of the finite rows; the unit-scaled normal equations are solved by Cholesky, optionally with ridge lambda added to the predictor diagonal. p counts the intercept; the intercept variance is sigma2 (1/n + xbar Sxx^-1 xbar).","symbols":[{"id":"coefficients","role":"output","label":"coefficients (intercept first)","binding":"wgsl:coefficientsOut"},{"id":"moments","role":"intermediate","label":"centred moments","binding":"wgsl:momentAt"},{"id":"intercept","role":"intermediate","binding":"wgsl:intercept"},{"id":"sigmaSquared","role":"intermediate","binding":"wgsl:sigmaSquared"},{"id":"residualSumSquares","role":"intermediate","binding":"wgsl:residualSumSquares"},{"id":"freedom","role":"intermediate","label":"residual degrees of freedom","binding":"wgsl:freedom"},{"id":"standardErrors","role":"output","binding":"wgsl:standardErrorsOut"},{"id":"tStatistics","role":"output","binding":"wgsl:tStatisticsOut"},{"id":"rSquared","role":"output","binding":"wgsl:rSquared"},{"id":"totalSumSquares","role":"intermediate","binding":"wgsl:totalSumSquares"}]}],"sources":[{"id":"wgsl:9195ef9e","language":"wgsl","moduleId":"GPUOrdinaryLeastSquares/means-tiles","hash":"9195ef9e","bodyHash":"cb4f5dbb","entryPoint":"main","constants":{"INVOCATION_COUNT":13,"WGSL_KERNEL_DISPATCH_X":1,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,10],0,0,[10,5],0,0,0,15,0,0,0,[16,3],0,[19,9],23,28,14,0,0,[29,16],23,[45,7],27,[52,3],27,55,23,[56,3],23,59,14]},{"id":"wgsl:a69f188c","language":"wgsl","moduleId":"GPUOrdinaryLeastSquares/means-merge","hash":"a69f188c","bodyHash":"70d9627c","entryPoint":"main","constants":{"INVOCATION_COUNT":4,"WGSL_KERNEL_DISPATCH_X":1,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,4],8,[60,3],0,[63,12],0,0,[10,5],0,0,0,15,0,0,[75,2],14,[77,2],14,[79,4],14,0,83,0,84,[30,4],36,85,[37,4],[86,2],[43,2],23,[88,3],23,[91,2],89,[93,4],23,[97,3],23,14]},{"id":"wgsl:38e11f4a","language":"wgsl","moduleId":"GPUOrdinaryLeastSquares/moments-tiles","hash":"38e11f4a","bodyHash":"49f87