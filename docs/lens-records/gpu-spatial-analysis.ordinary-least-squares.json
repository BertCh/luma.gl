 @binding(2) var<storage, read_write> partial: array<u32>;","// WGSL rejects NaN constants, so build one from a runtime bit pattern.","fn getNaN() -> f32 {","  var bits = 0x7fc00000u;","  return bitcast<f32>(bits);","}","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","const ROW_COUNT: u32 = 788u;","const TILE_ROWS: u32 = 64u;","const ROW_K: u32 = 3u;","fn isRowValid(row: u32) -> bool {","  ","  if (!isFiniteValue(response[responseOffset + row])) {","    return false;","  }","  for (var j = 0u; j < ROW_K; j++) {","    if (!isFiniteValue(design[designOffset + row * ROW_K + j])) {","      return false;","    }","  return true;","@compute @workgroup_size(64)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &design;","  _ = &response;","  _ = &partial;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 67108864u) { return; }","  let index = workgroupIndex * 64u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let firstRow = index * TILE_ROWS;","  let lastRow = min(firstRow + TILE_ROWS, ROW_COUNT);","  var sums: array<f32, 4>;","  var count = 0u;","  for (var row = firstRow; row < lastRow; row++) {","    if (!isRowValid(row)) {","      continue;","    count = count + 1u;","    for (var j = 0u; j < ROW_K; j++) {","      sums[j] = sums[j] + design[designOffset + row * ROW_K + j];","    sums[ROW_K] = sums[ROW_K] + response[responseOffset + row];","  let base = partialOffset + index * 5u;","  for (var column = 0u; column < 4u; column++) {","    partial[base + column] = bitcast<u32>(sums[column]);","  partial[base + 4u] = count;","@group(0) @binding(0) var<storage, read> partial: array<u32>;","const wsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> ws: array<u32>;","const K: u32 = 3u;","const D: u32 = 4u;","const KK: u32 = 9u;","const W_MEANS: u32 = 0u;","const W_COUNT: u32 = 4u;","const W_STATUS: u32 = 5u;","const W_LAMBDA: u32 = 6u;","const W_RESIDUAL_SUMS: u32 = 7u;","const W_SCALE: u32 = 10u;","const W_SLOPES: u32 = 13u;","const W_FACTOR: u32 = 16u;","const W_MOMENTS: u32 = 25u;","fn wsGet(slot: u32) -> f32 {","  return bitcast<f32>(ws[wsOffset + slot]);","fn wsSet(slot: u32, value: f32) {","  ws[wsOffset + slot] = bitcast<u32>(value);","fn momentAt(first: u32, second: u32) -> f32 {","  let lo = min(first, second);","  let hi = max(first, second);","  return wsGet(W_MOMENTS + lo * (2u * D - lo + 1u) / 2u + (hi - lo));","const TILE_COUNT: u32 = 13u;","@compute @workgroup_size(32)","  _ = &ws;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  var rows = 0u;","  for (var tile = 0u; tile < TILE_COUNT; tile++) {","    rows = rows + partial[partialOffset + tile * 5u + 4u];","  var sum = 0.0;","  var compensation = 0.0;","    let term = bitcast<f32>(partial[partialOffset + tile * 5u + index]) - compensation;","    let next = sum + term;","    compensation = (next - sum) - term;","    sum = next;","  wsSet(W_MEANS + index, select(0.0, sum / f32(rows), rows > 0u));","  if (index == 0u) {","    ws[wsOffset + W_COUNT] = rows;","@group(0) @binding(2) var<storage, read> ws: array<u32>;","@group(0) @binding(3) var<storage, read_write> partial: array<u32>;","  var means: array<f32, 4>;","  for (var column = 0u; column < D; column++) {","    means[column] = wsGet(W_MEANS + column);","  var accumulator: array<f32, 10>;","  var centered: array<f32, 4>;","      centered[j] = design[designOffset + row * ROW_K + j] - means[j];","    centered[ROW_K] = response[responseOffset + row] - means[ROW_K];","    var slot = 0u;","    for (var first = 0u; first < D; first++) {","      for (var second = first; second < D; second++) {","        accumulator[slot] = accumulator[slot] + centered[first] * centered[second];","        slot = slot + 1u;","      }","  for (var slot = 0u; slot < 10u; slot++) {","    partial[partialOffset + index * 10u + slot] = bitcast<u32>(accumulator[slot]);","    let term = bitcast<f32>(partial[partialOffset + tile * 10u + index]) - compensation;","  wsSet(W_MOMENTS + index, sum);","@group(0) @binding(0) var<storage, read_write> ws: array<u32>;","fn choleskyFactor_3(a: ptr<function, array<f32, 9>>) -> bool {","  for (var column = 0u; column < 3u; column++) {","    var diagonal = (*a)[column * 3u + column];","    for (var k = 0u; k < column; k++) {","      let value = (*a)[column * 3u + k];","      diagonal = diagonal - value * value;","    if (!(diagonal > 0.0) || diagonal > 3.0e38) {","    let pivot = sqrt(diagonal);","    (*a)[column * 3u + column] = pivot;","    for (var row = column + 1u; row < 3u; row++) {","      var value = (*a)[row * 3u + column];","      for (var k = 0u; k < column; k++) {","        value = value - (*a)[row * 3u + k] * (*a)[column * 3u + k];","      (*a)[row * 3u + column] = value / pivot;","fn choleskySolve_3(a: ptr<function, array<f32, 9>>, b: ptr<function, array<f32, 3>>) {","  for (var row = 0u; row < 3u; row++) {","    var value = (*b)[row];","    for (var k = 0u; k < row; k++) {","      value = value - (*a)[row * 3u + k] * (*b)[k];","    (*b)[row] = value / (*a)[row * 3u + row];","  for (var offset = 0u; offset < 3u; offset++) {","    let row = 2u - offset;","    for (var k = row + 1u; k < 3u; k++) {","      value = value - (*a)[k * 3u + row] * (*b)[k];","fn choleskyInverseDiagonal_3(a: ptr<function, array<f32, 9>>, column: u32) -> f32 {","  var unit: array<f32, 3>;","    unit[row] = select(0.0, 1.0, row == column);","  choleskySolve_3(a, &unit);","  return unit[column];","  let rows = ws[wsOffset + W_COUNT];","  let lambda = 0.0;","  wsSet(W_LAMBDA, lambda);","  if (rows <= K + 1u) {","    ws[wsOffset + W_STATUS] = 2u;","  var a: array<f32, 9>;","  var rhs: array<f32, 3>;","  var scale: array<f32, 3>;","  for (var i = 0u; i < K; i++) {","    let variance = momentAt(i, i);","    if (!(variance > 0.0) || !isFiniteValue(variance)) {","      ws[wsOffset + W_STATUS] = 1u;","      return;","    scale[i] = sqrt(variance);","    for (var j = 0u; j <= i; j++) {","      var entry = momentAt(i, j) / (scale[i] * scale[j]);","      if (i == j) {","        entry = entry + lambda / (scale[i] * scale[i]);","      a[i * K + j] = entry;","    rhs[i] = momentAt(i, K) / scale[i];","  if (!choleskyFactor_3(&a)) {","    ws[wsOffset + W_STATUS] = 1u;","    if (!(a[i * K + i] >= 0.0010000000474974513)) {","  for (var i = 0u; i < KK; i++) {","    wsSet(W_FACTOR + i, a[i]);","  choleskySolve_3(&a, &rhs);","    wsSet(W_SCALE + i, scale[i]);","    wsSet(W_SLOPES + i, rhs[i] / scale[i]);","  ws[wsOffset + W_STATUS] = 0u;","const residualOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> residualOut: array<f32>;","const fittedOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> fittedOut: array<f32>;","const squaredOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> squaredOut: array<f32>;","@compute @workgroup_size(256)","  _ = &residualOut;","  _ = &fittedOut;","  _ = &squaredOut;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  let nan = getNaN();","  residualOut[residualOutOffset + index] = nan;","  fittedOut[fittedOutOffset + index] = nan;","  squaredOut[squaredOutOffset + index] = nan;","  if (ws[wsOffset + W_STATUS] != 0u || !isRowValid(index)) {","  var fit = 0.0;","  for (var j = 0u; j < K; j++) {","    fit = fit + wsGet(W_SLOPES + j) * (design[designOffset + index * K + j] - wsGet(W_MEANS + j));","  let meanResponse = wsGet(W_MEANS + K);","  let residual = (response[responseOffset + index] - meanResponse) - fit;","  residualOut[residualOutOffset + index] = residual;","  fittedOut[fittedOutOffset + index] = meanResponse + fit;","  squaredOut[squaredOutOffset + index] = residual * residual;","const residualInOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> residualIn: array<f32>;","@group(0) @binding(1) var<storage, read_write> partial: array<u32>;","  _ = &residualIn;","  var sumSquares = 0.0;","  var sumCubes = 0.0;","  var sumFourth = 0.0;","    let e = residualIn[residualInOffset + row];","    if (!isFiniteValue(e)) {","    let e2 = e * e;","    sumSquares = sumSquares + e2;","    sumCubes = sumCubes + e2 * e;","    sumFourth = sumFourth + e2 * e2;","  let base = partialOffset + index * 3u;","  partial[base] = bitcast<u32>(sumSquares);","  partial[base + 1u] = bitcast<u32>(sumCubes);","  partial[base + 2u] = bitcast<u32>(sumFourth);","    let term = bitcast<f32>(partial[partialOffset + tile * 3u + index]) - compensation;","  wsSet(W_RESIDUAL_SUMS + index, sum);","@group(0) @binding(0) var<storage, read> ws: array<u32>;","const coefficientsOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> coefficientsOut: array<f32>;","const standardErrorsOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> standardErrorsOut: array<f32>;","const tStatisticsOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> tStatisticsOut: array<f32>;","const summaryOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> summaryOut: array<f32>;","const statusOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> statusOut: array<u32>;","fn getSymmetricEigenvalueRange_3(a: ptr<function, array<f32, 9>>) -> vec2<f32> {","  for (var sweep = 0u; sweep < 16u; sweep++) {","    var offDiagonal = 0.0;","    var diagonal = 0.0;","    for (var row = 0u; row < 3u; row++) {","      diagonal = diagonal + (*a)[row * 3u + row] * (*a)[row * 3u + row];","      for (var column = row + 1u; column < 3u; column++) {","        offDiagonal = offDiagonal + (*a)[row * 3u + column] * (*a)[row * 3u + column];","    if (offDiagonal <= 1.0e-14 * diagonal) {","      break;","    for (var first = 0u; first + 1u < 3u; first++) {","      for (var second = first + 1u; second < 3u; second++) {","        let pivot = (*a)[first * 3u + second];","        if (abs(pivot) < 1.0e-30) {","          continue;","        }","        let theta = ((*a)[second * 3u + second] - (*a)[first * 3u + first]) / (2.0 * pivot);","        let tangent = select(-1.0, 1.0, theta >= 0.0) / (abs(theta) + sqrt(theta * theta + 1.0));","        let cosine = 1.0 / sqrt(tangent * tangent + 1.0);","        let sine = tangent * cosine;","        for (var k = 0u; k < 3u; k++) {","          let left = (*a)[k * 3u + first];","          let right = (*a)[k * 3u + second];","          (*a)[k * 3u + first] = cosine * left - sine * right;","          (*a)[k * 3u + second] = sine * left + cosine * right;","          let top = (*a)[first * 3u + k];","          let bottom = (*a)[second * 3u + k];","          (*a)[first * 3u + k] = cosine * top - sine * bottom;","          (*a)[second * 3u + k] = sine * top + cosine * bottom;","  var smallest = (*a)[0];","  var largest = (*a)[0];","  for (var row = 1u; row < 3u; row++) {","    smallest = min(smallest, (*a)[row * 3u + row]);","    largest = max(largest, (*a)[row * 3u + row]);","  return vec2<f32>(smallest, largest);","fn getBelsleyConditionNumber_3(","  factor: ptr<function, array<f32, 9>>,","  alpha: ptr<function, array<f32, 3>>,","  beta: ptr<function, array<f32, 3>>",") -> f32 {","  // Column-major B: b[column * 4u + row].","  var b: array<f32, 16>;","  b[0] = 1.0;","  for (var column = 1u; column < 4u; column++) {","    let j = column - 1u;","    b[column * 4u] = (*alpha)[j];","    for (var i = 0u; i <= j; i++) {","      b[column * 4u + 1u + i] = (*beta)[j] * (*factor)[j * 3u + i];","    var rotated = false;","    for (var first = 0u; first + 1u < 4u; first++) {","      for (var second = first + 1u; second < 4u; second++) {","        var normFirst = 0.0;","        var normSecond = 0.0;","        var product = 0.0;","        for (var row = 0u; row < 4u; row++) {","          let x = b[first * 4u + row];","          let y = b[second * 4u + row];","          normFirst = normFirst + x * x;","          normSecond = normSecond + y * y;","          product = product + x * y;","        if (!(abs(product) > 1.0e-7 * sqrt(normFirst * normSecond))) {","        rotated = true;","        let zeta = (normSecond - normFirst) / (2.0 * product);","        let tangent = select(-1.0, 1.0, zeta >= 0.0) / (abs(zeta) + sqrt(1.0 + zeta * zeta));","        let cosine = 1.0 / sqrt(1.0 + tangent * tangent);","        let sine = cosine * tangent;","          b[first * 4u + row] = cosine * x - sine * y;","          b[second * 4u + row] = sine * x + cosine * y;","    if (!rotated) {","  var largest = 0.0;","  var smallest = 3.0e38;","    var norm = 0.0;","    for (var row = 0u; row < 4u; row++) {","      norm = norm + b[column * 4u + row] * b[column * 4u + row];","    largest = max(largest, sqrt(norm));","    smallest = min(smallest, sqrt(norm));","  return largest / smallest;","  _ = &coefficientsOut;","  _ = &standardErrorsOut;","  _ = &tStatisticsOut;","  _ = &summaryOut;","  _ = &statusOut;","  let status = ws[wsOffset + W_STATUS];","  statusOut[statusOutOffset] = status;","  if (status != 0u) {","    for (var i = 0u; i < 4u; i++) {","      coefficientsOut[coefficientsOutOffset + i] = nan;","      standardErrorsOut[standardErrorsOutOffset + i] = nan;","      tStatisticsOut[tStatisticsOutOffset + i] = nan;","    for (var slot = 0u; slot < 22u; slot++) {","      summaryOut[summaryOutOffset + slot] = nan;","    summaryOut[summaryOutOffset] = f32(rows);","  let n = f32(rows);","  let freedom = n - 4.0;","  let residualSumSquares = wsGet(W_RESIDUAL_SUMS);","  let totalSumSquares = momentAt(K, K);","    a[i] = wsGet(W_FACTOR + i);","  let sigmaSquared = residualSumSquares / freedom;","  var intercept = wsGet(W_MEANS + K);","  var u: array<f32, 3>;","    intercept = intercept - wsGet(W_SLOPES + i) * wsGet(W_MEANS + i);","    u[i] = wsGet(W_MEANS + i) / wsGet(W_SCALE + i);","  coefficientsOut[coefficientsOutOffset] = intercept;","    coefficientsOut[coefficientsOutOffset + 1u + i] = wsGet(W_SLOPES + i);","  // Intercept variance: sigma2 (1 / n + u' R^-1 u) with u = xbar / scale.","  choleskySolve_3(&a, &u);","  var quadratic = 0.0;","    quadratic = quadratic + (wsGet(W_MEANS + i) / wsGet(W_SCALE + i)) * u[i];","  standardErrorsOut[standardErrorsOutOffset] = sqrt(max(sigmaSquared * (1.0 / n + quadratic), 0.0));","  var maximumInflation = 0.0;","    let scale = wsGet(W_SCALE + i);","    // Diagonal of the inverse correlation matrix is the variance inflation factor of column i.","    let correlationInverse = choleskyInverseDiagonal_3(&a, i);","    maximumInflation = max(maximumInflation, correlationInverse);","    let inverse = correlationInverse / (scale * scale);","    standardErrorsOut[standardErrorsOutOffset + 1u + i] = sqrt(max(sigmaSquared * inverse, 0.0));","  for (var i = 0u; i < 4u; i++) {","    let standardError = standardErrorsOut[standardErrorsOutOffset + i];","    tStatisticsOut[tStatisticsOutOffset + i] = select(","      nan,","      coefficientsOut[coefficientsOutOffset + i] / standardError,","      standardError > 0.0","    );","  let rSquared = select(nan, 1.0 - residualSumSquares / totalSumSquares, totalSumSquares > 0.0);","  let meanSquare = max(residualSumSquares / n, 1.17549435e-38);","  let logLikelihood = -0.5 * n * (1.8378770664093453 + log(meanSquare) + 1.0);","  var jarqueBera = nan;","  var jarqueBeraP = nan;","  var skewness = nan;","  var kurtosis = nan;","  let m2 = residualSumSquares / n;","  if (m2 > 0.0) {","    let m3 = wsGet(W_RESIDUAL_SUMS + 1u) / n;","    let m4 = wsGet(W_RESIDUAL_SUMS + 2u) / n;","    skewness = m3 / (m2 * sqrt(m2));","    kurtosis = m4 / (m2 * m2);","    let excess = kurtosis - 3.0;","    jarqueBera = n / 6.0 * (skewness * skewness + 0.25 * excess * excess);","    jarqueBeraP = exp(-0.5 * jarqueBera);","  for (var slot = 0u; slot < 22u; slot++) {","    summaryOut[summaryOutOffset + slot] = nan;","  summaryOut[summaryOutOffset + 0u] = n;","  summaryOut[summaryOutOffset + 1u] = rSquared;","  summaryOut[summaryOutOffset + 2u] = 1.0 - (1.0 - rSquared) * (n - 1.0) / freedom;","  summaryOut[summaryOutOffset + 3u] = sigmaSquared;","  summaryOut[summaryOutOffset + 4u] = logLikelihood;","  summaryOut[summaryOutOffset + 5u] = 2.0 * 4.0 - 2.0 * logLikelihood;","  summaryOut[summaryOutOffset + 6u] = 4.0 * log(n) - 2.0 * logLikelihood;","  summaryOut[summaryOutOffset + 7u] = jarqueBera;","  summaryOut[summaryOutOffset + 8u] = jarqueBeraP;","  summaryOut[summaryOutOffset + 11u] = residualSumSquares;","  summaryOut[summaryOutOffset + 12u] = totalSumSquares;","  summaryOut[summaryOutOffset + 13u] = skewness;","  summaryOut[summaryOutOffset + 14u] = kurtosis;","  summaryOut[summaryOutOffset + 15u] = wsGet(W_LAMBDA);","  // Conditioning. Belsley (spreg condition_index) of the raw [1, X] design, from the Cholesky","  // factor of the unpenalized predictor correlation matrix and the column means, never from the","  // raw Gram matrix (its smallest eigenvalue is below float32 resolution once the condition","  // number passes a few hundred). See getBelsleyConditionNumberWGSL.","  var unpenalized: array<f32, 9>;","  var alpha: array<f32, 3>;","  var beta: array<f32, 3>;","    for (var j = 0u; j < K; j++) {","      unpenalized[i * K + j] = momentAt(i, j) / (wsGet(W_SCALE + i) * wsGet(W_SCALE + j));","    let centered = momentAt(i, i);","    let meanI = wsGet(W_MEANS + i);","    let rawNorm = sqrt(n * meanI * meanI + centered);","    alpha[i] = sqrt(n) * meanI / rawNorm;","    beta[i] = sqrt(centered) / rawNorm;","  var belsley = 3.0e38;","  if (choleskyFactor_3(&unpenalized)) {","    belsley = getBelsleyConditionNumber_3(&unpenalized, &alpha, &beta);","  // The factored (optionally ridge-penalized) predictor correlation matrix.","  var correlation: array<f32, 9>;","      var entry = momentAt(i, j) / (wsGet(W_SCALE + i) * wsGet(W_SCALE + j));","        entry = entry + wsGet(W_LAMBDA) / (wsGet(W_SCALE + i) * wsGet(W_SCALE + i));","      correlation[i * K + j] = entry;","  let correlationRange = getSymmetricEigenvalueRange_3(&correlation);","  let correlationCondition = correlationRange.y / max(correlationRange.x, 1.0e-30);","  summaryOut[summaryOutOffset + 18u] =","    belsley;","  summaryOut[summaryOutOffset + 19u] =","    correlationCondition;","  summaryOut[summaryOutOffset + 20u] =","    maximumInflation;","  summaryOut[summaryOutOffset + 21u] =","    select(0.0, 1.0, correlationCondition > 10000.0);","const mainWsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> mainWs: array<u32>;","@group(0) @binding(2) var<storage, read_write> summaryOut: array<f32>;","const DEGREES_OF_FREEDOM: u32 = 3u;","const LOG_GAMMA: f32 = -0.12078224122524261;","fn getChiSquareSurvival(value: f32) -> f32 {","  if (!(value > 0.0)) {","    return 1.0;","  let a = f32(DEGREES_OF_FREEDOM) * 0.5;","  let x = value * 0.5;","  let logPrefactor = -x + a * log(x) - LOG_GAMMA;","  if (x < a + 1.0) {","    var term = 1.0 / a;","    var sum = term;","    for (var iteration = 1u; iteration <= 200u; iteration++) {","      term = term * x / (a + f32(iteration));","      sum = sum + term;","      if (term < sum * 1.0e-7) {","        break;","    return clamp(1.0 - sum * exp(logPrefactor), 0.0, 1.0);","  let tiny = 1.0e-30;","  var b = x + 1.0 - a;","  var c = 1.0 / tiny;","  var d = 1.0 / b;","  var h = d;","  for (var iteration = 1u; iteration <= 200u; iteration++) {","    let fi = f32(iteration);","    let an = -fi * (fi - a);","    b = b + 2.0;","    d = an * d + b;","    if (abs(d) < tiny) {","      d = tiny;","    c = b + an / c;","    if (abs(c) < tiny) {","      c = tiny;","    d = 1.0 / d;","    let delta = d * c;","    h = h * delta;","    if (abs(delta - 1.0) < 1.0e-7) {","  return clamp(exp(logPrefactor) * h, 0.0, 1.0);","  _ = &mainWs;","  var koenker = nan;","  var koenkerP = nan;","  var breusch = nan;","  var breuschP = nan;","  if (status == 0u && totalSumSquares > 0.0) {","    var explained = 0.0;","    for (var i = 0u; i < 3u; i++) {","      explained = explained + wsGet(W_SLOPES + i) * momentAt(i, K);","    let rSquared = clamp(explained / totalSumSquares, 0.0, 1.0);","    let n = f32(ws[wsOffset + W_COUNT]);","    koenker = n * rSquared;","    koenkerP = getChiSquareSurvival(koenker);","    // Classic Breusch-Pagan: 0.5 R2 (sum e^4 / s2^2 - n) = 0.5 R2 n (kurtosis - 1), s2 = RSS / n.","    let residualSumSquares = bitcast<f32>(mainWs[mainWsOffset + W_RESIDUAL_SUMS]);","    let sumFourth = bitcast<f32>(mainWs[mainWsOffset + W_RESIDUAL_SUMS + 2u]);","    if (residualSumSquares > 0.0) {","      let kurtosis = sumFourth * n / (residualSumSquares * residualSumSquares);","      breusch = max(0.5 * rSquared * n * (kurtosis - 1.0), 0.0);","      breuschP = getChiSquareSurvival(breusch);","  summaryOut[summaryOutOffset + 9u] = koenker;","  summaryOut[summaryOutOffset + 10u] = koenkerP;","  summaryOut[summaryOutOffset + 16u] = breusch;","  summaryOut[summaryOutOffset + 17u] = breuschP;"],"strings":["GPUOrdinaryLeastSquares","ordinary-least-squares-workspace","buffer","read","read_write","ordinary-least-squares-bp-workspace","compute","ordinary-least-squares","transient","ordinary-least-squares-finish","ordinary-least-squares-residuals","response","predictors","ordinary-least-squares-squared-residuals","partial","ordinary-least-squares-bp-moments-tiles","ordinary-least-squares-bp-finish","ordinary-least-squares-residual-merge","residuals","summary","imported","ordinary-least-squares-bp-means-merge","ordinary-least-squares-bp-moments-merge","ordinary-least-squares-bp-partial-means","ordinary-least-squares-bp-partial-moments","ordinary-least-squares-means-merge","ordinary-least-squares-moments-merge","ordinary-least-squares-partial-means","ordinary-least-squares-partial-moments","ordinary-least-squares-partial-residuals","ordinary-least-squares-means-tiles","