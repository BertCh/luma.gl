,"const DISPATCH_Y: u32 = 1u;","const TABLE_KEYS_OFFSET: u32 = 0u;","const TABLE_VALUES_OFFSET: u32 = 0u;","const SOURCE_ROWS_OFFSET: u32 = 0u;","const STATISTICS_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> tableKeys: array<u32>;","@group(0) @binding(1) var<storage, read_write> tableValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sourceRows: array<u32>;","@group(0) @binding(3) var<storage, read_write> statistics: array<u32>;","@compute @workgroup_size(256) fn main(","  @builtin(workgroup_id) workgroupId: vec3u,","  @builtin(local_invocation_index) localIndex: u32",") {","  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;","  let elementIndex = workgroupIndex * 256u + localIndex;","  if (elementIndex < CAPACITY) {","    tableKeys[TABLE_KEYS_OFFSET + elementIndex] = 4294967295u;","    tableValues[TABLE_VALUES_OFFSET + elementIndex] = 4294967295u;","    sourceRows[SOURCE_ROWS_OFFSET + elementIndex] = 4294967295u;","  }","  if (elementIndex < 6u) {","    statistics[STATISTICS_OFFSET + elementIndex] = 0u;","}","const ELEMENT_COUNT: u32 = 1024u;","const CAPACITY_MASK: u32 = 2047u;","const MAX_PROBES: u32 = 2048u;","const DISPATCH_X: u32 = 4u;","const KEYS_OFFSET: u32 = 0u;","const FIRST_SOURCE_ROW: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputKeys: array<u32>;","@group(0) @binding(1) var<storage, read_write> tableKeys: array<atomic<u32>>;","@group(0) @binding(2) var<storage, read_write> sourceRows: array<atomic<u32>>;","@group(0) @binding(3) var<storage, read_write> statistics: array<atomic<u32>>;","fn hashKey(key: u32) -> u32 {","  var value = key;","  value = (value ^ (value >> 16u)) * 0x7feb352du;","  value = (value ^ (value >> 15u)) * 0x846ca68bu;","  return value ^ (value >> 16u);","  let inputIndex = workgroupIndex * 256u + localIndex;","  if (inputIndex >= ELEMENT_COUNT) { return; }","  ","  let key = inputKeys[KEYS_OFFSET + inputIndex];","  if (key == 4294967295u) {","    atomicAdd(&statistics[STATISTICS_OFFSET + 3u], 1u);","    return;","  let start = hashKey(key) & CAPACITY_MASK;","  var probes = 0u;","  var inserted = false;","  var duplicate = false;","  for (var probe = 0u; probe < MAX_PROBES; probe++) {","    probes = probe + 1u;","    let slot = (start + probe) & CAPACITY_MASK;","    var result = atomicCompareExchangeWeak(","      &tableKeys[TABLE_KEYS_OFFSET + slot], 4294967295u, key","    );","    // Bound spurious weak-CAS retries without probing onward and risking a duplicate slot.","    var exchangeAttempt = 1u;","    while (","      !result.exchanged &&","      result.old_value == 4294967295u &&","      exchangeAttempt < 4u","    ) {","      result = atomicCompareExchangeWeak(","        &tableKeys[TABLE_KEYS_OFFSET + slot], 4294967295u, key","      );","      exchangeAttempt++;","    }","    if (!result.exchanged && result.old_value == 4294967295u) {","      break;","    if (result.exchanged || result.old_value == key) {","      atomicMin(&sourceRows[SOURCE_ROWS_OFFSET + slot], FIRST_SOURCE_ROW + inputIndex);","      inserted = result.exchanged;","      duplicate = !result.exchanged;","  atomicAdd(&statistics[STATISTICS_OFFSET + 4u], probes);","  atomicMax(&statistics[STATISTICS_OFFSET + 5u], probes);","  if (inserted) {","    atomicAdd(&statistics[STATISTICS_OFFSET], 1u);","  } else if (duplicate) {","    atomicAdd(&statistics[STATISTICS_OFFSET + 1u], 1u);","  } else {","    atomicAdd(&statistics[STATISTICS_OFFSET + 2u], 1u);","const SOURCE_ROW_COUNT: u32 = 1024u;","@group(0) @binding(0) var<storage, read> tableKeys: array<u32>;","@group(0) @binding(1) var<storage, read> sourceRows: array<u32>;","@group(0) @binding(2) var<storage, read_write> tableValues: array<u32>;","  let slot = workgroupIndex * 256u + localIndex;","  if (slot >= CAPACITY || tableKeys[TABLE_KEYS_OFFSET + slot] == 4294967295u) { return; }","  let sourceRow = sourceRows[SOURCE_ROWS_OFFSET + slot];","  if (sourceRow < FIRST_SOURCE_ROW || sourceRow - FIRST_SOURCE_ROW >= SOURCE_ROW_COUNT) { return; }","  let localSourceRow = sourceRow - FIRST_SOURCE_ROW;","  tableValues[TABLE_VALUES_OFFSET + slot] = 0u + localSourceRow;","enable subgroups;","requires subgroup_id;","const ELEMENT_COUNT: u32 = 143u;","const BLOCK_COUNT: u32 = 1u;","const INPUT_OFFSET: u32 = 0u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","  if (workgroupIndex >= 16777216u || workgroupIndex >= BLOCK_COUNT) { return; }","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    ","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","const OUTPUT_START: u32 = 0u;","const OUTPUT_END: u32 = 143u;","const DISPATCH_X: u32 = 1u;","const MATCHED_ROWS_OFFSET: u32 = 0u;","const FOUND_OFFSET