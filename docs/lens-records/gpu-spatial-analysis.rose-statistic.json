{"schema":"luma.lens-record/1","scenarioId":"gpu-spatial-analysis.rose-statistic","recordedAt":"2026-10-15T12:29:08.277Z","adapterLabel":"apple (unknown)","record":{"schema":"luma.computation/1","id":"gpu-spatial-analysis.rose-statistic","runId":"run-a1bc246d","createdAt":"2026-10-15T12:29:08.248Z","adapter":{"backend":"webgpu","vendor":"apple","architecture":"metal-3","description":""},"domains":["gpu-spatial-analysis"],"graphs":[["~:0","gpu-spatial-analysis-rose-statistic-compiled","compiled","gpu-spatial-analysis","gpu-spatial-analysis-rose-statistic",[["~:1","~0","~0","rose-statistic","compute","~9","wgsl:39d244c8",[256,1,1],[["~:2","~5","~5","~8","f32",0,894],["~:2","~4","~4","~8","f32",0,894],["~:2","~6","~6","~8","f32",0,894],["~:2","~3","~3","~a","f32",0,5],["~:2","~1","~1","~a","f32",0,18]],["~:3",[1,1,1],256,false],["~5","~4","~6","~3","~1"],["~3","~1"],["~:4","~9","axial",1,1,256,17880,92],["~:5"]]],[],[["~:6","~5","~2",7152,"~7","~0","~0"],["~:6","~4","~2",7152,"~7","~0","~0"],["~:6","~6","~2",3576,"~7","~0","~0"],["~:7","~3","~2",20,"~b","transient-buffer-0",20,"~0","~0",true],["~:7","~1","~2",72,"~b","transient-buffer-1",72,"~0","~0",true]],["~:8",2]]],"axes":{"axes":[{"id":"segment","label":"street segment","kind":"data","keySpace":"segment","size":894},{"id":"summary","label":"rose summary word","kind":"structure","keySpace":"summary","size":5},{"id":"sector","label":"10 degree sector","kind":"structure","keySpace":"sector","size":18}],"keySpaces":[{"id":"segment","label":"street segment","size":894,"indexSpace":"1d"},{"id":"summary","label":"rose summary word","size":5,"indexSpace":"1d"},{"id":"sector","label":"10 degree sector","size":18,"indexSpace":"1d"}],"relations":[]},"refs":{"formulas":[{"id":"rose-circular-moments","derivation":"curated","tex":"\\begin{aligned}\n\\term{circularAngle}{\\phi_i}&=m\\,\\theta_i,\\qquad m=1\\ \\text{(directional) or } 2\\ \\text{(axial)}\\\\\n\\term{cosineSum}{C}&=\\sum_i w_i\\cos\\phi_i,\\qquad \\term{sineSum}{S}=\\sum_i w_i\\sin\\phi_i,\\qquad \\term{totalWeight}{W}=\\sum_i w_i\\\\\n\\term{resultant}{R}&=\\frac{\\sqrt{C^2+S^2}}{W},\\qquad \\term{meanAngle}{\\bar{\\theta}}=\\tfrac{1}{m}\\operatorname{atan2}(S,C),\\qquad V=1-R\\\\\n\\term{rayleighZ}{z}&=\\frac{(\\sum_i\\cos\\phi_i)^2+(\\sum_i\\sin\\phi_i)^2}{\\term{validCount}{n}}=n\\,\\bar{R}_0^2\n\\end{aligned}","ascii":"theta_i = atan2(dy, dx) of segment i, in [0, 2 pi) (axial: folded into [0, pi)); phi_i = m theta_i with m = 1 (directional) or 2 (axial). C = sum w_i cos(phi_i), S = sum w_i sin(phi_i), W = sum w_i over segments with positive finite length and weight. Mean angle = atan2(S, C) / m, resultant length R = sqrt(C^2 + S^2) / W, circular variance V = 1 - R, Rayleigh z = ((sum cos(phi_i))^2 + (sum sin(phi_i))^2) / n = n Rbar_0^2, using each of the n valid directions once, independently of descriptive weights. Rbar_0 is the unweighted resultant, distinct from the weighted R. This is not giddy Rose permutation inference; no p-value is returned. Bins are left-closed equal-width sectors of the period (2 pi, or pi when axial) holding the summed weight. When no valid segment remains, count and bins are zero and the other summary fields are NaN.","symbols":[{"id":"circularAngle","role":"intermediate","binding":"wgsl:circularAngle"},{"id":"cosineSum","role":"intermediate","binding":"wgsl:sharedCosine"},{"id":"sineSum","role":"intermediate","binding":"wgsl:sharedSine"},{"id":"totalWeight","role":"intermediate","binding":"wgsl:totalWeight"},{"id":"resultant","role":"output","binding":"wgsl:resultant"},{"id":"meanAngle","role":"output","binding":"wgsl:meanAngle"},{"id":"rayleighZ","role":"output","binding":"wgsl:rayleighZ"},{"id":"validCount","role":"intermediate","binding":"wgsl:validCount"}]}],"sources":[{"id":"wgsl:39d244c8","language":"wgsl","moduleId":"GPURoseStatistic/axial","hash":"39d244c8","bodyHash":"00517a67","entryPoint":"main","constants":{"INVOCATION_COUNT":256,"WGSL_KERNEL_DISPATCH_X":1,"WGSL_KERNEL_DISPATCH_Y":1},"textLines":[[0,20],0,20,0,[21,8],0,[29,68],86,97,[87,2],91,52,[98,15],88,91,52,[113,19],88,52,132]}]},"decisions":[],"choices":[{"name":"mode","label":"Circular mode","stage":"operator","alternatives":["directional","axial"],"sweepable":true,"value":"axial"},{"name":"binCount","label":"Rose bins","stage":"presentation","sweepable":true,"value":18}],"captures":{"schema":"luma.computation-captures/1","runId":"run-a1bc246d","snapshots":[{"id":"gpu-spatial-analysis-rose-statistic-snapshots-starts-0","name":"starts","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-rose-statistic-compiled","resource":"starts","afterNode":"rose-statistic-reduce","components":2,"role":"intermediate","keySpace":"segment"},{"id":"gpu-spatial-analysis-rose-statistic-snapshots-ends-0","name":"ends","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-rose-statistic-compiled","resource":"ends","afterNode":"rose-statistic-reduce","components":2,"role":"intermediate","keySpace":"segment"},{"id":"gpu-spatial-analysis-rose-statistic-snapshots-weights-0","name":"weights","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-rose-statistic-compiled","resource":"weights","afterNode":"rose-statistic-reduce","role":"intermediate","keySpace":"segment","meaning":"Segment length (m), the weight of each direction"},{"id":"gpu-spatial-analysis-rose-statistic-snapshots-summary-0","name":"summary","iteration":0,"elementType":"f32","values":"b64:AIBfRJoaEECDKMM98JpnP2+SRUE=","provenance":"gpu-readback","graph":"gpu-spatial-analysis-rose-statistic-compiled","resource":"summary","afterNode":"rose-statistic-reduce","role":"output","keySpace":"summary","meaning":"Count, length-weighted mean axial angle (rad from east), weighted resultant length and circular variance, unweighted segment Rayleigh z"},{"id":"gpu-spatial-analysis-rose-statistic-snapshots-bins-0","name":"bins","iteration":0,"elementType":"f32","values":"b64:xO8lR5/DR0TtN9lEJNyHQrcHJETIwIhCaqQEQzjeq0Py1fdDXHMhRxX2X0RrfJFFOfQFRe7vsUUfFphDutVLQqmsd0JK5hxD","provenance":"gpu-readback","graph":"gpu-spatial-analysis-rose-statistic-compiled","resource":"bins","afterNode":"rose-statistic-reduce","role":"output","keySpace":"sector","meaning":"Street length (m) per 10 degree sector, counter-clockwise from east"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const startsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> starts: array<f32>;","const endsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> ends: array<f32>;","const weightsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> weights: array<f32>;","const summaryOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> summary: array<f32>;","const binsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> bins: array<f32>;","const ROWS: u32 = 894u;","const GROUP_COUNT: u32 = 1u;","const LANES: u32 = 256u;","const BIN_COUNT: u32 = 18u;","const PI: f32 = 3.141592653589793;","const PERIOD: f32 = PI;","fn isFiniteFloat(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","var<workgroup> tileBin: array<u32, 256>;","var<workgroup> tileWeight: array<f32, 256>;","var<workgroup> sharedCount: array<u32, 256>;","var<workgroup> sharedWeight: array<f32, 256>;","var<workgroup> sharedCosine: array<f32, 256>;","var<workgroup> sharedSine: array<f32, 256>;","var<workgroup> sharedDirectionCosine: array<f32, 256>;","var<workgroup> sharedDirectionSine: array<f32, 256>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &starts;","  _ = &ends;","  _ = &weights;","  _ = &summary;","  _ = &bins;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  ","  let group = index / LANES;","  let lane = localInvocationIndex;","  let isActiveGroup = group < GROUP_COUNT;","  let binBase = binsOffset + group * BIN_COUNT;","  if (isActiveGroup) {","    for (var bin = lane; bin < BIN_COUNT; bin += LANES) { bins[binBase + bin] = 0.0; }","  }","  var count = 0u;","  var weightTotal = 0.0;","  var cosine = 0.0;","  var sine = 0.0;","  var directionCosine = 0.0;","  var directionSine = 0.0;","  for (var tile = 0u; tile < ROWS; tile += LANES) {","    let row = tile + lane;","    let hasRow = isActiveGroup && row < ROWS;","    var rowBin = 0xffffffffu;","    var rowWeight = 0.0;","    if (hasRow) {","      if (!(false)) {","        let start = vec2f(starts[startsOffset + row * 2u], starts[startsOffset + row * 2u + 1u]);","        let end = vec2f(ends[endsOffset + row * 2u], ends[endsOffset + row * 2u + 1u]);","        let delta = end - start;","        let lengthSquared = dot(delta, delta);","        let weight = weights[weightsOffset + row];","        if (lengthSquared > 0.0 && weight > 0.0 && isFiniteFloat(lengthSquared) && isFiniteFloat(weight)) {","          var angle = atan2(delta.y, delta.x);","          if (angle < 0.0) { angle += 2.0 * PI; }","          if (angle >= PI) { angle -= PI; }","          let circularAngle = 2.0 * angle;","          let cosineAngle = cos(circularAngle);","          let sineAngle = sin(circularAngle);","          cosine += weight * cosineAngle;","          sine += weight * sineAngle;","          directionCosine += cosineAngle;","          directionSine += sineAngle;","          weightTotal += weight;","          count++;","          rowBin = min(u32(floor(angle * f32(BIN_COUNT) / PERIOD + 1e-6)), BIN_COUNT - 1u);","          rowWeight = weight;","        }","      }","    }","    tileBin[lane] = rowBin;","    tileWeight[lane] = rowWeight;","    workgroupBarrier();","    if (isActiveGroup) {","      for (var bin = lane; bin < BIN_COUNT; bin += LANES) {","        var added = 0.0;","        for (var other = 0u; other < LANES; other++) {","          if (tileBin[other] == bin) { added += tileWeight[other]; }","        bins[binBase + bin] += added;","  sharedCount[lane] = count;","  sharedWeight[lane] = weightTotal;","  sharedCosine[lane] = cosine;","  sharedSine[lane] = sine;","  sharedDirectionCosine[lane] = directionCosine;","  sharedDirectionSine[lane] = directionSine;","  workgroupBarrier();","  for (var stride = LANES / 2u; stride > 0u; stride /= 2u) {","    if (lane < stride) {","      sharedCount[lane] += sharedCount[lane + stride];","      sharedWeight[lane] += sharedWeight[lane + stride];","      sharedCosine[lane] += sharedCosine[lane + stride];","      sharedSine[lane] += sharedSine[lane + stride];","      sharedDirectionCosine[lane] += sharedDirectionCosine[lane + stride];","      sharedDirectionSine[lane] += sharedDirectionSine[lane + stride];","  if (lane == 0u && isActiveGroup) {","    let base = summaryOffset + group * 5u;","    summary[base] = f32(sharedCount[0]);","    if (sharedWeight[0] > 0.0) {","      let totalWeight = sharedWeight[0];","      var meanAngle = atan2(sharedSine[0], sharedCosine[0]);","      if (meanAngle < 0.0) { meanAngle += 2.0 * PI; }","      meanAngle *= 0.5;","      let resultant = sqrt(sharedCosine[0] * sharedCosine[0] + sharedSine[0] * sharedSine[0]) / totalWeight;","      summary[base + 1u] = meanAngle;","      summary[base + 2u] = resultant;","      summary[base + 3u] = 1.0 - resultant;","      let validCount = f32(sharedCount[0]);","      let rayleighZ = (sharedDirectionCosine[0] * sharedDirectionCosine[0] +","        sharedDirectionSine[0] * sharedDirectionSine[0]) / validCount;","      summary[base + 4u] = rayleighZ;","    } else {","      let nan = bitcast<f32>(0x7fc00000u | (group & 0u));","      for (var slot = 1u; slot < 5u; slot++) { summary[base + slot] = nan; }","}"],"strings":["rose-statistic-reduce","bins","buffer","summary","ends","starts","weights","imported","read","GPURoseStatistic","read_write","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","kind","bytes","ownership","firstNode","lastNode"],["id","kind","bytes","ownership","allocation","allocationBytes","firstNode","lastNode","retained"],["retained"]],"lists":[]}}
