u-spatial-analysis-line-segmentize-snapshots-lineOffsets-0","name":"lineOffsets","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"lineOffsets","afterNode":"line-segmentize-publish","role":"intermediate"},{"id":"gpu-spatial-analysis-line-segmentize-snapshots-outputOffsets-0","name":"outputOffsets","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"outputOffsets","afterNode":"line-segmentize-publish","role":"intermediate"},{"id":"gpu-spatial-analysis-line-segmentize-snapshots-sourceLineIndices-0","name":"sourceLineIndices","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"sourceLineIndices","afterNode":"line-segmentize-publish","role":"intermediate","keySpace":"road","meaning":"source road index (zero-based); unused slots are 0xffffffff"},{"id":"gpu-spatial-analysis-line-segmentize-snapshots-count-0","name":"count","iteration":0,"elementType":"u32","values":"b64:xAUAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"count","afterNode":"line-segmentize-publish","role":"intermediate"},{"id":"gpu-spatial-analysis-line-segmentize-snapshots-lineCount-0","name":"lineCount","iteration":0,"elementType":"u32","values":"b64:3wAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"lineCount","afterNode":"line-segmentize-publish","role":"intermediate"},{"id":"gpu-spatial-analysis-line-segmentize-snapshots-overflow-0","name":"overflow","iteration":0,"elementType":"u32","values":"b64:AAAAAA==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"overflow","afterNode":"line-segmentize-publish","role":"intermediate"},{"id":"gpu-spatial-analysis-line-segmentize-snapshots-densified-0","name":"densified","iteration":0,"elementType":"f32","values":"rle:,*62712:00000000","provenance":"gpu-readback","graph":"gpu-spatial-analysis-line-segmentize-compiled","resource":"densified","afterNode":"line-segmentize-publish","components":2,"role":"output","geometry":{"kind":"lines","coordinateModel":"projected","unit":"m","offsetsCapture":"outputOffsets"},"meaning":"GPU-emitted vertices; GPU offsets exclude unused capacity"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const positionsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> positions: array<f32>;","const lineOffsetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> lineOffsets: array<u32>;","const parametersOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> parameters: array<f32>;","const countsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> counts: array<u32>;","const LINE_COUNT: u32 = 223u;","const MAXIMUM_PIECES: u32 = 64u;","const NO_LINE: u32 = 0xffffffffu;","fn findLine(row: u32) -> u32 {","  var low = 0u;","  var high = LINE_COUNT + 1u;","  while (low < high) {","    let middle = (low + high) / 2u;","    if (lineOffsets[lineOffsetsOffset + middle] <= row) {","      low = middle + 1u;","    } else {","      high = middle;","    }","  }","  if (low == 0u || low > LINE_COUNT) {","    return NO_LINE;","  return low - 1u;","}","const RADIUS: f32 = 1.0;","fn getPosition(row: u32) -> vec2<f32> {","  return vec2<f32>(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);","fn getSegmentLength(a: vec2<f32>, b: vec2<f32>) -> f32 {","  return length(b - a);","fn getPieceExtent(start: vec2<f32>, end: vec2<f32>) -> f32 {","  return getSegmentLength(start, end);","fn getPieceCount(segmentLength: f32, maximumLength: f32) -> u32 {","  if (!(maximumLength > 0.0) || !(segmentLength > 0.0)) {","    return 1u;","  let requestedPieces = ceil(segmentLength / maximumLength);","  ","  let pieces = min(requestedPieces, f32(MAXIMUM_PIECES));","  return clamp(u32(pieces), 1u, MAXIMUM_PIECES);","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &positions;","  _ = &lineOffsets;","  _ = &parameters;","  _ = &counts;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let line = findLine(index);","  var count = 0u;","  if (line != NO_LINE) {","    let first = lineOffsets[lineOffsetsOffset + line];","    let last = min(lineOffsets[lineOffsetsOffset + line + 1u], 513u);","    ","    if (index + 1u >= last ) {","      count = 1u;","      count = getPieceCount(","        getPieceExtent(getPosition(index), getPosition(index + 1u)),","        parameters[parametersOffset + 0u]","      );","  counts[countsOffset + index] = count;","const sourceLineIndicesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> sourceLineIndices: array<u32>;","  _ = &sourceLineIndices;","  sourceLineIndices[sourceLineIndicesOffset + index] = index;","enable subgroups;","requires subgroup_id;","const ELEMENT_COUNT: u32 = 513u;","const BLOCK_COUNT: u32 = 3u;","const INPUT_OFFSET: u32 = 0u;","const OUTPUT_OFFSET: u32 = 0u;","const SUM_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 3u + workgroupId.x;","  if (workgroupIndex >= 16777216u || workgroupIndex >= BLOCK_COUNT) { return; }","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","const ELEMENT_COUNT: u32 = 3u;","const BLOCK_COUNT: u32 = 1u;","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","const OFFSETS_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","@group(0) @binding(1) var<storage, read> counts: array<u32>;","const startsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> starts: array<u32>;","const outputPositionsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> outputPositions: array<f32>;","const CAPACITY: u32 = 32832u;","const BALANCED_ROWS: u32 = 513u;","const BALANCED_LANES: u32 = 128u;","const BALANCED_NONE: u32 = 0xffffffffu;","var<workgroup> balancedWindow: array<u32, 2>;","// Last row in [low, high] whose output range starts at or before the slot.","fn balancedLastAtMost(slot: u32, lowRow: u32, highRow: u32) -> u32 {","  var low = lowRow;","  var high = highRow;","    let middle = (low + high + 1u) >> 1u;","    if (balancedStart(middle) <= slot) {","      low = middle;","      high = middle - 1u;","  return low;","fn findBalancedOwner(slot: u32, firstSlot: u32, lane: u32) -> u32 {","    let lowRow = balancedLastAtMost(firstSlot, 0u, BALANCED_ROWS - 1u);","    balancedWindow[0] = lowRow;","    balancedWindow[1] = balancedLastAtMost(firstSlot + (BALANCED_LANES - 1u), lowRow, BALANCED_ROWS - 1u);","  let windowLow = workgroupUniformLoad(&balancedWindow[0]);","  let windowHigh = workgroupUniformLoad(&balancedWindow[1]);","  let total = balancedStart(BALANCED_ROWS - 1u) + balancedCount(BALANCED_ROWS - 1u);","  if (slot >= total) {","    return BALANCED_NONE;","  return balancedLastAtMost(slot, windowLow, windowHigh);","fn balancedStart(row: u32) -> u32 { return starts[startsOffset + row]; }","fn balancedCount(row: u32) -> u32 { return counts[countsOffset + row]; }","fn writeVertex(outputRow: u32, vertex: vec2<f32>, measure: f32, sourceRow: u32, prefixTurn: i32) {","  if (outputRow >= CAPACITY) {","  var longitude = vertex.x;","  var turn = prefixTurn;","  outputPositions[outputPositionsOffset + 2u * outputRow] = longitude;","  outputPositions[outputPositionsOffset + 2u * outputRow + 1u] = vertex.y;","@compute @workgroup_size(128)","  _ = &starts;","  _ = &outputPositions;","  if (workgroupIndex >= 33554432u) { return; }","  let index = workgroupIndex * 128u + localInvocationIndex;","  let row = findBalancedOwner(index, workgroupIndex * BALANCED_LANES, localInvocationIndex);","  if (row == BALANCED_NONE) {","  let count = counts[countsOffset + row];","  let piece = index - starts[startsOffset + row];","  var start = getPosition(row);","  let prefixTurn = 0i;","  let measure = 0.0;","  if (piece == 0u) {","    writeVertex(index, start, measure, row, prefixTurn);","  let next = row + 1u;","  let end = getPosition(next);","  let segmentLength = getSegmentLength(start, end);","  let fraction = f32(piece) / f32(count);","  writeVertex(index, mix(start, end, fraction), measure + segmentLength * fraction, row, prefixTurn);","@group(0) @binding(0) var<storage, read> lineOffsets: array<u32>;","const outputLineOffsetsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> outputLineOffsets: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> countOut: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> overflowOut: array<u32>;","const lineCountOutOffset: u32 = 0u;","@group(0) @binding(6) var<storage, read_write> lineCountOut: array<u32>;","const ROW_COUNT: u32 = 513u;","  _ = &outputLineOffsets;","  _ = &countOut;","  _ = &overflowOut;","  _ = &lineCountOut;","  let total = starts[startsOffset + ROW_COUNT - 1u] + counts[countsOffset + ROW_COUNT - 1u];","  let row = min(lineOffsets[lineOffsetsOffset + index], ROW_COUNT);","  var start = total;","  if (row < ROW_COUNT) {","    start = starts[startsOffset + row];","  outputLineOffsets[outputLineOffsetsOffset + index] = min(start, CAPACITY);","  if (index == 0u) {","    countOut[countOutOffset] = min(total, CAPACITY);","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);","    lineCountOut[lineCountOutOffset] = LINE_COUNT;"],"strings":["line-segmentize-publish","buffer","line-segmentize-counts","line-segmentize-starts","read","read_write","line-segmentize-count","transient","GPULineSegmentize","compute","line-segmentize","line-segmentize-emit","lineOffsets","positions","GPUScan","line-segmentize-scan-level-0-add-offsets","line-segmentize-scan-level-0-block-offsets","line-