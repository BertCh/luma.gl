: f32, bHigh: f32, bLow: f32) -> f32 {","  return (aHigh - bHigh) + (aLow - bLow);","}","// Exact double-single a >= b. Backends with fast-math may reassociate the sum above and drop the","// low parts, so acceptance compares the high parts first and uses the low parts only on ties.","fn isTimeAtLeast(aHigh: f32, aLow: f32, bHigh: f32, bLow: f32) -> bool {","  return aHigh > bHigh || (aHigh == bHigh && aLow >= bLow);","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &params;","  _ = &startHigh;","  _ = &startLow;","  _ = &outputMask;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  ","  let windowStartHigh = params[paramsOffset + 0u];","  let windowStartLow = params[paramsOffset + 1u];","  let windowEndHigh = params[paramsOffset + 2u];","  let windowEndLow = params[paramsOffset + 3u];","  let startFade = params[paramsOffset + 4u];","  let endFade = params[paramsOffset + 5u];","  let rowStartHigh = startHigh[startHighOffset + index];","  let rowStartLow = startLow[startLowOffset + index];","  let rowEndHigh = rowStartHigh;","  let rowEndLow = rowStartLow;","  // Ordered comparisons are false for NaN, so NaN rows are rejected. A reversed window","  // (end < start) accepts nothing, interval rows included (B-13).","  let endAfterWindowStart = timeDifference(rowEndHigh, rowEndLow, windowStartHigh, windowStartLow);","  let startBeforeWindowEnd = timeDifference(windowEndHigh, windowEndLow, rowStartHigh, rowStartLow);","  let accepted =","    isTimeAtLeast(windowEndHigh, windowEndLow, windowStartHigh, windowStartLow) &&","    isTimeAtLeast(rowEndHigh, rowEndLow, windowStartHigh, windowStartLow) &&","    isTimeAtLeast(windowEndHigh, windowEndLow, rowStartHigh, rowStartLow);","  outputMask[outputMaskOffset + index] = select(0u, 1u, accepted);","enable subgroups;","requires subgroup_id;","const ELEMENT_COUNT: u32 = 1500u;","const BLOCK_COUNT: u32 = 6u;","const INPUT_OFFSET: u32 = 0u;","const OUTPUT_OFFSET: u32 = 0u;","const SUM_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","@compute @workgroup_size(256) fn main(","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 6u + workgroupId.x;","  if (workgroupIndex >= 16777216u || workgroupIndex >= BLOCK_COUNT) { return; }","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","    }","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","const ELEMENT_COUNT: u32 = 6u;","const BLOCK_COUNT: u32 = 1u;","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","    ","const OFFSETS_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","const FLAGS_OFFSET: u32 = 0u;","const OUTPUT_START: u32 = 0u;","const OUTPUT_END: u32 = 1500u;","const COUNT_OFFSET: u32 = 0u;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(4) var<storage, read_write> outputCount: array<u32>;","  if (index >= ELEMENT_COUNT) { return; }","  let flag = min(flags[FLAGS_OFFSET + index], 1u);","  let outputIndex = offsets[OFFSETS_OFFSET + index];","  if (flag != 0u && outputIndex >= OUTPUT_START && outputIndex < OUTPUT_END) {","    outputValues[OUTPUT_OFFSET + outputIndex - OUTPUT_START] = inputValues[INPUT_OFFSET + index];","  if (index == ELEMENT_COUNT - 1u) {","    outputCount[COUNT_OFFSET] = outputIndex + flag;","const totalInOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> totalIn: array<u32>;","const countOutOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read_write> countOut: array<u32>;","const overflowOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> overflowOut: array<u32>;","override CAPACITY: u32;","@compute @workgroup_size(32)","  _ = &totalIn;","  _ = &countOut;","  _ = &overflowOut;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  let total = totalIn[totalInOffset];","  let count = min(total, CAPACITY);","  if (index == 0u) {","    countOut[countOutOffset] = count;","    overflowOut[overflowOutOffset] = select(0u, 1u, total > CAPACITY);"],"strings":["buffer","time-window-filter-visibility-compact-scatter","outputMask","time-window-filter-classify","read","time-window-filter-visibility-compact-offsets","read_write","transient","time-window-filter-publish","compute","time-window-filter","GPUScan","time-window-filter-total","time-window-filter-visibility-compact-scan-level-0-block-offsets","time-window-filter-visibility-compact-scan-level-0-block-sums","time-window-filter-visibility-compact-scan-level-0-scan","GPUTimeWindowFilter","time-window-filter-visibility-compact-scan-level-0-add-offsets","time-window-filter-visibility-compact-scan-level-1-scan","time-window-filter-visibility-source-ids","count","level-scan","outputValues","overflow","time-window-filter-visibility-identity","gpu-core.scan","imported","inputValues","time-window","time-window-filter-visibility-compact-scan/levels","timestamps","timestampsLow","unconditional","GPUCompaction","add-offsets","offsets","subgroups","transient-buffer-1","transient-buffer-2","transient-buffer-3","transient-buffer-4"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","variant","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","label","namespace","kind","op","reads","writes","attrs"],["id","label","namespace","kind","op","loop","dedupName","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["id","iteration","phase","maximumIterations"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],["id","label","namespace","kind","op","formula","source","workgroupSize","bindings","dispatch","reads","writes","wor