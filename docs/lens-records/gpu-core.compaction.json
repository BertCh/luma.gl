t; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","    }","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","}","const ELEMENT_COUNT: u32 = 4u;","const BLOCK_COUNT: u32 = 1u;","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","    ","const OFFSETS_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","  @builtin(local_invocation_index) localInvocationIndex: u32,","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","const FLAGS_OFFSET: u32 = 0u;","const OUTPUT_START: u32 = 0u;","const OUTPUT_END: u32 = 1024u;","const COUNT_OFFSET: u32 = 0u;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(4) var<storage, read_write> outputCount: array<u32>;","  if (index >= ELEMENT_COUNT) { return; }","  let flag = min(flags[FLAGS_OFFSET + index], 1u);","  let outputIndex = offsets[OFFSETS_OFFSET + index];","  if (flag != 0u && outputIndex >= OUTPUT_START && outputIndex < OUTPUT_END) {","    outputValues[OUTPUT_OFFSET + outputIndex - OUTPUT_START] = inputValues[INPUT_OFFSET + index];","  if (index == ELEMENT_COUNT - 1u) {","    outputCount[COUNT_OFFSET] = outputIndex + flag;"],"strings":["gpu-compaction-scatter","gpu-compaction-offsets","buffer","GPUScan","gpu-compaction-scan-level-0-block-off