    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>two-day-rainfall · 4×1×1 workgroups × 256×1×1 lanes = 1024 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-core-elementwise-id-probe-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect><rect x=\"21\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"1\"></rect><rect x=\"41\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"2\"></rect><rect x=\"61\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"3\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-core-elementwise-id-probe-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"replay\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"mean\" href=\"data:image/png;base64,\"></image><g data-action=\"pick