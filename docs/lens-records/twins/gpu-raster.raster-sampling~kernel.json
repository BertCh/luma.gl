    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>raster-sampling-sample · 1×1×1 workgroups × 32×1×1 lanes = 32 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-raster-raster-sampling-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 32\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-raster-raster-sampling-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><rect x=\"2\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 0</title></rect><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><rect x=\"42\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 1</title></rect><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><rect x=\"82\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 2</title></rect><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><rect x=\"122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 3</title></rect><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><rect x=\"162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 4</title></rect><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><rect x=\"202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 5</title></rect><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><rect x=\"242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 6</title></rect><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><rect x=\"282\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 7</title></rect><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><rect x=\"322\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 8</title></rect><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><rect x=\"362\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 9</title></rect><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><rect x=\"402\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 10</title></rect><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><rect x=\"442\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 11</title></rect><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><rect x=\"482\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 12</title></rect><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><rect x=\"522\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 13</title></rect><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><rect x=\"562\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 14</title></rect><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"15\"><rect x=\"602\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 15</title></rect><text x=\"605\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">15</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"16\"><rect x=\"642\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 16</title></rect><text x=\"645\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">16</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"17\"><rect x=\"682\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 17</title></rect><text x=\"685\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">17</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"18\"><rect x=\"722\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 18</title></rect><text x=\"725\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">18</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"19\"><rect x=\"762\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 19</title></rect><text x=\"765\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">19</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"20\"><rect x=\"802\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 20</title></rect><text x=\"805\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">20</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"21\"><rect x=\"842\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 21</title></rect><text x=\"845\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">21</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"22\"><rect x=\"882\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 22</title></rect><text x=\"885\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">22</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"23\"><rect x=\"922\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 23</title></rect><text x=\"925\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">23</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"24\"><rect x=\"962\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 24</title></rect><text x=\"965\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">24</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"25\"><rect x=\"1002\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1005\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">25</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"26\"><rect x=\"1042\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1045\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">26</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"27\"><rect x=\"1082\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1085\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">27</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"28\"><rect x=\"1122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">28</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"29\"><rect x=\"1162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">29</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"30\"><rect x=\"1202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">30</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-raster-sampling-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const rasterOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; raster: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const valuesOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; valuesOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">const RASTER_WIDTH: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"15\">const RASTER_HEIGHT: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"18\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"19\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"20\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"21\">}\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">fn isNaNValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"24\">\n</span><span class=\"lens-source-line\" data-line=\"25\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">\n</span><span class=\"lens-source-line\" data-line=\"28\">// Cell value with every nodata convention folded into NaN.\n</span><span class=\"lens-source-line\" data-line=\"29\">fn fetchCell(column: i32, row: i32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"30\">  let cell = u32(row * RASTER_WIDTH + column);\n</span><span class=\"lens-source-line\" data-line=\"31\">  var value = raster[rasterOffset + cell];\n</span><span class=\"lens-source-line\" data-line=\"32\">  \n</span><span class=\"lens-source-line\" data-line=\"33\">  \n</span><span class=\"lens-source-line\" data-line=\"34\">  return value;\n</span><span class=\"lens-source-line\" data-line=\"35\">}\n</span><span class=\"lens-source-line\" data-line=\"36\">fn fetchClamped(column: i32, row: i32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"37\">  return fetchCell(clamp(column, 0, RASTER_WIDTH - 1), clamp(row, 0, RASTER_HEIGHT - 1));\n</span><span class=\"lens-source-line\" data-line=\"38\">}\n</span><span class=\"lens-source-line\" data-line=\"39\">\n</span><span class=\"lens-source-line\" data-line=\"40\">fn getCubicWeights(t: f32) -&gt; vec4&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"41\">  return vec4&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"42\">    t * (-0.5 + t * (1.0 - 0.5 * t)),\n</span><span class=\"lens-source-line\" data-line=\"43\">    1.0 + t * t * (-2.5 + 1.5 * t),\n</span><span class=\"lens-source-line\" data-line=\"44\">    t * (0.5 + t * (2.0 - 1.5 * t)),\n</span><span class=\"lens-source-line\" data-line=\"45\">    t * t * (-0.5 + 0.5 * t)\n</span><span class=\"lens-source-line\" data-line=\"46\">  );\n</span><span class=\"lens-source-line\" data-line=\"47\">}\n</span><span class=\"lens-source-line\" data-line=\"48\">\n</span><span class=\"lens-source-line\" data-line=\"49\">// A sample participates only when both of its axis weights are nonzero.\n</span><span class=\"lens-source-line\" data-line=\"50\">fn sampleBilinear(iu: i32, iv: i32, fx: f32, fy: f32, renormalize: bool) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"51\">  var wx = array&lt;f32, 2&gt;(1.0 - fx, fx);\n</span><span class=\"lens-source-line\" data-line=\"52\">  var wy = array&lt;f32, 2&gt;(1.0 - fy, fy);\n</span><span class=\"lens-source-line\" data-line=\"53\">  var sum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"54\">  var weightSum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"55\">  var hasNoData = false;\n</span><span class=\"lens-source-line\" data-line=\"56\">  for (var j = 0; j &lt; 2; j++) {\n</span><span class=\"lens-source-line\" data-line=\"57\">    for (var i = 0; i &lt; 2; i++) {\n</span><span class=\"lens-source-line\" data-line=\"58\">      if (wx[i] != 0.0 &amp;&amp; wy[j] != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"59\">        let value = fetchClamped(iu + i, iv + j);\n</span><span class=\"lens-source-line\" data-line=\"60\">        let weight = wx[i] * wy[j];\n</span><span class=\"lens-source-line\" data-line=\"61\">        if (isNaNValue(value)) {\n</span><span class=\"lens-source-line\" data-line=\"62\">          hasNoData = true;\n</span><span class=\"lens-source-line\" data-line=\"63\">        } else {\n</span><span class=\"lens-source-line\" data-line=\"64\">          sum += weight * value;\n</span><span class=\"lens-source-line\" data-line=\"65\">          weightSum += weight;\n</span><span class=\"lens-source-line\" data-line=\"66\">        }\n</span><span class=\"lens-source-line\" data-line=\"67\">      }\n</span><span class=\"lens-source-line\" data-line=\"68\">    }\n</span><span class=\"lens-source-line\" data-line=\"69\">  }\n</span><span class=\"lens-source-line\" data-line=\"70\">  if (!hasNoData) {\n</span><span class=\"lens-source-line\" data-line=\"71\">    return sum;\n</span><span class=\"lens-source-line\" data-line=\"72\">  }\n</span><span class=\"lens-source-line\" data-line=\"73\">  if (renormalize &amp;&amp; weightSum &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"74\">    return sum / weightSum;\n</span><span class=\"lens-source-line\" data-line=\"75\">  }\n</span><span class=\"lens-source-line\" data-line=\"76\">  return getNaN();\n</span><span class=\"lens-source-line\" data-line=\"77\">}\n</span><span class=\"lens-source-line\" data-line=\"78\">\n</span><span class=\"lens-source-line\" data-line=\"79\">fn sampleBicubic(iu: i32, iv: i32, fx: f32, fy: f32, renormalize: bool) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"80\">  let cx = getCubicWeights(fx);\n</span><span class=\"lens-source-line\" data-line=\"81\">  let cy = getCubicWeights(fy);\n</span><span class=\"lens-source-line\" data-line=\"82\">  var wx = array&lt;f32, 4&gt;(cx.x, cx.y, cx.z, cx.w);\n</span><span class=\"lens-source-line\" data-line=\"83\">  var wy = array&lt;f32, 4&gt;(cy.x, cy.y, cy.z, cy.w);\n</span><span class=\"lens-source-line\" data-line=\"84\">  var cells = array&lt;f32, 16&gt;();\n</span><span class=\"lens-source-line\" data-line=\"85\">  var hasNoData = false;\n</span><span class=\"lens-source-line\" data-line=\"86\">  for (var j = 0; j &lt; 4; j++) {\n</span><span class=\"lens-source-line\" data-line=\"87\">    for (var i = 0; i &lt; 4; i++) {\n</span><span class=\"lens-source-line\" data-line=\"88\">      if (wx[i] != 0.0 &amp;&amp; wy[j] != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"89\">        let value = fetchClamped(iu - 1 + i, iv - 1 + j);\n</span><span class=\"lens-source-line\" data-line=\"90\">        cells[j * 4 + i] = value;\n</span><span class=\"lens-source-line\" data-line=\"91\">        if (isNaNValue(value)) {\n</span><span class=\"lens-source-line\" data-line=\"92\">          hasNoData = true;\n</span><span class=\"lens-source-line\" data-line=\"93\">        }\n</span><span class=\"lens-source-line\" data-line=\"94\">      }\n</span><span class=\"lens-source-line\" data-line=\"95\">    }\n</span><span class=\"lens-source-line\" data-line=\"96\">  }\n</span><span class=\"lens-source-line\" data-line=\"97\">  if (hasNoData) {\n</span><span class=\"lens-source-line\" data-line=\"98\">    return sampleBilinear(iu, iv, fx, fy, renormalize);\n</span><span class=\"lens-source-line\" data-line=\"99\">  }\n</span><span class=\"lens-source-line\" data-line=\"100\">  var result = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"101\">  for (var j = 0; j &lt; 4; j++) {\n</span><span class=\"lens-source-line\" data-line=\"102\">    if (wy[j] != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"103\">      var row = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"104\">      for (var i = 0; i &lt; 4; i++) {\n</span><span class=\"lens-source-line\" data-line=\"105\">        if (wx[i] != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"106\">          row += wx[i] * cells[j * 4 + i];\n</span><span class=\"lens-source-line\" data-line=\"107\">        }\n</span><span class=\"lens-source-line\" data-line=\"108\">      }\n</span><span class=\"lens-source-line\" data-line=\"109\">      result += wy[j] * row;\n</span><span class=\"lens-source-line\" data-line=\"110\">    }\n</span><span class=\"lens-source-line\" data-line=\"111\">  }\n</span><span class=\"lens-source-line\" data-line=\"112\">  return result;\n</span><span class=\"lens-source-line\" data-line=\"113\">}\n</span><span class=\"lens-source-line\" data-line=\"114\">\n</span><span class=\"lens-source-line\" data-line=\"115\">fn sampleRaster(x: f32, y: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"116\">  if (isNaNValue(x) || isNaNValue(y)) {\n</span><span class=\"lens-source-line\" data-line=\"117\">    return getNaN();\n</span><span class=\"lens-source-line\" data-line=\"118\">  }\n</span><span class=\"lens-source-line\" data-line=\"119\">  let minX = params[paramsOffset];\n</span><span class=\"lens-source-line\" data-line=\"120\">  let minY = params[paramsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"121\">  if (x &lt; minX || x &gt; params[paramsOffset + 2u] || y &lt; minY || y &gt; params[paramsOffset + 3u]) {\n</span><span class=\"lens-source-line\" data-line=\"122\">    return getNaN();\n</span><span class=\"lens-source-line\" data-line=\"123\">  }\n</span><span class=\"lens-source-line\" data-line=\"124\">  let method = u32(params[paramsOffset + 8u]);\n</span><span class=\"lens-source-line\" data-line=\"125\">  let renormalize = params[paramsOffset + 9u] != 0.0;\n</span><span class=\"lens-source-line\" data-line=\"126\">  // The row coordinate counts from the outer edge of row 0 with a signed step, so it is correct\n</span><span class=\"lens-source-line\" data-line=\"127\">  // for rows that advance toward larger or smaller y.\n</span><span class=\"lens-source-line\" data-line=\"128\">  let tx = (x - minX) * params[paramsOffset + 6u];\n</span><span class=\"lens-source-line\" data-line=\"129\">  let ty = (y - params[paramsOffset + 11u]) * params[paramsOffset + 7u];\n</span><span class=\"lens-source-line\" data-line=\"130\">  if (method == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"131\">    return fetchClamped(i32(floor(tx)), i32(floor(ty)));\n</span><span class=\"lens-source-line\" data-line=\"132\">  }\n</span><span class=\"lens-source-line\" data-line=\"133\">  let u = tx - 0.5;\n</span><span class=\"lens-source-line\" data-line=\"134\">  let v = ty - 0.5;\n</span><span class=\"lens-source-line\" data-line=\"135\">  let u0 = floor(u);\n</span><span class=\"lens-source-line\" data-line=\"136\">  let v0 = floor(v);\n</span><span class=\"lens-source-line\" data-line=\"137\">  if (method == 1u) {\n</span><span class=\"lens-source-line\" data-line=\"138\">    return sampleBilinear(i32(u0), i32(v0), u - u0, v - v0, renormalize);\n</span><span class=\"lens-source-line\" data-line=\"139\">  }\n</span><span class=\"lens-source-line\" data-line=\"140\">  return sampleBicubic(i32(u0), i32(v0), u - u0, v - v0, renormalize);\n</span><span class=\"lens-source-line\" data-line=\"141\">}\n</span><span class=\"lens-source-line\" data-line=\"142\">const POINT_CAPACITY: u32 = 25u;\n</span><span class=\"lens-source-line\" data-line=\"143\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"144\">@compute @workgroup_size(32)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"145\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"146\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"147\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"148\">) {\n</span><span class=\"lens-source-line\" data-line=\"149\">  _ = &amp;raster;\n</span><span class=\"lens-source-line\" data-line=\"150\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"151\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"152\">  _ = &amp;valuesOut;\n</span><span class=\"lens-source-line\" data-line=\"153\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"154\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"155\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"156\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"157\">  if (workgroupIndex &gt;= 134217728u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"158\">  let index = workgroupIndex * 32u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"159\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"160\">    return;\n</span><span class=\"lens-source-line\" data-line=\"161\">  }\n</span><span class=\"lens-source-line\" data-line=\"162\">  let activeCount = POINT_CAPACITY;\n</span><span class=\"lens-source-line\" data-line=\"163\">  var result = getNaN();\n</span><span class=\"lens-source-line\" data-line=\"164\">  if (index &lt; activeCount) {\n</span><span class=\"lens-source-line\" data-line=\"165\">    result = sampleRaster(\n</span><span class=\"lens-source-line\" data-line=\"166\">      positions[positionsOffset + 2u * index],\n</span><span class=\"lens-source-line\" data-line=\"167\">      positions[positionsOffset + 2u * index + 1u]\n</span><span class=\"lens-source-line\" data-line=\"168\">    );\n</span><span class=\"lens-source-line\" data-line=\"169\">  }\n</span><span class=\"lens-source-line\" data-line=\"170\">  valuesOut[valuesOutOffset + index] = result;\n</span><span class=\"lens-source-line\" data-line=\"171\">  \n</span><span class=\"lens-source-line\" data-line=\"172\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>raster<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"samplingDem\">samplingDem</td><td>read</td><td>f32</td></tr><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"samplingPoints\">samplingPoints</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"sampling-parameters\">sampling-parameters</td><td>read</td><td>f32</td></tr><tr><td>valuesOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"samplingValues\">samplingValues</td><td>read_write</td><td>f32