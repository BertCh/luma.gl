=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"22\">@compute @workgroup_size(32)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"23\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"24\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"25\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"26\">) {\n</span><span class=\"lens-source-line\" data-line=\"27\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"28\">  _ = &amp;state;\n</span><span class=\"lens-source-line\" data-line=\"29\">  _ = &amp;extremes;\n</span><span class=\"lens-source-line\" data-line=\"30\">  _ = &amp;edgeState;\n</span><span class=\"lens-source-line\" data-line=\"31\">  _ = &amp;quantileGate;\n</span><span class=\"lens-source-line\" data-line=\"32\">  _ = &amp;quantileParameters;\n</span><span class=\"lens-source-line\" data-line=\"33\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"34\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"35\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"36\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"37\">  if (workgroupIndex &gt;= 134217728u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"38\">  let index = workgroupIndex * 32u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"39\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"40\">    return;\n</span><span class=\"lens-source-line\" data-line=\"41\">  }\n</span><span class=\"lens-source-line\" data-line=\"42\">  let methodValue = params[paramsOffset];\n</span><span class=\"lens-source-line\" data-line=\"43\">  var method = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"44\">  if (methodValue &gt;= 0.0 &amp;&amp; methodValue &lt; 32.0 &amp;&amp; floor(methodValue) == methodValue) {\n</span><span class=\"lens-source-line\" data-line=\"45\">    let code = u32(methodValue);\n</span><span class=\"lens-source-line\" data-line=\"46\">    if ((COMPILED_METHODS &amp; (1u &lt;&lt; code)) != 0u) {\n</span><span class=\"lens-source-line\" data-line=\"47\">      method = code;\n</span><span class=\"lens-source-line\" data-line=\"48\">    }\n</span><span class=\"lens-source-line\" data-line=\"49\">  }\n</span><span class=\"lens-source-line\" data-line=\"50\">  let classValue = params[paramsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"51\">  var classCount = 1u;\n</span><span class=\"lens-source-line\" data-line=\"52\">  if (classValue &gt;= 1.0) {\n</span><span class=\"lens-source-line\" data-line=\"53\">    classCount = u32(min(classValue, f32(MAXIMUM_CLASS_COUNT)));\n</span><span class=\"lens-source-line\" data-line=\"54\">  }\n</span><span class=\"lens-source-line\" data-line=\"55\">  if (method == 4u) {\n</span><span class=\"lens-source-line\" data-line=\"56\">    classCount = 6u;\n</span><span class=\"lens-source-line\" data-line=\"57\">  }\n</span><span class=\"lens-source-line\" data-line=\"58\">  state[stateOffset + 0u] = method;\n</span><span class=\"lens-source-line\" data-line=\"59\">  state[stateOffset + 1u] = classCount;\n</span><span class=\"lens-source-line\" data-line=\"60\">  state[stateOffset + 2u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"61\">  state[stateOffset + 3u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"62\">  state[stateOffset + 4u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"63\">  state[stateOffset + 5u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"64\">  extremes[extremesOffset + 0u] = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"65\">  extremes[extremesOffset + 1u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"66\">  extremes[extremesOffset + 2u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"67\">  extremes[extremesOffset + 3u] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"68\">  edgeState[edgeStateOffset] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"69\">  quantileGate[quantileGateOffset] = select(0u, 1u, method == 1u || method == 4u);\n</span><span class=\"lens-source-line\" data-line=\"70\">  quantileParameters[quantileParametersOffset] = 3.0;\n</span><span class=\"lens-source-line\" data-line=\"71\">  quantileParameters[quantileParametersOffset + 1u] = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"72\">  quantileParameters[quantileParametersOffset + 2u] = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"73\">  quantileParameters[quantileParametersOffset + 3u] = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"74\">  for (var slot = 0u; slot &lt; QUANTILE_COUNT; slot = slot + 1u) {\n</span><span class=\"lens-source-line\" data-line=\"75\">    quantileParameters[quantileParametersOffset + 4u + slot] = params[paramsOffset + HEADER + slot];\n</span><span class=\"lens-source-line\" data-line=\"76\">  }\n</span><span class=\"lens-source-line\" data-line=\"77\">  \n</span><span class=\"lens-source-line\" data-line=\"78\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"break-parameters\">break-parameters</td><td>read</td><td>f32</td></tr><tr><td>state<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"b