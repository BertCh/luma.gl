5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const boundsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; bounds: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const boxOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; box: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const maskOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; maskOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">fn isFiniteBits(x: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"13\">  return (bitcast&lt;u32&gt;(x) &amp; 0x7f800000u) != 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"14\">}\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"17\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"18\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"19\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"20\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"21\">) {\n</span><span class=\"lens-source-line\" data-line=\"22\">  _ = &amp;bounds;\n</span><span class=\"lens-source-line\" data-line=\"23\">  _ = &amp;box;\n</span><span class=\"lens-source-line\" data-line=\"24\">  _ = &amp;maskOut;\n</span><span class=\"lens-source-line\" data-line=\"25\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"26\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"27\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"28\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"29\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"30\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"31\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"32\">    return;\n</span><span class=\"lens-source-line\" data-line=\"33\">  }\n</span><span class=\"lens-source-line\" data-line=\"34\">  let base = boundsOffset + 4u * index;\n</span><span class=\"lens-source-line\" data-line=\"35\">  let fMin = vec2&lt;f32&gt;(bounds[base], bounds[base + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"36\">  let fMax = vec2&lt;f32&gt;(bounds[base + 2u], bounds[base + 3u]);\n</span><span class=\"lens-source-line\" data-line=\"37\">  let boxMin = vec2&lt;f32&gt;(box[boxOffset], box[boxOffset + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"38\">  let boxMax = vec2&lt;f32&gt;(box[boxOffset + 2u], box[boxOffset + 3u]);\n</span><span class=\"lens-source-line\" data-line=\"39\">  let finite = isFiniteBits(fMin.x) &amp;&amp; isFiniteBits(fMin.y) &amp;&amp; isFiniteBits(fMax.x) &amp;&amp; isFiniteBits(fMax.y);\n</span><span class=\"lens-source-line\" data-line=\"40\">  let accepted = finite &amp;&amp; fMin.x &gt;= boxMin.x &amp;&amp; fMax.x &lt;= boxMax.x &amp;&amp; fMin.y &gt;= boxMin.y &amp;&amp; fMax.y &lt;= boxMax.y;\n</span><span class=\"lens-source-line\" data-line=\"41\">  maskOut[maskOutOffset + index] = select(0u, 1u, accepted);\n</span><span class=\"lens-source-line\" data-line=\"42\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>bounds<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"bounds\">bounds</td><td>read</td><td>f32</td></tr><tr><td>box<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"parameters\">parameters</td><td>read</td><td>f32</td></tr><tr><td>maskOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"selected\">selected</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUBoundsFilter · main · 5586df03</figcaption></figure></section>",
