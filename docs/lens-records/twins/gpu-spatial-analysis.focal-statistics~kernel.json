cs-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"64\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"2\" data-sampling=\"nearest\" href=\"data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAACCAMAAAAOwC77AAAAA1BMVEVfZnJNNohmAAAATUlEQVR4AQFCAL3/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAEIAAb1u9mUAAAAASUVORK5CYII=\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>64 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const rasterOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; raster: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const meanOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; meanOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const deviationOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; deviationOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const countOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; countOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const WIDTH: u32 = 32u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const HEIGHT: u32 = 32u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const MAXIMUM_RADIUS: i32 = 4;\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"20\">\n</span><span class=\"lens-source-line\" data-line=\"21\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"22\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"23\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"24\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"25\">}\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">\n</span><span class=\"lens-source-line\" data-line=\"28\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">fn readCell(cell: u32, value: ptr&lt;function, f32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"31\">  let sample = raster[rasterOffset + cell];\n</span><span class=\"lens-source-line\" data-line=\"32\">  *value = sample;\n</span><span class=\"lens-source-line\" data-line=\"33\">  // Compare bits: NaN is nodata, and infinities are kept as values.\n</span><span class=\"lens-source-line\" data-line=\"34\">  var isValid = (bitcast&lt;u32&gt;(sample) &amp; 0x7fffffffu) &lt;= 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"35\">  \n</span><span class=\"lens-source-line\" data-line=\"36\">  \n</span><span class=\"lens-source-line\" data-line=\"37\">  return isValid;\n</span><span class=\"lens-source-line\" data-line=\"38\">}\n</span><span class=\"lens-source-line\" data-line=\"39\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"40\">@compute @workgroup_size(64)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"41\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"42\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"43\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"44\">) {\n</span><span class=\"lens-source-line\" data-line=\"45\">  _ = &amp;raster;\n</span><span class=\"lens-source-line\" data-line=\"46\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"47\">  _ = &amp;meanOut;\n</span><span class=\"lens-source-line\" data-line=\"48\">  _ = &amp;deviationOut;\n</span><span class=\"lens-source-line\" data-line=\"49\">  _ = &amp;countOut;\n</span><span class=\"lens-source-line\" data-line=\"50\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"51\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"52\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"53\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"54\">  if (workgroupIndex &gt;= 67108864u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"55\">  let index = workgroupIndex * 64u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"56\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"57\">    return;\n</span><span class=\"lens-source-line\" data-line=\"58\">  }\n</span><span class=\"lens-source-line\" data-line=\"59\">  let column = i32(index % WIDTH);\n</span><span class=\"lens-source-line\" data-line=\"60\">  let row = i32(index / WIDTH);\n</span><span class=\"lens-source-line\" data-line=\"61\">  let radiusValue = params[paramsOffset];\n</span><span class=\"lens-source-line\" data-line=\"62\">  let isCircle = params[paramsOffset + 1u] == 1.0;\n</span><span class=\"lens-source-line\" data-line=\"63\">  let minimumCountValue = params[paramsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"64\">  let propagateCenterNoData = params[paramsOffset + 3u] != 0.0;\n</span><span class=\"lens-source-line\" data-line=\"65\">  let minimumCount = max(u32(clamp(select(1.0, minimumCountValue, isFiniteValue(minimumCountValue)), 0.0, 4294967040.0)), 1u);\n</span><span class=\"lens-source-line\" data-line=\"66\">  // NaN or negative radii give an empty window.\n</span><span class=\"lens-source-line\" data-line=\"67\">  let hasWindow = radiusValue &gt;= 0.0;\n</span><span class=\"lens-source-line\" data-line=\"68\">  let windowRadius = select(-1, i32(min(floor(radiusValue), f32(MAXIMUM_RADIUS))), hasWindow);\n</span><span class=\"lens-source-line\" data-line=\"69\">  let radiusSquared = radiusValue * radiusValue;\n</span><span class=\"lens-source-line\" data-line=\"70\">  var centerValue = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"71\">  let centerValid = readCell(index, &amp;centerValue);\n</span><span class=\"lens-source-line\" data-line=\"72\">  var count = 0u;\n</span><span class=\"lens-source-line\" data-line=\"73\">  var sum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"74\">  for (var dy = -windowRadius; dy &lt;= windowRadius; dy++) {\n</span><span class=\"lens-source-line\" data-line=\"75\">    let sampleRow = row + dy;\n</span><span class=\"lens-source-line\" data-line=\"76\">    if (sampleRow &lt; 0 || sampleRow &gt;= i32(HEIGHT)) {\n</span><span class=\"lens-source-line\" data-line=\"77\">      continue;\n</span><span class=\"lens-source-line\" data-line=\"78\">    }\n</span><span class=\"lens-source-line\" data-line=\"79\">    for (var dx = -windowRadius; dx &lt;= windowRadius; dx++) {\n</span><span class=\"lens-source-line\" data-line=\"80\">      let sampleColumn = column + dx;\n</span><span class=\"lens-source-line\" data-line=\"81\">      if (sampleColumn &lt; 0 || sampleColumn &gt;= i32(WIDTH)) {\n</span><span class=\"lens-source-line\" data-line=\"82\">        continue;\n</span><span class=\"lens-source-line\" data-line=\"83\">      }\n</span><span class=\"lens-source-line\" data-line=\"84\">      if (isCircle &amp;&amp; f32(dx * dx + dy * dy) &gt; radiusSquared) {\n</span><span class=\"lens-source-line\" data-line=\"85\">        continue;\n</span><span class=\"lens-source-line\" data-line=\"86\">      }\n</span><span class=\"lens-source-line\" data-line=\"87\">      var value = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"88\">      if (!readCell(u32(sampleRow) * WIDTH + u32(sampleColumn), &amp;value)) {\n</span><span class=\"lens-source-line\" data-line=\"89\">        continue;\n</span><span class=\"lens-source-line\" data-line=\"90\">      }\n</span><span class=\"lens-source-line\" data-line=\"91\">      count += 1u;\n</span><span class=\"lens-source-line\" data-line=\"92\">      sum += value;\n</span><span class=\"lens-source-line\" data-line=\"93\">    }\n</span><span class=\"lens-source-line\" data-line=\"94\">  }\n</span><span class=\"lens-source-line\" data-line=\"95\">  let isDefined = count &gt;= minimumCount &amp;&amp; (!propagateCenterNoData || centerValid);\n</span><span class=\"lens-source-line\" data-line=\"96\">  let nan = getNaN();\n</span><span class=\"lens-source-line\" data-line=\"97\">  let mean = sum / f32(max(count, 1u));\n</span><span class=\"lens-source-line\" data-line=\"98\">  \n</span><span class=\"lens-source-line\" data-line=\"99\">  meanOut[meanOutOffset + index] = select(nan, mean, isDefined);\n</span><span class=\"lens-source-line\" data-line=\"100\">  countOut[countOutOffset + index] = count;\n</span><span class=\"lens-source-line\" data-line=\"101\">  var squaredDeviationSum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"102\">  if (isDefined) {\n</span><span class=\"lens-source-line\" data-line=\"103\">    for (var dy = -windowRadius; dy &lt;= windowRadius; dy++) {\n</span><span class=\"lens-source-line\" data-line=\"104\">    let sampleRow = row + dy;\n</span><span class=\"lens-source-line\" data-line=\"105\">    if (sampleRow &lt; 0 || sampleRow &gt;= i32(HEIGHT)) {\n</span><span class=\"lens-source-line\" data-line=\"106\">      continue;\n</span><span class=\"lens-source-line\" data-line=\"107\">    }\n</span><span class=\"lens-source-line\" data-line=\"108\">    for (var dx = -windowRadius; dx &lt;= windowRadius; dx++) {\n</span><span class=\"lens-source-line\" data-line=\"109\">      let sampleColumn = column + dx;\n</span><span class=\"lens-source-line\" data-line=\"110\">      if (sampleColumn &lt; 0 || sampleColumn &gt;= i32(WIDTH)) {\n</span><span class=\"lens-source-line\" data-line=\"111\">        continue;\n</span><span class=\"lens-source-line\" data-line=\"112\">      }\n</span><span class=\"lens-source-line\" data-line=\"113\">      if (isCircle &amp;&amp; f32(dx * dx + dy * dy) &gt; radiusSquared) {\n</span><span class=\"lens-source-line\" data-line=\"114\">        continue;\n</span><span class=\"lens-source-line\" data-line=\"115\">      }\n</span><span class=\"lens-source-line\" data-line=\"116\">      var value = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"117\">      if (!readCell(u32(sampleRow) * WIDTH + u32(sampleColumn), &amp;value)) {\n</span><span class=\"lens-source-line\" data-line=\"118\">        continue;\n</span><span class=\"lens-source-line\" data-line=\"119\">      }\n</span><span class=\"lens-source-line\" data-line=\"120\">      let deviation = value - mean;\n</span><span class=\"lens-source-line\" data-line=\"121\">      squaredDeviationSum += deviation * deviation;\n</span><span class=\"lens-source-line\" data-line=\"122\">    }\n</span><span class=\"lens-source-line\" data-line=\"123\">  }\n</span><span class=\"lens-source-line\" data-line=\"124\">  }\n</span><span class=\"lens-source-line\" data-line=\"125\">  deviationOut[deviationOutOffset + index] = select(nan, sqrt(squaredDeviationSum / f32(max(count, 1u))), isDefined);\n</span><span class=\"lens-source-line\" data-line=\"126\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>raster<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"elevation\">elevation</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"parameters\">parameters</td><td>read</td><td>f32</td></tr><tr><td>meanOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"mean\">mean</td><td>read_write</td><td>f32</td></tr><tr><td>deviationOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"standardDeviation\">standardDeviation</td><td>read_write</td><td>f32</td></tr><tr><td>countOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"windowCounts\">windowCounts</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUFocalStatistics/moments · main · 96849d3b</figcaption></figure></section>",
