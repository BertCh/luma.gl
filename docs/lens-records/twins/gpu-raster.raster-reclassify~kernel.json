s-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const sourceOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; source: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const breaksOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; breaks: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const classValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; classValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const reclassifiedOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; reclassifiedOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const MAXIMUM_BREAK_COUNT: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">const NO_DATA_CLASS: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"20\">\n</span><span class=\"lens-source-line\" data-line=\"21\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"22\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"23\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"24\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"25\">}\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">fn isNaNValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"28\">\n</span><span class=\"lens-source-line\" data-line=\"29\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"30\">\n</span><span class=\"lens-source-line\" data-line=\"31\">fn isNoDataValue(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"32\">  return isNaNValue(value) || value == 0.0;\n</span><span class=\"lens-source-line\" data-line=\"33\">}\n</span><span class=\"lens-source-line\" data-line=\"34\">\n</span><span class=\"lens-source-line\" data-line=\"35\">fn countBreaksBelow(first: u32, count: u32, value: f32, closedRight: bool) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"36\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"37\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"38\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"39\">    if (low &gt;= high) {\n</span><span class=\"lens-source-line\" data-line=\"40\">      break;\n</span><span class=\"lens-source-line\" data-line=\"41\">    }\n</span><span class=\"lens-source-line\" data-line=\"42\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"43\">    let boundary = breaks[breaksOffset + first + middle];\n</span><span class=\"lens-source-line\" data-line=\"44\">    let isBelow = select(boundary &lt;= value, boundary &lt; value, closedRight);\n</span><span class=\"lens-source-line\" data-line=\"45\">    if (isBelow) {\n</span><span class=\"lens-source-line\" data-line=\"46\">      low = middle + 1u;\n</span><span class=\"lens-source-line\" data-line=\"47\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"48\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"49\">    }\n</span><span class=\"lens-source-line\" data-line=\"50\">  }\n</span><span class=\"lens-source-line\" data-line=\"51\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"52\">}\n</span><span class=\"lens-source-line\" data-line=\"53\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"54\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"55\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"56\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"57\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"58\">) {\n</span><span class=\"lens-source-line\" data-line=\"59\">  _ = &amp;source;\n</span><span class=\"lens-source-line\" data-line=\"60\">  _ = &amp;breaks;\n</span><span class=\"lens-source-line\" data-line=\"61\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"62\">  _ = &amp;classValues;\n</span><span class=\"lens-source-line\" data-line=\"63\">  _ = &amp;reclassifiedOut;\n</span><span class=\"lens-source-line\" data-line=\"64\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"65\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"66\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"67\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"68\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"69\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"70\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"71\">    return;\n</span><span class=\"lens-source-line\" data-line=\"72\">  }\n</span><span class=\"lens-source-line\" data-line=\"73\">  \n</span><span class=\"lens-source-line\" data-line=\"74\">  let value = source[sourceOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"75\">  var isValid = !isNoDataValue(value);\n</span><span class=\"lens-source-line\" data-line=\"76\">  \n</span><span class=\"lens-source-line\" data-line=\"77\">  let breakCountValue = params[paramsOffset];\n</span><span class=\"lens-source-line\" data-line=\"78\">  let breakCount = min(u32(clamp(select(0.0, breakCountValue, isFiniteValue(breakCountValue)), 0.0, 4294967040.0)), MAXIMUM_BREAK_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"79\">  let closedRight = params[paramsOffset + 1u] != 0.0;\n</span><span class=\"lens-source-line\" data-line=\"80\">  var classIndex = NO_DATA_CLASS;\n</span><span class=\"lens-source-line\" data-line=\"81\">  if (isValid) {\n</span><span class=\"lens-source-line\" data-line=\"82\">    classIndex = countBreaksBelow(0u, breakCount, value, closedRight);\n</span><span class=\"lens-source-line\" data-line=\"83\">  }\n</span><span class=\"lens-source-line\" data-line=\"84\">  \n</span><span class=\"lens-source-line\" data-line=\"85\">  reclassifiedOut[reclassifiedOutOffset + index] = select(getNaN(), classValues[classValuesOffset + min(classIndex, MAXIMUM_BREAK_COUNT)], isValid);\n</span><span class=\"lens-source-line\" data-line=\"86\">  \n</span><span class=\"lens-source-line\" data-line=\"87\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>source<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"suitabilityLandCover\">suitabilityLandCover</td><td>read</td><td>f32</td></tr><tr><td>breaks<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"suitabilityBreaks\">suitabilityBreaks</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"reclassify-parameters\">reclassify-parameters</td><td>read</td><td>f32</td></tr><tr><td>classValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"suitabilityValues\">suitabilityValues</td><td>read</td><td>f32</td></tr><tr><td>reclassifiedOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"suitability\">suitability</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPURasterReclassify/classify · main · b89d035d</figcaption></figure></section>",
