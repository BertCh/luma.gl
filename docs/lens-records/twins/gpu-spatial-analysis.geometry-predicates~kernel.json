ata-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>128 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const gPositionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; gPositions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const gFeatureOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; gFeatureOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const gPolygonOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; gPolygonOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const gRingOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; gRingOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const outputOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; output: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">fn isNaNBits(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"17\">fn canonicalBits(value: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"18\">  let bits = bitcast&lt;u32&gt;(value);\n</span><span class=\"lens-source-line\" data-line=\"19\">  return select(bits, 0u, (bits &amp; 0x7fffffffu) == 0u);\n</span><span class=\"lens-source-line\" data-line=\"20\">}\n</span><span class=\"lens-source-line\" data-line=\"21\">fn samePoint(first: vec2f, second: vec2f) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"22\">  return canonicalBits(first.x) == canonicalBits(second.x) &amp;&amp; canonicalBits(first.y) == canonicalBits(second.y);\n</span><span class=\"lens-source-line\" data-line=\"23\">}\n</span><span class=\"lens-source-line\" data-line=\"24\">fn identicalValue(first: f32, second: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"25\">  return canonicalBits(first) == canonicalBits(second) || (isNaNBits(first) &amp;&amp; isNaNBits(second));\n</span><span class=\"lens-source-line\" data-line=\"26\">}\n</span><span class=\"lens-source-line\" data-line=\"27\">fn identicalPosition(first: vec2f, second: vec2f) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"28\">  return identicalValue(first.x, second.x) &amp;&amp; identicalValue(first.y, second.y);\n</span><span class=\"lens-source-line\" data-line=\"29\">}\n</span><span class=\"lens-source-line\" data-line=\"30\">// Distance at most tolerance, scaled so that tiny and huge offsets neither underflow nor overflow.\n</span><span class=\"lens-source-line\" data-line=\"31\">fn withinTolerance(first: vec2f, second: vec2f, tolerance: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"32\">  if (isNaNBits(first.x) || isNaNBits(first.y) || isNaNBits(second.x) || isNaNBits(second.y)) { return false; }\n</span><span class=\"lens-source-line\" data-line=\"33\">  let delta = first - second;\n</span><span class=\"lens-source-line\" data-line=\"34\">  let scale = max(abs(delta.x), abs(delta.y));\n</span><span class=\"lens-source-line\" data-line=\"35\">  if (scale == 0.0) { return true; }\n</span><span class=\"lens-source-line\" data-line=\"36\">  let scaled = delta / scale;\n</span><span class=\"lens-source-line\" data-line=\"37\">  return scale * sqrt(scaled.x * scaled.x + scaled.y * scaled.y) &lt;= tolerance;\n</span><span class=\"lens-source-line\" data-line=\"38\">}\n</span><span class=\"lens-source-line\" data-line=\"39\">\n</span><span class=\"lens-source-line\" data-line=\"40\">const g_FEATURE_COUNT: u32 = 102u;\n</span><span class=\"lens-source-line\" data-line=\"41\">const g_VERTEX_COUNT: u32 = 1431u;\n</span><span class=\"lens-source-line\" data-line=\"42\">fn gVertex(vertex: u32) -&gt; vec2f {\n</span><span class=\"lens-source-line\" data-line=\"43\">  return vec2f(gPositions[gPositionsOffset + vertex * 2u], gPositions[gPositionsOffset + vertex * 2u + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"44\">}\n</span><span class=\"lens-source-line\" data-line=\"45\">const g_POLYGON_COUNT: u32 = 102u;\n</span><span class=\"lens-source-line\" data-line=\"46\">const g_RING_COUNT: u32 = 102u;\n</span><span class=\"lens-source-line\" data-line=\"47\">fn gVertexStart(feature: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"48\">  let polygon = gFeatureOffsets[gFeatureOffsetsOffset + feature];\n</span><span class=\"lens-source-line\" data-line=\"49\">  let ring = gPolygonOffsets[gPolygonOffsetsOffset + polygon];\n</span><span class=\"lens-source-line\" data-line=\"50\">  return min(gRingOffsets[gRingOffsetsOffset + ring], g_VERTEX_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"51\">}\n</span><span class=\"lens-source-line\" data-line=\"52\">fn gLastRing(count: u32, value: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"53\">  if (count == 0u || gRingOffsets[gRingOffsetsOffset] &gt; value) { return 0u; }\n</span><span class=\"lens-source-line\" data-line=\"54\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"55\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"56\">  while (high - low &gt; 1u) {\n</span><span class=\"lens-source-line\" data-line=\"57\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"58\">    if (gRingOffsets[gRingOffsetsOffset + middle] &lt;= value) { low = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"59\">  }\n</span><span class=\"lens-source-line\" data-line=\"60\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"61\">}\n</span><span class=\"lens-source-line\" data-line=\"62\">fn gLastPolygon(count: u32, value: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"63\">  if (count == 0u || gPolygonOffsets[gPolygonOffsetsOffset] &gt; value) { return 0u; }\n</span><span class=\"lens-source-line\" data-line=\"64\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"65\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"66\">  while (high - low &gt; 1u) {\n</span><span class=\"lens-source-line\" data-line=\"67\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"68\">    if (gPolygonOffsets[gPolygonOffsetsOffset + middle] &lt;= value) { low = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"69\">  }\n</span><span class=\"lens-source-line\" data-line=\"70\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"71\">}\n</span><span class=\"lens-source-line\" data-line=\"72\">fn gLastFeature(count: u32, value: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"73\">  if (count == 0u || gFeatureOffsets[gFeatureOffsetsOffset] &gt; value) { return 0u; }\n</span><span class=\"lens-source-line\" data-line=\"74\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"75\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"76\">  while (high - low &gt; 1u) {\n</span><span class=\"lens-source-line\" data-line=\"77\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"78\">    if (gFeatureOffsets[gFeatureOffsetsOffset + middle] &lt;= value) { low = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"79\">  }\n</span><span class=\"lens-source-line\" data-line=\"80\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"81\">}\n</span><span class=\"lens-source-line\" data-line=\"82\">fn gFeatureOfVertex(vertex: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"83\">  let ring = gLastRing(g_RING_COUNT, vertex);\n</span><span class=\"lens-source-line\" data-line=\"84\">  let polygon = gLastPolygon(g_POLYGON_COUNT, ring);\n</span><span class=\"lens-source-line\" data-line=\"85\">  return gLastFeature(g_FEATURE_COUNT, polygon);\n</span><span class=\"lens-source-line\" data-line=\"86\">}\n</span><span class=\"lens-source-line\" data-line=\"87\">\n</span><span class=\"lens-source-line\" data-line=\"88\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"89\">@compute @workgroup_size(128)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"90\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"91\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"92\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"93\">) {\n</span><span class=\"lens-source-line\" data-line=\"94\">  _ = &amp;gPositions;\n</span><span class=\"lens-source-line\" data-line=\"95\">  _ = &amp;gFeatureOffsets;\n</span><span class=\"lens-source-line\" data-line=\"96\">  _ = &amp;gPolygonOffsets;\n</span><span class=\"lens-source-line\" data-line=\"97\">  _ = &amp;gRingOffsets;\n</span><span class=\"lens-source-line\" data-line=\"98\">  _ = &amp;output;\n</span><span class=\"lens-source-line\" data-line=\"99\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"100\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"101\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"102\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"103\">  if (workgroupIndex &gt;= 33554432u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"104\">  let index = workgroupIndex * 128u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"105\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"106\">    return;\n</span><span class=\"lens-source-line\" data-line=\"107\">  }\n</span><span class=\"lens-source-line\" data-line=\"108\">  let start = gVertexStart(index);\n</span><span class=\"lens-source-line\" data-line=\"109\">  let end = gVertexStart(index + 1u);\n</span><span class=\"lens-source-line\" data-line=\"110\">  output[outputOffset + index] = end - start;\n</span><span class=\"lens-source-line\" data-line=\"111\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>gPositions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"parks-positions\">parks-positions</td><td>read</td><td>f32</td></tr><tr><td>gFeatureOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"parks-feature-offsets\">parks-feature-offsets</td><td>read</td><td>u32</td></tr><tr><td>gPolygonOf