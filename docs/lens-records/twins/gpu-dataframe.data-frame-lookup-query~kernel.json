groupId.x;\n</span><span class=\"lens-source-line\" data-line=\"12\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"13\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"14\">  if (index &gt;= ELEMENT_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"15\">    return;\n</span><span class=\"lens-source-line\" data-line=\"16\">  }\n</span><span class=\"lens-source-line\" data-line=\"17\">  \n</span><span class=\"lens-source-line\" data-line=\"18\">  \n</span><span class=\"lens-source-line\" data-line=\"19\">  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, true);\n</span><span class=\"lens-source-line\" data-line=\"20\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>outputMask<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-dataframe.data-frame-lookup-query-gpu-dataframe-query-selection-mask\">gpu-dataframe.data-frame-lookup-query-gpu-dataframe-query-selection-mask</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUDataFrameQuery/predicate · main · 7c829855</figcaption></figure></section>",
