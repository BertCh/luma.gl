d\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const slicesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; slices: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const differenceOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; differenceOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const SLICE_COUNT: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"12\">const BAND_COUNT: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">fn quietNan() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"15\">  // A runtime value: WGSL rejects constant-expression NaN.\n</span><span class=\"lens-source-line\" data-line=\"16\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"17\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"18\">}\n</span><span class=\"lens-source-line\" data-line=\"19\">fn isNanValue(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"20\">  return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"21\">}\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"24\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"25\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"26\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"27\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"28\">) {\n</span><span class=\"lens-source-line\" data-line=\"29\">  _ = &amp;slices;\n</span><span class=\"lens-source-line\" data-line=\"30\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"31\">  _ = &amp;differenceOut;\n</span><span class=\"lens-source-line\" data-line=\"32\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"33\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"34\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"35\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"36\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"37\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"38\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"39\">    return;\n</span><span class=\"lens-source-line\" data-line=\"40\">  }\n</span><span class=\"lens-source-line\" data-line=\"41\">  let cell = index / BAND_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"42\">  let band = index % BAND_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"43\">  differenceOut[differenceOutOffset + index] = quietNan();\n</span><span class=\"lens-source-line\" data-line=\"44\">  \n</span><span class=\"lens-source-line\" data-line=\"45\">  let beforeSlice = params[paramsOffset];\n</span><span class=\"lens-source-line\" data-line=\"46\">  let afterSlice = params[paramsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"47\">  let epsilon = params[paramsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"48\">  if (!(beforeSlice &gt;= 0.0 &amp;&amp; beforeSlice &lt; f32(SLICE_COUNT) &amp;&amp; afterSlice &gt;= 0.0 &amp;&amp; afterSlice &lt; f32(SLICE_COUNT))) {\n</span><span class=\"lens-source-line\" data-line=\"49\">    return;\n</span><span class=\"lens-source-line\" data-line=\"50\">  }\n</span><span class=\"lens-source-line\" data-line=\"51\">  let before = slices[slicesOffset + (cell * SLICE_COUNT + u32(beforeSlice)) * BAND_COUNT + band];\n</span><span class=\"lens-source-line\" data-line=\"52\">  let after = slices[slicesOffset + (cell * SLICE_COUNT + u32(afterSlice)) * BAND_COUNT + band];\n</span><span class=\"lens-source-line\" data-line=\"53\">  if (isNanValue(before) || isNanValue(after)) {\n</span><span class=\"lens-source-line\" data-line=\"54\">    return;\n</span><span class=\"lens-source-line\" data-line=\"55\">  }\n</span><span class=\"lens-source-line\" data-line=\"56\">  differenceOut[differenceOutOffset + index] = after - before;\n</span><span class=\"lens-source-line\" data-line=\"57\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>slices<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"nirChangeSlices\">nirChangeSlices</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"change-parameters\">change-parameters</td><td>read</td><td>f32</td></tr><tr><td>differenceOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"nirChangeDifference\">nirChangeDifference</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUChangeDetection/two-slice · main · ccb049ad</figcaption></figure></section>",
