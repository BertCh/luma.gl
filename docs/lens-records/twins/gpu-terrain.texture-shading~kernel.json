group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const anchorOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; anchor: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"13\">@compute @workgroup_size(32)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"14\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"15\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"16\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"17\">) {\n</span><span class=\"lens-source-line\" data-line=\"18\">  _ = &amp;elevationValues;\n</span><span class=\"lens-source-line\" data-line=\"19\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"20\">  _ = &amp;anchor;\n</span><span class=\"lens-source-line\" data-line=\"21\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"22\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"23\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"24\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"25\">  if (workgroupIndex &gt;= 134217728u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"26\">  let index = workgroupIndex * 32u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"27\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"28\">    return;\n</span><span class=\"lens-source-line\" data-line=\"29\">  }\n</span><span class=\"lens-source-line\" data-line=\"30\">  var value = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"31\">  for (var probe = 0u; probe &lt; 64u; probe++) {\n</span><span class=\"lens-source-line\" data-line=\"32\">    let pixel = (probe * 64u) % 4096u;\n</span><span class=\"lens-source-line\" data-line=\"33\">    if (elevationValidity[elevationValidityOffset + pixel] != 0u) {\n</span><span class=\"lens-source-line\" data-line=\"34\">      value = elevationValues[elevationValuesOffset + pixel];\n</span><span class=\"lens-source-line\" data-line=\"35\">      break;\n</span><span class=\"lens-source-line\" data-line=\"36\">    }\n</span><span class=\"lens-source-line\" data-line=\"37\">  }\n</span><span class=\"lens-source-line\" data-line=\"38\">  anchor[anchorOffset] = value;\n</span><span class=\"lens-source-line\" data-line=\"39\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>elevationValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"texture-shading-elevation-values\">texture-shading-elevation-values</td><td>read</td><td>f32</td></tr><tr><td>elevationValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"texture-shading-elevation-validity\">texture-shading-elevation-validity</td><td>read</td><td>u32</td></tr><tr><td>anchor<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"texture-shading-anchor\">texture-shading-anchor</td><td>read_write</td><td>f32</td></tr></tbody></tab