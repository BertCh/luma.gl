es-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const conditionValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; conditionValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const valuesOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; valuesOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"15\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"16\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"17\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"18\">}\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">fn isNaNValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">fn isNoDataValue(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"25\">  return isNaNValue(value) || value == 0.0;\n</span><span class=\"lens-source-line\" data-line=\"26\">}\n</span><span class=\"lens-source-line\" data-line=\"27\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"28\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"29\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"30\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"31\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"32\">) {\n</span><span class=\"lens-source-line\" data-line=\"33\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"34\">  _ = &amp;conditionValues;\n</span><span class=\"lens-source-line\" data-line=\"35\">  _ = &amp;valuesOut;\n</span><span class=\"lens-source-line\" data-line=\"36\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"37\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"38\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"39\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"40\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"41\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"42\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"43\">    return;\n</span><span class=\"lens-source-line\" data-line=\"44\">  }\n</span><span class=\"lens-source-line\" data-line=\"45\">  var conditionDefined = true;\n</span><span class=\"lens-source-line\" data-line=\"46\">  var condition = false;\n</span><span class=\"lens-source-line\" data-line=\"47\">  let conditionValue = conditionValues[conditionValuesOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"48\">  conditionDefined = !isNoDataValue(conditionValue);\n</span><span class=\"lens-source-line\" data-line=\"49\">  let comparison = u32(params[paramsOffset]);\n</span><span class=\"lens-source-line\" data-line=\"50\">  let threshold = params[paramsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"51\">  let upperThreshold = params[paramsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"52\">  switch comparison {\n</span><span class=\"lens-source-line\" data-line=\"53\">    case 0u: { condition = conditionValue &lt; threshold; }\n</span><span class=\"lens-source-line\" data-line=\"54\">    case 1u: { condition = conditionValue &lt;= threshold; }\n</span><span class=\"lens-source-line\" data-line=\"55\">    case 2u: { condition = conditionValue &gt; threshold; }\n</span><span class=\"lens-source-line\" data-line=\"56\">    case 3u: { condition = conditionValue &gt;= threshold; }\n</span><span class=\"lens-source-line\" data-line=\"57\">    case 4u: { condition = conditionValue == threshold; }\n</span><span class=\"lens-source-line\" data-line=\"58\">    case 5u: { condition = conditionValue != threshold; }\n</span><span class=\"lens-source-line\" data-line=\"59\">    default: { condition = conditionValue &gt;= threshold &amp;&amp; conditionValue &lt;= upperThreshold; }\n</span><span class=\"lens-source-line\" data-line=\"60\">  }\n</span><span class=\"lens-source-line\" data-line=\"61\">  let aValue = params[paramsOffset + 3u];\n</span><span class=\"lens-source-line\" data-line=\"62\">  let bValue = params[paramsOffset + 4u];\n</span><span class=\"lens-source-line\" data-line=\"63\">  let chosen = select(bValue, aValue, condition);\n</span><span class=\"lens-source-line\" data-line=\"64\">  let isDefined = conditionDefined &amp;&amp; !isNoDataValue(chosen);\n</span><span class=\"lens-source-line\" data-line=\"65\">  valuesOut[valuesOutOffset + index] = select(getNaN(), chosen, isDefined);\n</span><span class=\"lens-source-line\" data-line=\"66\">  \n</span><span class=\"lens-source-line\" data-line=\"67\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"conditional-parameters\">conditional-parameters</td><td>read</td><td>f32</td></tr><tr><td>conditionValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"conditionalLandCover\">conditionalLandCover</td><td>read</td><td>f32</td></tr><tr><td>valuesOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"conditionalFriction\">conditionalFriction</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPURasterConditional/select · main · b612ddcb</figcaption></figure></section>",
