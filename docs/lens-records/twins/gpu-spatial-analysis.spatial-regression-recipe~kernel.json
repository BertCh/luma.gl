ide WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const ringOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; ringOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const polygonOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; polygonOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const featureOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; featureOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const vertexHighOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; vertexHigh: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const vertexLowOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; vertexLow: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const vertexPolygonOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"18\">@group(0) @binding(6) var&lt;storage, read_write&gt; vertexPolygon: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"19\">const vertexNextOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"20\">@group(0) @binding(7) var&lt;storage, read_write&gt; vertexNext: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"21\">const RING_COUNT: u32 = 199u;\n</span><span class=\"lens-source-line\" data-line=\"22\">const POLYGON_COUNT: u32 = 199u;\n</span><span class=\"lens-source-line\" data-line=\"23\">const FEATURE_COUNT: u32 = 199u;\n</span><span class=\"lens-source-line\" data-line=\"24\">const SNAP_TOLERANCE: f32 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">fn isFiniteFloat(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"28\">\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">fn quantise(value: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"31\">  if (SNAP_TOLERANCE &lt;= 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"32\">    return bitcast&lt;u32&gt;(select(value, 0.0, value == 0.0));\n</span><span class=\"lens-source-line\" data-line=\"33\">  }\n</span><span class=\"lens-source-line\" data-line=\"34\">  let snapped = clamp(floor(value / SNAP_TOLERANCE + 0.5), -2147483520.0, 2147483520.0);\n</span><span class=\"lens-source-line\" data-line=\"35\">  return bitcast&lt;u32&gt;(i32(snapped)) ^ 0x80000000u;\n</span><span class=\"lens-source-line\" data-line=\"36\">}\n</span><span class=\"lens-source-line\" data-line=\"37\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"38\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"39\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"40\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"41\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"42\">) {\n</span><span class=\"lens-source-line\" data-line=\"43\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"44\">  _ = &amp;ringOffsets;\n</span><span class=\"lens-source-line\" data-line=\"45\">  _ = &amp;polygonOffsets;\n</span><span class=\"lens-source-line\" data-line=\"46\">  _ = &amp;featureOffsets;\n</span><span class=\"lens-source-line\" data-line=\"47\">  _ = &amp;vertexHigh;\n</span><span class=\"lens-source-line\" data-line=\"48\">  _ = &amp;vertexLow;\n</span><span class=\"lens-source-line\" data-line=\"49\">  _ = &amp;vertexPolygon;\n</span><span class=\"lens-source-line\" data-line=\"50\">  _ = &amp;vertexNext;\n</span><span class=\"lens-source-line\" data-line=\"51\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"52\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"53\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"54\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"55\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"56\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"57\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"58\">    return;\n</span><span class=\"lens-source-line\" data-line=\"59\">  }\n</span><span class=\"lens-source-line\" data-line=\"60\">  var ring = 0u;\n</span><span class=\"lens-source-line\" data-line=\"61\">  var high = RING_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"62\">  while (ring + 1u &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"63\">    let middle = (ring + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"64\">    if (ringOffsets[ringOffsetsOffset + middle] &lt;= index) {\n</span><span class=\"lens-source-line\" data-line=\"65\">      ring = middle;\n</span><span class=\"lens-source-line\" data-line=\"66\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"67\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"68\">    }\n</span><span class=\"lens-source-line\" data-line=\"69\">  }\n</span><span class=\"lens-source-line\" data-line=\"70\">  var polygon = 0u;\n</span><span class=\"lens-source-line\" data-line=\"71\">  high = POLYGON_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"72\">  while (polygon + 1u &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"73\">    let middle = (polygon + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"74\">    if (polygonOffsets[polygonOffsetsOffset + middle] &lt;= ring) {\n</span><span class=\"lens-source-line\" data-line=\"75\">      polygon = middle;\n</span><span class=\"lens-source-line\" data-line=\"76\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"77\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"78\">    }\n</span><span class=\"lens-source-line\" data-line=\"79\">  }\n</span><span class=\"lens-source-line\" data-line=\"80\">  var feature = 0u;\n</span><span class=\"lens-source-line\" data-line=\"81\">  high = FEATURE_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"82\">  while (feature + 1u &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"83\">    let middle = (feature + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"84\">    if (featureOffsets[featureOffsetsOffset + middle] &lt;= polygon) {\n</span><span class=\"lens-source-line\" data-line=\"85\">      feature = middle;\n</span><span class=\"lens-source-line\" data-line=\"86\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"87\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"88\">    }\n</span><span class=\"lens-source-line\" data-line=\"89\">  }\n</span><span class=\"lens-source-line\" data-line=\"90\">  let x = positions[positionsOffset + index * 2u];\n</span><span class=\"lens-source-line\" data-line=\"91\">  let y = positions[positionsOffset + index * 2u + 1u];\n</span><span class=\"lens-source-line\" data-line=\"92\">  let ringBegin = ringOffsets[ringOffsetsOffset + ring];\n</span><span class=\"lens-source-line\" data-line=\"93\">  let ringEnd = ringOffsets[ringOffsetsOffset + ring + 1u];\n</span><span class=\"lens-source-line\" data-line=\"94\">  let valid = index &gt;= ringBegin &amp;&amp; index &lt; ringEnd &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"95\">    ring &gt;= polygonOffsets[polygonOffsetsOffset] &amp;&amp; ring &lt; polygonOffsets[polygonOffsetsOffset + POLYGON_COUNT] &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"96\">    ring &lt; polygonOffsets[polygonOffsetsOffset + polygon + 1u] &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"97\">    polygon &gt;= featureOffsets[featureOffsetsOffset] &amp;&amp; polygon &lt; featureOffsets[featureOffsetsOffset + FEATURE_COUNT] &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"98\">    polygon &lt; featureOffsets[featureOffsetsOffset + feature + 1u] &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"99\">    isFiniteFloat(x) &amp;&amp; isFiniteFloat(y);\n</span><span class=\"lens-source-line\" data-line=\"100\">  vertexHigh[vertexHighOffset + index] = select(4294967295u, quantise(x), valid);\n</span><span class=\"lens-source-line\" data-line=\"101\">  vertexLow[vertexLowOffset + index] = select(4294967295u, quantise(y), valid);\n</span><span class=\"lens-source-line\" data-line=\"102\">  vertexPolygon[vertexPolygonOffset + index] = select(4294967295u, feature, valid);\n</span><span class=\"lens-source-line\" data-line=\"103\">  vertexNext[vertexNextOffset + index] = select(index + 1u, ringBegin, index + 1u == ringEnd);\n</span><span class=\"lens-source-line\" data-line=\"104\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tracts-positions\">tracts-positions</td><td>read</td><td>f32</td></tr><tr><td>ringOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tracts-ring-offsets\">tracts-ring-offsets</td><td>read</td><td>u32</td></tr><tr><td>polygonOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tracts-polygon-offsets\">tracts-polygon-offsets</td><td>read</td><td>u32</td></tr><tr><td>featureOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tracts-feature-offsets\">tracts-feature-offsets</td><td>read</td><td>u32</td></tr><tr><td>vertexHigh<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"contiguity-weights-vertex-high\">contiguity-weights-vertex-high</td><td>read_write</td><td>u32</td></tr><tr><td>vertexLow<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"contiguity-weights-vertex-low\">contiguity-weights-vertex-low</td><td>