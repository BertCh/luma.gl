de INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const eventsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; events: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const populationsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; populations: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const eventsPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; eventsPartials: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const populationPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; populationPartials: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const countPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; countPartials: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const invalidPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; invalidPartials: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line\" data-line=\"18\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">fn getSquare(value: f32) -&gt; f32 { return value * value; }\n</span><span class=\"lens-source-line\" data-line=\"21\">fn isRowIncluded(row: u32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"22\">  return true;\n</span><span class=\"lens-source-line\" data-line=\"23\">}\n</span><span class=\"lens-source-line\" data-line=\"24\">fn isRowValid(row: u32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"25\">  let event = events[eventsOffset + row];\n</span><span class=\"lens-source-line\" data-line=\"26\">  let population = populations[populationsOffset + row];\n</span><span class=\"lens-source-line\" data-line=\"27\">  return isRowIncluded(row) &amp;&amp; isFiniteValue(event) &amp;&amp; isFiniteValue(population) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"28\">    event &gt;= 0.0 &amp;&amp; population &gt; 0.0;\n</span><span class=\"lens-source-line\" data-line=\"29\">}\n</span><span class=\"lens-source-line\" data-line=\"30\">const ROW_COUNT: u32 = 791u;\n</span><span class=\"lens-source-line\" data-line=\"31\">const BLOCK_ROWS: u32 = 4096u;\n</span><span class=\"lens-source-line\" data-line=\"32\">const WORKGROUP_SIZE: u32 = 256u;\n</span><span class=\"lens-source-line\" data-line=\"33\">var&lt;workgroup&gt; shared_events: array&lt;f32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"34\">var&lt;workgroup&gt; shared_population: array&lt;f32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"35\">var&lt;workgroup&gt; shared_count: array&lt;u32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"36\">var&lt;workgroup&gt; shared_invalid: array&lt;u32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"37\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"38\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"39\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"40\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"41\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"42\">) {\n</span><span class=\"lens-source-line\" data-line=\"43\">  _ = &amp;events;\n</span><span class=\"lens-source-line\" data-line=\"44\">  _ = &amp;populations;\n</span><span class=\"lens-source-line\" data-line=\"45\">  _ = &amp;eventsPartials;\n</span><span class=\"lens-source-line\" data-line=\"46\">  _ = &amp;populationPartials;\n</span><span class=\"lens-source-line\" data-line=\"47\">  _ = &amp;countPartials;\n</span><span class=\"lens-source-line\" data-line=\"48\">  _ = &amp;invalidPartials;\n</span><span class=\"lens-source-line\" data-line=\"49\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"50\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"51\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"52\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"53\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"54\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"55\">  \n</span><span class=\"lens-source-line\" data-line=\"56\">  let block = index / WORKGROUP_SIZE;\n</span><span class=\"lens-source-line\" data-line=\"57\">  let isInRange = index &lt; INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"58\">  var local_events = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"59\">  var local_population = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"60\">  var local_count = 0u;\n</span><span class=\"lens-source-line\" data-line=\"61\">  var local_invalid = 0u;\n</span><span class=\"lens-source-line\" data-line=\"62\">  if (isInRange) {\n</span><span class=\"lens-source-line\" data-line=\"63\">    let end = min((block + 1u) * BLOCK_ROWS, ROW_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"64\">    for (var row = block * BLOCK_ROWS + localInvocationIndex; row &lt; end; row += WORKGROUP_SIZE) {\n</span><span class=\"lens-source-line\" data-line=\"65\">      let isValid = isRowValid(row);\n</span><span class=\"lens-source-line\" data-line=\"66\">      let isInvalid = isRowIncluded(row) &amp;&amp; !isValid;\n</span><span class=\"lens-source-line\" data-line=\"67\">      if (isValid) { local_events += events[eventsOffset + row]; }\n</span><span class=\"lens-source-line\" data-line=\"68\">      if (isValid) { local_population += populations[populationsOffset + row]; }\n</span><span class=\"lens-source-line\" data-line=\"69\">      if (isValid) { local_count += 1u; }\n</span><span class=\"lens-source-line\" data-line=\"70\">      if (isInvalid) { local_invalid += 1u; }\n</span><span class=\"lens-source-line\" data-line=\"71\">    }\n</span><span class=\"lens-source-line\" data-line=\"72\">  }\n</span><span class=\"lens-source-line\" data-line=\"73\">  shared_events[localInvocationIndex] = local_events;\n</span><span class=\"lens-source-line\" data-line=\"74\">  shared_population[localInvocationIndex] = local_population;\n</span><span class=\"lens-source-line\" data-line=\"75\">  shared_count[localInvocationIndex] = local_count;\n</span><span class=\"lens-source-line\" data-line=\"76\">  shared_invalid[localInvocationIndex] = local_invalid;\n</span><span class=\"lens-source-line\" data-line=\"77\">  workgroupBarrier();\n</span><span class=\"lens-source-line\" data-line=\"78\">  for (var stride = WORKGROUP_SIZE / 2u; stride &gt; 0u; stride = stride / 2u) {\n</span><span class=\"lens-source-line\" data-line=\"79\">    if (localInvocationIndex &lt; stride) {\n</span><span class=\"lens-source-line\" data-line=\"80\">      shared_events[localInvocationIndex] += shared_events[localInvocationIndex + stride];\n</span><span class=\"lens-source-line\" data-line=\"81\">      shared_population[localInvocationIndex] += shared_population[localInvocationIndex + stride];\n</span><span class=\"lens-source-line\" data-line=\"82\">      shared_count[localInvocationIndex] += shared_count[localInvocationIndex + stride];\n</span><span class=\"lens-source-line\" data-line=\"83\">      shared_invalid[localInvocationIndex] += shared_invalid[localInvocationIndex + stride];\n</span><span class=\"lens-source-line\" data-line=\"84\">    }\n</span><span class=\"lens-source-line\" data-line=\"85\">    workgroupBarrier();\n</span><span class=\"lens-source-line\" data-line=\"86\">  }\n</span><span class=\"lens-source-line\" data-line=\"87\">  if (isInRange &amp;&amp; localInvocationIndex == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"88\">    eventsPartials[eventsPartialsOffset + block] = shared_events[0];\n</span><span class=\"lens-source-line\" data-line=\"89\">    populationPartials[populationPartialsOffset + block] = shared_population[0];\n</span><span class=\"lens-source-line\" data-line=\"90\">    countPartials[countPartialsOffset + block] = shared_count[0];\n</span><span class=\"lens-source-line\" data-line=\"91\">    invalidPartials[invalidPartialsOffset + block] = shared_invalid[0];\n</span><span class=\"lens-source-line\" data-line=\"92\">  }\n</span><span class=\"lens-source-line\" data-line=\"93\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>events<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"events\">events</td><td>read</td><td>f32</td></tr><tr><td>populat