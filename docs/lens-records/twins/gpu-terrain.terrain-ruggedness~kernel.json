anes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevation: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const rugValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; rugValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const WIDTH: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"12\">const HEIGHT: i32 = 64;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">fn isSampleValid(row: i32, column: i32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"17\">  let sampleIndex = u32(row * WIDTH + column);\n</span><span class=\"lens-source-line\" data-line=\"18\">  return elevationValidity[elevationValidityOffset + sampleIndex] != 0u &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"19\">    isFiniteValue(elevation[elevationOffset + sampleIndex]);\n</span><span class=\"lens-source-line\" data-line=\"20\">}\n</span><span class=\"lens-source-line\" data-line=\"21\">fn getSample(row: i32, column: i32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"22\">  return elevation[elevationOffset + u32(row * WIDTH + column)];\n</span><span class=\"lens-source-line\" data-line=\"23\">}\n</span><span class=\"lens-source-line\" data-line=\"24\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"25\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"26\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"27\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"28\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"29\">) {\n</span><span class=\"lens-source-line\" data-line=\"30\">  _ = &amp;elevation;\n</span><span class=\"lens-source-line\" data-line=\"31\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"32\">  _ = &amp;rugValues;\n</span><span class=\"lens-source-line\" data-line=\"33\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"34\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"35\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"36\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"37\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"38\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"39\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"40\">    return;\n</span><span class=\"lens-source-line\" data-line=\"41\">  }\n</span><span class=\"lens-source-line\" data-line=\"42\">  let row = i32(index) / WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"43\">  let column = i32(index) % WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"44\">  var windowValues: array&lt;f32, 9&gt;;\n</span><span class=\"lens-source-line\" data-line=\"45\">  let centerValue = getSample(row, column);\n</span><span class=\"lens-source-line\" data-line=\"46\">  var isValid = row &gt; 0 &amp;&amp; row &lt; HEIGHT - 1 &amp;&amp; column &gt; 0 &amp;&amp; column &lt; WIDTH - 1;\n</span><span class=\"lens-source-line\" data-line=\"47\">  if (isValid) {\n</span><span class=\"lens-source-line\" data-line=\"48\">    for (var k = 0; k &lt; 9; k++) {\n</span><span class=\"lens-source-line\" data-line=\"49\">      let sampleRow = row + k / 3 - 1;\n</span><span class=\"lens-source-line\" data-line=\"50\">      let sampleColumn = column + k % 3 - 1;\n</span><span class=\"lens-source-line\" data-line=\"51\">      isValid = isValid &amp;&amp; isSampleValid(sampleRow, sampleColumn);\n</span><span class=\"lens-source-line\" data-line=\"52\">      if (isValid) {\n</span><span class=\"lens-source-line\" data-line=\"53\">        windowValues[k] = getSample(sampleRow, sampleColumn);\n</span><span class=\"lens-source-line\" data-line=\"54\">      }\n</span><span class=\"lens-source-line\" data-line=\"55\">    }\n</span><span class=\"lens-source-line\" data-line=\"56\">  }\n</span><span class=\"lens-source-line\" data-line=\"57\">  var differenceSum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"58\">  var absoluteSum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"59\">  var squareSum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"60\">  var minimum = windowValues[0];\n</span><span class=\"lens-source-line\" data-line=\"61\">  var maximum = windowValues[0];\n</span><span class=\"lens-source-line\" data-line=\"62\">  for (var k = 0; k &lt; 9; k++) {\n</span><span class=\"lens-source-line\" data-line=\"63\">    // Differences against the centre are formed first so they stay exact near large offsets.\n</span><span class=\"lens-source-line\" data-line=\"64\">    let difference = windowValues[k] - centerValue;\n</span><span class=\"lens-source-line\" data-line=\"65\">    differenceSum += difference;\n</span><span class=\"lens-source-line\" data-line=\"66\">    absoluteSum += abs(difference);\n</span><span class=\"lens-source-line\" data-line=\"67\">    squareSum += difference * difference;\n</span><span class=\"lens-source-line\" data-line=\"68\">    minimum = min(minimum, windowValues[k]);\n</span><span class=\"lens-source-line\" data-line=\"69\">    maximum = max(maximum, windowValues[k]);\n</span><span class=\"lens-source-line\" data-line=\"70\">  }\n</span><span class=\"lens-source-line\" data-line=\"71\">  let topographicPosition = -differenceSum / 8.0;\n</span><span class=\"lens-source-line\" data-line=\"72\">  let ruggedness = sqrt(squareSum);\n</span><span class=\"lens-source-line\" data-line=\"73\">  let roughness = maximum - minimum;\n</span><span class=\"lens-source-line\" data-line=\"74\">  isValid = isValid &amp;&amp; isFiniteValue(topographicPosition) &amp;&amp; isFiniteValue(ruggedness) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"75\">    isFiniteValue(roughness);\n</span><span class=\"lens-source-line\" data-line=\"76\">  let invalidValue = bitcast&lt;f32&gt;(0x7fc00000u | (index &amp; 0u));\n</span><span class=\"lens-source-line\" data-line=\"77\">  \n</span><span class=\"lens-source-line\" data-line=\"78\">  rugValues[rugValuesOffset + index] = select(invalidValue, ruggedness, isValid);\n</span><span class=\"lens-source-line\" data-line=\"79\">  \n</span><span class=\"lens-source-line\" data-line=\"80\">  \n</span><span class=\"lens-source-line\" data-line=\"81\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>elevation<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-ruggedness-elevation-values\">terrain-ruggedness-elevation-values</td><td>read</td><td>f32</td></tr><tr><td>elevationValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-ruggedness-elevation-validity\">terrain-ruggedness-elevation-validity</td><td>read</td><td>u32</td></tr><tr><td>rugValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrainRuggednessIndex\">terrainRuggednessIndex</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUTerrainRuggedness/nodata-riley · main · fb833b63</figcaption></figure></section>",
