nce=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><rect x=\"402\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 10</title></rect><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><rect x=\"442\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 11</title></rect><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><rect x=\"482\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 12</title></rect><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><rect x=\"522\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 13</title></rect><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><rect x=\"562\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 14</title></rect><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"15\"><rect x=\"602\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 15</title></rect><text x=\"605\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">15</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"16\"><rect x=\"642\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 16</title></rect><text x=\"645\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">16</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"17\"><rect x=\"682\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 17</title></rect><text x=\"685\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">17</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"18\"><rect x=\"722\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 18</title></rect><text x=\"725\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">18</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"19\"><rect x=\"762\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 19</title></rect><text x=\"765\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">19</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"20\"><rect x=\"802\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 20</title></rect><text x=\"805\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">20</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"21\"><rect x=\"842\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 21</title></rect><text x=\"845\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">21</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"22\"><rect x=\"882\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 22</title></rect><text x=\"885\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">22</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"23\"><rect x=\"922\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 23</title></rect><text x=\"925\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">23</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"24\"><rect x=\"962\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 24</title></rect><text x=\"965\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">24</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"25\"><rect x=\"1002\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 25</title></rect><text x=\"1005\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">25</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"26\"><rect x=\"1042\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 26</title></rect><text x=\"1045\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">26</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"27\"><rect x=\"1082\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 27</title></rect><text x=\"1085\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">27</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"28\"><rect x=\"1122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 28</title></rect><text x=\"1125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">28</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"29\"><rect x=\"1162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 29</title></rect><text x=\"1165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">29</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"30\"><rect x=\"1202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-streamlines-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">30</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-raster-streamlines-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const velocitiesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; velocities: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const parametersOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; parameters: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const wordsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; words: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const candidatesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; candidates: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const spansOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; spans: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const keysOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; keys: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const statusOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"18\">@group(0) @binding(6) var&lt;storage, read_write&gt; status: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">fn philoxMulHiLo(a: u32, b: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"21\">  let aLow = a &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"22\">  let aHigh = a &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"23\">  let bLow = b &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"24\">  let bHigh = b &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"25\">  let lowLow = aLow * bLow;\n</span><span class=\"lens-source-line\" data-line=\"26\">  let highLow = aHigh * bLow;\n</span><span class=\"lens-source-line\" data-line=\"27\">  let lowHigh = aLow * bHigh;\n</span><span class=\"lens-source-line\" data-line=\"28\">  let highHigh = aHigh * bHigh;\n</span><span class=\"lens-source-line\" data-line=\"29\">  let middle = (lowLow &gt;&gt; 16u) + (highLow &amp; 0xffffu) + (lowHigh &amp; 0xffffu);\n</span><span class=\"lens-source-line\" data-line=\"30\">  let high = highHigh + (highLow &gt;&gt; 16u) + (lowHigh &gt;&gt; 16u) + (middle &gt;&gt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"31\">  return vec2&lt;u32&gt;(high, a * b);\n</span><span class=\"lens-source-line\" data-line=\"32\">}\n</span><span class=\"lens-source-line\" data-line=\"33\">\n</span><span class=\"lens-source-line\" data-line=\"34\">fn philoxRound(counter: vec4&lt;u32&gt;, key: vec2&lt;u32&gt;) -&gt; vec4&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"35\">  let product0 = philoxMulHiLo(3528531795u, counter.x);\n</span><span class=\"lens-source-line\" data-line=\"36\">  let product1 = philoxMulHiLo(3449720151u, counter.z);\n</span><span class=\"lens-source-line\" data-line=\"37\">  return vec4&lt;u32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"38\">    product1.x ^ counter.y ^ key.x,\n</span><span class=\"lens-source-line\" data-line=\"39\">    product1.y,\n</span><span class=\"lens-source-line\" data-line=\"40\">    product0.x ^ counter.w ^ key.y,\n</span><span class=\"lens-source-line\" data-line=\"41\">    product0.y\n</span><span class=\"lens-source-line\" data-line=\"42\">  );\n</span><span class=\"lens-source-line\" data-line=\"43\">}\n</span><span class=\"lens-source-line\" data-line=\"44\">\n</span><span class=\"lens-source-line\" data-line=\"45\">fn philox4x32(counterIn: vec4&lt;u32&gt;, keyIn: vec2&lt;u32&gt;) -&gt; vec4&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"46\">  var counter = counterIn;\n</span><span class=\"lens-source-line\" data-line=\"47\">  var key = keyIn;\n</span><span class=\"lens-source-line\" data-line=\"48\">  for (var roundIndex = 0u; roundIndex &lt; 9u; roundIndex = roundIndex + 1u) {\n</span><span class=\"lens-source-line\" data-line=\"49\">    counter = philoxRound(counter, key);\n</span><span class=\"lens-source-line\" data-line=\"50\">    key = key + vec2&lt;u32&gt;(2654435769u, 3144134277u);\n</span><span class=\"lens-source-line\" data-line=\"51\">  }\n</span><span class=\"lens-source-line\" data-line=\"52\">  return philoxRound(counter, key);\n</span><span class=\"lens-source-line\" data-line=\"53\">}\n</span><span class=\"lens-source-line\" data-line=\"54\">\n</span><span class=\"lens-source-line\" data-line=\"55\">fn philoxUnitFloat(word: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"56\">  return f32(word &gt;&gt; 8u) * (1.0 / 16777216.0);\n</span><span class=\"lens-source-line\" data-line=\"57\">}\n</span><span class=\"lens-source-line\" data-line=\"58\">\n</span><span class=\"lens-source-line\" data-line=\"59\">\n</span><span class=\"lens-source-line\" data-line=\"60\">const FIELD_WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"61\">const FIELD_HEIGHT: u32 = 48u;\n</span><span class=\"lens-source-line\" data-line=\"62\">\n</span><span class=\"lens-source-line\" data-line=\"63\">fn isNanFloat(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"64\">  return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"65\">}\n</span><span class=\"lens-source-line\" data-line=\"66\">\n</span><span class=\"lens-source-line\" data-line=\"67\">fn readFieldVelocity(column: u32, row: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"68\">  let base = velocitiesOffset + 2u * (row * FIELD_WIDTH + column);\n</span><span class=\"lens-source-line\" data-line=\"69\">  return vec2&lt;f32&gt;(velocities[base], velocities[base + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"70\">}\n</span><span class=\"lens-source-line\" data-line=\"71\">\n</span><span class=\"lens-source-line\" data-line=\"72\">fn isNanVelocity(value: vec2&lt;f32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"73\">  return isNanFloat(value.x) || isNanFloat(value.y);\n</span><span class=\"lens-source-line\" data-line=\"74\">}\n</span><span class=\"lens-source-line\" data-line=\"75\">\n</span><span class=\"lens-source-line\" data-line=\"76\">fn sampleField(position: vec2&lt;f32&gt;, extent: vec4&lt;f32&gt;) -&gt; vec3&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"77\">  let local = (position - extent.xy) / extent.zw;\n</span><span class=\"lens-source-line\" data-line=\"78\">  if (isNanVelocity(local)) {\n</span><span class=\"lens-source-line\" data-line=\"79\">    return vec3&lt;f32&gt;(0.0);\n</span><span class=\"lens-source-line\" data-line=\"80\">  }\n</span><span class=\"lens-source-line\" data-line=\"81\">  if (local.x &lt; 0.0 || local.y &lt; 0.0 || local.x &gt;= f32(FIELD_WIDTH) || local.y &gt;= f32(FIELD_HEIGHT)) {\n</span><span class=\"lens-source-line\" data-line=\"82\">    return vec3&lt;f32&gt;(0.0);\n</span><span class=\"lens-source-line\" data-line=\"83\">  }\n</span><span class=\"lens-source-line\" data-line=\"84\">  let grid = clamp(\n</span><span class=\"lens-source-line\" data-line=\"85\">    local - vec2&lt;f32&gt;(0.5),\n</span><span class=\"lens-source-line\" data-line=\"86\">    vec2&lt;f32&gt;(0.0),\n</span><span class=\"lens-source-line\" data-line=\"87\">    vec2&lt;f32&gt;(f32(FIELD_WIDTH - 1u), f32(FIELD_HEIGHT - 1u))\n</span><span class=\"lens-source-line\" data-line=\"88\">  );\n</span><span class=\"lens-source-line\" data-line=\"89\">  let column0 = min(u32(grid.x), FIELD_WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"90\">  let row0 = min(u32(grid.y), FIELD_HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"91\">  let column1 = min(column0 + 1u, FIELD_WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"92\">  let row1 = min(row0 + 1u, FIELD_HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"93\">  let fraction = grid - vec2&lt;f32&gt;(f32(column0), f32(row0));\n</span><span class=\"lens-source-line\" data-line=\"94\">  let v00 = readFieldVelocity(column0, row0);\n</span><span class=\"lens-s