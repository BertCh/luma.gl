a-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const timestampsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; timestamps: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; params: array&lt;i32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const yearOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; yearOut: array&lt;i32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const monthOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; monthOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">const MILLISECONDS_PER_DAY: u32 = 86400000u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const MAXIMUM_DAYS: u32 = 1000000000u;\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">struct CalendarFields {\n</span><span class=\"lens-source-line\" data-line=\"18\">  valid: bool,\n</span><span class=\"lens-source-line\" data-line=\"19\">  year: i32,\n</span><span class=\"lens-source-line\" data-line=\"20\">  month: u32,\n</span><span class=\"lens-source-line\" data-line=\"21\">  day: u32,\n</span><span class=\"lens-source-line\" data-line=\"22\">  hour: u32,\n</span><span class=\"lens-source-line\" data-line=\"23\">  minute: u32,\n</span><span class=\"lens-source-line\" data-line=\"24\">  weekday: u32,\n</span><span class=\"lens-source-line\" data-line=\"25\">  dayOfYear: u32,\n</span><span class=\"lens-source-line\" data-line=\"26\">  isoWeek: u32,\n</span><span class=\"lens-source-line\" data-line=\"27\">  isoWeekYear: i32,\n</span><span class=\"lens-source-line\" data-line=\"28\">  quarter: u32\n</span><span class=\"lens-source-line\" data-line=\"29\">}\n</span><span class=\"lens-source-line\" data-line=\"30\">\n</span><span class=\"lens-source-line\" data-line=\"31\">fn invalidCalendar() -&gt; CalendarFields {\n</span><span class=\"lens-source-line\" data-line=\"32\">  let invalidYear = bitcast&lt;i32&gt;(0x80000000u);\n</span><span class=\"lens-source-line\" data-line=\"33\">  return CalendarFields(false, invalidYear, 0xffffffffu, 0xffffffffu, 0xffffffffu, 0xffffffffu,\n</span><span class=\"lens-source-line\" data-line=\"34\">    0xffffffffu, 0xffffffffu, 0xffffffffu, invalidYear, 0xffffffffu);\n</span><span class=\"lens-source-line\" data-line=\"35\">}\n</span><span class=\"lens-source-line\" data-line=\"36\">\n</span><span class=\"lens-source-line\" data-line=\"37\">fn isLeapYear(year: i32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"38\">  return (year % 4 == 0) &amp;&amp; ((year % 100 != 0) || (year % 400 == 0));\n</span><span class=\"lens-source-line\" data-line=\"39\">}\n</span><span class=\"lens-source-line\" data-line=\"40\">\n</span><span class=\"lens-source-line\" data-line=\"41\">// Hinnant civil_from_days: days since 1970-01-01 to (year, month, day).\n</span><span class=\"lens-source-line\" data-line=\"42\">fn civilFromDays(days: i32) -&gt; vec3&lt;i32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"43\">  let z = days + 719468;\n</span><span class=\"lens-source-line\" data-line=\"44\">  let era = select((z - 146096) / 146097, z / 146097, z &gt;= 0);\n</span><span class=\"lens-source-line\" data-line=\"45\">  let dayOfEra = z - era * 146097;\n</span><span class=\"lens-source-line\" data-line=\"46\">  let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;\n</span><span class=\"lens-source-line\" data-line=\"47\">  let dayOfMarchYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);\n</span><span class=\"lens-source-line\" data-line=\"48\">  let monthPrime = (5 * dayOfMarchYear + 2) / 153;\n</span><span class=\"lens-source-line\" data-line=\"49\">  let day = dayOfMarchYear - (153 * monthPrime + 2) / 5 + 1;\n</span><span class=\"lens-source-line\" data-line=\"50\">  let month = select(monthPrime - 9, monthPrime + 3, monthPrime &lt; 10);\n</span><span class=\"lens-source-line\" data-line=\"51\">  let year = yearOfEra + era * 400 + select(0, 1, month &lt;= 2);\n</span><span class=\"lens-source-line\" data-line=\"52\">  return vec3&lt;i32&gt;(year, month, day);\n</span><span class=\"lens-source-line\" data-line=\"53\">}\n</span><span class=\"lens-source-line\" data-line=\"54\">\n</span><span class=\"lens-source-line\" data-line=\"55\">fn getDayOfYear(date: vec3&lt;i32&gt;) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"56\">  let adjustment = select(select(-2, -1, isLeapYear(date.x)), 0, date.y &lt;= 2);\n</span><span class=\"lens-source-line\" data-line=\"57\">  return (367 * date.y - 362) / 12 + date.z + adjustment;\n</span><span class=\"lens-source-line\" data-line=\"58\">}\n</span><span class=\"lens-source-line\" data-line=\"59\">\n</span><span class=\"lens-source-line\" data-line=\"60\">struct DivideResult {\n</span><span class=\"lens-source-line\" data-line=\"61\">  quotientLow: u32,\n</span><span class=\"lens-source-line\" data-line=\"62\">  quotientHigh: u32,\n</span><span class=\"lens-source-line\" data-line=\"63\">  remainder: u32\n</span><span class=\"lens-source-line\" data-line=\"64\">}\n</span><span class=\"lens-source-line\" data-line=\"65\">\n</span><span class=\"lens-source-line\" data-line=\"66\">// Exact unsigned 64-bit division by a divisor below 2^28, one nibble at a time so that\n</span><span class=\"lens-source-line\" data-line=\"67\">// remainder * 16 never overflows 32 bits.\n</span><span class=\"lens-source-line\" data-line=\"68\">fn divideUnsigned64(value: vec2&lt;u32&gt;, divisor: u32) -&gt; DivideResult {\n</span><span class=\"lens-source-line\" data-line=\"69\">  var remainder = value.y % divisor;\n</span><span class=\"lens-source-line\" data-line=\"70\">  var quotientLow = 0u;\n</span><span class=\"lens-source-line\" data-line=\"71\">  for (var nibble = 7i; nibble &gt;= 0i; nibble = nibble - 1i) {\n</span><span class=\"lens-source-line\" data-line=\"72\">    let shift = u32(nibble) * 4u;\n</span><span class=\"lens-source-line\" data-line=\"73\">    let current = (remainder &lt;&lt; 4u) | ((value.x &gt;&gt; shift) &amp; 0xfu);\n</span><span class=\"lens-source-line\" data-line=\"74\">    quotientLow = quotientLow | ((current / divisor) &lt;&lt; shift);\n</span><span class=\"lens-source-line\" data-line=\"75\">    remainder = current % divisor;\n</span><span class=\"lens-source-line\" data-line=\"76\">  }\n</span><span class=\"lens-source-line\" data-line=\"77\">  return DivideResult(quotientLow, value.y / divisor, remainder);\n</span><span class=\"lens-source-line\" data-line=\"78\">}\n</span><span class=\"lens-source-line\" data-line=\"79\">\n</span><span class=\"lens-source-line\" data-line=\"80\">// Minutes to milliseconds; an offset beyond +-1440 minutes maps to a value the decode rejects.\n</span><span class=\"lens-source-line\" data-line=\"81\">fn minutesToMilliseconds(offsetMinutes: i32) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"82\">  return select(offsetMinutes * 60000, 0x7fffffff, offsetMinutes &lt; -1440 || offsetMinutes &gt; 1440);\n</span><span class=\"lens-source-line\" data-line=\"83\">}\n</span><span class=\"lens-source-line\" data-line=\"84\">\n</span><span class=\"lens-source-line\" data-line=\"85\">fn decodeCalendar(time: vec2&lt;u32&gt;, offsetMilliseconds: i32, firstDay: u32) -&gt; CalendarFields {\n</span><span class=\"lens-source-line\" data-line=\"86\">  let invalid = invalidCalendar();\n</span><span class=\"lens-source-line\" data-line=\"87\">  if (offsetMilliseconds &lt; -86400000 || offsetMilliseconds &gt; 86400000) {\n</span><span class=\"lens-source-line\" data-line=\"88\">    return invalid;\n</span><span class=\"lens-source-line\" data-line=\"89\">  }\n</span><span class=\"lens-source-line\" data-line=\"90\">  // Signed 64-bit local time = time + offset, with overflow detection.\n</span><span class=\"lens-source-line\" data-line=\"91\">  let offsetLow = bitcast&lt;u32&gt;(offsetMilliseconds);\n</span><span class=\"lens-source-line\" data-line=\"92\">  let offsetHigh = select(0u, 0xffffffffu, offsetMilliseconds &lt; 0);\n</span><span class=\"lens-source-line\" data-line=\"93\">  let low = time.x + offsetLow;\n</span><span class=\"lens-source-line\" data-line=\"94\">  let high = time.y + offsetHigh + select(0u, 1u, low &lt; time.x);\n</span><span class=\"lens-source-line\" data-line=\"95\">  let timeSign = time.y &gt;&gt; 31u;\n</span><span class=\"lens-source-line\" data-line=\"96\">  let sumSign = high &gt;&gt; 31u;\n</span><span class=\"lens-source-line\" data-line=\"97\">  if (timeSign == (offsetHigh &gt;&gt; 31u) &amp;&amp; sumSign != timeSign) {\n</span><span class=\"lens-source-line\" data-line=\"98\">    return invalid;\n</span><span class=\"lens-source-line\" data-line=\"99\">  }\n</span><span class=\"lens-source-line\" data-line=\"100\">  let isNegative = sumSign != 0u;\n</span><span class=\"lens-source-line\" data-line=\"101\">  var magnitude = vec2&lt;u32&gt;(low, high);\n</span><span class=\"lens-source-line\" data-line=\"102\">  if (isNegative) {\n</span><span class=\"lens-source-line\" data-line=\"103\">    let negatedLow = ~low + 1u;\n</span><span class=\"lens-source-line\" data-line=\"104\">    magnitude = vec2&lt;u32&gt;(negatedLow, ~high + select(0u, 1u, negatedLow == 0u));\n</span><span class=\"lens-source-line\" data-line=\"105\">  }\n</span><span class=\"lens-source-line\" data-line=\"106\">  let division = divideUnsigned64(magnitude, MILLISECONDS_PER_DAY);\n</span><span class=\"lens-source-line\" data-line=\"107\">  if (division.quotientHigh != 0u || division.quotientLow &gt; MAXIMUM_DAYS) {\n</span><span class=\"lens-source-line\" data-line=\"108\">    return invalid;\n</span><span class=\"lens-source-line\" data-line=\"109\">  }\n</span><span class=\"lens-source-line\" data-line=\"110\">  var days = i32(division.quotientLow);\n</span><span class=\"lens-source-line\" data-line=\"111\">  var millisecondsOfDay = division.remainder;\n</span><span class=\"lens-source-line\" data-line=\"112\">  if (isNegative) {\n</span><span class=\"lens-source-line\" data-line=\"113\">    // floor(-(q * D + r) / D) = -(q + 1) with D - r left over when r is not zero.\n</span><span class=\"lens-source-line\" data-line=\"114\">    if (millisecondsOfDay != 0u) {\n</span><span class=\"lens-source-line\" data-line=\"115\">      days = days + 1;\n</span><span class=\"lens-source-line\" data-line=\"116\">      millisecondsOfDay = MILLISECONDS_PER_DAY - millisecondsOfDay;\n</span><span class=\"lens-source-line\" data-line=\"117\">    }\n</span><span class=\"lens-source-line\" data-line=\"118\">    days = -days;\n</span><span class=\"lens-source-line\" data-line=\"119\">  }\n</span><span class=\"lens-source-line\" data-line=\"120\">  let date = civilFromDays(days);\n</span><span class=\"lens-source-line\" data-line=\"121\">  let isoWeekday = u32(((days + 3) % 7 + 7) % 7);\n</span><span class=\"lens-source-line\" data-line=\"122\">  let thursday = days - i32(isoWeekday) + 3;\n</span><span class=\"lens-source-line\" data-line=\"123\">  let thursdayDate = civilFromDays(thursday);\n</span><span class=\"lens-source-line\" data-line=\"124\">  var fields = invalid;\n</span><span class=\"lens-source-line\" data-line=\"125\">  fields.valid = true;\n</span><span class=\"lens-source-line\" data-line=\"126\">  fields.year = date.x;\n</span><span class=\"lens-source-line\" data-line=\"127\">  fields.month = u32(date.y);\n</span><span class=\"lens-source-line\" data-line=\"128\">  fields.day = u32(date.z);\n</span><span class=\"lens-source-line\" data-line=\"129\">  fields.hour = millisecondsOfDay / 3600000u;\n</span><span class=\"lens-source-line\" data-line=\"130\">  fields.minute = (millisecondsOfDay % 3600000u) / 60000u;\n</span><span class=\"lens-source-line\" data-line=\"131\">  fields.weekday = (isoWeekday + 7u - firstDay) % 7u;\n</span><span class=\"lens-source-line\" data-line=\"132\">  fields.dayOfYear = u32(getDayOfYear(date));\n</span><span class=\"lens-source-line\" data-line=\"133\">  fields.isoWeek = u32((getDayOfYear(thursdayDate) - 1) / 7 + 1);\n</span><span class=\"lens-source-line\" data-line=\"134\">  fields.isoWeekYear = thursdayDate.x;\n</span><span class=\"lens-source-line\" data-line=\"135\">  fields.quarter = u32((date.y - 1) / 3 + 1);\n</span><span class=\"lens-source-line\" data-line=\"136\">  return fields;\n</span><span class=\"lens-source-line\" data-line=\"137\">}\n</span><span class=\"lens-source-line\" data-line=\"138\">\n</span><span class=\"lens-source-line\" data-line=\"139\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"140\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"141\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"142\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"143\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"144\">) {\n</span><span class=\"lens-source-line\" data-line=\"145\">  _ = &amp;timestamps;\n</span><span class=\"lens-source-line\" data-line=\"146\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"147\">  _ = &amp;yearOut;\n</span><span class=\"lens-source-line\" data-line=\"148\">  _ = &amp;monthOut;\n</span><span class=\"lens-source-line\" data-line=\"149\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"150\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"151\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"152\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"153\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"154\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"155\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"156\">    return;\n</span><span class=\"lens-source-line\" data-line=\"157\">  }\n</span><span class=\"lens-source-line\" data-line=\"158\">  let time = vec2&lt;u32&gt;(timestamps[timestampsOffset + 2u * index], timestamps[timestampsOffset + 2u * index + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"159\">  let offsetMilliseconds = minutesToMilliseconds(params[paramsOffset]);\n</span><span class=\"lens-source-line\" data-line=\"160\">  let firstDay = u32(((params[paramsOffset + 1u] % 7) + 7) % 7);\n</span><span class=\"lens-source-line\" data-line=\"161\">  var fields = decodeCalendar(time, offsetMilliseconds, firstDay);\n</span><span class=\"lens-source-line\" data-line=\"162\">  \n</span><span class=\"lens-source-line\" data-line=\"163\">  yearOut[yearOutOffset + index] = fields.year;\n</span><span class=\"lens-source-line\" data-line=\"164\">  monthOut[monthOutOffset + index] = fields.month;\n</span><span class=\"lens-source-line\" data-line=\"165\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>timestamps<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata