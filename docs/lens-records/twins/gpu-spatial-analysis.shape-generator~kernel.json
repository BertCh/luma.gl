y=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const centersOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; centers: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const radiiOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; radii: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const parametersOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; parameters: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const positionsOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; positionsOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const FEATURE_COUNT: u32 = 107u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const MAXIMUM_SEGMENTS: u32 = 32u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const MINIMUM_SEGMENTS: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const MAXIMUM_VERTICES: u32 = 33u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const IS_SECTOR: bool = false;\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">fn getSegmentCount(rawSegments: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"20\">  return clamp(u32(max(rawSegments, 0.0)), MINIMUM_SEGMENTS, MAXIMUM_SEGMENTS);\n</span><span class=\"lens-source-line\" data-line=\"21\">}\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">fn getVertexCount(segments: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"24\">  return select(segments + 1u, segments + 3u, IS_SECTOR);\n</span><span class=\"lens-source-line\" data-line=\"25\">}\n</span><span class=\"lens-source-line\" data-line=\"26\">const EARTH_RADIUS: f32 = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"27\">const DEGREES: f32 = 0.017453292519943295;\n</span><span class=\"lens-source-line\" data-line=\"28\">const TWO_PI: f32 = 6.283185307179586;\n</span><span class=\"lens-source-line\" data-line=\"29\">const NOT_A_NUMBER: u32 = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"30\">\n</span><span class=\"lens-source-line\" data-line=\"31\">\n</span><span class=\"lens-source-line\" data-line=\"32\">\n</span><span class=\"lens-source-line\" data-line=\"33\">\n</span><span class=\"lens-source-line\" data-line=\"34\">fn isFiniteBits(x: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"35\">  return (bitcast&lt;u32&gt;(x) &amp; 0x7f800000u) != 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"36\">}\n</span><span class=\"lens-source-line\" data-line=\"37\">\n</span><span class=\"lens-source-line\" data-line=\"38\">\n</span><span class=\"lens-source-line\" data-line=\"39\">// Point at the given distance (world units, or meters for geodesic) and bearing (radians\n</span><span class=\"lens-source-line\" data-line=\"40\">// clockwise from north) from the center.\n</span><span class=\"lens-source-line\" data-line=\"41\">fn getDestination(center: vec2&lt;f32&gt;, distance: f32, bearing: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"42\">  return center + distance * vec2&lt;f32&gt;(sin(bearing), cos(bearing));\n</span><span class=\"lens-source-line\" data-line=\"43\">}\n</span><span class=\"lens-source-line\" data-line=\"44\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"45\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"46\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"47\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"48\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"49\">) {\n</span><span class=\"lens-source-line\" data-line=\"50\">  _ = &amp;centers;\n</span><span class=\"lens-source-line\" data-line=\"51\">  _ = &amp;radii;\n</span><span class=\"lens-source-line\" data-line=\"52\">  _ = &amp;parameters;\n</span><span class=\"lens-source-line\" data-line=\"53\">  _ = &amp;positionsOut;\n</span><span class=\"lens-source-line\" data-line=\"54\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"55\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"56\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"57\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"58\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"59\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"60\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"61\">    return;\n</span><span class=\"lens-source-line\" data-line=\"62\">  }\n</span><span class=\"lens-source-line\" data-line=\"63\">  let feature = index / MAXIMUM_VERTICES;\n</span><span class=\"lens-source-line\" data-line=\"64\">  let local = index % MAXIMUM_VERTICES;\n</span><span class=\"lens-source-line\" data-line=\"65\">  let segments = getSegmentCount(parameters[parametersOffset]);\n</span><span class=\"lens-source-line\" data-line=\"66\">  let vertices = getVertexCount(segments);\n</span><span class=\"lens-source-line\" data-line=\"67\">  if (local &gt;= vertices) {\n</span><span class=\"lens-source-line\" data-line=\"68\">    return;\n</span><span class=\"lens-source-line\" data-line=\"69\">  }\n</span><span class=\"lens-source-line\" data-line=\"70\">  let radiusScale = parameters[parametersOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"71\">  let center = vec2&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"72\">    centers[centersOffset + 2u * feature], centers[centersOffset + 2u * feature + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"73\">  var position = center;\n</span><span class=\"lens-source-line\" data-line=\"74\">  var radius = radii[radiiOffset + feature] * radiusScale;\n</span><span class=\"lens-source-line\" data-line=\"75\">  if (!isFiniteBits(radius) || radius &lt; 0.0) { radius = 0.0; }\n</span><span class=\"lens-source-line\" data-line=\"76\">  // Counter-clockwise ring, bearings 0, -360 / n, ...; the last vertex repeats the first.\n</span><span class=\"lens-source-line\" data-line=\"77\">  let ringStep = f32(local % segments) / f32(segments);\n</span><span class=\"lens-source-line\" data-line=\"78\">  position = getDestination(center, radius, -ringStep * TWO_PI);\n</span><span class=\"lens-source-line\" data-line=\"79\">  if (!isFiniteBits(center.x) || !isFiniteBits(center.y)) {\n</span><span class=\"lens-source-line\" data-line=\"80\">    position = vec2&lt;f32&gt;(bitcast&lt;f32&gt;(NOT_A_NUMBER | (feature &amp; 0u)));\n</span><span class=\"lens-source-line\" data-line=\"81\">  }\n</span><span class=\"lens-source-line\" data-line=\"82\">  let base = positionsOutOffset + 2u * (feature * vertices + local);\n</span><span class=\"lens-source-line\" data-line=\"83\">  positionsOut[base] = position.x;\n</span><span class=\"lens-source-line\" data-line=\"84\">  positionsOut[base + 1u] = position.y;\n</span><span class=\"lens-source-line\" data-line=\"85\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>centers<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"centers\">centers</td><td>read</td><td>f32</td></tr><tr><td>radii<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"radii\">radii</td><td>read</td><td>f32</td></tr><tr><td>parameters<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"parameters\">parameters</td><td>read</td><td>f32</td></tr><tr><td>positionsOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"circleVertices\">circleVertices</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUShapeGenerator/circle-planar · main · 61988759</figc