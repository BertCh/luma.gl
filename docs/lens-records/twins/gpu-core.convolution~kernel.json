ernUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">const ELEMENT_COUNT: u32 = 4096u;\n</span><span class=\"lens-source-line\" data-line=\"2\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"3\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"4\">const KERNEL_WIDTH: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"5\">const KERNEL_HEIGHT: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"6\">const KERNEL_CENTER_X: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"7\">const KERNEL_CENTER_Y: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"8\">const INPUT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"9\">const KERNEL_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"10\">const OUTPUT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"11\">@group(0) @binding(0) var&lt;storage, read&gt; inputValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(1) var&lt;storage, read&gt; kernelValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"13\">@group(0) @binding(2) var&lt;storage, read_write&gt; outputValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line lens-source-line--workgroup-size lens-source-line--entry-point\" data-line=\"14\">@compute @workgroup_size(256) fn main(\n</span><span class=\"lens-source-line\" data-line=\"15\">  @builtin(workgroup_id) workgroupId: vec3u,\n</span><span class=\"lens-source-line\" data-line=\"16\">  @builtin(local_invocation_index) localInvocationIndex: u32\n</span><span class=\"lens-source-line\" data-line=\"17\">) {\n</span><span class=\"lens-source-line\" data-line=\"18\">  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 16u + workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"19\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"20\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"21\">  if (index &gt;= ELEMENT_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"22\">    return;\n</span><span class=\"lens-source-line\" data-line=\"23\">  }\n</span><span class=\"lens-source-line\" data-line=\"24\">  let outputIndex = 0u + index;\n</span><span class=\"lens-source-line\" data-line=\"25\">  let outputY = outputIndex / WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"26\">  let outputX = outputIndex - outputY * WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"27\">  var total = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"28\">  for (var kernelLocalIndex = 0u; kernelLocalIndex &lt; 9u; kernelLocalIndex++) {\n</span><span class=\"lens-source-line\" data-line=\"29\">    let kernelIndex = 0u + kernelLocalIndex;\n</span><span class=\"lens-source-line\" data-line=\"30\">    let kernelY = kernelIndex / KERNEL_WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"31\">    let kernelX = kernelIndex % KERNEL_WIDTH;\n</span><span class=\"lens-source-line\" data-line=\"32\">    let sourceY = i32(outputY) - (i32(kernelY) - i32(KERNEL_CENTER_Y));\n</span><span class=\"lens-source-line\" data-line=\"33\">    let sourceX = i32(outputX) - (i32(kernelX) - i32(KERNEL_CENTER_X));\n</span><span class=\"lens-source-line\" data-line=\"34\">    let kernelValue = kernelValues[KERNEL_OFFSET + kernelLocalIndex];\n</span><span class=\"lens-source-line\" data-line=\"35\">    if (sourceX &lt; 0 || sourceX &gt;= i32(WIDTH) || sourceY &lt; 0 || sourceY &gt;= i32(HEIGHT)) {\n</span><span class=\"lens-source-line\" data-line=\"36\">      continue;\n</span><span class=\"lens-source-line\" data-line=\"37\">    }\n</span><span class=\"lens-source-line\" data-line=\"38\">    let sourceIndex = u32(sourceY) * WIDTH + u32(sourceX);\n</span><span class=\"lens-source-line\" data-line=\"39\">    if (sourceIndex &gt;= 0u &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"40\">        sourceIndex - 0u &lt; 4096u) {\n</span><span class=\"lens-source-line\" data-line=\"41\">      total += inputValues[INPUT_OFFSET + sourceIndex - 0u] * kernelValue;\n</span><span class=\"lens-source-line\" data-line=\"42\">    }\n</span><span class=\"lens-source-line\" data-line=\"43\">  }\n</span><span class=\"lens-source-line\" data-line=\"44\">  outputValues[OUTPUT_OFFSET + index] = total;\n</span><span class=\"lens-source-line\" data-line=\"45\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>inputValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"elevation\">elevation</td><td>read</td><td>f32</td></tr><tr><td>kernelValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"laplacian\">laplacian</td><td>read</td><td>f32</td></tr><tr><td>outputValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"curvature\">curvature</td><td>write</td><td>f32</td></tr></tbody></table><figcaption>GPUConvolution/direct · main · d2834a17</figcaption></figure></section>",
