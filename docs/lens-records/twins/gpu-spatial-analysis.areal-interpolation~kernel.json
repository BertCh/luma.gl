ne\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const zonesOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read_write&gt; zonesOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const primaryOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; primary: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const secondaryOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; secondary: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const CELL_COUNT: u32 = 13482u;\n</span><span class=\"lens-source-line\" data-line=\"12\">const CAPACITY: u32 = 5276u;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"14\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"15\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"16\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"17\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"18\">) {\n</span><span class=\"lens-source-line\" data-line=\"19\">  _ = &amp;zonesOut;\n</span><span class=\"lens-source-line\" data-line=\"20\">  _ = &amp;primary;\n</span><span class=\"lens-source-line\" data-line=\"21\">  _ = &amp;secondary;\n</span><span class=\"lens-source-line\" data-line=\"22\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"23\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"24\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"25\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"26\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"27\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"28\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"29\">    return;\n</span><span class=\"lens-source-line\" data-line=\"30\">  }\n</span><span class=\"lens-source-line\" data-line=\"31\">  if (index &lt; CELL_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"32\">    zonesOut[zonesOutOffset + index] = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"33\">    \n</span><span class=\"lens-source-line\" data-line=\"34\">  }\n</span><span class=\"lens-source-line\" data-line=\"35\">  if (index &lt; CAPACITY) {\n</span><span class=\"lens-source-line\" data-line=\"36\">    primary[primaryOffset + index] = 3260416u;\n</span><span class=\"lens-source-line\" data-line=\"37\">    secondary[secondaryOffset + index] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"38\">  }\n</span><span class=\"lens-source-line\" data-line=\"39\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>zonesOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tractZones\">tractZones</td><td>read_write</td><td>u32</td></tr><tr><td>primary<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tract-zones-primary\">tract-zones-primary</td><td>read_write</td><td>u32</td></tr><tr><td>secondary<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tract-zones-secondary\">tract-zones-secondary</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUPolygonRasterization/reset · main · 1facd093</figcaption></figure></section>",
