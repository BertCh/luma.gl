  "figure": {
    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>isolines-count · 16×1×1 workgroups × 256×1×1 lanes = 4096 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-raster-isolines-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect><rect x=\"21\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"1\"></rect><rect x=\"41\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"2\"></rect><rect x=\"61\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"3\"></rect><rect x=\"81\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"4\"></rect><rect x=\"101\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"5\"></rect><rect x=\"121\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"6\"></rect><rect x=\"141\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"7\"></rect><rect x=\"161\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"8\"></rect><rect x=\"181\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"9\"></rect><rect x=\"201\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"10\"></rect><rect x=\"221\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"11\"></rect><rect x=\"241\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"12\"></rect><rect x=\"261\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"13\"></rect><rect x=\"281\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"14\"></rect><rect x=\"301\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"15\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-raster-isolines-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const levelsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; levels: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const rasterOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; raster: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const countsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; counts: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const MAXIMUM_LEVELS: u32 = 7u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const CAPACITY: u32 = 1300u;\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"20\">\n</span><span class=\"lens-source-line\" data-line=\"21\">fn readCell(cell: u32, value: ptr&lt;function, f32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"22\">  let sample = raster[rasterOffset + cell];\n</span><span class=\"lens-source-line\" data-line=\"23\">  *value = sample;\n</span><span class=\"lens-source-line\" data-line=\"24\">  // Compare bits: NaN and infinities are nodata, since a crossing cannot interpolate them.\n</span><span class=\"lens-source-line\" data-line=\"25\">  var isValid = isFiniteValue(sample);\n</span><span class=\"lens-source-line\" data-line=\"26\">  \n</span><span class=\"lens-source-line\" data-line=\"27\">  \n</span><span class=\"lens-source-line\" data-line=\"28\">  return isValid;\n</span><span class=\"lens-source-line\" data-line=\"29\">}\n</span><span class=\"lens-source-line\" data-line=\"30\">\n</span><span class=\"lens-source-line\" data-line=\"31\">struct Corners {\n</span><span class=\"lens-source-line\" data-line=\"32\">  valid: bool,\n</span><span class=\"lens-source-line\" data-line=\"33\">  v: vec4&lt;f32&gt;\n</span><span class=\"lens-source-line\" data-line=\"34\">}\n</span><span class=\"lens-source-line\" data-line=\"35\">\n</span><span class=\"lens-source-line\" data-line=\"36\">fn loadCorners(cx: u32, cy: u32) -&gt; Corners {\n</span><span class=\"lens-source-line\" data-line=\"37\">  var v0 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"38\">  var v1 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"39\">  var v2 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"40\">  var v3 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"41\">  let ok0 = readCell(cy * WIDTH + cx, &amp;v0);\n</span><span class=\"lens-source-line\" data-line=\"42\">  let ok1 = readCell(cy * WIDTH + cx + 1u, &amp;v1);\n</span><span class=\"lens-source-line\" data-line=\"43\">  let ok2 = readCell((cy + 1u) * WIDTH + cx + 1u, &amp;v2);\n</span><span class=\"lens-source-line\" data-line=\"44\">  let ok3 = readCell((cy + 1u) * WIDTH + cx, &amp;v3);\n</span><span class=\"lens-source-line\" data-line=\"45\">  var corners: Corners;\n</span><span class=\"lens-source-line\" data-line=\"46\">  corners.valid = ok0 &amp;&amp; ok1 &amp;&amp; ok2 &amp;&amp; ok3;\n</span><span class=\"lens-source-line\" data-line=\"47\">  corners.v = vec4&lt;f32&gt;(v0, v1, v2, v3);\n</span><span class=\"lens-source-line\" data-line=\"48\">  return corners;\n</span><span class=\"lens-source-line\" data-line=\"49\">}\n</span><span class=\"lens-source-line\" data-line=\"50\">\n</span><span class=\"lens-source-line\" data-line=\"51\">// Bit i is set when corner i (v0..v3) is high, i.e. value &gt;= level.\n</span><span class=\"lens-source-line\" data-line=\"52\">fn getHighMask(v: vec4&lt;f32&gt;, level: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"53\">  return select(0u, 1u, v.x &gt;= level) | select(0u, 2u, v.y &gt;= level) |\n</span><span class=\"lens-source-line\" data-line=\"54\">    select(0u, 4u, v.z &gt;= level) | select(0u, 8u, v.w &gt;= level);\n</span><span class=\"lens-source-line\" data-line=\"55\">}\n</span><span class=\"lens-source-line\" data-line=\"56\">\n</span><span class=\"lens-source-line\" data-line=\"57\">// Counter-clockwise boundary walk v0 -&gt; v1 -&gt; v2 -&gt; v3 -&gt; v0: edge k runs from corner k to corner\n</span><span class=\"lens-source-line\" data-line=\"58\">// (k + 1) % 4, i.e. edges e0 bottom, e1 right, e2 top, e3 left. An exit is high -&gt; low (the\n</span><span class=\"lens-source-line\" data-line=\"59\">// segment starts there, keeping high on its left); an entry is low -&gt; high (the segment ends).\n</span><span class=\"lens-source-line\" data-line=\"60\">fn getRotatedMask(mask: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"61\">  return ((mask &gt;&gt; 1u) | (mask &lt;&lt; 3u)) &amp; 15u;\n</span><span class=\"lens-source-line\" data-line=\"62\">}\n</span><span class=\"lens-source-line\" data-line=\"63\">fn getExitMask(mask: u32) -&gt; u32 { return mask &amp; ~getRotatedMask(mask) &amp; 15u; }\n</span><span class=\"lens-source-line\" data-line=\"64\">fn getEntryMask(mask: u32) -&gt; u32 { return ~mask &amp; getRotatedMask(mask) &amp; 15u; }\n</span><span class=\"lens-source-line\" data-line=\"65\">\n</span><span class=\"lens-source-line\" data-line=\"66\">fn getEdgeId(k: u32, cx: u32, cy: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"67\">  let horizontalCount = HEIGHT * (WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"68\">  if (k == 0u) { return cy * (WIDTH - 1u) + cx; }\n</span><span class=\"lens-source-line\" data-line=\"69\">  if (k == 2u) { return (cy + 1u) * (WIDTH - 1u) + cx; }\n</span><span class=\"lens-source-line\" data-line=\"70\">  if (k == 3u) { return horizontalCount + cy * WIDTH + cx; }\n</span><span class=\"lens-source-line\" data-line=\"71\">  return horizontalCount + cy * WIDTH + cx + 1u;\n</span><span class=\"lens-source-line\" data-line=\"72\">}\n</span><span class=\"lens-source-line\" data-line=\"73\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"74\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"75\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"76\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"77\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"78\">) {\n</span><span class=\"lens-source-line\" data-line=\"79\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"80\">  _ = &amp;levels;\n</span><span class=\"lens-source-line\" data-line=\"81\">  _ = &amp;raster;\n</span><span class=\"lens-source-line\" data-line=\"82\">  _ = &amp;counts;\n</span><span class=\"lens-source-line\" data-line=\"83\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"84\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"85\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"86\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"87\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"88\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"89\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"90\">    return;\n</span><span class=\"lens-source-line\" data-line=\"91\">  }\n</span><span class=\"lens-source-line\" data-line=\"92\">  let cx = index % (WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"93\">  let cy = index / (WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"94\">  let corners = loadCorners(cx, cy);\n</span><span class=\"lens-source-line\" data-line=\"95\">  var cellTotal = 0u;\n</span><span class=\"lens-source-line\" data-line=\"96\">  if (corners.valid) {\n</span><span class=\"lens-source-line\" data-line=\"97\">    let levelCount = min(u32(max(params[paramsOffset], 0.0)), MAXIMUM_LEVELS);\n</span><span class=\"lens-source-line\" data-line=\"98\">    for (var levelIndex = 0u; levelIndex &lt; levelCount; levelIndex++) {\n</span><span class=\"lens-source-line\" data-line=\"99\">      let mask = getHighMask(corners.v, levels[levelsOffset + levelIndex]);\n</span><span class=\"lens-source-line\" data-line=\"100\">      cellTotal += countOneBits(getExitMask(mask));\n</span><span class=\"lens-source-line\" data-line=\"101\">    }\n</span><span class=\"lens-source-line\" data-line=\"102\">  }\n</span><span class=\"lens-source-line\" data-line=\"103\">  counts[countsOffset + index] = cellTotal;\n</span><span class=\"lens-source-line\" data-line=\"104\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"isolines-parameters\">isolines-parameters</td><td>read</td><td>f32</td></tr><tr><td>levels<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"isolinesLevels\">isolinesLevels</td><td>read</td><td>f32</td></tr><tr><td>raster<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"isolinesElevation\">isolinesElevation</td><td>read</td><td>f32</td></tr><tr><td>counts<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"isolines-cell-counts\">isolines-cell-counts</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUIsolines/count · main · 96add652</figcaption></figure></section>",
