hed\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const stackOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; stack: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const remapBreaksOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; remapBreaks: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const remapValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; remapValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const scoreOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; scoreOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const LAYER_COUNT: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const CELL_COUNT: u32 = 4096u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const MAXIMUM_BREAK_COUNT: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"23\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"24\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"25\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"26\">}\n</span><span class=\"lens-source-line\" data-line=\"27\">\n</span><span class=\"lens-source-line\" data-line=\"28\">fn isNaNValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"31\">\n</span><span class=\"lens-source-line\" data-line=\"32\">fn isNoDataValue(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"33\">  return isNaNValue(value);\n</span><span class=\"lens-source-line\" data-line=\"34\">}\n</span><span class=\"lens-source-line\" data-line=\"35\">\n</span><span class=\"lens-source-line\" data-line=\"36\">fn countBreaksBelow(first: u32, count: u32, value: f32, closedRight: bool) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"37\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"38\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"39\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"40\">    if (low &gt;= high) {\n</span><span class=\"lens-source-line\" data-line=\"41\">      break;\n</span><span class=\"lens-source-line\" data-line=\"42\">    }\n</span><span class=\"lens-source-line\" data-line=\"43\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"44\">    let boundary = remapBreaks[remapBreaksOffset + first + middle];\n</span><span class=\"lens-source-line\" data-line=\"45\">    let isBelow = select(boundary &lt;= value, boundary &lt; value, closedRight);\n</span><span class=\"lens-source-line\" data-line=\"46\">    if (isBelow) {\n</span><span class=\"lens-source-line\" data-line=\"47\">      low = middle + 1u;\n</span><span class=\"lens-source-line\" data-line=\"48\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"49\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"50\">    }\n</span><span class=\"lens-source-line\" data-line=\"51\">  }\n</span><span class=\"lens-source-line\" data-line=\"52\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"53\">}\n</span><span class=\"lens-source-line\" data-line=\"54\">\n</span><span class=\"lens-source-line\" data-line=\"55\">fn getOrderedKey(x: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"56\">  let bits = bitcast&lt;u32&gt;(x);\n</span><span class=\"lens-source-line\" data-line=\"57\">  return select(bits ^ 0x80000000u, ~bits, (bits &amp; 0x80000000u) != 0u);\n</span><span class=\"lens-source-line\" data-line=\"58\">}\n</span><span class=\"lens-source-line\" data-line=\"59\">\n</span><span class=\"lens-source-line\" data-line=\"60\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"61\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"62\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"63\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"64\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"65\">) {\n</span><span class=\"lens-source-line\" data-line=\"66\">  _ = &amp;stack;\n</span><span class=\"lens-source-line\" data-line=\"67\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"68\">  _ = &amp;remapBreaks;\n</span><span class=\"lens-source-line\" data-line=\"69\">  _ = &amp;remapValues;\n</span><span class=\"lens-source-line\" data-line=\"70\">  _ = &amp;scoreOut;\n</span><span class=\"lens-source-line\" data-line=\"71\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"72\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"73\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"74\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"75\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"76\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"77\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"78\">    return;\n</span><span class=\"lens-source-line\" data-line=\"79\">  }\n</span><span class=\"lens-source-line\" data-line=\"80\">  \n</span><span class=\"lens-source-line\" data-line=\"81\">  let normalizeWeights = params[paramsOffset] != 0.0;\n</span><span class=\"lens-source-line\" data-line=\"82\">  let ignoreNoData = params[paramsOffset + 1u] != 0.0;\n</span><span class=\"lens-source-line\" data-line=\"83\">  var sum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"84\">  var weightSum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"85\">  var usedCount = 0u;\n</span><span class=\"lens-source-line\" data-line=\"86\">  var isDefined = true;\n</span><span class=\"lens-source-line\" data-line=\"87\">  for (var layer = 0u; layer &lt; LAYER_COUNT; layer++) {\n</span><span class=\"lens-source-line\" data-line=\"88\">    let base = paramsOffset + 8u + layer * 8u;\n</span><span class=\"lens-source-line\" data-line=\"89\">    let weight = params[base];\n</span><span class=\"lens-source-line\" data-line=\"90\">    let value = stack[stackOffset + layer * CELL_COUNT + index];\n</span><span class=\"lens-source-line\" data-line=\"91\">    if (isNoDataValue(value)) {\n</span><span class=\"lens-source-line\" data-line=\"92\">      if (!ignoreNoData) {\n</span><span class=\"lens-source-line\" data-line=\"93\">        isDefined = false;\n</span><span class=\"lens-source-line\" data-line=\"94\">      }\n</span><span class=\"lens-source-line\" data-line=\"95\">      continue;\n</span><span class=\"lens-source-line\" data-line=\"96\">    }\n</span><span class=\"lens-source-line\" data-line=\"97\">    var remapped = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"98\">    if (params[base + 1u] == 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"99\">      let inputMinimum = params[base + 2u];\n</span><span class=\"lens-source-line\" data-line=\"100\">      if (params[base + 7u] != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"101\">        remapped = select(0.0, 1.0, value &gt;= inputMinimum);\n</span><span class=\"lens-source-line\" data-line=\"102\">      } else {\n</span><span class=\"lens-source-line\" data-line=\"103\">        remapped = clamp((value - inputMinimum) * params[base + 3u], 0.0, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"104\">      }\n</span><span class=\"lens-source-line\" data-line=\"105\">      if (params[base + 4u] != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"106\">        remapped = 1.0 - remapped;\n</span><span class=\"lens-source-line\" data-line=\"107\">      }\n</span><span class=\"lens-source-line\" data-line=\"108\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"109\">      let breakCountValue = params[base + 5u];\n</span><span class=\"lens-source-line\" data-line=\"110\">      let breakCount = min(u32(clamp(select(0.0, breakCountValue, isFiniteValue(breakCountValue)), 0.0, 4294967040.0)), MAXIMUM_BREAK_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"111\">      let classIndex = countBreaksBelow(layer * MAXIMUM_BREAK_COUNT, breakCount, value, params[base + 6u] != 0.0);\n</span><span class=\"lens-source-line\" data-line=\"112\">      remapped = remapValues[remapValuesOffset + layer * (MAXIMUM_BREAK_COUNT + 1u) + classIndex];\n</span><span class=\"lens-source-line\" data-line=\"113\">    }\n</span><span class=\"lens-source-line\" data-line=\"114\">    if (isNaNValue(remapped)) {\n</span><span class=\"lens-source-line\" data-line=\"115\">      // Restricted class: the cell is excluded whatever the nodata policy.\n</span><span class=\"lens-source-line\" data-line=\"116\">      isDefined = false;\n</span><span class=\"lens-source-line\" data-line=\"117\">    }\n</span><span class=\"lens-source-line\" data-line=\"118\">    sum = sum + weight * remapped;\n</span><span class=\"lens-source-line\" data-line=\"119\">    weightSum = weightSum + abs(weight);\n</span><span class=\"lens-source-line\" data-line=\"120\">    usedCount = usedCount + 1u;\n</span><span class=\"lens-source-line\" data-line=\"121\">  }\n</span><span class=\"lens-source-line\" data-line=\"122\">  isDefined = isDefined &amp;&amp; usedCount &gt; 0u;\n</span><span class=\"lens-source-line\" data-line=\"123\">  var score = sum;\n</span><span class=\"lens-source-line\" data-line=\"124\">  if (normalizeWeights) {\n</span><span class=\"lens-source-line\" data-line=\"125\">    isDefined = isDefined &amp;&amp; weightSum &gt; 0.0;\n</span><span class=\"lens-source-line\" data-line=\"126\">    score = sum / weightSum;\n</span><span class=\"lens-source-line\" data-line=\"127\">  }\n</span><span class=\"lens-source-line\" data-line=\"128\">  score = select(getNaN(), score, isDefined &amp;&amp; !isNaNValue(score));\n</span><span class=\"lens-source-line\" data-line=\"129\">  let isScoreDefined = !isNaNValue(score);\n</span><span class=\"lens-source-line\" data-line=\"130\">  scoreOut[scoreOutOffset + index] = score;\n</span><span class=\"lens-source-line\" data-line=\"131\">  \n</span><span class=\"lens-source-line\" data-line=\"132\">  \n</span><span class=\"lens-source-line\" data-line=\"133\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>stack<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"landscapeStack\">landscapeStack</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"overlay-parameters\">overlay-parameters</td><td>read</td><td>f32</td></tr><tr><td>remapBreaks<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"overlayBreaks\">overlayBreaks</td><td>read</td><td>f32</td></tr><tr><td>remapValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"overlayValues\">overlayValues</td><td>read</td><td>f32</td></tr><tr><td>scoreOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"suitabilityScore\">suitabilityScore</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUWeightedOverlay/score · main · 063a9d4a</figcaption></figure></section>",
