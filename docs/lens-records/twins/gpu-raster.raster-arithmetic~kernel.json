s-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const aValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; aValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const bValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; bValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const valuesOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; valuesOut: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"17\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"18\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"19\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"20\">}\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">fn isNaNValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">fn isNoDataValue(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"27\">  return isNaNValue(value) || value == 0.0;\n</span><span class=\"lens-source-line\" data-line=\"28\">}\n</span><span class=\"lens-source-line\" data-line=\"29\">fn getPower(base: f32, exponent: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"30\">  if (base &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"31\">    return pow(base, exponent);\n</span><span class=\"lens-source-line\" data-line=\"32\">  }\n</span><span class=\"lens-source-line\" data-line=\"33\">  if (base == 0.0 &amp;&amp; exponent &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"34\">    return 0.0;\n</span><span class=\"lens-source-line\" data-line=\"35\">  }\n</span><span class=\"lens-source-line\" data-line=\"36\">  return getNaN();\n</span><span class=\"lens-source-line\" data-line=\"37\">}\n</span><span class=\"lens-source-line\" data-line=\"38\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"39\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"40\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"41\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"42\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"43\">) {\n</span><span class=\"lens-source-line\" data-line=\"44\">  _ = &amp;aValues;\n</span><span class=\"lens-source-line\" data-line=\"45\">  _ = &amp;bValues;\n</span><span class=\"lens-source-line\" data-line=\"46\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"47\">  _ = &amp;valuesOut;\n</span><span class=\"lens-source-line\" data-line=\"48\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"49\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"50\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"51\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"52\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"53\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"54\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"55\">    return;\n</span><span class=\"lens-source-line\" data-line=\"56\">  }\n</span><span class=\"lens-source-line\" data-line=\"57\">  let operation = u32(params[paramsOffset]);\n</span><span class=\"lens-source-line\" data-line=\"58\">  let aRaw = aValues[aValuesOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"59\">  let bRaw = bValues[bValuesOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"60\">  let isUnary = operation &gt;= 16u;\n</span><span class=\"lens-source-line\" data-line=\"61\">  let isDefined = !isNoDataValue(aRaw) &amp;&amp; (isUnary || !isNoDataValue(bRaw));\n</span><span class=\"lens-source-line\" data-line=\"62\">  let a = aRaw * params[paramsOffset + 1u] + params[paramsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"63\">  let b = bRaw * params[paramsOffset + 3u] + params[paramsOffset + 4u];\n</span><span class=\"lens-source-line\" data-line=\"64\">  let nan = getNaN();\n</span><span class=\"lens-source-line\" data-line=\"65\">  var result = nan;\n</span><span class=\"lens-source-line\" data-line=\"66\">  switch operation {\n</span><span class=\"lens-source-line\" data-line=\"67\">    case 0u: { result = a + b; }\n</span><span class=\"lens-source-line\" data-line=\"68\">    case 1u: { result = a - b; }\n</span><span class=\"lens-source-line\" data-line=\"69\">    case 2u: { result = a * b; }\n</span><span class=\"lens-source-line\" data-line=\"70\">    case 3u: { result = select(a / b, nan, b == 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"71\">    case 4u: { result = min(a, b); }\n</span><span class=\"lens-source-line\" data-line=\"72\">    case 5u: { result = max(a, b); }\n</span><span class=\"lens-source-line\" data-line=\"73\">    case 6u: { result = getPower(a, b); }\n</span><span class=\"lens-source-line\" data-line=\"74\">    case 7u: { result = abs(a - b); }\n</span><span class=\"lens-source-line\" data-line=\"75\">    case 8u: {\n</span><span class=\"lens-source-line\" data-line=\"76\">      let total = a + b;\n</span><span class=\"lens-source-line\" data-line=\"77\">      result = select((a - b) / total, nan, total == 0.0);\n</span><span class=\"lens-source-line\" data-line=\"78\">    }\n</span><span class=\"lens-source-line\" data-line=\"79\">    case 16u: { result = abs(a); }\n</span><span class=\"lens-source-line\" data-line=\"80\">    case 17u: { result = select(sqrt(a), nan, a &lt; 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"81\">    case 18u: { result = select(log(a), nan, a &lt;= 0.0); }\n</span><span class=\"lens-source-line\" data-line=\"82\">    case 19u: { result = exp(a); }\n</span><span class=\"lens-source-line\" data-line=\"83\">    case 20u: { result = floor(a); }\n</span><span class=\"lens-source-line\" data-line=\"84\">    case 21u: { result = ceil(a); }\n</span><span class=\"lens-source-line\" data-line=\"85\">    case 22u: { result = round(a); }\n</span><span class=\"lens-source-line\" data-line=\"86\">    default: { result = nan; }\n</span><span class=\"lens-source-line\" data-line=\"87\">  }\n</span><span class=\"lens-source-line\" data-line=\"88\">  if (isDefined &amp;&amp; !isNaNValue(result)) {\n</span><span class=\"lens-source-line\" data-line=\"89\">    result = min(max(result, params[paramsOffset + 6u]), params[paramsOffset + 7u]);\n</span><span class=\"lens-source-line\" data-line=\"90\">  } else {\n</span><span class=\"lens-source-line\" data-line=\"91\">    result = nan;\n</span><span class=\"lens-source-line\" data-line=\"92\">  }\n</span><span class=\"lens-source-line\" data-line=\"93\">  valuesOut[valuesOutOffset + index] = result;\n</span><span class=\"lens-source-line\" data-line=\"94\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>aValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"nirAfter\">nirAfter</td><td>read</td><td>f32</td></tr><tr><td>bValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"nirBefore\">nirBefore</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"arithmetic-parameters\">arithmetic-parameters</td><td>read</td><td>f32</td></tr><tr><td>valuesOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"nirDifference\">nirDifference</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPURasterArithmetic/evaluate · main · e1703670</figcaption></figure></section>",
