ance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"7\"></rect><rect x=\"161\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"8\"></rect><rect x=\"181\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"9\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-k-means-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const validFlagsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; validFlags: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const rowIdsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; rowIds: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const xsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; xs: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const ysOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; ys: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const seedCursorOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; seedCursor: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const K: u32 = 6u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const NOISE: u32 = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">// Mirrors getKMeansRestartSeed: restart 0 uses the seed itself, later restarts a murmur3 mix.\n</span><span class=\"lens-source-line\" data-line=\"21\">// The seed is the per-frame parameters word 0, so the source is the same for every seed.\n</span><span class=\"lens-source-line\" data-line=\"22\">fn getRestartSeed(seed: u32, restart: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"23\">  if (restart == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"24\">    return seed;\n</span><span class=\"lens-source-line\" data-line=\"25\">  }\n</span><span class=\"lens-source-line\" data-line=\"26\">  var hash = seed + restart * 0x9e3779b9u;\n</span><span class=\"lens-source-line\" data-line=\"27\">  hash = hash ^ (hash &gt;&gt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"28\">  hash = hash * 0x85ebca6bu;\n</span><span class=\"lens-source-line\" data-line=\"29\">  hash = hash ^ (hash &gt;&gt; 13u);\n</span><span class=\"lens-source-line\" data-line=\"30\">  hash = hash * 0xc2b2ae35u;\n</span><span class=\"lens-source-line\" data-line=\"31\">  return hash ^ (hash &gt;&gt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"32\">}\n</span><span class=\"lens-source-line\" data-line=\"33\">\n</span><span class=\"lens-source-line\" data-line=\"34\">\n</span><span class=\"lens-source-line\" data-line=\"35\">fn isFiniteFloat(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"36\">\n</span><span class=\"lens-source-line\" data-line=\"37\">\n</span><span class=\"lens-source-line\" data-line=\"38\">fn isNanBits(x: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"39\">  return (bitcast&lt;u32&gt;(x) &amp; 0x7fffffffu) &gt; 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"40\">}\n</span><span class=\"lens-source-line\" data-line=\"41\">\n</span><span class=\"lens-source-line\" data-line=\"42\">\n</span><span class=\"lens-source-line\" data-line=\"43\">\n</span><span class=\"lens-source-line\" data-line=\"44\">fn getQuietNaN(seed: u32) -&gt; f32 { return bitcast&lt;f32&gt;(0x7fc00000u | (seed &amp; 0u)); }\n</span><span class=\"lens-source-line\" data-line=\"45\">\n</span><span class=\"lens-source-line\" data-line=\"46\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"47\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"48\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"49\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"50\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"51\">) {\n</span><span class=\"lens-source-line\" data-line=\"52\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"53\">  _ = &amp;validFlags;\n</span><span class=\"lens-source-line\" data-line=\"54\">  _ = &amp;rowIds;\n</span><span class=\"lens-source-line\" data-line=\"55\">  _ = &amp;xs;\n</span><span class=\"lens-source-line\" data-line=\"56\">  _ = &amp;ys;\n</span><span class=\"lens-source-line\" data-line=\"57\">  _ = &amp;seedCursor;\n</span><span class=\"lens-source-line\" data-line=\"58\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"59\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"60\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"61\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"62\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"63\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"64\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"65\">    return;\n</span><span class=\"lens-source-line\" data-line=\"66\">  }\n</span><span class=\"lens-source-line\" data-line=\"67\">  if (index == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"68\">    seedCursor[seedCursorOffset] = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"69\">  }\n</span><span class=\"lens-source-line\" data-line=\"70\">  let x = positions[positionsOffset + index * 2u];\n</span><span class=\"lens-source-line\" data-line=\"71\">  let y = positions[positionsOffset + index * 2u + 1u];\n</span><span class=\"lens-source-line\" data-line=\"72\">  let valid = isFiniteFloat(x) &amp;&amp; isFiniteFloat(y);\n</span><span class=\"lens-source-line\" data-line=\"73\">  validFlags[validFlagsOffset + index] = select(0u, 1u, valid);\n</span><span class=\"lens-source-line\" data-line=\"74\">  rowIds[rowIdsOffset + index] = index;\n</span><span class=\"lens-source-line\" data-line=\"75\">  xs[xsOffset + index] = select(0.0, x, valid);\n</span><span class=\"lens-source-line\" data-line=\"76\">  ys[ysOffset + index] = select(0.0, y, valid);\n</span><span class=\"lens-source-line\" data-line=\"77\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"observations\">observations</td><td>read</td><td>f32</td></tr><tr><td>validFlags<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kmeans-valid-flags\">kmeans-valid-flags</td><td>read_write</td><td>u32</td></tr><tr><td>rowIds<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kmeans-row-ids\">kmeans-row-ids</td><td>read_write</td><td>u32</td></tr><tr><td>xs<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kmeans-xs\">kmeans-xs</td><td>read_write</td><td>f32</td></tr><tr><td>ys<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kmeans-ys\">kmeans-ys</td><td>read_write</td><td>f32</td></tr><tr><td>seedCursor<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kmeans-seed-cursor\">kmeans-seed-cursor</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUKMeans/prepare · main · b8ddb983</figcaption></figure></section>",
