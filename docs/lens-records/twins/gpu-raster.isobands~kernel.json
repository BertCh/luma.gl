ns-source-line\" data-line=\"179\">      return other;\n</span><span class=\"lens-source-line\" data-line=\"180\">    }\n</span><span class=\"lens-source-line\" data-line=\"181\">  }\n</span><span class=\"lens-source-line\" data-line=\"182\">  return edge;\n</span><span class=\"lens-source-line\" data-line=\"183\">}\n</span><span class=\"lens-source-line\" data-line=\"184\">\n</span><span class=\"lens-source-line\" data-line=\"185\">fn findCrossingEvent(level: u32, edge: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"186\">  for (var i = 0u; i &lt; cellEventCount; i++) {\n</span><span class=\"lens-source-line\" data-line=\"187\">    let cellEvent = cellEvents[i];\n</span><span class=\"lens-source-line\" data-line=\"188\">    if ((cellEvent &amp; 3u) != 0u &amp;&amp; ((cellEvent &gt;&gt; 2u) &amp; 1u) == level &amp;&amp; ((cellEvent &gt;&gt; 3u) &amp; 7u) == edge) {\n</span><span class=\"lens-source-line\" data-line=\"189\">      return i;\n</span><span class=\"lens-source-line\" data-line=\"190\">    }\n</span><span class=\"lens-source-line\" data-line=\"191\">  }\n</span><span class=\"lens-source-line\" data-line=\"192\">  return NO_EVENT;\n</span><span class=\"lens-source-line\" data-line=\"193\">}\n</span><span class=\"lens-source-line\" data-line=\"194\">\n</span><span class=\"lens-source-line\" data-line=\"195\">fn getBandState(value: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"196\">  if (bandHasLow &amp;&amp; value &lt; bandLow) {\n</span><span class=\"lens-source-line\" data-line=\"197\">    return 0u;\n</span><span class=\"lens-source-line\" data-line=\"198\">  }\n</span><span class=\"lens-source-line\" data-line=\"199\">  if (bandHasHigh &amp;&amp; value &gt;= bandHigh) {\n</span><span class=\"lens-source-line\" data-line=\"200\">    return 2u;\n</span></code></pre><p>264 source lines omitted</p><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>va