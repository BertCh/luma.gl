  "figure": {
    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>isobands-count · 16×1×1 workgroups × 256×1×1 lanes = 4096 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-raster-isobands-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect><rect x=\"21\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"1\"></rect><rect x=\"41\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"2\"></rect><rect x=\"61\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"3\"></rect><rect x=\"81\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"4\"></rect><rect x=\"101\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"5\"></rect><rect x=\"121\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"6\"></rect><rect x=\"141\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"7\"></rect><rect x=\"161\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"8\"></rect><rect x=\"181\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"9\"></rect><rect x=\"201\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"10\"></rect><rect x=\"221\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"11\"></rect><rect x=\"241\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"12\"></rect><rect x=\"261\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"13\"></rect><rect x=\"281\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"14\"></rect><rect x=\"301\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"15\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-raster-isobands-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const valuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; values: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const breaksOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; breaks: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const cellCountsOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; cellCountsOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const MAXIMUM_BREAK_COUNT: u32 = 7u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const NO_DATA_CLASS: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line\" data-line=\"18\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"21\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"22\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"23\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"24\">}\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">fn isNaNValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"27\">\n</span><span class=\"lens-source-line\" data-line=\"28\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">fn isNoDataValue(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"31\">  return isNaNValue(value);\n</span><span class=\"lens-source-line\" data-line=\"32\">}\n</span><span class=\"lens-source-line\" data-line=\"33\">\n</span><span class=\"lens-source-line\" data-line=\"34\">fn countBreaksBelow(first: u32, count: u32, value: f32, closedRight: bool) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"35\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"36\">  var high = count;\n</span><span class=\"lens-source-line\" data-line=\"37\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"38\">    if (low &gt;= high) {\n</span><span class=\"lens-source-line\" data-line=\"39\">      break;\n</span><span class=\"lens-source-line\" data-line=\"40\">    }\n</span><span class=\"lens-source-line\" data-line=\"41\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"42\">    let boundary = breaks[breaksOffset + first + middle];\n</span><span class=\"lens-source-line\" data-line=\"43\">    let isBelow = select(boundary &lt;= value, boundary &lt; value, closedRight);\n</span><span class=\"lens-source-line\" data-line=\"44\">    if (isBelow) {\n</span><span class=\"lens-source-line\" data-line=\"45\">      low = middle + 1u;\n</span><span class=\"lens-source-line\" data-line=\"46\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"47\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"48\">    }\n</span><span class=\"lens-source-line\" data-line=\"49\">  }\n</span><span class=\"lens-source-line\" data-line=\"50\">  return low;\n</span><span class=\"lens-source-line\" data-line=\"51\">}\n</span><span class=\"lens-source-line\" data-line=\"52\">fn writeTriangle(index: u32, a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;, c: vec2&lt;f32&gt;, band: u32) {}\n</span><span class=\"lens-source-line\" data-line=\"53\">const EMIT_EDGES: bool = false;\n</span><span class=\"lens-source-line\" data-line=\"54\">fn writeEdge(index: u32, start: vec2&lt;f32&gt;, end: vec2&lt;f32&gt;, band: u32) {}\n</span><span class=\"lens-source-line\" data-line=\"55\">\n</span><span class=\"lens-source-line\" data-line=\"56\">const CELL_COLUMNS: u32 = WIDTH - 1u;\n</span><span class=\"lens-source-line\" data-line=\"57\">const NO_EVENT: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"58\">\n</span><span class=\"lens-source-line\" data-line=\"59\">// Event kinds in bits 0..1: 0 corner, 1 entry crossing, 2 exit crossing. Bit 2 is the level\n</span><span class=\"lens-source-line\" data-line=\"60\">// (0 low, 1 high), bits 3..5 the corner index (corners) or canonical edge index (crossings).\n</span><span class=\"lens-source-line\" data-line=\"61\">var&lt;private&gt; cornerValues: array&lt;f32, 4&gt;;\n</span><span class=\"lens-source-line\" data-line=\"62\">var&lt;private&gt; bandStates: array&lt;u32, 4&gt;;\n</span><span class=\"lens-source-line\" data-line=\"63\">var&lt;private&gt; bandMasks: array&lt;u32, 2&gt;;\n</span><span class=\"lens-source-line\" data-line=\"64\">var&lt;private&gt; bandJoined: array&lt;bool, 2&gt;;\n</span><span class=\"lens-source-line\" data-line=\"65\">var&lt;private&gt; cellEvents: array&lt;u32, 12&gt;;\n</span><span class=\"lens-source-line\" data-line=\"66\">var&lt;private&gt; cellEventCount: u32;\n</span><span class=\"lens-source-line\" data-line=\"67\">var&lt;private&gt; cellColumn: u32;\n</span><span class=\"lens-source-line\" data-line=\"68\">var&lt;private&gt; cellRow: u32;\n</span><span class=\"lens-source-line\" data-line=\"69\">var&lt;private&gt; bandLow: f32;\n</span><span class=\"lens-source-line\" data-line=\"70\">var&lt;private&gt; bandHigh: f32;\n</span><span class=\"lens-source-line\" data-line=\"71\">var&lt;private&gt; pieceVertexCount: u32;\n</span><span class=\"lens-source-line\" data-line=\"72\">var&lt;private&gt; pieceFirst: vec2&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"73\">var&lt;private&gt; piecePrevious: vec2&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"74\">var&lt;private&gt; emittedTriangles: u32;\n</span><span class=\"lens-source-line\" data-line=\"75\">var&lt;private&gt; cellEventWalks: array&lt;u32, 12&gt;;\n</span><span class=\"lens-source-line\" data-line=\"76\">var&lt;private&gt; pieceNextIsLevel: bool;\n</span><span class=\"lens-source-line\" data-line=\"77\">var&lt;private&gt; pieceLastWalk: u32;\n</span><span class=\"lens-source-line\" data-line=\"78\">var&lt;private&gt; cellEdgeCount: u32;\n</span><span class=\"lens-source-line\" data-line=\"79\">var&lt;private&gt; bandHasLow: bool;\n</span><span class=\"lens-source-line\" data-line=\"80\">var&lt;private&gt; bandHasHigh: bool;\n</span><span class=\"lens-source-line\" data-line=\"81\">var&lt;private&gt; bandIsSliver: bool;\n</span><span class=\"lens-source-line\" data-line=\"82\">var&lt;private&gt; edgeBase: u32;\n</span><span class=\"lens-source-line\" data-line=\"83\">var&lt;private&gt; EDGE_START: array&lt;u32, 4&gt; = array&lt;u32, 4&gt;(0u, 1u, 3u, 0u);\n</span><span class=\"lens-source-line\" data-line=\"84\">var&lt;private&gt; EDGE_END: array&lt;u32, 4&gt; = array&lt;u32, 4&gt;(1u, 2u, 2u, 3u);\n</span><span class=\"lens-source-line\" data-line=\"85\">\n</span><span class=\"lens-source-line\" data-line=\"86\">fn getParameterCount(value: f32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"87\">  return min(u32(clamp(select(0.0, value, isFiniteValue(value)), 0.0, 4294967040.0)), MAXIMUM_BREAK_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"88\">}\n</span><span class=\"lens-source-line\" data-line=\"89\">\n</span><span class=\"lens-source-line\" data-line=\"90\">fn getWorldPosition(gridX: f32, gridY: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"91\">  let x = params[paramsOffset + 4u] + (gridX + 0.5) * params[paramsOffset + 8u];\n</span><span class=\"lens-source-line\" data-line=\"92\">  let y = params[paramsOffset + 5u] + (gridY + 0.5) * params[paramsOffset + 9u];\n</span><span class=\"lens-source-line\" data-line=\"93\">  return vec2&lt;f32&gt;(x, y);\n</span><span class=\"lens-source-line\" data-line=\"94\">}\n</span><span class=\"lens-source-line\" data-line=\"95\">\n</span><span class=\"lens-source-line\" data-line=\"96\">fn getCornerPosition(corner: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"97\">  let dx = select(0u, 1u, corner == 1u || corner == 2u);\n</span><span class=\"lens-source-line\" data-line=\"98\">  let dy = select(0u, 1u, corner &gt;= 2u);\n</span><span class=\"lens-source-line\" data-line=\"99\">  return getWorldPosition(f32(cellColumn + dx), f32(cellRow + dy));\n</span><span class=\"lens-source-line\" data-line=\"100\">}\n</span><span class=\"lens-source-line\" data-line=\"101\">\n</span><span class=\"lens-source-line\" data-line=\"102\">// Crossing of the band&#39;s low (level 0) or high (level 1) break on a canonical edge: horizontal\n</span><span class=\"lens-source-line\" data-line=\"103\">// edges run +x, vertical edges +y, from the lower-index sample to the higher-index sample.\n</span><span class=\"lens-source-line\" data-line=\"104\">fn getCrossingPosition(level: u32, edge: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"105\">  let boundary = select(bandLow, bandHigh, level == 1u);\n</span><span class=\"lens-source-line\" data-line=\"106\">  let startValue = cornerValues[EDGE_START[edge]];\n</span><span class=\"lens-source-line\" data-line=\"107\">  let endValue = cornerValues[EDGE_END[edge]];\n</span><span class=\"lens-source-line\" data-line=\"108\">  let t = (boundary - startValue) / (endValue - startValue);\n</span><span class=\"lens-source-line\" data-line=\"109\">  let baseX = f32(cellColumn);\n</span><span class=\"lens-source-line\" data-line=\"110\">  let baseY = f32(cellRow);\n</span><span class=\"lens-source-line\" data-line=\"111\">  if (edge == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"112\">    return getWorldPosition(baseX + t, baseY);\n</span><span class=\"lens-source-line\" data-line=\"113\">  }\n</span><span class=\"lens-source-line\" data-line=\"114\">  if (edge == 1u) {\n</span><span class=\"lens-source-line\" data-line=\"115\">    return getWorldPosition(f32(cellColumn + 1u), baseY + t);\n</span><span class=\"lens-source-line\" data-line=\"116\">  }\n</span><span class=\"lens-source-line\" data-line=\"117\">  if (edge == 2u) {\n</span><span class=\"lens-source-line\" data-line=\"118\">    return getWorldPosition(baseX + t, f32(cellRow + 1u));\n</span><span class=\"lens-source-line\" data-line=\"119\">  }\n</span><span class=\"lens-source-line\" data-line=\"120\">  return getWorldPosition(baseX, baseY + t);\n</span><span class=\"lens-source-line\" data-line=\"121\">}\n</span><span class=\"lens-source-line\" data-line=\"122\">\n</span><span class=\"lens-source-line\" data-line=\"123\">fn getEventPosition(cellEvent: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"124\">  let index = (cellEvent &gt;&gt; 3u) &amp; 7u;\n</span><span class=\"lens-source-line\" data-line=\"125\">  if ((cellEvent &amp; 3u) == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"126\">    return getCornerPosition(index);\n</span><span class=\"lens-source-line\" data-line=\"127\">  }\n</span><span class=\"lens-source-line\" data-line=\"128\">  return getCrossingPosition((cellEvent &gt;&gt; 2u) &amp; 1u, index);\n</span><span class=\"lens-source-line\" data-line=\"129\">}\n</span><span class=\"lens-source-line\" data-line=\"130\">\n</span><span class=\"lens-source-line\" data-line=\"131\">fn pushEvent(cellEvent: u32, walk: u32) {\n</span><span class=\"lens-source-line\" data-line=\"132\">  cellEvents[cellEventCount] = cellEvent;\n</span><span class=\"lens-source-line\" data-line=\"133\">  cellEventWalks[cellEventCount] = walk;\n</span><span class=\"lens-source-line\" data-line=\"134\">  cellEventCount++;\n</span><span class=\"lens-source-line\" data-line=\"135\">}\n</span><span class=\"lens-source-line\" data-line=\"136\">\n</span><span class=\"lens-source-line\" data-line=\"137\">fn buildEvents() {\n</span><span class=\"lens-source-line\" data-line=\"138\">  cellEventCount = 0u;\n</span><span class=\"lens-source-line\" data-line=\"139\">  for (var walk = 0u; walk &lt; 4u; walk++) {\n</span><span class=\"lens-source-line\" data-line=\"140\">    let startState = bandStates[walk];\n</span><span class=\"lens-source-line\" data-line=\"141\">    let endState = bandStates[(walk + 1u) % 4u];\n</span><span class=\"lens-source-line\" data-line=\"142\">    if (startState == 1u) {\n</span><span class=\"lens-source-line\" data-line=\"143\">      pushEvent(walk &lt;&lt; 3u, walk);\n</span><span class=\"lens-source-line\" data-line=\"144\">    }\n</span><span class=\"lens-source-line\" data-line=\"145\">    if (startState &lt; endState) {\n</span><span class=\"lens-source-line\" data-line=\"146\">      if (startState == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"147\">        pushEvent(1u | (walk &lt;&lt; 3u), walk);\n</span><span class=\"lens-source-line\" data-line=\"148\">      }\n</span><span class=\"lens-source-line\" data-line=\"149\">      if (endState == 2u) {\n</span><span class=\"lens-source-line\" data-line=\"150\">        pushEvent(2u | 4u | (walk &lt;&lt; 3u), walk);\n</span><span class=\"lens-source-line\" data-line=\"151\">      }\n</span><span class=\"lens-source-line\" data-line=\"152\">    } else if (startState &gt; endState) {\n</span><span class=\"lens-source-line\" data-line=\"153\">      if (startState == 2u) {\n</span><span class=\"lens-source-line\" data-line=\"154\">        pushEvent(1u | 4u | (walk &lt;&lt; 3u), walk);\n</span><span class=\"lens-source-line\" data-line=\"155\">      }\n</span><span class=\"lens-source-line\" data-line=\"156\">      if (endState == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"157\">        pushEvent(2u | (walk &lt;&lt; 3u), walk);\n</span><span class=\"lens-source-line\" data-line=\"158\">