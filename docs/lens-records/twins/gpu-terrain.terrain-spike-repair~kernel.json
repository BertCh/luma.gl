ata-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const componentSizeOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read_write&gt; componentSize: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const seamCountOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; seamCount: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const voteCountOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; voteCount: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const agreeCountOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; agreeCount: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const bitCountOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; bitCount: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const scalarsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; scalars: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const statisticsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-