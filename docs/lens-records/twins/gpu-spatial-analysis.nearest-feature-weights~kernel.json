ata-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-spatial-analysis-nearest-feature-weights-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const featureMinimaOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; featureMinima: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const featureMaximaOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; featureMaxima: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">const FLOAT32_MAXIMUM: f32 = 3.402823466e+38;\n</span><span class=\"lens-source-line\" data-line=\"13\">const NO_FEATURE: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"14\">\n</span><span class=\"lens-source-line\" data-line=\"15\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"18\">@compute @workgroup_size(32)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"19\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"20\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"21\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"22\">) {\n</span><span class=\"lens-source-line\" data-line=\"23\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"24\">  _ = &amp;featureMinima;\n</span><span class=\"lens-source-line\" data-line=\"25\">  _ = &amp;featureMaxima;\n</span><span class=\"lens-source-line\" data-line=\"26\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"27\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"28\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"29\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"30\">  if (workgroupIndex &gt;= 134217728u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"31\">  let index = workgroupIndex * 32u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"32\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"33\">    return;\n</span><span class=\"lens-source-line\" data-line=\"34\">  }\n</span><span class=\"lens-source-line\" data-line=\"35\">  var minimum = vec2f(FLOAT32_MAXIMUM);\n</span><span class=\"lens-source-line\" data-line=\"36\">  var maximum = vec2f(-FLOAT32_MAXIMUM);\n</span><span class=\"lens-source-line\" data-line=\"37\">  let position = vec2f(positions[positionsOffset + index * 2u], positions[positionsOffset + index * 2u + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"38\">  if (isFiniteValue(position.x) &amp;&amp; isFiniteValue(position.y)) {\n</span><span class=\"lens-source-line\" data-line=\"39\">    minimum = position;\n</span><span class=\"lens-source-line\" data-line=\"40\">    maximum = position;\n</span><span class=\"lens-source-line\" data-line=\"41\">  }\n</span><span class=\"lens-source-line\" data-line=\"42\">  featureMinima[featureMinimaOffset + index * 2u] = minimum.x;\n</span><span class=\"lens-source-line\" data-line=\"43\">  featureMinima[featureMinimaOffset + index * 2u + 1u] = minimum.y;\n</span><span class=\"lens-source-line\" data-line=\"44\">  featureMaxima[featureMaximaOffset + index * 2u] = maximum.x;\n</span><span class=\"lens-source-line\" data-line=\"45\">  featureMaxima[featureMaximaOffset + index * 2u + 1u] = maximum.y;\n</span><span class=\"lens-source-line\" data-line=\"46\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"libraries\">libraries</td><td>read</td><td>f32</td></tr><tr><td>featureMinima<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"nearest-feature-join-feature-minima\">nearest-feature-join-feature-minima</td><td>read_write</td><td>f32</td></tr><tr><td>featureMaxima<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-