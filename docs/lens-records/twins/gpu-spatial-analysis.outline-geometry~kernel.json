></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const lineOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; lineOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const parametersOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; parameters: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const outputPositionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; outputPositions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">const LINE_COUNT: u32 = 51u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const ROW_COUNT: u32 = 550u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const JOIN_SEGMENTS: u32 = 8u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const VERTICES_PER_INPUT: u32 = 30u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const RADIUS: f32 = 6371009.0;\n</span><span class=\"lens-source-line\" data-line=\"19\">const DEGREES_PER_RADIAN: f32 = 57.29577951308232;\n</span><span class=\"lens-source-line\" data-line=\"20\">const TAU: f32 = 6.283185307179586;\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">fn getPosition(row: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"23\">  return vec2&lt;f32&gt;(positions[positionsOffset + 2u * row], positions[positionsOffset + 2u * row + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"24\">}\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line\" data-line=\"26\">fn writeVertex(slot: u32, base: u32, p: vec2&lt;f32&gt;) {\n</span><span class=\"lens-source-line\" data-line=\"27\">  let at = outputPositionsOffset + 2u * (base + slot);\n</span><span class=\"lens-source-line\" data-line=\"28\">  outputPositions[at] = p.x;\n</span><span class=\"lens-source-line\" data-line=\"29\">  outputPositions[at + 1u] = p.y;\n</span><span class=\"lens-source-line\" data-line=\"30\">}\n</span><span class=\"lens-source-line\" data-line=\"31\">\n</span><span class=\"lens-source-line\" data-line=\"32\">// Moves p by distance d along the metric direction (east, north).\n</span><span class=\"lens-source-line\" data-line=\"33\">fn offsetPoint(p: vec2&lt;f32&gt;, direction: vec2&lt;f32&gt;, d: f32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"34\">  return p + direction * d;\n</span><span class=\"lens-source-line\" data-line=\"35\">}\n</span><span class=\"lens-source-line\" data-line=\"36\">\n</span><span class=\"lens-source-line\" data-line=\"37\">// Unit metric direction of the segment a to b, or zero for a zero-length segment.\n</span><span class=\"lens-source-line\" data-line=\"38\">fn getDirection(a: vec2&lt;f32&gt;, b: vec2&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"39\">  let metric = b - a;\n</span><span class=\"lens-source-line\" data-line=\"40\">  let metricLength = length(metric);\n</span><span class=\"lens-source-line\" data-line=\"41\">  if (metricLength &lt;= 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"42\">    return vec2&lt;f32&gt;(0.0);\n</span><span class=\"lens-source-line\" data-line=\"43\">  }\n</span><span class=\"lens-source-line\" data-line=\"44\">  return metric / metricLength;\n</span><span class=\"lens-source-line\" data-line=\"45\">}\n</span><span class=\"lens-source-line\" data-line=\"46\">\n</span><span class=\"lens-source-line\" data-line=\"47\">const NO_LINE: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"48\">\n</span><span class=\"lens-source-line\" data-line=\"49\">fn findLine(row: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"50\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"51\">  var high = LINE_COUNT + 1u;\n</span><span class=\"lens-source-line\" data-line=\"52\">  while (low &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"53\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"54\">    if (lineOffsets[lineOffsetsOffset + middle] &lt;= row) {\n</span><span class=\"lens-source-line\" data-line=\"55\">      low = middle + 1u;\n</span><span class=\"lens-source-line\" data-line=\"56\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"57\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"58\">    }\n</span><span class=\"lens-source-line\" data-line=\"59\">  }\n</span><span class=\"lens-source-line\" data-line=\"60\">  if (low == 0u || low &gt; LINE_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"61\">    return NO_LINE;\n</span><span class=\"lens-source-line\" data-line=\"62\">  }\n</span><span class=\"lens-source-line\" data-line=\"63\">  return low - 1u;\n</span><span class=\"lens-source-line\" data-line=\"64\">}\n</span><span class=\"lens-source-line\" data-line=\"65\">\n</span><span class=\"lens-source-line\" data-line=\"66\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"67\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"68\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"69\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"70\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"71\">) {\n</span><span class=\"lens-source-line\" data-line=\"72\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"73\">  _ = &amp;lineOffsets;\n</span><span class=\"lens-source-line\" data-line=\"74\">  _ = &amp;parameters;\n</span><span class=\"lens-source-line\" data-line=\"75\">  _ = &amp;outputPositions;\n</span><span class=\"lens-source-line\" data-line=\"76\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"77\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"78\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"79\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"80\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"81\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"82\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"83\">    return;\n</span><span class=\"lens-source-line\" data-line=\"84\">  }\n</span><span class=\"lens-source-line\" data-line=\"85\">  let distance = max(parameters[parametersOffset], 0.0);\n</span><span class=\"lens-source-line\" data-line=\"86\">  let base = index * VERTICES_PER_INPUT;\n</span><span class=\"lens-source-line\" data-line=\"87\">  let center = getPosition(index);\n</span><span class=\"lens-source-line\" data-line=\"88\">  // Round join and cap disc: JOIN_SEGMENTS counter-clockwise triangles around the vertex.\n</span><span class=\"lens-source-line\" data-line=\"89\">  // Each rim point is shared by two triangles, so it is computed once (one sin/cos per segment).\n</span><span class=\"lens-source-line\" data-line=\"90\">  var rimA = offsetPoint(center, vec2&lt;f32&gt;(1.0, 0.0), distance);\n</span><span class=\"lens-source-line\" data-line=\"91\">  for (var k = 0u; k &lt; JOIN_SEGMENTS; k++) {\n</span><span class=\"lens-source-line\" data-line=\"92\">    let angleB = TAU * f32(k + 1u) / f32(JOIN_SEGMENTS);\n</span><span class=\"lens-source-line\" data-line=\"93\">    let rimB = offsetPoint(center, vec2&lt;f32&gt;(cos(angleB), sin(angleB)), distance);\n</span><span class=\"lens-source-line\" data-line=\"94\">    writeVertex(3u * k, base, center);\n</span><span class=\"lens-source-line\" data-line=\"95\">    writeVertex(3u * k + 1u, base, rimA);\n</span><span class=\"lens-source-line\" data-line=\"96\">    writeVertex(3u * k + 2u, base, rimB);\n</span><span class=\"lens-source-line\" data-line=\"97\">    rimA = rimB;\n</span><span class=\"lens-source-line\" data-line=\"98\">  }\n</span><span class=\"lens-source-line\" data-line=\"99\">  // Rectangle toward the next vertex, or a degenerate pair of triangles.\n</span><span class=\"lens-source-line\" data-line=\"100\">  var nextRow = ROW_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"101\">  let line = findLine(index);\n</span><span class=\"lens-source-line\" data-line=\"102\">  if (line != NO_LINE) {\n</span><span class=\"lens-source-line\" data-line=\"103\">    let lineStart = lineOffsets[lineOffsetsOffset + line];\n</span><span class=\"lens-source-line\" data-line=\"104\">    let lineEnd = min(lineOffsets[lineOffsetsOffset + line + 1u], ROW_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"105\">    if (index + 1u &lt; lineEnd) {\n</span><span class=\"lens-source-line\" data-line=\"106\">      nextRow = index + 1u;\n</span><span class=\"lens-source-line\" data-line=\"107\">    } else if (lineEnd - lineStart &gt;= 2u) {\n</span><span class=\"lens-source-line\" data-line=\"108\">      nextRow = lineStart;\n</span><span class=\"lens-source-line\" data-line=\"109\">    }\n</span><span class=\"lens-source-line\" data-line=\"110\">  }\n</span><span class=\"lens-source-line\" data-line=\"111\">  var quad = array&lt;vec2&lt;f32&gt;, 6&gt;(center, center, center, center, center, center);\n</span><span class=\"lens-source-line\" data-line=\"112\">  if (nextRow &lt; ROW_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"113\">    let next = getPosition(nextRow);\n</span><span class=\"lens-source-line\" data-line=\"114\">    let direction = getDirection(center, next);\n</span><span class=\"lens-source-line\" data-line=\"115\">    if (dot(direction, direction) &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"116\">      let normal = vec2&lt;f32&gt;(-direction.y, direction.x);\n</span><span class=\"lens-source-line\" data-line=\"117\">      let aLeft = offsetPoint(center, normal, distance);\n</span><span class=\"lens-source-line\" data-line=\"118\">      let aRight = offsetPoint(center, -normal, distance);\n</span><span class=\"lens-source-line\" data-line=\"119\">      let bRight = offsetPoint(next, -normal, distance);\n</span><span class=\"lens-source-line\" data-line=\"120\">      let bLeft = offsetPoint(next, normal, distance);\n</span><span class=\"lens-source-line\" data-line=\"121\">      quad = array&lt;vec2&lt;f32&gt;, 6&gt;(aLeft, aRight, bRight, aLeft, bRight, bLeft);\n</span><span class=\"lens-source-line\" data-line=\"122\">    }\n</span><span class=\"lens-source-line\" data-line=\"123\">  }\n</span><span class=\"lens-source-line\" data-line=\"124\">  for (var vertex = 0u; vertex &lt; 6u; vertex++) {\n</span><span class=\"lens-source-line\" data-line=\"125\">    writeVertex(3u * JOIN_SEGMENTS + vertex, base, quad[vertex]);\n</span><span class=\"lens-source-line\" data-line=\"126\">  }\n</span><span class=\"lens-source-line\" data-line=\"127\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"positions\">positions</td><td>read</td><td>f32</td></tr><tr><td>lineOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"ringOffsets\">ringOffsets</td><td>read</td><td>u32</td></tr><tr><td>parameters<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"parameters\">parameters</td><td>read</td><td>f32</td></tr><tr><td>outputPositions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"outline\">outline</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUOutlineGeometry/polygons · main · 7495d2f2</figcaption></figure></section>",
