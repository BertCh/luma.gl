-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const featureMinimaOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; featureMinima: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const featureMaximaOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; featureMaxima: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">const FLOAT32_MAXIMUM: f32 = 3.402823466e+38;\n</span><span class=\"lens-source-line\" data-line=\"13\">const NO_FEATURE: u32 = 0xffffffffu;\n</span><span class=\"lens-source-line\" data-line=\"14\">\n</span><span class=\"lens-source-line\" data-line=\"15\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"18\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"19\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"20\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"21\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"22\">) {\n</span><span class=\"lens-source-line\" data-line=\"23\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"24\">  _ = &amp;featureMinima;\n</span><span class=\"lens-source-line\" data-line=\"25\">  _ = &amp;featureMaxima;\n</span><span class=\"lens-source-line\" data-line=\"26\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"27\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"28\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"29\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"30\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"31\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"32\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"33\">    return;\n</span><span class=\"lens-source-line\" data-line=\"34\">  }\n</span><span class=\"lens-source-line\" data-line=\"35\">  var minimum = vec2f(FLOAT32_MAXIMUM);\n</span><span class=\"lens-source-line\" data-line=\"36\">  var maximum = vec2f(-FLOAT32_MAXIMUM);\n</span><span class=\"lens-source-line\" data-line=\"37\">  let position = vec2f(positions[positionsOffset + index * 2u], positions[positionsOffset + index * 2u + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"38\">  if (isFiniteValue(position.x) &amp;&amp; isFiniteValue(position.y)) {\n</span><span class=\"lens-source-line\" data-line=\"39\">    minimum = position;\n</span><span class=\"lens-source-line\" data-line=\"40\">    maximum = position;\n</span><span class=\"lens-source-line\" data-line=\"41\">  }\n</span><span class=\"lens-source-line\" data-line=\"42\">  featureMinima[featureMinimaOffset + index * 2u] = minimum.x;\n</span><span class=\"lens-source-line\" data-line=\"43\">  featureMinima[featureMinimaOffset + index * 2u + 1u] = minimum.y;\n</span><span class=\"lens-source-line\" data-line=\"44\">  featureMaxima[featureMaximaOffset + index * 2u] = maximum.x;\n</span><span class=\"lens-source-line\" data-line=\"45\">  featureMaxima[featureMaximaOffset + index * 2u + 1u] = maximum.y;\n</span><span class=\"lens-source-line\" data-line=\"46\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"observations\">observations</td><td>read</td><td>f32</td></tr><tr><td>featureMinima<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"hierarchical-density-clustering-neighbors-feature-minima\">hierarchical-density-clustering-neighbors-feature-minima</td><td>read_write</td><td>f32</td></tr><tr><td>featureMaxima<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"hierarchical-density-clustering-neighbors-feature-maxima\">hierarchical-density-clustering-neighbors-feature-maxima</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUNearestFeatureJoin/bounds-points · main · 2634c1f8</figcaption></figure></section>",
