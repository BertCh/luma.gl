xt x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">const ELEMENT_COUNT: u32 = 791u;\n</span><span class=\"lens-source-line\" data-line=\"3\">const INPUT_0_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"4\">@group(0) @binding(0) var&lt;storage, read&gt; input0: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"5\">const INPUT_1_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(1) var&lt;storage, read&gt; input1: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const INPUT_2_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(2) var&lt;storage, read&gt; input2: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const INPUT_3_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(3) var&lt;storage, read&gt; input3: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const VALIDITY_3_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(4) var&lt;storage, read&gt; validity3: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const CONTROL_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(5) var&lt;storage, read&gt; queryControls: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const DERIVED_0_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(6) var&lt;storage, read_write&gt; derived0: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const OUTPUT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"18\">@group(0) @binding(7) var&lt;storage, read_write&gt; outputMask: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"20\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"21\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"22\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"23\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"24\">) {\n</span><span class=\"lens-source-line\" data-line=\"25\">  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 4u + workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"26\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"27\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"28\">  if (index &gt;= ELEMENT_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"29\">    return;\n</span><span class=\"lens-source-line\" data-line=\"30\">  }\n</span><span class=\"lens-source-line\" data-line=\"31\">  let expression0Value: f32 = input0[INPUT_0_OFFSET + index];\n</span><span class=\"lens-source-line\" data-line=\"32\">  let expression0Valid: bool = true;\n</span><span class=\"lens-source-line\" data-line=\"33\">  let expression1Value: f32 = input1[INPUT_1_OFFSET + index];\n</span><span class=\"lens-source-line\" data-line=\"34\">  let expression1Valid: bool = true;\n</span><span class=\"lens-source-line\" data-line=\"35\">  let expression2Value: f32 = (expression0Value / expression1Value);\n</span><span class=\"lens-source-line\" data-line=\"36\">  let expression2Valid: bool = expression0Valid &amp;&amp; expression1Valid;\n</span><span class=\"lens-source-line\" data-line=\"37\">  let expression3Value: f32 = input2[INPUT_2_OFFSET + index];\n</span><span class=\"lens-source-line\" data-line=\"38\">  let expression3Valid: bool = true;\n</span><span class=\"lens-source-line\" data-line=\"39\">  let expression4Value: f32 = bitcast&lt;f32&gt;(queryControls[CONTROL_OFFSET + 0u]);\n</span><span class=\"lens-source-line\" data-line=\"40\">  let expression4Valid: bool = queryControls[CONTROL_OFFSET + 1u] != 0u;\n</span><span class=\"lens-source-line\" data-line=\"41\">  let expression5Value: bool = (expression3Value &gt; expression4Value);\n</span><span class=\"lens-source-line\" data-line=\"42\">  let expression5Valid: bool = expression3Valid &amp;&amp; expression4Valid;\n</span><span class=\"lens-source-line\" data-line=\"43\">  let expression6Value: f32 = input3[INPUT_3_OFFSET + index];\n</span><span class=\"lens-source-line\" data-line=\"44\">  let expression6Valid: bool = validity3[VALIDITY_3_OFFSET + index] != 0u;\n</span><span class=\"lens-source-line\" data-line=\"45\">  let expression7Value: bool = expression6Valid;\n</span><span class=\"lens-source-line\" data-line=\"46\">  let expression7Valid: bool = true;\n</span><span class=\"lens-source-line\" data-line=\"47\">  let expression8Value: bool = (expression5Value &amp;&amp; expression7Value);\n</span><span class=\"lens-source-line\" data-line=\"48\">  let expression8Valid: bool = (expression5Valid &amp;&amp; expression7Valid) || (expression5Valid &amp;&amp; !expression5Value) || (expression7Valid &amp;&amp; !expression7Value);\n</span><span class=\"lens-source-line\" data-line=\"49\">  derived0[DERIVED_0_OFFSET + index] = expression2Value;\n</span><span class=\"lens-source-line\" data-line=\"50\">  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, (expression8Valid &amp;&amp; expression8Value));\n</span><span class=\"lens-source-line\" data-line=\"51\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>input0<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-dataframe.data-frame-query-gpu-dataframe-query-input-0\">gpu-dataframe.data-frame-query-gpu-dataframe-query-input-0</td><td>read</td><td>f32</td></tr><tr><td>input1<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-dataframe.data-frame-query-gpu-dataframe-query-input-1\">gpu-dataframe.data-frame-query-gpu-dataframe-query-input-1</td><td>read</td><td>f32</td></tr><tr><td>input2<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-dataframe.data-frame-query-gpu-dataframe-query-input-2\">gpu-dataframe.data-frame-query-gpu-dataframe-query-input-2</td><td>read</td><td>f32</td></tr><tr><td>input3<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-dataframe.data-frame-query-gpu-dataframe-query-input-3\">gpu-dataframe.data-frame-query-gpu-dataframe-query-input-3</td><td>read</td><td>f32</td></tr><tr><td>validity3<span class=\"lens-