    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>advection-0-step · 1×1×1 workgroups × 256×1×1 lanes = 256 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-raster-particle-advection-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-raster-particle-advection-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const velocitiesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; velocities: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const parametersOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; parameters: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const wordsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; words: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const agesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; ages: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const generationsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; generations: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const speedsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"18\">@group(0) @binding(6) var&lt;storage, read_write&gt; speeds: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"19\">\n</span><span class=\"lens-source-line\" data-line=\"20\">fn philoxMulHiLo(a: u32, b: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"21\">  let aLow = a &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"22\">  let aHigh = a &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"23\">  let bLow = b &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"24\">  let bHigh = b &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"25\">  let lowLow = aLow * bLow;\n</span><span class=\"lens-source-line\" data-line=\"26\">  let highLow = aHigh * bLow;\n</span><span class=\"lens-source-line\" data-line=\"27\">  let lowHigh = aLow * bHigh;\n</span><span class=\"lens-source-line\" data-line=\"28\">  let highHigh = aHigh * bHigh;\n</span><span class=\"lens-source-line\" data-line=\"29\">  let middle = (lowLow &gt;&gt; 16u) + (highLow &amp; 0xffffu) + (lowHigh &amp; 0xffffu);\n</span><span class=\"lens-source-line\" data-line=\"30\">  let high = highHigh + (highLow &gt;&gt; 16u) + (lowHigh &gt;&gt; 16u) + (middle &gt;&gt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"31\">  return vec2&lt;u32&gt;(high, a * b);\n</span><span class=\"lens-source-line\" data-line=\"32\">}\n</span><span class=\"lens-source-line\" data-line=\"33\">\n</span><span class=\"lens-source-line\" data-line=\"34\">fn philoxRound(counter: vec4&lt;u32&gt;, key: vec2&lt;u32&gt;) -&gt; vec4&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"35\">  let product0 = philoxMulHiLo(3528531795u, counter.x);\n</span><span class=\"lens-source-line\" data-line=\"36\">  let product1 = philoxMulHiLo(3449720151u, counter.z);\n</span><span class=\"lens-source-line\" data-line=\"37\">  return vec4&lt;u32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"38\">    product1.x ^ counter.y ^ key.x,\n</span><span class=\"lens-source-line\" data-line=\"39\">    product1.y,\n</span><span class=\"lens-source-line\" data-line=\"40\">    product0.x ^ counter.w ^ key.y,\n</span><span class=\"lens-source-line\" data-line=\"41\">    product0.y\n</span><span class=\"lens-source-line\" data-line=\"42\">  );\n</span><span class=\"lens-source-line\" data-line=\"43\">}\n</span><span class=\"lens-source-line\" data-line=\"44\">\n</span><span class=\"lens-source-line\" data-line=\"45\">fn philox4x32(counterIn: vec4&lt;u32&gt;, keyIn: vec2&lt;u32&gt;) -&gt; vec4&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"46\">  var counter = counterIn;\n</span><span class=\"lens-source-line\" data-line=\"47\">  var key = keyIn;\n</span><span class=\"lens-source-line\" data-line=\"48\">  for (var roundIndex = 0u; roundIndex &lt; 9u; roundIndex = roundIndex + 1u) {\n</span><span class=\"lens-source-line\" data-line=\"49\">    counter = philoxRound(counter, key);\n</span><span class=\"lens-source-line\" data-line=\"50\">    key = key + vec2&lt;u32&gt;(2654435769u, 3144134277u);\n</span><span class=\"lens-source-line\" data-line=\"51\">  }\n</span><span class=\"lens-source-line\" data-line=\"52\">  return philoxRound(counter, key);\n</span><span class=\"lens-source-line\" data-line=\"53\">}\n</span><span class=\"lens-source-line\" data-line=\"54\">\n</span><span class=\"lens-source-line\" data-line=\"55\">fn philoxUnitFloat(word: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"56\">  return f32(word &gt;&gt; 8u) * (1.0 / 16777216.0);\n</span><span class=\"lens-source-line\" data-line=\"57\">}\n</span><span class=\"lens-source-line\" data-line=\"58\">\n</span><span class=\"lens-source-line\" data-line=\"59\">\n</span><span class=\"lens-source-line\" data-line=\"60\">const FIELD_WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"61\">const FIELD_HEIGHT: u32 = 48u;\n</span><span class=\"lens-source-line\" data-line=\"62\">\n</span><span class=\"lens-source-line\" data-line=\"63\">fn isNanFloat(value: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"64\">  return (bitcast&lt;u32&gt;(value) &amp; 0x7fffffffu) &gt; 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"65\">}\n</span><span class=\"lens-source-line\" data-line=\"66\">\n</span><span class=\"lens-source-line\" data-line=\"67\">fn readFieldVelocity(column: u32, row: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"68\">  let base = velocitiesOffset + 2u * (row * FIELD_WIDTH + column);\n</span><span class=\"lens-source-line\" data-line=\"69\">  return vec2&lt;f32&gt;(velocities[base], velocities[base + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"70\">}\n</span><span class=\"lens-source-line\" data-line=\"71\">\n</span><span class=\"lens-source-line\" data-line=\"72\">fn isNanVelocity(value: vec2&lt;f32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"73\">  return isNanFloat(value.x) || isNanFloat(value.y);\n</span><span class=\"lens-source-line\" data-line=\"74\">}\n</span><span class=\"lens-source-line\" data-line=\"75\">\n</span><span class=\"lens-source-line\" data-line=\"76\">fn sampleField(position: vec2&lt;f32&gt;, extent: vec4&lt;f32&gt;) -&gt; vec3&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"77\">  let local = (position - extent.xy) / extent.zw;\n</span><span class=\"lens-source-line\" data-line=\"78\">  if (isNanVelocity(local)) {\n</span><span class=\"lens-source-line\" data-line=\"79\">    return vec3&lt;f32&gt;(0.0);\n</span><span class=\"lens-source-line\" data-line=\"80\">  }\n</span><span class=\"lens-source-line\" data-line=\"81\">  if (local.x &lt; 0.0 || local.y &lt; 0.0 || local.x &gt;= f32(FIELD_WIDTH) || local.y &gt;= f32(FIELD_HEIGHT)) {\n</span><span class=\"lens-source-line\" data-line=\"82\">    return vec3&lt;f32&gt;(0.0);\n</span><span class=\"lens-source-line\" data-line=\"83\">  }\n</span><span class=\"lens-source-line\" data-line=\"84\">  let grid = clamp(\n</span><span class=\"lens-source-line\" data-line=\"85\">    local - vec2&lt;f32&gt;(0.5),\n</span><span class=\"lens-source-line\" data-line=\"86\">    vec2&lt;f32&gt;(0.0),\n</span><span class=\"lens-source-line\" data-line=\"87\">    vec2&lt;f32&gt;(f32(FIELD_WIDTH - 1u), f32(FIELD_HEIGHT - 1u))\n</span><span class=\"lens-source-line\" data-line=\"88\">  );\n</span><span class=\"lens-source-line\" data-line=\"89\">  let column0 = min(u32(grid.x), FIELD_WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"90\">  let row0 = min(u32(grid.y), FIELD_HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"91\">  let column1 = min(column0 + 1u, FIELD_WIDTH - 1u);\n</span><span class=\"lens-source-line\" data-line=\"92\">  let row1 = min(row0 + 1u, FIELD_HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"93\">  let fraction = grid - vec2&lt;f32&gt;(f32(column0), f32(row0));\n</span><span class=\"lens-source-line\" data-line=\"94\">  let v00 = readFieldVelocity(column0, row0);\n</span><span class=\"lens-source-line\" data-line=\"95\">  let v10 = readFieldVelocity(column1, row0);\n</span><span class=\"lens-source-line\" data-line=\"96\">  let v01 = readFieldVelocity(column0, row1);\n</span><span class=\"lens-source-line\" data-line=\"97\">  let v11 = readFieldVelocity(column1, row1);\n</span><span class=\"lens-source-line\" data-line=\"98\">  if (isNanVelocity(v00) || isNanVelocity(v10) || isNanVelocity(v01) || isNanVelocity(v11)) {\n</span><span class=\"lens-source-line\" data-line=\"99\">    return vec3&lt;f32&gt;(0.0);\n</span><span class=\"lens-source-line\" data-line=\"100\">  }\n</span><span class=\"lens-source-line\" data-line=\"101\">  let bottom = v00 * (1.0 - fraction.x) + v10 * fraction.x;\n</span><span class=\"lens-source-line\" data-line=\"102\">  let top = v01 * (1.0 - fraction.x) + v11 * fraction.x;\n</span><span class=\"lens-source-line\" data-line=\"103\">  return vec3&lt;f32&gt;(bottom * (1.0 - fraction.y) + top * fraction.y, 1.0);\n</span><span class=\"lens-source-line\" data-line=\"104\">}\n</span><span class=\"lens-source-line\" data-line=\"105\">\n</span><span class=\"lens-source-line\" data-line=\"106\">fn readParameter(slot: u32) -&gt; f32 { return parameters[parametersOffset + slot]; }\n</span><span class=\"lens-source-line\" data-line=\"107\">fn getSpeed(sample: vec2&lt;f32&gt;, speedScale: f32) -&gt; f32 { return length(sample) * abs(speedScale); }\n</span><span class=\"lens-source-line\" data-line=\"108\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"109\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"110\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"111\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"112\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"113\">) {\n</span><span class=\"lens-source-line\" data-line=\"114\">  _ = &amp;velocities;\n</span><span class=\"lens-source-line\" data-line=\"115\">  _ = &amp;parameters;\n</span><span class=\"lens-source-line\" data-line=\"116\">  _ = &amp;words;\n</span><span class=\"lens-source-line\" data-line=\"117\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"118\">  _ = &amp;ages;\n</span><span class=\"lens-source-line\" data-line=\"119\">  _ = &amp;generations;\n</span><span class=\"lens-source-line\" data-line=\"120\">  _ = &amp;speeds;\n</span><span class=\"lens-source-line\" data-line=\"121\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"122\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"123\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"124\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"125\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"126\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"127\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"128\">    return;\n</span><span class=\"lens-source-line\" data-line=\"129\">  }\n</span><span class=\"lens-source-line\" data-line=\"130\">  \n</span><span class=\"lens-source-line\" data-line=\"131\">  let extent = vec4&lt;f32&gt;(readParameter(0u), readParameter(1u), readParameter(2u), readParameter(3u));\n</span><span class=\"lens-source-line\" data-line=\"132\">  let timeStep = readParameter(4u);\n</span><span class=\"lens-source-line\" data-line=\"133\">  let speedScale = readParameter(5u);\n</span><span class=\"lens-source-line\" data-line=\"134\">  let dropRate = readParameter(6u);\n</span><span class=\"lens-source-line\" data-line=\"135\">  let minimumSpeed = readParameter(7u);\n</span><span class=\"lens-source-line\" data-line=\"136\">  let spawnMin = vec2&lt;f32&gt;(readParameter(8u), readParameter(9u));\n</span><span class=\"lens-source-line\" data-line=\"137\">  let spawnMax = vec2&lt;f32&gt;(readParameter(10u), readParameter(11u));\n</span><span class=\"lens-source-line\" data-line=\"138\">  let seed = words[wordsOffset];\n</span><span class=\"lens-source-line\" data-line=\"139\">  let frame = words[wordsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"140\">  let maximumAge = words[wordsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"141\">  let reset = words[wordsOffset + 3u] != 0u;\n</span><span class=\"lens-source-line\" data-line=\"142\">  let step = timeStep * speedScale;\n</span><span class=\"lens-source-line\" data-line=\"143\">  let halfStep = 0.5 * step;\n</span><span class=\"lens-source-line\" data-line=\"144\">  var position = vec2&lt;f32&gt;(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"145\">  var previous = position;\n</span><span class=\"lens-source-line\" data-line=\"146\">  var age = ages[agesOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"147\">  var generation = generations[generationsOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"148\">  var respawn = reset;\n</span><span class=\"lens-source-line\" data-line=\"149\">  var speed = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"150\">  if (reset) {\n</span><span class=\"lens-source-line\" data-line=\"151\">    generation = 0u;\n</span><span class=\"lens-source-line\" data-line=\"152\">  } else {\n</span><span class=\"lens-source-line\" data-line=\"153\">    let k1 = sampleField(position, extent);\n</span><span class=\"lens-source-line\" data-line=\"154\">    let middle = position + halfStep * k1.xy;\n</span><span class=\"lens-source-line\" data-line=\"155\">    let k2 = sampleField(middle, extent);\n</span><span class=\"lens-source-line\" data-line=\"156\">    let next = position + step * k2.xy;\n</span><span class=\"lens-source-line\" data-line=\"157\">    let landing = sampleField(next, extent);\n</span><span class=\"lens-source-line\" data-line=\"158\">    let dropWord = philox4x32(vec4&lt;u32&gt;(index, frame, 0u, 0u), vec2&lt;u32&gt;(seed, 5u)).x;\n</span><span class=\"lens-source-line\" data-line=\"159\">    let expired = maximumAge != 0u &amp;&amp; age + 1u &gt;= maximumAge;\n</span><span class=\"lens-source-line\" data-line=\"160\">    let tooSlow = k2.z != 0.0 &amp;&amp; getSpeed(k2.xy, speedScale) &lt; minimumSpeed;\n</span><span class=\"lens-source-line\" data-line=\"161\">    if (k1.z == 0.0 || k2.z == 0.0 || landing.z == 0.0 || expired || tooSlow ||\n</span><span class=\"lens-source-line\" data-line=\"162\">        philoxUnitFloat(dropWord) &lt; dropRate) {\n</span><span class=\"lens-source-line\" data-line=\"163\">      respawn = true;\n</span><span class=\"lens-source-line\" data-line=\"164\">      generation = generation + 1u;\n</span><span class=\"lens-source-line\" data-line=\"165\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"166\">      position = next;\n</span><span class=\"lens-source-line\" data-line=\"167\">      age = age + 1u;\n</span><span class=\"lens-source-line\" data-line=\"168\">      speed = getSpeed(landing.xy, speedScale);\n</span><span class=\"lens-source-line\" data-line=\"169\">    }\n</span><span class=\"lens-source-line\" data-line=\"170\">  }\n</span><span class=\"lens-source-line\" data-line=\"171\">  if (respawn) {\n</span><span class=\"lens-source-line\" data-line=\"172\">    let random = philox4x32(vec4&lt;u32&gt;(index, generation, 0u, 0u), vec2&lt;u32&gt;(seed, 4u));\n</span><span class=\"lens-source-line\" data-line=\"173\">    position = spawnMin + vec2&lt;f32&gt;(philoxUnitFloat(random.x), philoxUnitFloat(random.y)) * (spawnMax - spawnMin);\n</span><span class=\"lens-source-line\" data-line=\"174\">    previous = position;\n</span><span class=\"lens-source-line\" data-line=\"175\">    age = 0u;\n</span><span class=\"lens-source-line\" data-line=\"176\">    if (reset) {\n</span><span class=\"lens-source-line\" data-line=\"177\">      age = min(u32(floor(philoxUnitFloat(random.z) * f32(maximumAge))), max(maximumAge, 1u) - 1u);\n</span><span class=\"lens-source-line\" data-line=\"178\">    }\n</span><span class=\"lens-source-line\" data-line=\"179\">    let landing = sampleField(position, extent);\n</span><span class=\"lens-source-line\" data-line=\"180\">    speed = select(0.0, getSpeed(landing.xy, speedScale), landing.z != 0.0);\n</span><span class=\"lens-source-line\" data-line=\"181\">  }\n</span><span class=\"lens-source-line\" data-line=\"182\">  positions[positionsOffset + 2u * index] = position.x;\n</span><span class=\"lens-source-line\" data-line=\"183\">  positions[positionsOffset + 2u * index + 1u] = position.y;\n</span><span class=\"lens-source-line\" data-line=\"