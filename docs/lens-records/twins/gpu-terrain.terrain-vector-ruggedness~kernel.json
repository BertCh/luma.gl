or-ruggedness-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevation: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const settingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; settings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const normalXOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; normalX: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const normalYOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; normalY: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const normalZOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; normalZ: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"19\">const ROW_NORTH_SIGN: f32 = -1.0;\n</span><span class=\"lens-source-line\" data-line=\"20\">\n</span><span class=\"lens-source-line\" data-line=\"21\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">fn getGroundCellSize(row: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"24\">  let cellSize = vec2&lt;f32&gt;(settings[settingsOffset + 0u], settings[settingsOffset + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"25\">  return cellSize;\n</span><span class=\"lens-source-line\" data-line=\"26\">}\n</span><span class=\"lens-source-line\" data-line=\"27\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"28\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"29\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"30\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"31\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"32\">) {\n</span><span class=\"lens-source-line\" data-line=\"33\">  _ = &amp;elevation;\n</span><span class=\"lens-source-line\" data-line=\"34\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"35\">  _ = &amp;settings;\n</span><span class=\"lens-source-line\" data-line=\"36\">  _ = &amp;normalX;\n</span><span class=\"lens-source-line\" data-line=\"37\">  _ = &amp;normalY;\n</span><span class=\"lens-source-line\" data-line=\"38\">  _ = &amp;normalZ;\n</span><span class=\"lens-source-line\" data-line=\"39\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"40\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"41\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"42\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"43\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"44\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"45\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"46\">    return;\n</span><span class=\"lens-source-line\" data-line=\"47\">  }\n</span><span class=\"lens-source-line\" data-line=\"48\">  let row = i32(index / WIDTH);\n</span><span class=\"lens-source-line\" data-line=\"49\">  let column = i32(index % WIDTH);\n</span><span class=\"lens-source-line\" data-line=\"50\">  var isValid = true;\n</span><span class=\"lens-source-line\" data-line=\"51\">  var windowValues: array&lt;f32, 9&gt;;\n</span><span class=\"lens-source-line\" data-line=\"52\">  for (var k = 0; k &lt; 9; k++) {\n</span><span class=\"lens-source-line\" data-line=\"53\">    var sampleRow = row + k / 3 - 1;\n</span><span class=\"lens-source-line\" data-line=\"54\">    var sampleColumn = column + k % 3 - 1;\n</span><span class=\"lens-source-line\" data-line=\"55\">    \n</span><span class=\"lens-source-line\" data-line=\"56\">    sampleRow = clamp(sampleRow, 0, i32(HEIGHT) - 1);\n</span><span class=\"lens-source-line\" data-line=\"57\">    sampleColumn = clamp(sampleColumn, 0, i32(WIDTH) - 1);\n</span><span class=\"lens-source-line\" data-line=\"58\">    let sampleIndex = u32(sampleRow) * WIDTH + u32(sampleColumn);\n</span><span class=\"lens-source-line\" data-line=\"59\">    let sampleValue = elevation[elevationOffset + sampleIndex];\n</span><span class=\"lens-source-line\" data-line=\"60\">    isValid = isValid &amp;&amp; elevationValidity[elevationValidityOffset + sampleIndex] != 0u &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"61\">      isFiniteValue(sampleValue);\n</span><span class=\"lens-source-line\" data-line=\"62\">    windowValues[k] = sampleValue;\n</span><span class=\"lens-source-line\" data-line=\"63\">  }\n</span><span class=\"lens-source-line\" data-line=\"64\">  let groundCell = getGroundCellSize(u32(row));\n</span><span class=\"lens-source-line\" data-line=\"65\">  let zFactor = settings[settingsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"66\">  // Horn: weights 1-2-1 across three rows or columns, divided by 8 cell sizes.\n</span><span class=\"lens-source-line\" data-line=\"67\">  let eastGradient = zFactor *\n</span><span class=\"lens-source-line\" data-line=\"68\">    ((windowValues[2] + 2.0 * windowValues[5] + windowValues[8]) -\n</span><span class=\"lens-source-line\" data-line=\"69\">     (windowValues[0] + 2.0 * windowValues[3] + windowValues[6])) / (8.0 * groundCell.x);\n</span><span class=\"lens-source-line\" data-line=\"70\">  let northGradient = ROW_NORTH_SIGN * zFactor *\n</span><span class=\"lens-source-line\" data-line=\"71\">    ((windowValues[6] + 2.0 * windowValues[7] + windowValues[8]) -\n</span><span class=\"lens-source-line\" data-line=\"72\">     (windowValues[0] + 2.0 * windowValues[1] + windowValues[2])) / (8.0 * groundCell.y);\n</span><span class=\"lens-source-line\" data-line=\"73\">  isValid = isValid &amp;&amp; groundCell.x &gt; 0.0 &amp;&amp; groundCell.y &gt; 0.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"74\">    isFiniteValue(eastGradient) &amp;&amp; isFiniteValue(northGradient);\n</span><span class=\"lens-source-line\" data-line=\"75\">  let normal = normalize(vec3&lt;f32&gt;(-eastGradient, -northGradient, 1.0));\n</span><span class=\"lens-source-line\" data-line=\"76\">  let invalidValue = bitcast&lt;f32&gt;(0x7fc00000u | (index &amp; 0u));\n</span><span class=\"lens-source-line\" data-line=\"77\">  normalX[normalXOffset + index] = select(invalidValue, normal.x, isValid);\n</span><span class=\"lens-source-line\" data-line=\"78\">  normalY[normalYOffset + index] = select(invalidValue, normal.y, isValid);\n</span><span class=\"lens-source-line\" data-line=\"79\">  normalZ[normalZOffset + index] = select(invalidValue, normal.z, isValid);\n</span><span class=\"lens-source-line\" data-line=\"80\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>elevation<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-vector-ruggedness-elevation-values\">terrain-vector-ruggedness-elevation-values</td><td>read</td><td>f32</td></tr><tr><td>elevationValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-vector-ruggedness-elevation-validity\">terrain-vector-ruggedness-elevation-validity</td><td>read</td><td>u32</td></tr><tr><td>settings<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"vector-ruggedness-parameters\">vector-ruggedness-parameters</td><td>read</td><td>f32</td></tr><tr><td>normalX<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-vector-ruggedness-normal-x\">terrain-vector-ruggedness-normal-x</td><td>read_write</td><td>f32</td></tr><tr><td>normalY<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-vector-ruggedness-normal-y\">terrain-vector-ruggedness-normal-y</td><td>read_write</td><td>f32</td></tr><tr><td>normalZ<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-vector-ruggedness-normal-z\">terrain-vector-ruggedness-normal-z</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUTerrainVectorRuggedness/normals-uniform-clamp · main · 746e442d</figcaption></figure></section>",
