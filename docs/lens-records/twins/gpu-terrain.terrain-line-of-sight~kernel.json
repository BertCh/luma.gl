></rect><text x=\"805\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">20</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"21\"><rect x=\"842\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"845\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">21</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"22\"><rect x=\"882\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"885\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">22</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"23\"><rect x=\"922\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"925\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">23</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"24\"><rect x=\"962\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"965\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">24</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"25\"><rect x=\"1002\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1005\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">25</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"26\"><rect x=\"1042\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1045\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">26</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"27\"><rect x=\"1082\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1085\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">27</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"28\"><rect x=\"1122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">28</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"29\"><rect x=\"1162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">29</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"30\"><rect x=\"1202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">30</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"31\"><rect x=\"1242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"url(#lens-gpu-terrain-terrain-line-of-sight-kernel-lanes-hatched)\" stroke=\"currentColor\"><title>idle: beyond the invocation guard</title></rect><text x=\"1245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">31</text></g></svg><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevationValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const settingsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; settings: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const pairsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; pairs: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const visibilityValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; visibilityValues: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const clearanceValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read_write&gt; clearanceValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const WIDTH: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const HEIGHT: u32 = 64u;\n</span><span class=\"lens-source-line\" data-line=\"19\">const HIDDEN: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"20\">const VISIBLE: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"21\">const OUT_OF_RANGE: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"22\">const NO_DATA: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"23\">const MARGINAL: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"24\">const MAXIMUM_FLOAT: f32 = 3.4028234663852886e38;\n</span><span class=\"lens-source-line\" data-line=\"25\">const SKIP_EPSILON: f32 = 0.00000762939453125;\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"28\">\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">fn isValidPixel(column: u32, row: u32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"31\">  return elevationValidity[elevationValidityOffset + row * WIDTH + column] != 0u;\n</span><span class=\"lens-source-line\" data-line=\"32\">}\n</span><span class=\"lens-source-line\" data-line=\"33\">fn getElevation(column: u32, row: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"34\">  return elevationValues[elevationValuesOffset + row * WIDTH + column];\n</span><span class=\"lens-source-line\" data-line=\"35\">}\n</span><span class=\"lens-source-line\" data-line=\"36\">// Bilinear elevation at a clamped pixel-center position; .y is 0 when any corner is invalid.\n</span><span class=\"lens-source-line\" data-line=\"37\">fn sampleElevation(position: vec2&lt;f32&gt;) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"38\">  let maximum = vec2&lt;f32&gt;(f32(WIDTH - 1u), f32(HEIGHT - 1u));\n</span><span class=\"lens-source-line\" data-line=\"39\">  let clamped = clamp(position, vec2&lt;f32&gt;(0.0), maximum);\n</span><span class=\"lens-source-line\" data-line=\"40\">  let base = vec2&lt;u32&gt;(floor(clamped));\n</span><span class=\"lens-source-line\" data-line=\"41\">  let next = min(base + vec2&lt;u32&gt;(1u), vec2&lt;u32&gt;(WIDTH - 1u, HEIGHT - 1u));\n</span><span class=\"lens-source-line\" data-line=\"42\">  let fraction = clamped - floor(clamped);\n</span><span class=\"lens-source-line\" data-line=\"43\">  // Canonical elevation is NaN exactly where a pixel is invalid, so one bit test per corner\n</span><span class=\"lens-source-line\" data-line=\"44\">  // replaces four validity loads; the interpolation below is unchanged.\n</span><span class=\"lens-source-line\" data-line=\"45\">  let corner00 = getElevation(base.x, base.y);\n</span><span class=\"lens-source-line\" data-line=\"46\">  let corner10 = getElevation(next.x, base.y);\n</span><span class=\"lens-source-line\" data-line=\"47\">  let corner01 = getElevation(base.x, next.y);\n</span><span class=\"lens-source-line\" data-line=\"48\">  let corner11 = getElevation(next.x, next.y);\n</span><span class=\"lens-source-line\" data-line=\"49\">  if (!isFiniteValue(corner00) || !isFiniteValue(corner10) ||\n</span><span class=\"lens-source-line\" data-line=\"50\">      !isFiniteValue(corner01) || !isFiniteValue(corner11)) {\n</span><span class=\"lens-source-line\" data-line=\"51\">    return vec2&lt;f32&gt;(0.0, 0.0);\n</span><span class=\"lens-source-line\" data-line=\"52\">  }\n</span><span class=\"lens-source-line\" data-line=\"53\">  let top = mix(corner00, corner10, fraction.x);\n</span><span class=\"lens-source-line\" data-line=\"54\">  let bottom = mix(corner01, corner11, fraction.x);\n</span><span class=\"lens-source-line\" data-line=\"55\">  return vec2&lt;f32&gt;(mix(top, bottom, fraction.y), 1.0);\n</span><span class=\"lens-source-line\" data-line=\"56\">}\n</span><span class=\"lens-source-line\" data-line=\"57\">fn rayPosition(observer: vec2&lt;f32&gt;, delta: vec2&lt;f32&gt;, sampleIndex: u32, count: u32) -&gt; vec2&lt;f32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"58\">  let fraction = f32(sampleIndex) / f32(count);\n</span><span class=\"lens-source-line\" data-line=\"59\">  return observer + delta * fraction;\n</span><span class=\"lens-source-line\" data-line=\"60\">}\n</span><span class=\"lens-source-line\" data-line=\"61\">fn rayDistance(targetDistance: f32, sampleIndex: u32, count: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"62\">  let fraction = f32(sampleIndex) / f32(count);\n</span><span class=\"lens-source-line\" data-line=\"63\">  return targetDistance * fraction;\n</span><span class=\"lens-source-line\" data-line=\"64\">}\n</span><span class=\"lens-source-line\" data-line=\"65\">struct SightLineResult {\n</span><span class=\"lens-source-line\" data-line=\"66\">  code: u32,\n</span><span class=\"lens-source-line\" data-line=\"67\">  clearance: f32\n</span><span class=\"lens-source-line\" data-line=\"68\">}\n</span><span class=\"lens-source-line\" data-line=\"69\">\n</span><span class=\"lens-source-line\" data-line=\"70\">// Observer and target are pixel-center positions; eye is the observer elevation (ground + height);\n</span><span class=\"lens-source-line\" data-line=\"71\">// targetTop is the target elevation (ground + height) before the curvature drop;\n</span><span class=\"lens-source-line\" data-line=\"72\">// tolerance is [toleranceMeters, tolerancePerKilometer, targetIgnoreDistance, targetIgnoreFraction].\n</span><span class=\"lens-source-line\" data-line=\"73\">fn traceSightLine(\n</span><span class=\"lens-source-line\" data-line=\"74\">  observer: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"75\">  targetPosition: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"76\">  eye: f32,\n</span><span class=\"lens-source-line\" data-line=\"77\">  targetTop: f32,\n</span><span class=\"lens-source-line\" data-line=\"78\">  cellSize: vec2&lt;f32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"79\">  curvature: f32,\n</span><span class=\"lens-source-line\" data-line=\"80\">  maxDistance: f32,\n</span><span class=\"lens-source-line\" data-line=\"81\">  tolerance: vec4&lt;f32&gt;\n</span><span class=\"lens-source-line\" data-line=\"82\">) -&gt; SightLineResult {\n</span><span class=\"lens-source-line\" data-line=\"83\">  let delta = targetPosition - observer;\n</span><span class=\"lens-source-line\" data-line=\"84\">  let targetDistance = length(delta * cellSize);\n</span><span class=\"lens-source-line\" data-line=\"85\">  if (maxDistance &gt; 0.0 &amp;&amp; targetDistance &gt; maxDistance) {\n</span><span class=\"lens-source-line\" data-line=\"86\">    return SightLineResult(OUT_OF_RANGE, 0.0);\n</span><span class=\"lens-source-line\" data-line=\"87\">  }\n</span><span class=\"lens-source-line\" data-line=\"88\">  if (targetDistance == 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"89\">    return SightLineResult(VISIBLE, MAXIMUM_FLOAT);\n</span><span class=\"lens-source-line\" data-line=\"90\">  }\n</span><span class=\"lens-source-line\" data-line=\"91\">  let targetElevation = targetTop - curvature * targetDistance * targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"92\">  let targetSlope = (targetElevation - eye) / targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"93\">  let band = (tolerance.x + tolerance.y * targetDistance / 1000.0) / targetDistance;\n</span><span class=\"lens-source-line\" data-line=\"94\">  let highLimit = targetSlope + band;\n</span><span class=\"lens-source-line\" data-line=\"95\">  let lowLimit = targetSlope - band;\n</span><span class=\"lens-source-line\" data-line=\"96\">  let stopDistance = targetDistance - max(tolerance.z, tolerance.w * targetDistance);\n</span><span class=\"lens-source-line\" data-line=\"97\">  let stepCount = u32(ceil(max(abs(delta.x), abs(delta.y))));\n</span><span class=\"lens-source-line\" data-line=\"98\">  var maxSlope = -MAXIMUM_FLOAT;\n</span><span class=\"lens-source-line\" data-line=\"99\">  var tested = false;\n</span><span class=\"lens-source-line\" data-line=\"100\">  var sampleIndex = 1u;\n</span><span class=\"lens-source-line\" data-line=\"101\">  var skipLevel = 0u;\n</span><span class=\"lens-source-line\" data-line=\"102\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"103\">    if (sampleIndex &gt;= stepCount) { break; }\n</span><span class=\"lens-source-line\" data-line=\"104\">    if (rayDistance(targetDistance, sampleIndex, stepCount) &gt; stopDistance) { break; }\n</span><span class=\"lens-source-line\" data-line=\"105\">    let current = sampleIndex;\n</span><span class=\"lens-source-line\" data-line=\"106\">    sampleIndex = sampleIndex + 1u;\n</span><span class=\"lens-source-line\" data-line=\"107\">    let elevationSample = sampleElevation(rayPosition(observer, delta, current, stepCount));\n</span><span class=\"lens-source-line\" data-line=\"108\">    // Invalid samples never block.\n</span><span class=\"lens-source-line\" data-line=\"109\">    if (elevationSample.y == 0.0) { continue; }\n</span><span class=\"lens-source-line\" data-line=\"110\">    let sampleDistance = rayDistance(targetDistance, current, stepCount);\n</span><span class=\"lens-source-line\" data-line=\"111\">    let sampleSlope =\n</span><span class=\"lens-source-line\" data-line=\"112\">      (elevationSample.x - curvature * sampleDistance * sampleDistance - eye) / sampleDistance;\n</span><span class=\"lens-source-line\" data-line=\"113\">    tested = true;\n</span><span class=\"lens-source-line\" data-line=\"114\">    if (sampleSlope &gt; maxSlope) {\n</span><span class=\"lens-source-line\" data-line=\"115\">      maxSlope = sampleSlope;\n</span><span class=\"lens-source-line\" data-line=\"116\">    }\n</span><span class=\"lens-source-line\" data-line=\"117\">  }\n</span><span class=\"lens-source-line\" data-line=\"118\">  var code = MARGINAL;\n</span><span class=\"lens-source-line\" data-line=\"119\">  if (maxSlope &gt; highLimit) {\n</span><span class=\"lens-source-line\" data-line=\"120\">    code = HIDDEN;\n</span><span class=\"lens-source-line\" data-line=\"121\">  } else if (maxSlope &lt;= lowLimit) {\n</span><span class=\"lens-source-line\" data-line=\"122\">    code = VISIBLE;\n</span><span class=\"lens-source-line\" data-line=\"123\">  }\n</span><span class=\"lens-source-line\" data-line=\"124\">  return SightLineResult(code, select(MAXIMUM_FLOAT, (targetSlope - maxSlope) * targetDistance, tested));\n</span><span class=\"lens-source-line\" data-line=\"125\">}\n</span><span class=\"lens-source-line\" data-line=\"126\">fn isInsideGrid(position: vec2&lt;f32&gt;) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"127\">  return isFiniteValue(position.x) &amp;&amp; isFiniteValue(position.y) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"128\">    position.x &gt;= 0.0 &amp;&amp; position.y &gt;= 0.0 &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"129\">    position.x &lt;= f32(WIDTH - 1u) &amp;&amp; position.y &lt;= f32(HEIGHT - 1u);\n</span><span class=\"lens-source-line\" data-line=\"130\">}\n</span><span class=\"lens-source-line\" data-line=\"131\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"132\">@compute @workgroup_size(32)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"133\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"134\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"135\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"136\">) {\n</span><span class=\"lens-source-line\" data-line=\"137\">  _ = &amp;elevationValues;\n</span><span class=\"lens-source-line\" data-line=\"138\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"139\">  _ = &amp;settings;\n</span><span class=\"lens-source-line\" data-line=\"140\">  _ = &amp;pairs;\n</span><span class=\"lens-source-line\" data-line=\"141\">  _ = &amp;visibilityValues;\n</span><span class=\"lens-source-line\" data-line=\"142\">  _ = &amp;clearanceValues;\n</span><span class=\"lens-source-line\" data-line=\"143\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"144\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"145\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"146\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"147\">  if (workgroupIndex &gt;= 134217728u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"148\">  let index = workgroupIndex * 32u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"149\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"150\">    return;\n</span><span class=\"lens-source-line\" data-line=\"151\">  }\n</span><span class=\"lens-source-line\" data-line=\"152\">  let pairBase = pairsOffset + 4u * index;\n</span><span class=\"lens-source-line\" data-line=\"153\">  let observer = vec2&lt;f32&gt;(pairs[pairBase], pairs[pairBase + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"154\">  let targetPosition = vec2&lt;f32&gt;(pairs[pairBase + 2u], pairs[pairBase + 3u]);\n</span><span class=\"lens-source-line\" data-line=\"155\">  let observerHeight = settings[settingsOffset];\n</span><span class=\"lens-source-line\" data-line=\"156\">  let targetHeight = settings[settingsOffset + 1u];\n</span><span class=\"lens-source-line\" data-line=\"157\">  let maxDistance = settings[settingsOffset + 2u];\n</span><span class=\"lens-source-line\" data-line=\"158\">  let cellSize = vec2&lt;f32&gt;(settings[settingsOffset + 3u], settings[settingsOffset + 4u]);\n</span><span class=\"lens-source-line\" data-line=\"159\">  let curvature = settings[settingsOffset + 5u];\n</span><span class=\"lens-source-line\" data-line=\"160\">  let tolerance = vec4&lt;f32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"161\">    settings[settingsOffset + 6u], settings[settingsOffset + 7u],\n</span><span class=\"lens-source-line\" data-line=\"162\">    settings[settingsOffset + 8u], settings[settingsOffset + 9u]);\n</span><span class=\"lens-source-line\" data-line=\"163\">  let observerInside = isInsideGrid(observer);\n</span><span class=\"lens-source-line\" data-line=\"164\">  let targetInside = isInsideGrid(targetPosition);\n</span><span class=\"lens-source-line\" data-line=\"165\">  let observerSample = sampleElevation(select(vec2&lt;f32&gt;(0.0), observer, observerInside));\n</span><span class=\"lens-source-line\" data-line=\"166\">  let targetSample = sampleElevation(select(vec2&lt;f32&gt;(0.0), targetPosition, targetInside));\n</span><span class=\"lens-source-line\" data-line=\"167\">  var code = NO_DATA;\n</span><span class=\"lens-source-line\" data-line=\"168\">  // A runtime-dependent bit pattern: WGSL rejects constant-evaluated NaN.\n</span><span class=\"lens-source-line\" data-line=\"169\">  var clearance = bitcast&lt;f32&gt;(0x7fc00000u | (index &amp; 0u));\n</span><span class=\"lens-source-line\" data-line=\"170\">  if (observerInside &amp;&amp; targetInside &amp;&amp; observerSample.y != 0.0 &amp;&amp; targetSample.y != 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"171\">    let result = traceSightLine(\n</span><span class=\"lens-source-line\" data-line=\"172\">      observer, targetPosition, observerSample.x + observerHeight, targetSample.x + targetHeight,\n</span><span class=\"lens-source-line\" data-line=\"173\">      cellSize, curvature, maxDistance, tolerance);\n</span><span class=\"lens-source-line\" data-line=\"174\">    code = result.code;\n</span><span class=\"lens-source-line\" data-line=\"175\">    if (result.code != OUT_OF_RANGE) {\n</span><span class=\"lens-source-line\" data-line=\"176\">      clearance = result.clearance;\n</span><span class=\"lens-source-line\" data-line=\"177\">    }\n</span><span class=\"lens-source-line\" data-line=\"178\">  }\n</span><span class=\"lens-source-line\" data-line=\"179\">  visibilityValues[visibilityValuesOffset + index] = code;\n</span><span class=\"lens-source-line\" data-line=\"180\">  clearanceValues[clearanceValuesOffset + index] = clearance;\n</span><span class=\"lens-source-line\" data-line=\"181\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>elevationValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-line-of-sight-elevation-values\">terrain-line-of-sight-elevation-values</td><td>read</td><td>f32</td></tr><tr><td>elevationValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-line-of-sight-elevation-validity\">terrain-line-of-sight-elevation-validity</td><td>read</td><td>u32</td></tr><tr><td>settings<span