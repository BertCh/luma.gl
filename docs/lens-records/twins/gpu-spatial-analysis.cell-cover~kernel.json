signs of orient(starts[k], ends[k], points[k]) for k &lt; count (at most 4). The only call\n</span><span class=\"lens-source-line\" data-line=\"161\">// site of orientSign for kernels that use these helpers. An uncertain sign (code 2) becomes the\n</span><span class=\"lens-source-line\" data-line=\"162\">// f32 cross-product sign and sets &#39;uncertain&#39;.\n</span><span class=\"lens-source-line\" data-line=\"163\">fn exactOrientSigns(\n</span><span class=\"lens-source-line\" data-line=\"164\">  count: u32,\n</span><span class=\"lens-source-line\" data-line=\"165\">  starts: array&lt;vec2f, 4&gt;,\n</span><span class=\"lens-source-line\" data-line=\"166\">  ends: array&lt;vec2f, 4&gt;,\n</span><span class=\"lens-source-line\" data-line=\"167\">  points: array&lt;vec2f, 4&gt;\n</span><span class=\"lens-source-line\" data-line=\"168\">) -&gt; ExactSigns {\n</span><span class=\"lens-source-line\" data-line=\"169\">  var startValues = starts;\n</span><span class=\"lens-source-line\" data-line=\"170\">  var endValues = ends;\n</span><span class=\"lens-source-line\" data-line=\"171\">  var pointValues = points;\n</span><span class=\"lens-source-line\" data-line=\"172\">  var result = ExactSigns(vec4i(0), false);\n</span><span class=\"lens-source-line\" data-line=\"173\">  for (var k = 0u; k &lt; min(count, 4u); k++) {\n</span><span class=\"lens-source-line\" data-line=\"174\">    let a = startValues[k];\n</span><span class=\"lens-source-line\" data-line=\"175\">    let b = endValues[k];\n</span><span class=\"lens-source-line\" data-line=\"176\">    let c = pointValues[k];\n</span><span class=\"lens-source-line\" data-line=\"177\">    var value = orientSign(a, b, c);\n</span><span class=\"lens-source-line\" data-line=\"178\">    if (value == 2) {\n</span><span class=\"lens-source-line\" data-line=\"179\">      result.uncertain = true;\n</span><span class=\"lens-source-line\" data-line=\"180\">      let direction = b - a;\n</span><span class=\"lens-source-line\" data-line