  "figure": {
    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>cell-cover-count · 1×1×1 workgroups × 32×1×1 lanes = 32 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-spatial-analysis-cell-cover-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 32\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-cell-cover-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><rect x=\"2\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 0</title></rect><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><rect x=\"42\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 1</title></rect><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><rect x=\"82\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 2</title></rect><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><rect x=\"122\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 3</title></rect><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><rect x=\"162\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 4</title></rect><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><rect x=\"202\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 5</title></rect><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><rect x=\"242\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 6</title></rect><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><rect x=\"282\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 7</title></rect><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><rect x=\"322\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 8</title></rect><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><rect x=\"362\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 9</title></rect><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><rect x=\"402\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 10</title></rect><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><rect x=\"442\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 11</title></rect><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><rect x=\"482\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 12</title></rect><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><rect x=\"522\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 13</title></rect><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><rect x=\"562\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 14</title></rect><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"15\"><rect x=\"602\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>lane 15</title></rect><text x=\"605\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">15</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"16\"><rect x=\"642\" y=\"2\" width=\"36\" height=\"28\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\"><title>