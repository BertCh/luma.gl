a-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>64 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const leftFeatureOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; leftFeatureOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const leftPolygonOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; leftPolygonOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const leftRingOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; leftRingOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const rightFeatureOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; rightFeatureOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const rightPolygonOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read&gt; rightPolygonOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const rightRingOffsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"16\">@group(0) @binding(5) var&lt;storage, read&gt; rightRingOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"17\">const offsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"18\">@group(0) @binding(6) var&lt;storage, read_write&gt; offsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"19\">const sourcesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"20\">@group(0) @binding(7) var&lt;storage, read_write&gt; sources: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"21\">const LEFT_RING_COUNT: u32 = 51u;\n</span><span class=\"lens-source-line\" data-line=\"22\">const LEFT_EXPANDED_VERTEX_COUNT: u32 = 601u;\n</span><span class=\"lens-source-line\" data-line=\"23\">const LEFT_POLYGON_COUNT: u32 = 51u;\n</span><span class=\"lens-source-line\" data-line=\"24\">const RIGHT_POLYGON_COUNT: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"25\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"26\">@compute @workgroup_size(64)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"27\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"28\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"29\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"30\">) {\n</span><span class=\"lens-source-line\" data-line=\"31\">  _ = &amp;leftFeatureOffsets;\n</span><span class=\"lens-source-line\" data-line=\"32\">  _ = &amp;leftPolygonOffsets;\n</span><span class=\"lens-source-line\" data-line=\"33\">  _ = &amp;leftRingOffsets;\n</span><span class=\"lens-source-line\" data-line=\"34\">  _ = &amp;rightFeatureOffsets;\n</span><span class=\"lens-source-line\" data-line=\"35\">  _ = &amp;rightPolygonOffsets;\n</span><span class=\"lens-source-line\" data-line=\"36\">  _ = &amp;rightRingOffsets;\n</span><span class=\"lens-source-line\" data-line=\"37\">  _ = &amp;offsets;\n</span><span class=\"lens-source-line\" data-line=\"38\">  _ = &amp;sources;\n</span><span class=\"lens-source-line\" data-line=\"39\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"40\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"41\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"42\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"43\">  if (workgroupIndex &gt;= 67108864u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"44\">  let index = workgroupIndex * 64u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"45\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"46\">    return;\n</span><span class=\"lens-source-line\" data-line=\"47\">  }\n</span><span class=\"lens-source-line\" data-line=\"48\">  if (index &lt;= LEFT_RING_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"49\">    offsets[offsetsOffset + index] = leftRingOffsets[leftRingOffsetsOffset + index] + index;\n</span><span class=\"lens-source-line\" data-line=\"50\">  } else {\n</span><span class=\"lens-source-line\" data-line=\"51\">    let rightRing = index - LEFT_RING_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"52\">    offsets[offsetsOffset + index] = LEFT_EXPANDED_VERTEX_COUNT + rightRingOffsets[rightRingOffsetsOffset + rightRing] + rightRing;\n</span><span class=\"lens-source-line\" data-line=\"53\">  }\n</span><span class=\"lens-source-line\" data-line=\"54\">  if (index &gt;= 52u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"55\">  let fromLeft = index &lt; LEFT_RING_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"56\">  let ring = select(index - LEFT_RING_COUNT, index, fromLeft);\n</span><span class=\"lens-source-line\" data-line=\"57\">  var polygon = 0u;\n</span><span class=\"lens-source-line\" data-line=\"58\">  var high = select(RIGHT_POLYGON_COUNT, LEFT_POLYGON_COUNT, fromLeft);\n</span><span class=\"lens-source-line\" data-line=\"59\">  while (polygon + 1u &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"60\">    let middle = (polygon + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"61\">    var start = 0u;\n</span><span class=\"lens-source-line\" data-line=\"62\">    if (fromLeft) { start = leftPolygonOffsets[leftPolygonOffsetsOffset + middle]; }\n</span><span class=\"lens-source-line\" data-line=\"63\">    else { start = rightPolygonOffsets[rightPolygonOffsetsOffset + middle]; }\n</span><span class=\"lens-source-line\" data-line=\"64\">    if (start &lt;= ring) { polygon = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"65\">  }\n</span><span class=\"lens-source-line\" data-line=\"66\">  var feature = 0u;\n</span><span class=\"lens-source-line\" data-line=\"67\">  high = select(1u, 51u, fromLeft);\n</span><span class=\"lens-source-line\" data-line=\"68\">  while (feature + 1u &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"69\">    let middle = (feature + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"70\">    var start = 0u;\n</span><span class=\"lens-source-line\" data-line=\"71\">    if (fromLeft) { start = leftFeatureOffsets[leftFeatureOffsetsOffset + middle]; }\n</span><span class=\"lens-source-line\" data-line=\"72\">    else { start = rightFeatureOffsets[rightFeatureOffsetsOffset + middle]; }\n</span><span class=\"lens-source-line\" data-line=\"73\">    if (start &lt;= polygon) { feature = middle; } else { high = middle; }\n</span><span class=\"lens-source-line\" data-line=\"74\">  }\n</span><span class=\"lens-source-line\" data-line=\"75\">  sources[sourcesOffset + index] = feature | select(0x80000000u, 0u, fromLeft);\n</span><span class=\"lens-source-line\" data-line=\"76\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>leftFeatureOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"featureOffsets\">featureOffsets</td><td>read</td><td>u32</td></tr><tr><td>leftPolygonOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"polygonOffsets\">polygonOffsets</td><td>read</td><td>u32</td></tr><tr><td>leftRingOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"ringOffsets\">ringOffsets</td><td>read</td><td>u32</td></tr><tr><td>rightFeatureOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"areaFeatureOffsets\">areaFeatureOffsets</td><td>read</td><td>u32</td></tr><tr><td>rightPolygonOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"areaPolygonOffsets\">areaPolygonOffsets</td><td>read</td><td>u32</td></tr><tr><td>rightRingOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"areaRingOffsets\">areaRingOffsets</td><td>read</td><td>u32</td></tr><tr><td>offsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></