ource-line\" data-line=\"18\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"19\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"20\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"21\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"22\">    return;\n</span><span class=\"lens-source-line\" data-line=\"23\">  }\n</span><span class=\"lens-source-line\" data-line=\"24\">  fillTarget[fillTargetOffset + index] = 3212836864u;\n</span><span class=\"lens-source-line\" data-line=\"25\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>fillTarget<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"map-matching-edge-table\">map-matching-edge-table</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUMapMatching/fill · main · b32331b1</figcaption></figure></section>",
