    "html": "<section class=\"lens-view lens-dispatch-view\"><h3>emerging-hot-spots-block-sums · 1×1×1 workgroups × 256×1×1 lanes = 256 invocations</h3><svg class=\"lens-workgroups\" viewBox=\"0 0 640 24\" role=\"img\" aria-label=\"Workgroups\"><defs><pattern id=\"lens-gpu-spatial-analysis-emerging-hot-spots-kernel-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><rect x=\"1\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"#181818\" stroke-width=\"3\" data-state=\"selection\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"0\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-spatial-analysis-emerging-hot-spots-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const valuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; values: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const sumPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; sumPartials: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const countPartialsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; countPartials: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">\n</span><span class=\"lens-source-line\" data-line=\"12\">const GRID_WIDTH: u32 = 14u;\n</span><span class=\"lens-source-line\" data-line=\"13\">const GRID_HEIGHT: u32 = 16u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const CELL_COUNT: u32 = 224u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const SLICE_COUNT: u32 = 12u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const BIN_COUNT: u32 = 2688u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const BIN_BLOCK: u32 = 4096u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const MAXIMUM_RADIUS: f32 = 2.0;\n</span><span class=\"lens-source-line\" data-line=\"19\">const SELF_WEIGHT: f32 = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"20\">\n</span><span class=\"lens-source-line\" data-line=\"21\">\n</span><span class=\"lens-source-line\" data-line=\"22\">fn isFiniteFloat(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">\n</span><span class=\"lens-source-line\" data-line=\"25\">// A runtime operand keeps the quiet-NaN bit pattern out of constant evaluation.\n</span><span class=\"lens-source-line\" data-line=\"26\">\n</span><span class=\"lens-source-line\" data-line=\"27\">fn getQuietNaN(seed: u32) -&gt; f32 { return bitcast&lt;f32&gt;(0x7fc00000u | (seed &amp; 0u)); }\n</span><span class=\"lens-source-line\" data-line=\"28\">\n</span><span class=\"lens-source-line\" data-line=\"29\">\n</span><span class=\"lens-source-line\" data-line=\"30\">// Two-sided normal p-value erfc(|z| / sqrt(2)) with the Numerical Recipes erfcc Chebyshev fit\n</span><span class=\"lens-source-line\" data-line=\"31\">// (fractional error below 1.2e-7 in exact arithmetic), so tiny p-values keep relative accuracy.\n</span><span class=\"lens-source-line\" data-line=\"32\">fn getTwoSidedPValue(z: f32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"33\">  let x = abs(z) * 0.70710678118654752;\n</span><span class=\"lens-source-line\" data-line=\"34\">  let t = 1.0 / (1.0 + 0.5 * x);\n</span><span class=\"lens-source-line\" data-line=\"35\">  let exponent = -x * x - 1.26551223 + t * (1.00002368 + t * (0.37409196 + t * (0.09678418 +\n</span><span class=\"lens-source-line\" data-line=\"36\">    t * (-0.18628806 + t * (0.27886807 + t * (-1.13520398 + t * (1.48851587 +\n</span><span class=\"lens-source-line\" data-line=\"37\">    t * (-0.82215223 + t * 0.17087277))))))));\n</span><span class=\"lens-source-line\" data-line=\"38\">  return min(t * exp(exponent), 1.0);\n</span><span class=\"lens-source-line\" data-line=\"39\">}\n</span><span class=\"lens-source-line\" data-line=\"40\">\n</span><span class=\"lens-source-line\" data-line=\"41\">\n</span><span class=\"lens-source-line\" data-line=\"42\">fn readValue(bin: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"43\">  return f32(values[valuesOffset + bin]);\n</span><span class=\"lens-source-line\" data-line=\"44\">}\n</span><span class=\"lens-source-line\" data-line=\"45\">\n</span><span class=\"lens-source-line\" data-line=\"46\">fn isBinValid(bin: u32, cell: u32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"47\">  \n</span><span class=\"lens-source-line\" data-line=\"48\">  return isFiniteFloat(readValue(bin));\n</span><span class=\"lens-source-line\" data-line=\"49\">}\n</span><span class=\"lens-source-line\" data-line=\"50\">\n</span><span class=\"lens-source-line\" data-line=\"51\">var&lt;workgroup&gt; partialSums: array&lt;f32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"52\">var&lt;workgroup&gt; partialCounts: array&lt;u32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"53\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"54\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"55\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"56\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"57\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"58\">) {\n</span><span class=\"lens-source-line\" data-line=\"59\">  _ = &amp;values;\n</span><span class=\"lens-source-line\" data-line=\"60\">  _ = &amp;sumPartials;\n</span><span class=\"lens-source-line\" data-line=\"61\">  _ = &amp;countPartials;\n</span><span class=\"lens-source-line\" data-line=\"62\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"63\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"64\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"65\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"66\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"67\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"68\">  \n</span><span class=\"lens-source-line\" data-line=\"69\">  let block = index / 256u;\n</span><span class=\"lens-source-line\" data-line=\"70\">  let isInRange = index &lt; INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"71\">  var sum = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"72\">  var count = 0u;\n</span><span class=\"lens-source-line\" data-line=\"73\">  if (isInRange) {\n</span><span class=\"lens-source-line\" data-line=\"74\">    let begin = block * BIN_BLOCK;\n</span><span class=\"lens-source-line\" data-line=\"75\">    let end = min(begin + BIN_BLOCK, BIN_COUNT);\n</span><span class=\"lens-source-line\" data-line=\"76\">    for (var bin = begin + localInvocationIndex; bin &lt; end; bin += 256u) {\n</span><span class=\"lens-source-line\" data-line=\"77\">      if (isBinValid(bin, bin / SLICE_COUNT)) {\n</span><span class=\"lens-source-line\" data-line=\"78\">        sum += readValue(bin);\n</span><span class=\"lens-source-line\" data-line=\"79\">        count++;\n</span><span class=\"lens-source-line\" data-line=\"80\">      }\n</span><span class=\"lens-source-line\" data-line=\"81\">    }\n</span><span class=\"lens-source-line\" data-line=\"82\">  }\n</span><span class=\"lens-source-line\" data-line=\"83\">  partialSums[localInvocationIndex] = sum;\n</span><span class=\"lens-source-line\" data-line=\"84\">  partialCounts[localInvocationIndex] = count;\n</span><span class=\"lens-source-line\" data-line=\"85\">  workgroupBarrier();\n</span><span class=\"lens-source-line\" data-line=\"86\">  for (var stride = 128u; stride &gt; 0u; stride = stride / 2u) {\n</span><span class=\"lens-source-line\" data-line=\"87\">    if (localInvocationIndex &lt; stride) {\n</span><span class=\"lens-source-line\" data-line=\"88\">      partialSums[localInvocationIndex] += partialSums[localInvocationIndex + stride];\n</span><span class=\"lens-source-line\" data-line=\"89\">      partialCounts[localInvocationIndex] += partialCounts[localInvocationIndex + stride];\n</span><span class=\"lens-source-line\" data-line=\"90\">    }\n</span><span class=\"lens-source-line\" data-line=\"91\">    workgroupBarrier();\n</span><span class=\"lens-source-line\" data-line=\"92\">  }\n</span><span class=\"lens-source-line\" data-line=\"93\">  if (isInRange &amp;&amp; localInvocationIndex == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"94\">    sumPartials[sumPartialsOffset + block] = partialSums[0];\n</span><span class=\"lens-source-line\" data-line=\"95\">    countPartials[countPartialsOffset + block] = partialCounts[0];\n</span><span class=\"lens-source-line\" data-line=\"96\">  }\n</span><span class=\"lens-source-line\" data-line=\"97\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>values<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"cube\">cube</td><td>read</td><td>u32</td></tr><tr><td>sumPartials<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"emerging-hot-spots-sum-partials\">emerging-hot-spots-sum-partials</td><td>read_write</td><td>f32</td></tr><tr><td>countPartials<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"emerging-hot-spots-count-partials\">emerging-hot-spots-count-partials</td><td>read_write</td><td>u32</td></tr></tb