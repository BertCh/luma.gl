"341\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"17\"></rect><rect x=\"361\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"18\"></rect><rect x=\"381\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"19\"></rect><rect x=\"401\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"20\"></rect><rect x=\"421\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"21\"></rect><rect x=\"441\" y=\"1\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"22\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-core-segmented-reduction-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">const INPUT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"2\">const SEGMENT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"3\">const OUTPUT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"4\">@group(0) @binding(0) var&lt;storage, read&gt; inputValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"5\">@group(0) @binding(1) var&lt;storage, read&gt; segmentOffsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(2) var&lt;storage, read_write&gt; outputValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">var&lt;workgroup&gt; scratch: array&lt;f32, 256&gt;;\n</span><span class=\"lens-source-line\" data-line=\"8\">fn combine(a: f32, b: f32) -&gt; f32 { return a + b; }\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"9\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"10\">fn main(@builtin(workgroup_id) wg: vec3u, @builtin(local_invocation_index) lane: u32) {\n</span><span class=\"lens-source-line\" data-line=\"11\">  let segment = wg.x;\n</span><span class=\"lens-source-line\" data-line=\"12\">  let begin = segmentOffsets[SEGMENT_OFFSET + segment];\n</span><span class=\"lens-source-line\" data-line=\"13\">  let end = segmentOffsets[SEGMENT_OFFSET + segment + 1u];\n</span><span class=\"lens-source-line\" data-line=\"14\">  var value: f32 = 0.0;\n</span><span class=\"lens-source-line\" data-line=\"15\">  var i = begin + lane;\n</span><span class=\"lens-source-line\" data-line=\"16\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"17\">    if (i &gt;= end) { break; }\n</span><span class=\"lens-source-line\" data-line=\"18\">    value = combine(value, inputValues[INPUT_OFFSET + i]);\n</span><span class=\"lens-source-line\" data-line=\"19\">    i += 256u;\n</span><span class=\"lens-source-line\" data-line=\"20\">  }\n</span><span class=\"lens-source-line\" data-line=\"21\">  scratch[lane] = value;\n</span><span class=\"lens-source-line\" data-line=\"22\">  workgroupBarrier();\n</span><span class=\"lens-source-line\" data-line=\"23\">  var stride = 128u;\n</span><span class=\"lens-source-line\" data-line=\"24\">  loop {\n</span><span class=\"lens-source-line\" data-line=\"25\">    if (stride == 0u) { break; }\n</span><span class=\"lens-source-line\" data-line=\"26\">    if (lane &lt; stride) { scratch[lane] = combine(scratch[lane], scratch[lane + stride]); }\n</span><span class=\"lens-source-line\" data-line=\"27\">    workgroupBarrier();\n</span><span class=\"lens-source-line\" data-line=\"28\">    stride = stride / 2u;\n</span><span class=\"lens-source-line\" data-line=\"29\">  }\n</span><span class=\"lens-source-line\" data-line=\"30\">  if (lane == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"31\">    outputValues[OUTPUT_OFFSET + segment] = select(scratch[0], f32(0), begin == end);\n</span><span class=\"lens-source-line\" data-line=\"32\">  }\n</span><span class=\"lens-source-line\" data-line=\"33\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>inputValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"rainfall\">rainfall</td><td>read</td><td>f32</td></tr><tr><td>segmentOffsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"stateOffsets\">stateOffsets</td><td>read</td><td>u32</td></tr><tr><td>outputValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"stateTotals\">stateTotals</td><td>write</td><td>f32</td></tr></tbody></table><figcaption>GPUSegmentedReduction/reduce · main · 830cc50a</figcaption></figure></section>",
