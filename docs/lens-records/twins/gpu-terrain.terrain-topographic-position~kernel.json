errain-terrain-topographic-position-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const elevationValuesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; elevationValues: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const elevationValidityOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; elevationValidity: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const lowPlanesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; lowPlanes: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const highPlanesOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; highPlanes: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const PIXEL_COUNT: u32 = 4096u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const INVERSE_QUANTUM: f32 = 256.0;\n</span><span class=\"lens-source-line\" data-line=\"15\">\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line\" data-line=\"19\">const MAXIMUM_QUANTIZED: f32 = 2147483520.0;\n</span><span class=\"lens-source-line\" data-line=\"20\">fn add64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"21\">  let low = left.x + right.x;\n</span><span class=\"lens-source-line\" data-line=\"22\">  return vec2&lt;u32&gt;(low, left.y + right.y + select(0u, 1u, low &lt; left.x));\n</span><span class=\"lens-source-line\" data-line=\"23\">}\n</span><span class=\"lens-source-line\" data-line=\"24\">fn subtract64(left: vec2&lt;u32&gt;, right: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"25\">  return vec2&lt;u32&gt;(left.x - right.x, left.y - right.y - select(0u, 1u, left.x &lt; right.x));\n</span><span class=\"lens-source-line\" data-line=\"26\">}\n</span><span class=\"lens-source-line\" data-line=\"27\">fn multiplyWide32(left: u32, right: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"28\">  let left0 = left &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"29\">  let left1 = left &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"30\">  let right0 = right &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"31\">  let right1 = right &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"32\">  let product00 = left0 * right0;\n</span><span class=\"lens-source-line\" data-line=\"33\">  let product01 = left0 * right1;\n</span><span class=\"lens-source-line\" data-line=\"34\">  let product10 = left1 * right0;\n</span><span class=\"lens-source-line\" data-line=\"35\">  let product11 = left1 * right1;\n</span><span class=\"lens-source-line\" data-line=\"36\">  let middle = (product00 &gt;&gt; 16u) + (product01 &amp; 0xffffu) + (product10 &amp; 0xffffu);\n</span><span class=\"lens-source-line\" data-line=\"37\">  return vec2&lt;u32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"38\">    (product00 &amp; 0xffffu) | (middle &lt;&lt; 16u),\n</span><span class=\"lens-source-line\" data-line=\"39\">    product11 + (product01 &gt;&gt; 16u) + (product10 &gt;&gt; 16u) + (middle &gt;&gt; 16u)\n</span><span class=\"lens-source-line\" data-line=\"40\">  );\n</span><span class=\"lens-source-line\" data-line=\"41\">}\n</span><span class=\"lens-source-line\" data-line=\"42\">fn multiply64By32(left: vec2&lt;u32&gt;, right: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"43\">  let wide = multiplyWide32(left.x, right);\n</span><span class=\"lens-source-line\" data-line=\"44\">  return vec2&lt;u32&gt;(wide.x, wide.y + left.y * right);\n</span><span class=\"lens-source-line\" data-line=\"45\">}\n</span><span class=\"lens-source-line\" data-line=\"46\">fn negate64(value: vec2&lt;u32&gt;) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"47\">  return subtract64(vec2&lt;u32&gt;(0u, 0u), value);\n</span><span class=\"lens-source-line\" data-line=\"48\">}\n</span><span class=\"lens-source-line\" data-line=\"49\">fn unsigned64ToFloat(value: vec2&lt;u32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"50\">  return f32(value.y) * 4294967296.0 + f32(value.x);\n</span><span class=\"lens-source-line\" data-line=\"51\">}\n</span><span class=\"lens-source-line\" data-line=\"52\">// Converts the magnitude, not the two&#39;s-complement words: f32(hi) * 2^32 + f32(lo) of a small\n</span><span class=\"lens-source-line\" data-line=\"53\">// negative value cancels -2^32 against a low word rounded up to 2^32.\n</span><span class=\"lens-source-line\" data-line=\"54\">fn signed64ToFloat(value: vec2&lt;u32&gt;) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"55\">  if (bitcast&lt;i32&gt;(value.y) &lt; 0i) {\n</span><span class=\"lens-source-line\" data-line=\"56\">    return -unsigned64ToFloat(negate64(value));\n</span><span class=\"lens-source-line\" data-line=\"57\">  }\n</span><span class=\"lens-source-line\" data-line=\"58\">  return unsigned64ToFloat(value);\n</span><span class=\"lens-source-line\" data-line=\"59\">}\n</span><span class=\"lens-source-line\" data-line=\"60\">fn isQuantizable(elevation: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"61\">  return isFiniteValue(elevation) &amp;&amp; abs(elevation * INVERSE_QUANTUM) &lt;= MAXIMUM_QUANTIZED;\n</span><span class=\"lens-source-line\" data-line=\"62\">}\n</span><span class=\"lens-source-line\" data-line=\"63\">fn quantizeElevation(elevation: f32) -&gt; i32 {\n</span><span class=\"lens-source-line\" data-line=\"64\">  return i32(round(elevation * INVERSE_QUANTUM));\n</span><span class=\"lens-source-line\" data-line=\"65\">}\n</span><span class=\"lens-source-line\" data-line=\"66\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"67\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"68\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"69\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"70\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"71\">) {\n</span><span class=\"lens-source-line\" data-line=\"72\">  _ = &amp;elevationValues;\n</span><span class=\"lens-source-line\" data-line=\"73\">  _ = &amp;elevationValidity;\n</span><span class=\"lens-source-line\" data-line=\"74\">  _ = &amp;lowPlanes;\n</span><span class=\"lens-source-line\" data-line=\"75\">  _ = &amp;highPlanes;\n</span><span class=\"lens-source-line\" data-line=\"76\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"77\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"78\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"79\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"80\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"81\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"82\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"83\">    return;\n</span><span class=\"lens-source-line\" data-line=\"84\">  }\n</span><span class=\"lens-source-line\" data-line=\"85\">  let elevation = elevationValues[elevationValuesOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"86\">  let isValid = elevationValidity[elevationValidityOffset + index] != 0u &amp;&amp; isQuantizable(elevation);\n</span><span class=\"lens-source-line\" data-line=\"87\">  var quantized = 0i;\n</span><span class=\"lens-source-line\" data-line=\"88\">  if (isValid) {\n</span><span class=\"lens-source-line\" data-line=\"89\">    quantized = quantizeElevation(elevation);\n</span><span class=\"lens-source-line\" data-line=\"90\">  }\n</span><span class=\"lens-source-line\" data-line=\"91\">  lowPlanes[lowPlanesOffset + index] = bitcast&lt;u32&gt;(quantized);\n</span><span class=\"lens-source-line\" data-line=\"92\">  lowPlanes[lowPlanesOffset + 2u * PIXEL_COUNT + index] = select(0u, 1u, isValid);\n</span><span class=\"lens-source-line\" data-line=\"93\">  highPlanes[highPlanesOffset + index] = select(0u, 0xffffffffu, quantized &lt; 0i);\n</span><span class=\"lens-source-line\" data-line=\"94\">  let magnitude = u32(abs(quantized));\n</span><span class=\"lens-source-line\" data-line=\"95\">  let square = multiplyWide32(magnitude, magnitude);\n</span><span class=\"lens-source-line\" data-line=\"96\">  lowPlanes[lowPlanesOffset + PIXEL_COUNT + index] = square.x;\n</span><span class=\"lens-source-line\" data-line=\"97\">  highPlanes[highPlanesOffset + PIXEL_COUNT + index] = square.y;\n</span><span class=\"lens-source-line\" data-line=\"98\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>elevationValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-topographic-position-elevation-values\">terrain-topographic-position-elevation-values</td><td>read</td><td>f32</td></tr><tr><td>elevationValidity<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-topographic-position-elevation-validity\">terrain-topographic-position-elevation-validity</td><td>read</td><td>u32</td></tr><tr><td>lowPlanes<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-topographic-position-summed-area-first-low\">terrain-topographic-position-summed-area-first-low</td><td>read_write</td><td>u32</td></tr><tr><td>highPlanes<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"terrain-topographic-position-summed-area-first-high\">terrain-topographic-position-summed-area-first-high</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUTerrainTopographicPosition/quantize · main · f7e439f0</figcaption></figure></section>",
