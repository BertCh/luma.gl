uage=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const fillTargetOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read_write&gt; fillTarget: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">\n</span><span class=\"lens-source-line\" data-line=\"8\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"9\">@compute @workgroup_size(64)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"10\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"11\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"12\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"13\">) {\n</span><span class=\"lens-source-line\" data-line=\"14\">  _ = &amp;fillTarget;\n</span><span class=\"lens-source-line\" data-line=\"15\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"16\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"17\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"18\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"19\">  if (workgroupIndex &gt;= 67108864u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"20\">  let index = workgroupIndex * 64u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"21\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"22\">    return;\n</span><span class=\"lens-source-line\" data-line=\"23\">  }\n</span><span class=\"lens-source-line\" data-line=\"24\">  fillTarget[fillTargetOffset + index] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"25\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>fillTarget<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"raster-sieve-pixel-counts\">raster-sieve-pixel-counts</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPURasterSieve/fill · main · 4214f29d</figcaption></figure></section>",
