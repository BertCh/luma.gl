axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">const VERTEX_COUNT: u32 = 1199u;\n</span><span class=\"lens-source-line\" data-line=\"3\">const OFFSETS_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"4\">const OUTPUT_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"5\">@group(0) @binding(0) var&lt;storage, read&gt; offsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(1) var&lt;storage, read_write&gt; output: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"8\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"9\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"10\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"11\">  @builtin(local_invocation_index) localInvocationIndex: u32\n</span><span class=\"lens-source-line\" data-line=\"12\">) {\n</span><span class=\"lens-source-line\" data-line=\"13\">  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 5u + workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"14\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"15\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"16\">  if (index &gt;= VERTEX_COUNT) { return; }\n</span><span class=\"lens-source-line\" data-line=\"17\">  output[OUTPUT_OFFSET + index] =\n</span><span class=\"lens-source-line\" data-line=\"18\">    offsets[OFFSETS_OFFSET + index + 1u] - offsets[OFFSETS_OFFSET + index];\n</span><span class=\"lens-source-line\" data-line=\"19\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>offsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"gpu-network.network-analytics-columns-offsets\">gpu-network.network-analytics-columns-offsets</td><td>read</td><td>u32</td></tr><tr><td>output<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"degree\">degree</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUGraphDegree · main · 99a2a015</figcaption></figure></section>",
