" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"46\"></rect><rect x=\"301\" y=\"21\" width=\"17\" height=\"17\" data-provenance=\"metadata\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1\" data-action=\"bind\" data-axis=\"workgroup\" data-key=\"47\"></rect></svg><h4>Workgroup 0 (default)</h4><svg class=\"lens-lanes\" viewBox=\"0 0 1280 256\" role=\"img\" aria-label=\"Lanes in expanded workgroup\"><defs><pattern id=\"lens-gpu-raster-line-integral-convolution-kernel-lanes-hatched\" patternUnits=\"userSpaceOnUse\" width=\"6\" height=\"6\" patternTransform=\"rotate(45)\"><line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"6\" stroke=\"#595959\" stroke-width=\"1\"></line></pattern></defs><image width=\"1280\" height=\"256\" preserveAspectRatio=\"none\" image-rendering=\"pixelated\" data-provenance=\"metadata\" data-raster-width=\"32\" data-raster-height=\"8\" data-sampling=\"nearest\" href=\"data:image/png;base64,\"></image><g data-action=\"pick\" data-axis=\"lane\" data-key=\"0\"><text x=\"5\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">0</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"1\"><text x=\"45\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">1</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"2\"><text x=\"85\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">2</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"3\"><text x=\"125\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">3</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"4\"><text x=\"165\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">4</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const wordsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; words: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const noiseOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; noise: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">\n</span><span class=\"lens-source-line\" data-line=\"10\">fn philoxMulHiLo(a: u32, b: u32) -&gt; vec2&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"11\">  let aLow = a &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"12\">  let aHigh = a &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"13\">  let bLow = b &amp; 0xffffu;\n</span><span class=\"lens-source-line\" data-line=\"14\">  let bHigh = b &gt;&gt; 16u;\n</span><span class=\"lens-source-line\" data-line=\"15\">  let lowLow = aLow * bLow;\n</span><span class=\"lens-source-line\" data-line=\"16\">  let highLow = aHigh * bLow;\n</span><span class=\"lens-source-line\" data-line=\"17\">  let lowHigh = aLow * bHigh;\n</span><span class=\"lens-source-line\" data-line=\"18\">  let highHigh = aHigh * bHigh;\n</span><span class=\"lens-source-line\" data-line=\"19\">  let middle = (lowLow &gt;&gt; 16u) + (highLow &amp; 0xffffu) + (lowHigh &amp; 0xffffu);\n</span><span class=\"lens-source-line\" data-line=\"20\">  let high = highHigh + (highLow &gt;&gt; 16u) + (lowHigh &gt;&gt; 16u) + (middle &gt;&gt; 16u);\n</span><span class=\"lens-source-line\" data-line=\"21\">  return vec2&lt;u32&gt;(high, a * b);\n</span><span class=\"lens-source-line\" data-line=\"22\">}\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line\" data-line=\"24\">fn philoxRound(counter: vec4&lt;u32&gt;, key: vec2&lt;u32&gt;) -&gt; vec4&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"25\">  let product0 = philoxMulHiLo(3528531795u, counter.x);\n</span><span class=\"lens-source-line\" data-line=\"26\">  let product1 = philoxMulHiLo(3449720151u, counter.z);\n</span><span class=\"lens-source-line\" data-line=\"27\">  return vec4&lt;u32&gt;(\n</span><span class=\"lens-source-line\" data-line=\"28\">    product1.x ^ counter.y ^ key.x,\n</span><span class=\"lens-source-line\" data-line=\"29\">    product1.y,\n</span><span class=\"lens-source-line\" data-line=\"30\">    product0.x ^ counter.w ^ key.y,\n</span><span class=\"lens-source-line\" data-line=\"31\">    product0.y\n</span><span class=\"lens-source-line\" data-line=\"32\">  );\n</span><span class=\"lens-source-line\" data-line=\"33\">}\n</span><span class=\"lens-source-line\" data-line=\"34\">\n</span><span class=\"lens-source-line\" data-line=\"35\">fn philox4x32(counterIn: vec4&lt;u32&gt;, keyIn: vec2&lt;u32&gt;) -&gt; vec4&lt;u32&gt; {\n</span><span class=\"lens-source-line\" data-line=\"36\">  var counter = counterIn;\n</span><span class=\"lens-source-line\" data-line=\"37\">  var key = keyIn;\n</span><span class=\"lens-source-line\" data-line=\"38\">  for (var roundIndex = 0u; roundIndex &lt; 9u; roundIndex = roundIndex + 1u) {\n</span><span class=\"lens-source-line\" data-line=\"39\">    counter = philoxRound(counter, key);\n</span><span class=\"lens-source-line\" data-line=\"40\">    key = key + vec2&lt;u32&gt;(2654435769u, 3144134277u);\n</span><span class=\"lens-source-line\" data-line=\"41\">  }\n</span><span class=\"lens-source-line\" data-line=\"42\">  return philoxRound(counter, key);\n</span><span class=\"lens-source-line\" data-line=\"43\">}\n</span><span class=\"lens-source-line\" data-line=\"44\">\n</span><span class=\"lens-source-line\" data-line=\"45\">fn philoxUnitFloat(word: u32) -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"46\">  return f32(word &gt;&gt; 8u) * (1.0 / 16777216.0);\n</span><span class=\"lens-source-line\" data-line=\"47\">}\n</span><span class=\"lens-source-line\" data-line=\"48\">\n</span><span class=\"lens-source-line\" data-line=\"49\">const WIDTH: u32 = 128u;\n</span><span class=\"lens-source-line\" data-line=\"50\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"51\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"52\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"53\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"54\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"55\">) {\n</span><span class=\"lens-source-line\" data-line=\"56\">  _ = &amp;words;\n</span><span class=\"lens-source-line\" data-line=\"57\">  _ = &amp;noise;\n</span><span class=\"lens-source-line\" data-line=\"58\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"59\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"60\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"61\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"62\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"63\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"64\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"65\">    return;\n</span><span class=\"lens-source-line\" data-line=\"66\">  }\n</span><span class=\"lens-source-line\" data-line=\"67\">  let seed = words[wordsOffset];\n</span><span class=\"lens-source-line\" data-line=\"68\">  let counter = vec4&lt;u32&gt;(index % WIDTH, index / WIDTH, 0u, 0u);\n</span><span class=\"lens-source-line\" data-line=\"69\">  noise[noiseOffset + index] = philoxUnitFloat(\n</span><span class=\"lens-source-line\" data-line=\"70\">    philox4x32(counter, vec2&lt;u32&gt;(seed, 1u)).x\n</span><span class=\"lens-source-line\" data-line=\"71\">  );\n</span><span class=\"lens-source-line\" data-line=\"72\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>words<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"lic-words\">lic-words</td><td>read</td><td>u32</td></tr><tr><td>noise<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"line-integral-convolution-noise\">line-integral-convolution-noise</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPULineIntegralConvolution/noise · main · 5861f0bb</figcaption></figure></section>",
