ane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const predictorsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; predictors: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const responseOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; response: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const rowValidOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; rowValid: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const ROW_COUNT: u32 = 788u;\n</span><span class=\"lens-source-line\" data-line=\"14\">const PREDICTOR_COUNT: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"15\">const P: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const LADDER: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const TABLE_ROWS: u32 = 13u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const MAXIMUM_NEIGHBORS: u32 = 128u;\n</span><span class=\"lens-source-line\" data-line=\"19\">const TILE_ROWS: u32 = 256u;\n</span><span class=\"lens-source-line\" data-line=\"20\">const TILE_COUNT: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"21\">const LOCAL_STRIDE: u32 = 6u;\n</span><span class=\"lens-source-line\" data-line=\"22\">const TILE_CANDIDATE_STRIDE: u32 = 5u;\n</span><span class=\"lens-source-line\" data-line=\"23\">const TABLE_STRIDE: u32 = 7u;\n</span><span class=\"lens-source-line\" data-line=\"24\">// Layout of the rowValid binding: validity flags, local results, standard errors, t values, tail.\n</span><span class=\"lens-source-line\" data-line=\"25\">const LOCALS_BASE: u32 = 788u;\n</span><span class=\"lens-source-line\" data-line=\"26\">const STANDARD_ERROR_BASE: u32 = 5516u;\n</span><span class=\"lens-source-line\" data-line=\"27\">const T_VALUE_BASE: u32 = 8668u;\n</span><span class=\"lens-source-line\" data-line=\"28\">const TAIL_BASE: u32 = 11820u;\n</span><span class=\"lens-source-line\" data-line=\"29\">const TAIL_SELECTED_INDEX: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"30\">const TAIL_SELECTED_VALUE: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"31\">const TAIL_KERNEL: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"32\">const TAIL_MODE: u32 = 3u;\n</span><span class=\"lens-source-line\" data-line=\"33\">const TAIL_SIGMA_SQUARED: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"34\">const TAIL_CRITICAL_T: u32 = 5u;\n</span><span class=\"lens-source-line\" data-line=\"35\">const HEADER: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"36\">const PARAMETER_LENGTH: u32 = 6u;\n</span><span class=\"lens-source-line\" data-line=\"37\">const SENTINEL: f32 = 3.0e38;\n</span><span class=\"lens-source-line\" data-line=\"38\">const ADAPTIVE_FACTOR: f32 = 1.00001;\n</span><span class=\"lens-source-line\" data-line=\"39\">const MINIMUM_VARIANCE: f32 = 1e-30;\n</span><span class=\"lens-source-line\" data-line=\"40\">const LN_TWO_PI: f32 = 1.8378770664093453;\n</span><span class=\"lens-source-line\" data-line=\"41\">\n</span><span class=\"lens-source-line\" data-line=\"42\">\n</span><span class=\"lens-source-line\" data-line=\"43\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"44\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"45\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"46\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"47\">}\n</span><span class=\"lens-source-line\" data-line=\"48\">\n</span><span class=\"lens-source-line\" data-line=\"49\">\n</span><span class=\"lens-source-line\" data-line=\"50\">\n</span><span class=\"lens-source-line\" data-line=\"51\">fn isFiniteBits(x: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"52\">  return (bitcast&lt;u32&gt;(x) &amp; 0x7f800000u) != 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"53\">}\n</span><span class=\"lens-source-line\" data-line=\"54\">\n</span><span class=\"lens-source-line\" data-line=\"55\">\n</span><span class=\"lens-source-line\" data-line=\"56\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"57\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"58\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"59\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"60\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"61\">) {\n</span><span class=\"lens-source-line\" data-line=\"62\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"63\">  _ = &amp;predictors;\n</span><span class=\"lens-source-line\" data-line=\"64\">  _ = &amp;response;\n</span><span class=\"lens-source-line\" data-line=\"65\">  _ = &amp;rowValid;\n</span><span class=\"lens-source-line\" data-line=\"66\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"67\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"68\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"69\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"70\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"71\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"72\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"73\">    return;\n</span><span class=\"lens-source-line\" data-line=\"74\">  }\n</span><span class=\"lens-source-line\" data-line=\"75\">  var isValid = true;\n</span><span class=\"lens-source-line\" data-line=\"76\">  \n</span><span class=\"lens-source-line\" data-line=\"77\">  if (!isFiniteBits(positions[positionsOffset + 2u * index]) ||\n</span><span class=\"lens-source-line\" data-line=\"78\">    !isFiniteBits(positions[positionsOffset + 2u * index + 1u]) ||\n</span><span class=\"lens-source-line\" data-line=\"79\">    !isFiniteBits(response[responseOffset + index])) {\n</span><span class=\"lens-source-line\" data-line=\"80\">    isValid = false;\n</span><span class=\"lens-source-line\" data-line=\"81\">  }\n</span><span class=\"lens-source-line\" data-line=\"82\">  \n</span><span class=\"lens-source-line\" data-line=\"83\">  for (var column = 0u; column &lt; PREDICTOR_COUNT; column++) {\n</span><span class=\"lens-source-line\" data-line=\"84\">    if (!isFiniteBits(predictors[predictorsOffset + index * PREDICTOR_COUNT + column])) {\n</span><span class=\"lens-source-line\" data-line=\"85\">      isValid = false;\n</span><span class=\"lens-source-line\" data-line=\"86\">    }\n</span><span class=\"lens-source-line\" data-line=\"87\">  }\n</span><span class=\"lens-source-line\" data-line=\"88\">  rowValid[rowValidOffset + index] = select(0u, 1u, isValid);\n</span><span class=\"lens-source-line\" data-line=\"89\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"positions\">positions</td><td>read</td><td>f32</td></tr><tr><td>predictors<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"predictors\">predictors</td><td>read</td><td>f32</td></tr><tr><td>response<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"response\">response</td><td>read</td><td>f32</td></tr><tr><td>rowValid<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"geographically-weighted-regression-row-state\">geographically-weighted-regression-row-state</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUGeographicallyWeightedRegression/validate · mai