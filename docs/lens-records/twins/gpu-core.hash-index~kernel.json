y=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">const CAPACITY: u32 = 2048u;\n</span><span class=\"lens-source-line\" data-line=\"3\">const DISPATCH_X: u32 = 8u;\n</span><span class=\"lens-source-line\" data-line=\"4\">const DISPATCH_Y: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"5\">const TABLE_KEYS_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"6\">const TABLE_VALUES_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"7\">const SOURCE_ROWS_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"8\">const STATISTICS_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"9\">@group(0) @binding(0) var&lt;storage, read_write&gt; tableKeys: array&lt;u32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(1) var&lt;storage, read_write&gt; tableValues: array&lt;u32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"11\">@group(0) @binding(2) var&lt;storage, read_write&gt; sourceRows: array&lt;u32&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; statistics: array&lt;u32&gt;;\n</span><span class=\"lens-source-line lens-source-line--workgroup-size lens-source-line--entry-point\" data-line=\"13\">@compute @workgroup_size(256) fn main(\n</span><span class=\"lens-source-line\" data-line=\"14\">  @builtin(workgroup_id) workgroupId: vec3u,\n</span><span class=\"lens-source-line\" data-line=\"15\">  @builtin(local_invocation_index) localIndex: u32\n</span><span class=\"lens-source-line\" data-line=\"16\">) {\n</span><span class=\"lens-source-line\" data-line=\"17\">  let workgroupIndex = (workgroupId.z * DISPATCH_Y + workgroupId.y) * DISPATCH_X + workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"18\">  let elementIndex = workgroupIndex * 256u + localIndex;\n</span><span class=\"lens-source-line\" data-line=\"19\">  if (elementIndex &lt; CAPACITY) {\n</span><span class=\"lens-source-line\" data-line=\"20\">    tableKeys[TABLE_KEYS_OFFSET + elementIndex] = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"21\">    tableValues[TABLE_VALUES_OFFSET + elementIndex] = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"22\">    sourceRows[SOURCE_ROWS_OFFSET + elementIndex] = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"23\">  }\n</span><span class=\"lens-source-line\" data-line=\"24\">  if (elementIndex &lt; 6u) {\n</span><span class=\"lens-source-line\" data-line=\"25\">    statistics[STATISTICS_OFFSET + elementIndex] = 0u;\n</span><span class=\"lens-source-line\" data-line=\"26\">  }\n</span><span class=\"lens-source-line\" data-line=\"27\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>tableKeys<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tableKeys\">tableKeys</td><td>write</td><td>u32</td></tr><tr><td>tableValues<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"tableValues\">tableValues</td><td>write</td><td>u32</td></tr><tr><td>sourceRows<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"station-hash-source-rows\">station-hash-source-rows</td><td>write</td><td>u32</td></tr><tr><td>statistics<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"statistics\">statistics</td><td>write</td><td>u32</td></tr></tbody></table><figcaption>GPUHashIndex/initialize · main · ca0c064b</figcaption></figure></section>",
