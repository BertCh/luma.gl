 data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const positionsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; positions: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const paramsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; params: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const pointWeightsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; pointWeights: array&lt;f32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const DOMAIN_MIN: vec2f = vec2f(-5375.0, -5875.0);\n</span><span class=\"lens-source-line\" data-line=\"12\">const DOMAIN_MAX: vec2f = vec2f(5750.0, 7125.0);\n</span><span class=\"lens-source-line\" data-line=\"13\">\n</span><span class=\"lens-source-line\" data-line=\"14\">\n</span><span class=\"lens-source-line\" data-line=\"15\">fn isFiniteValue(value: f32) -&gt; bool { return (bitcast&lt;u32&gt;(value) &amp; 0x7f800000u) != 0x7f800000u; }\n</span><span class=\"lens-source-line\" data-line=\"16\">\n</span><span class=\"lens-source-line\" data-line=\"17\">\n</span><span class=\"lens-source-line\" data-line=\"18\">fn isNanBits(x: f32) -&gt; bool {\n</span><span class=\"lens-source-line\" data-line=\"19\">  return (bitcast&lt;u32&gt;(x) &amp; 0x7fffffffu) &gt; 0x7f800000u;\n</span><span class=\"lens-source-line\" data-line=\"20\">}\n</span><span class=\"lens-source-line\" data-line=\"21\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"22\">\n</span><span class=\"lens-source-line\" data-line=\"23\">// WGSL rejects NaN constants, so build one from a runtime bit pattern.\n</span><span class=\"lens-source-line\" data-line=\"24\">fn getNaN() -&gt; f32 {\n</span><span class=\"lens-source-line\" data-line=\"25\">  var bits = 0x7fc00000u;\n</span><span class=\"lens-source-line\" data-line=\"26\">  return bitcast&lt;f32&gt;(bits);\n</span><span class=\"lens-source-line\" data-line=\"27\">}\n</span><span class=\"lens-source-line\" data-line=\"28\">\n</span><span class=\"lens-source-line\" data-line=\"29\">fn getCoordinate(value: f32, minimum: f32, maximum: f32, size: u32) -&gt; u32 {\n</span><span class=\"lens-source-line\" data-line=\"30\">  if (maximum == minimum || value == minimum) { return 0u; }\n</span><span class=\"lens-source-line\" data-line=\"31\">  if (value == maximum) { return size - 1u; }\n</span><span class=\"lens-source-line\" data-line=\"32\">  if (minimum &lt; 0.0 &amp;&amp; maximum &gt; 0.0) {\n</span><span class=\"lens-source-line\" data-line=\"33\">    let scale = max(abs(minimum), abs(maximum));\n</span><span class=\"lens-source-line\" data-line=\"34\">    let scaledValue = value / scale;\n</span><span class=\"lens-source-line\" data-line=\"35\">    let scaledMinimum = minimum / scale;\n</span><span class=\"lens-source-line\" data-line=\"36\">    let scaledMaximum = maximum / scale;\n</span><span class=\"lens-source-line\" data-line=\"37\">    return min(\n</span><span class=\"lens-source-line\" data-line=\"38\">      u32((scaledValue - scaledMinimum) / (scaledMaximum - scaledMinimum) * f32(size)),\n</span><span class=\"lens-source-line\" data-line=\"39\">      size - 1u\n</span><span class=\"lens-source-line\" data-line=\"40\">    );\n</span><span class=\"lens-source-line\" data-line=\"41\">  }\n</span><span class=\"lens-source-line\" data-line=\"42\">  return min(u32((value - minimum) / (maximum - minimum) * f32(size)), size - 1u);\n</span><span class=\"lens-source-line\" data-line=\"43\">}\n</span><span class=\"lens-source-line\" data-line=\"44\">\n</span><span class=\"lens-source-line\" data-line=\"45\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"46\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"47\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"48\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"49\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"50\">) {\n</span><span class=\"lens-source-line\" data-line=\"51\">  _ = &amp;positions;\n</span><span class=\"lens-source-line\" data-line=\"52\">  _ = &amp;params;\n</span><span class=\"lens-source-line\" data-line=\"53\">  _ = &amp;pointWeights;\n</span><span class=\"lens-source-line\" data-line=\"54\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"55\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"56\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"57\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"58\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"59\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"60\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"61\">    return;\n</span><span class=\"lens-source-line\" data-line=\"62\">  }\n</span><span class=\"lens-source-line\" data-line=\"63\">  let gridStart = vec2f(params[paramsOffset], params[paramsOffset + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"64\">  let bandwidth = params[paramsOffset + 4u];\n</span><span class=\"lens-source-line\" data-line=\"65\">  let windowMin = vec2f(params[paramsOffset + 5u], params[paramsOffset + 6u]) - gridStart;\n</span><span class=\"lens-source-line\" data-line=\"66\">  let windowMax = vec2f(params[paramsOffset + 7u], params[paramsOffset + 8u]) - gridStart;\n</span><span class=\"lens-source-line\" data-line=\"67\">  let position = vec2f(positions[positionsOffset + 2u * index], positions[positionsOffset + 2u * index + 1u]);\n</span><span class=\"lens-source-line\" data-line=\"68\">  let weight = 1.0;\n</span><span class=\"lens-source-line\" data-line=\"69\">  var included = isFiniteValue(position.x) &amp;&amp; isFiniteValue(position.y) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"70\">    all(position &gt;= DOMAIN_MIN) &amp;&amp; all(position &lt;= DOMAIN_MAX) &amp;&amp;\n</span><span class=\"lens-source-line\" data-line=\"71\">    isFiniteValue(weight) &amp;&amp; weight &gt;= 0.0;\n</span><span class=\"lens-source-line\" data-line=\"72\">  let relative = position - gridStart;\n</span><span class=\"lens-source-line\" data-line=\"73\">  included = included &amp;&amp; all(relative &gt;= windowMin) &amp;&amp; all(relative &lt;= windowMax);\n</span><span class=\"lens-source-line\" data-line=\"74\">  var corrected = select(0.0, weight, included);\n</span><span class=\"lens-source-line\" data-line=\"75\">  \n</span><span class=\"lens-source-line\" data-line=\"76\">  \n</span><span class=\"lens-source-line\" data-line=\"77\">  pointWeights[pointWeightsOffset + index] = corrected;\n</span><span class=\"lens-source-line\" data-line=\"78\">  \n</span><span class=\"lens-source-line\" data-line=\"79\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>positions<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"observations\">observations</td><td>read</td><td>f32</td></tr><tr><td>params<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kde-parameters\">kde-parameters</td><td>read</td><td>f32</td></tr><tr><td>pointWeights<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"kernel-density-point-weights\">kernel-density-point-weights</td><td>read_write</td><td>f32</td></tr></tbody></table><figcaption>GPUKernelDensity/point-weights-uniform · main · 55079192</figcaption></figure></section>",
