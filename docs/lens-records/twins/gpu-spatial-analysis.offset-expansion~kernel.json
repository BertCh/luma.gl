data-key=\"5\"><text x=\"205\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">5</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"6\"><text x=\"245\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">6</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"7\"><text x=\"285\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">7</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"8\"><text x=\"325\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">8</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"9\"><text x=\"365\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">9</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"10\"><text x=\"405\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">10</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"11\"><text x=\"445\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">11</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"12\"><text x=\"485\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">12</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"13\"><text x=\"525\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">13</text></g><g data-action=\"pick\" data-axis=\"lane\" data-key=\"14\"><text x=\"565\" y=\"21\" fill=\"currentColor\" data-provenance=\"metadata\">14</text></g></svg><p>256 lanes; first 15 and pinned lane labelled. Grey cells are idle or unavailable.</p><p>id probe not recorded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const offsetsOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; offsets: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const ownersOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read_write&gt; ownersOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const countOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read_write&gt; countOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const overflowOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read_write&gt; overflowOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const localOutOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; localOut: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const OWNER_COUNT: u32 = 199u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const CAPACITY: u32 = 2343u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const NO_OWNER: u32 = 4294967295u;\n</span><span class=\"lens-source-line\" data-line=\"18\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"19\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"20\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"21\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"22\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"23\">) {\n</span><span class=\"lens-source-line\" data-line=\"24\">  _ = &amp;offsets;\n</span><span class=\"lens-source-line\" data-line=\"25\">  _ = &amp;ownersOut;\n</span><span class=\"lens-source-line\" data-line=\"26\">  _ = &amp;countOut;\n</span><span class=\"lens-source-line\" data-line=\"27\">  _ = &amp;overflowOut;\n</span><span class=\"lens-source-line\" data-line=\"28\">  _ = &amp;localOut;\n</span><span class=\"lens-source-line\" data-line=\"29\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"30\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"31\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"32\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"33\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"34\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"35\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"36\">    return;\n</span><span class=\"lens-source-line\" data-line=\"37\">  }\n</span><span class=\"lens-source-line\" data-line=\"38\">  let total = offsets[offsetsOffset + OWNER_COUNT];\n</span><span class=\"lens-source-line\" data-line=\"39\">  if (index == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"40\">    countOut[countOutOffset] = min(total, CAPACITY);\n</span><span class=\"lens-source-line\" data-line=\"41\">    overflowOut[overflowOutOffset] = select(0u, 1u, total &gt; CAPACITY);\n</span><span class=\"lens-source-line\" data-line=\"42\">    \n</span><span class=\"lens-source-line\" data-line=\"43\">  }\n</span><span class=\"lens-source-line\" data-line=\"44\">  // Count the owners whose first row is at or before this row (offsets are non-decreasing).\n</span><span class=\"lens-source-line\" data-line=\"45\">  var low = 0u;\n</span><span class=\"lens-source-line\" data-line=\"46\">  var high = OWNER_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"47\">  while (low &lt; high) {\n</span><span class=\"lens-source-line\" data-line=\"48\">    let middle = (low + high) / 2u;\n</span><span class=\"lens-source-line\" data-line=\"49\">    if (offsets[offsetsOffset + middle] &lt;= index) {\n</span><span class=\"lens-source-line\" data-line=\"50\">      low = middle + 1u;\n</span><span class=\"lens-source-line\" data-line=\"51\">    } else {\n</span><span class=\"lens-source-line\" data-line=\"52\">      high = middle;\n</span><span class=\"lens-source-line\" data-line=\"53\">    }\n</span><span class=\"lens-source-line\" data-line=\"54\">  }\n</span><span class=\"lens-source-line\" data-line=\"55\">  var owner = NO_OWNER;\n</span><span class=\"lens-source-line\" data-line=\"56\">  var local = NO_OWNER;\n</span><span class=\"lens-source-line\" data-line=\"57\">  if (index &lt; total &amp;&amp; low &gt; 0u) {\n</span><span class=\"lens-source-line\" data-line=\"58\">    let ownerRow = low - 1u;\n</span><span class=\"lens-source-line\" data-line=\"59\">    owner = ownerRow;\n</span><span class=\"lens-source-line\" data-line=\"60\">    local = index - offsets[offsetsOffset + ownerRow];\n</span><span class=\"lens-source-line\" data-line=\"61\">  }\n</span><span class=\"lens-source-line\" data-line=\"62\">  ownersOut[ownersOutOffset + index] = owner;\n</span><span class=\"lens-source-line\" data-line=\"63\">  localOut[localOutOffset + index] = local;\n</span><span class=\"lens-source-line\" data-line=\"64\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>offsets<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"offsets\">offsets</td><td>read</td><td>u32</td></tr><tr><td>ownersOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"owners\">owners</td><td>read_write</td><td>u32</td></tr><tr><td>countOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"count\">count</td><td>read_write</td><td>u32</td></tr><tr><td>overflowOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"overflow\">overflow</td><td>read_write</td><td>u32</td></tr><tr><td>localOut<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"localIndex\">localIndex</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUOffsetExpansion · main · fb3a3187</figcaption></figure></section>",
