data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">const VERTEX_COUNT: u32 = 485u;\n</span><span class=\"lens-source-line\" data-line=\"3\">const DEGREES_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line\" data-line=\"4\">const CURSORS_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"5\">@group(0) @binding(0) var&lt;storage, read_write&gt; degrees: array&lt;atomic&lt;u32&gt;&gt;;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(1) var&lt;storage, read_write&gt; cursors: array&lt;atomic&lt;u32&gt;&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const INVALID_OFFSET: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(2) var&lt;storage, read_write&gt; invalidEdges: array&lt;atomic&lt;u32&gt;&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"10\">@compute @workgroup_size(256)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"11\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"12\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;,\n</span><span class=\"lens-source-line\" data-line=\"13\">  @builtin(local_invocation_index) localInvocationIndex: u32\n</span><span class=\"lens-source-line\" data-line=\"14\">) {\n</span><span class=\"lens-source-line\" data-line=\"15\">  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 2u + workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"16\">  if (workgroupIndex &gt;= 16777216u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"17\">  let index = workgroupIndex * 256u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"18\">  if (index &lt; VERTEX_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"19\">    atomicStore(&amp;degrees[DEGREES_OFFSET + index], 0u);\n</span><span class=\"lens-source-line\" data-line=\"20\">    atomicStore(&amp;cursors[CURSORS_OFFSET + index], 0u);\n</span><span class=\"lens-source-line\" data-line=\"21\">  }\n</span><span class=\"lens-source-line\" data-line=\"22\">  if (index == 0u) { atomicStore(&amp;invalidEdges[INVALID_OFFSET], 0u); }\n</span><span class=\"lens-source-line\" data-line=\"23\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>degrees<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"rail-topology-forward-degrees\">rail-topology-forward-degrees</td><td>read_write</td><td>u32</td></tr><tr><td>cursors<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"rail-topology-forward-cursors\">rail-topology-forward-cursors</td><td>read_write</td><td>u32</td></tr><tr><td>invalidEdges<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"rail-topology-invalid-edge-count\">rail-topology-invalid-edge-count</td><td>read_write</td><td>u32</td></tr></tbody></table><figcaption>GPUGraphTopology · main · b6c79e6b</figcaption></figure></section>",
