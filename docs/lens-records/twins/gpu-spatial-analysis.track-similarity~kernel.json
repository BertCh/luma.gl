ded; lane ids are computed from the dispatch shape · apple</p><figure class=\"lens-kernel-source\"><pre><code data-language=\"wgsl\"><span class=\"lens-source-line\" data-line=\"1\">\n</span><span class=\"lens-source-line\" data-line=\"2\">override INVOCATION_COUNT: u32;\n</span><span class=\"lens-source-line\" data-line=\"3\">override WGSL_KERNEL_DISPATCH_X: u32;\n</span><span class=\"lens-source-line\" data-line=\"4\">override WGSL_KERNEL_DISPATCH_Y: u32;\n</span><span class=\"lens-source-line\" data-line=\"5\">const pairAOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"6\">@group(0) @binding(0) var&lt;storage, read&gt; pairA: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"7\">const pairBOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"8\">@group(0) @binding(1) var&lt;storage, read&gt; pairB: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"9\">const offsetsAOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"10\">@group(0) @binding(2) var&lt;storage, read&gt; offsetsA: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"11\">const offsetsBOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"12\">@group(0) @binding(3) var&lt;storage, read&gt; offsetsB: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"13\">const statusOffset: u32 = 0u;\n</span><span class=\"lens-source-line lens-source-line--binding\" data-line=\"14\">@group(0) @binding(4) var&lt;storage, read_write&gt; status: array&lt;u32&gt;;\n</span><span class=\"lens-source-line\" data-line=\"15\">const PAIR_COUNT: u32 = 66u;\n</span><span class=\"lens-source-line\" data-line=\"16\">const TRACK_COUNT_A: u32 = 12u;\n</span><span class=\"lens-source-line\" data-line=\"17\">const TRACK_COUNT_B: u32 = 12u;\n</span><span class=\"lens-source-line\" data-line=\"18\">const FRECHET_CAP: u32 = 512u;\n</span><span class=\"lens-source-line\" data-line=\"19\">const DENSIFY: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"20\">const STATUS_EMPTY: u32 = 1u;\n</span><span class=\"lens-source-line\" data-line=\"21\">const STATUS_TOO_LONG: u32 = 2u;\n</span><span class=\"lens-source-line\" data-line=\"22\">const STATUS_INVALID: u32 = 4u;\n</span><span class=\"lens-source-line\" data-line=\"23\">\n</span><span class=\"lens-source-line lens-source-line--workgroup-size\" data-line=\"24\">@compute @workgroup_size(128)\n</span><span class=\"lens-source-line lens-source-line--entry-point\" data-line=\"25\">fn main(\n</span><span class=\"lens-source-line\" data-line=\"26\">  @builtin(local_invocation_index) localInvocationIndex: u32,\n</span><span class=\"lens-source-line\" data-line=\"27\">  @builtin(workgroup_id) workgroupId: vec3&lt;u32&gt;\n</span><span class=\"lens-source-line\" data-line=\"28\">) {\n</span><span class=\"lens-source-line\" data-line=\"29\">  _ = &amp;pairA;\n</span><span class=\"lens-source-line\" data-line=\"30\">  _ = &amp;pairB;\n</span><span class=\"lens-source-line\" data-line=\"31\">  _ = &amp;offsetsA;\n</span><span class=\"lens-source-line\" data-line=\"32\">  _ = &amp;offsetsB;\n</span><span class=\"lens-source-line\" data-line=\"33\">  _ = &amp;status;\n</span><span class=\"lens-source-line\" data-line=\"34\">  _ = INVOCATION_COUNT;\n</span><span class=\"lens-source-line\" data-line=\"35\">  let workgroupIndex =\n</span><span class=\"lens-source-line\" data-line=\"36\">    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +\n</span><span class=\"lens-source-line\" data-line=\"37\">    workgroupId.x;\n</span><span class=\"lens-source-line\" data-line=\"38\">  if (workgroupIndex &gt;= 33554432u) { return; }\n</span><span class=\"lens-source-line\" data-line=\"39\">  let index = workgroupIndex * 128u + localInvocationIndex;\n</span><span class=\"lens-source-line\" data-line=\"40\">  if (index &gt;= INVOCATION_COUNT) {\n</span><span class=\"lens-source-line\" data-line=\"41\">    return;\n</span><span class=\"lens-source-line\" data-line=\"42\">  }\n</span><span class=\"lens-source-line\" data-line=\"43\">  let a = pairA[pairAOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"44\">  let b = pairB[pairBOffset + index];\n</span><span class=\"lens-source-line\" data-line=\"45\">  var flags = 0u;\n</span><span class=\"lens-source-line\" data-line=\"46\">  \n</span><span class=\"lens-source-line\" data-line=\"47\">  if (a &gt;= TRACK_COUNT_A || b &gt;= TRACK_COUNT_B) {\n</span><span class=\"lens-source-line\" data-line=\"48\">    flags = STATUS_INVALID;\n</span><span class=\"lens-source-line\" data-line=\"49\">  } else if (flags == 0u) {\n</span><span class=\"lens-source-line\" data-line=\"50\">    let countA = offsetsA[offsetsAOffset + a + 1u] - offsetsA[offsetsAOffset + a];\n</span><span class=\"lens-source-line\" data-line=\"51\">    let countB = offsetsB[offsetsBOffset + b + 1u] - offsetsB[offsetsBOffset + b];\n</span><span class=\"lens-source-line\" data-line=\"52\">    if (countA == 0u || countB == 0u) { flags = STATUS_EMPTY; }\n</span><span class=\"lens-source-line\" data-line=\"53\">    else if (min((countA - 1u) * DENSIFY, (countB - 1u) * DENSIFY) + 1u &gt; FRECHET_CAP) { flags = STATUS_TOO_LONG; }\n</span><span class=\"lens-source-line\" data-line=\"54\">  }\n</span><span class=\"lens-source-line\" data-line=\"55\">  status[statusOffset + index] = flags;\n</span><span class=\"lens-source-line\" data-line=\"56\">}\n</span></code></pre><table><thead><tr><th>Name</th><th>Resource</th><th>Access</th><th>Element type</th></tr></thead><tbody><tr><td>pairA<span class=\"lens-provenance lens-provenance--metadata\" title=\"Static metadata, not an execution measurement.\">metadata</span></td><td data-action=\"bind\" data-axis=\"buffer\" data-key=\"pairA\">pairA</td><td>read</td><td>u32</td></tr><tr><td>