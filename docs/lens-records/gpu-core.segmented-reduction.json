e,"timestamped":false,"taps":0,"lensTwin":true,"retained":[]},"nodes":{}}]},"encoding":{"sourceLines":["const INPUT_OFFSET: u32 = 0u;","const SEGMENT_OFFSET: u32 = 0u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read> segmentOffsets: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputValues: array<f32>;","var<workgroup> scratch: array<f32, 256>;","fn combine(a: f32, b: f32) -> f32 { return a + b; }","@compute @workgroup_size(256)","fn main(@builtin(workgroup_id) wg: vec3u, @builtin(local_invocation_index) lane: u32) {","  let segment = wg.x;","  let begin = segmentOffsets[SEGMENT_OFFSET + segment];","  let end = segmentOffsets[SEGMENT_OFFSET + segment + 1u];","  var value: f32 = 0.0;","  var i = begin + lane;","  loop {","    if (i >= end) { break; }","    value = combine(value, inputValues[INPUT_OFFSET + i]);","    i += 256u;","  }","  scratch[lane] = value;","  workgroupBarrier();","  var stride = 128u;","    if (stride == 0u) { break; }","    if (lane < stride) { scratch[lane] = combine(scratch[lane], scratch[lane + stride]); }","    workgroupBarrier();","    stride = stride / 2u;","  if (lane == 0u) {","    outputValues[OUTPUT_OFFSET + segment] = select(scratch[0], f32(0), begin == end);","}"],"strings":["state-rainfall-total","buffer","imported","rainfall","stateOffsets","stateTotals","GPUSegmentedReduction","read"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","datum","formula","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs"],["keySpace"],["name","resource","access","elementType","elementOffset","length"],["workgroups","invocationCount","indirect"],["operation","commandCount","maximumWorkgroupCount","maximumInvocationCount","readByteLength","writeByteLength"],[],["id","kind","bytes","ownership","firstNode","lastNode"]],"lists":[]}}
