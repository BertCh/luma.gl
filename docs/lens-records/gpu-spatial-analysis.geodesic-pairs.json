es":"b64:1AZuSYxBqkm178tKp4CuSVmDnUl3Q7hIuGm0Sl2+z0pK3exKLi3oSUi9tUmOXZFJFL0USgldK0pdDJBJsyLCSo1kzkq35rtK8nDFSbQRQUl/kyVKC0oDSYVfpEntERpLbNcqSh6OIUvYSy1L4xsvSvkU3EmOPylKPgEpSo1WNUp5fzFKcn9LSoeF9UkxwcZJ0+iSSelBLUpYDwhKgmUrSQ==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-geodesic-pairs-compiled","resource":"distances","afterNode":"geodesic-pairs-pairs","role":"intermediate","keySpace":"pair","meaning":"WGS84 geodesic distance in m; capped Vincenty inverse (16 iterations), spherical fallback when not converged"},{"id":"gpu-spatial-analysis-geodesic-pairs-snapshots-initialBearings-0","name":"initialBearings","iteration":0,"elementType":"f32","values":"b64:Mp0gQ6oepUIxIkVCBry7wsBlCsOlD6lC010+Qlq+NUIGA05CsaAbQ6H7FsNk57hCaRLBwgXgxMJTmrdCdoc/QhYDcUK51DlC4DwcQ+4iJsM3txnDH2dNwqc4KsMQ+hTCcb+LwlNWlMFAKM3BYRAMw3zjH0M8LczCHQCDwgyVr8I4EAHDhNYGQyZaq8KR3yBDts+EQn/BdcLp0VfCDkGPQg==","provenance":"gpu-readback","graph":"gpu-spatial-analysis-geodesic-pairs-compiled","resource":"initialBearings","afterNode":"geodesic-pairs-pairs","role":"intermediate","keySpace":"pair","meaning":"initial bearing at ORD in degrees clockwise from north, in (-180, 180]"},{"id":"gpu-spatial-analysis-geodesic-pairs-snapshots-converged-0","name":"converged","iteration":0,"elementType":"u32","values":"rle:*40:00000001","provenance":"gpu-readback","graph":"gpu-spatial-analysis-geodesic-pairs-compiled","resource":"converged","afterNode":"geodesic-pairs-pairs","role":"intermediate","keySpace":"pair","meaning":"1 when Vincenty converged; 0 for near-antipodal pairs (sphere fallback)"},{"id":"gpu-spatial-analysis-geodesic-pairs-snapshots-midpoints-0","name":"midpoints","iteration":0,"elementType":"f32","values":"b64:","provenance":"gpu-readback","graph":"gpu-spatial-analysis-geodesic-pairs-compiled","resource":"midpoints","afterNode":"geodesic-pairs-pairs","components":2,"role":"output","geometry":{"kind":"points","coordinateModel":"geographic"},"keySpace":"pair","meaning":"spherical great-circle midpoint of each route (not the WGS84 geodesic midpoint)"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const originsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> origins: array<f32>;","const targetsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> targets: array<f32>;","const distancesOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> distances: array<f32>;","const initialBearingsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> initialBearings: array<f32>;","const midpointsOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> midpoints: array<f32>;","const convergedOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> converged: array<u32>;","const GEODESIC_PI: f32 = 3.14159265358979;","const GEODESIC_DEGREES_TO_RADIANS: f32 = 0.0174532925199433;","const GEODESIC_RADIANS_TO_DEGREES: f32 = 57.2957795130823;","fn geodesicWrapLongitudeDelta(delta: f32) -> f32 {","  return delta - 360.0 * round(delta / 360.0);","}","// cos(latitude) as sin(colatitude): 90 - |lat| is exact in f32, so the cosine keeps its relative","// precision near the poles where cos(lat * pi / 180) would not.","fn geodesicCosLatitude(latitudeDegrees: f32) -> f32 {","  return sin((90.0 - abs(latitudeDegrees)) * GEODESIC_DEGREES_TO_RADIANS);","fn geodesicUnitVector(lngLat: vec2<f32>) -> vec3<f32> {","  let lambda = lngLat.x * GEODESIC_DEGREES_TO_RADIANS;","  let phi = lngLat.y * GEODESIC_DEGREES_TO_RADIANS;","  let cosPhi = geodesicCosLatitude(lngLat.y);","  return vec3<f32>(cosPhi * cos(lambda), cosPhi * sin(lambda), sin(phi));","fn geodesicFromUnitVector(vector: vec3<f32>) -> vec2<f32> {","  let horizontal = sqrt(vector.x * vector.x + vector.y * vector.y);","  return vec2<f32>(","    atan2(vector.y, vector.x) * GEODESIC_RADIANS_TO_DEGREES,","    atan2(vector.z, horizontal) * GEODESIC_RADIANS_TO_DEGREES","  );","fn geodesicHaversineTerm(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let deltaPhi = (b.y - a.y) * GEODESIC_DEGREES_TO_RADIANS;","  let deltaLambda = geodesicWrapLongitudeDelta(b.x - a.x) * GEODESIC_DEGREES_TO_RADIANS;","  let sinHalfPhi = sin(0.5 * deltaPhi);","  let sinHalfLambda = sin(0.5 * deltaLambda);","  let term = sinHalfPhi * sinHalfPhi +","    geodesicCosLatitude(a.y) * geodesicCosLatitude(b.y) *","    sinHalfLambda * sinHalfLambda;","  return clamp(term, 0.0, 1.0);","fn geodesicCentralAngle(a: vec2<f32>, b: vec2<f32>) -> f32 {","  // Vincenty's special case for the sphere: well conditioned from a millimeter to antipodal,","  // unlike the haversine form whose sqrt(1 - h) loses precision near antipodes.","  let phi1 = a.y * GEODESIC_DEGREES_TO_RADIANS;","  let phi2 = b.y * GEODESIC_DEGREES_TO_RADIANS;","  let sinPhi1 = sin(phi1);","  let cosPhi1 = geodesicCosLatitude(a.y);","  let cosPhi2 = geodesicCosLatitude(b.y);","  let halfVersine = 2.0 * sinHalfLambda * sinHalfLambda;","  let east = cosPhi2 * sin(deltaLambda);","  let north = sin(deltaPhi) + sinPhi1 * cosPhi2 * halfVersine;","  let up = sinPhi1 * sin(phi2) + cosPhi1 * cosPhi2 * (1.0 - halfVersine);","  return atan2(sqrt(east * east + north * north), up);","fn geodesicInitialBearingDegrees(a: vec2<f32>, b: vec2<f32>) -> f32 {","  let y = sin(deltaLambda) * cosPhi2;","  // cos(phi1) sin(phi2) - sin(phi1) cos(phi2) cos(deltaLambda), without cancellation.","  let x = sin(deltaPhi) + 2.0 * sin(phi1) * cosPhi2 * sinHalfLambda * sinHalfLambda;","  return atan2(y, x) * GEODESIC_RADIANS_TO_DEGREES;","fn geodesicDestination(origin: vec2<f32>, bearingDegrees: f32, angle: f32) -> vec2<f32> {","  let phi1 = origin.y * GEODESIC_DEGREES_TO_RADIANS;","  let theta = bearingDegrees * GEODESIC_DEGREES_TO_RADIANS;","  let cosPhi1 = geodesicCosLatitude(origin.y);","  let sinHalfAngle = sin(0.5 * angle);","  // sin(phi2) - sin(phi1), from the half-angle form so short moves keep their precision.","  let sinDelta = -2.0 * sinPhi1 * sinHalfAngle * sinHalfAngle + cosPhi1 * sin(angle) * cos(theta);","  let sinPhi2 = clamp(sinPhi1 + sinDelta, -1.0, 1.0);","  let roughPhi2 = asin(sinPhi2);","  // sin(phi2) - sin(phi1) = 2 cos((phi1 + phi2) / 2) sin((phi2 - phi1) / 2); the midpoint cosine","  // is insensitive to the rough phi2, so the latitude change is recovered to relative precision.","  let midpointCosine = cos(0.5 * (phi1 + roughPhi2));","  var deltaPhi = roughPhi2 - phi1;","  if (abs(midpointCosine) > 1e-3) {","    deltaPhi = 2.0 * asin(clamp(sinDelta / (2.0 * midpointCosine), -1.0, 1.0));","  }","  let deltaLambda = atan2(","    sin(theta) * sin(angle) * cosPhi1,","    cos(angle) - sinPhi1 * sinPhi2","    origin.x + deltaLambda * GEODESIC_RADIANS_TO_DEGREES,","    origin.y + deltaPhi * GEODESIC_RADIANS_TO_DEGREES","fn geodesicInterpolate(a: vec2<f32>, b: vec2<f32>, angle: f32, fraction: f32) -> vec2<f32> {","  let unitA = geodesicUnitVector(a);","  let unitB = geodesicUnitVector(b);","  var vector: vec3<f32>;","  if (angle < 1e-6) {","    vector = normalize(mix(unitA, unitB, fraction));","  } else {","    let sinAngle = sin(angle);","    vector = unitA * (sin((1.0 - fraction) * angle) / sinAngle) +","      unitB * (sin(fraction * angle) / sinAngle);","  let lngLat = geodesicFromUnitVector(vector);","  // Keep longitudes continuous with the start point (unwrapped across the antimeridian).","  return vec2<f32>(a.x + geodesicWrapLongitudeDelta(lngLat.x - a.x), lngLat.y);","fn geodesicSinLatitudeDelta(latitudeDegrees: f32, originLatitudeDegrees: f32) -> f32 {","  let halfSum = 0.5 * (latitudeDegrees + originLatitudeDegrees) * GEODESIC_DEGREES_TO_RADIANS;","  let halfDifference = 0.5 * (latitudeDegrees - originLatitudeDegrees) * GEODESIC_DEGREES_TO_RADIANS;","  return 2.0 * cos(halfSum) * sin(halfDifference);","fn geodesicHaversineDistance(a: vec2<f32>, b: vec2<f32>, radius: f32) -> f32 {","  return radius * geodesicCentralAngle(a, b);","// Offset of position from origin in the local equirectangular frame at origin, in degrees of","// latitude (east offsets scaled by cos(latitude of origin), longitudes wrapped at +-180).","fn geodesicLocalOffset(origin: vec2<f32>, position: vec2<f32>) -> vec2<f32> {","    geodesicWrapLongitudeDelta(position.x - origin.x) * geodesicCosLatitude(origin.y),","    position.y - origin.y","// Fraction in [0, 1] of the point of segment start-end closest to point, in the local","// equirectangular frame at point: exact to first order for segments of road length.","fn geodesicSegmentFraction(point: vec2<f32>, start: vec2<f32>, end: vec2<f32>) -> f32 {","  let startOffset = geodesicLocalOffset(point, start);","  let segment = geodesicLocalOffset(point, end) - startOffset;","  let denominator = dot(segment, segment);","  if (denominator > 0.0) {","    return clamp(-dot(startOffset, segment) / denominator, 0.0, 1.0);","  return 0.0;","// Great-circle distance (units of radius) from point to the position at fraction along the","// segment, built from coordinate differences so short distances keep their precision near +-180.","fn geodesicSegmentDistance(","  point: vec2<f32>,","  start: vec2<f32>,","  end: vec2<f32>,","  fraction: f32,","  radius: f32",") -> f32 {","  let startOffset = vec2<f32>(geodesicWrapLongitudeDelta(start.x - point.x), start.y - point.y);","  let delta = vec2<f32>(geodesicWrapLongitudeDelta(end.x - start.x), end.y - start.y);","  let offset = startOffset + fraction * delta;","  let sinHalfLatitude = sin(0.5 * offset.y * GEODESIC_DEGREES_TO_RADIANS);","  let sinHalfLongitude = sin(0.5 * offset.x * GEODESIC_DEGREES_TO_RADIANS);","  let term = sinHalfLatitude * sinHalfLatitude +","    geodesicCosLatitude(point.y) * geodesicCosLatitude(point.y + offset.y) *","    sinHalfLongitude * sinHalfLongitude;","  return 2.0 * radius * asin(sqrt(clamp(term, 0.0, 1.0)));","struct VincentyInverse {","  distance: f32,","  initialBearing: f32,","  finalBearing: f32,","  converged: bool,","struct VincentyDirect {","  destination: vec2<f32>,","const VINCENTY_A: f32 = 6378137.0;","const VINCENTY_B: f32 = 6356752.5;","const VINCENTY_F: f32 = 0.0033528106287121773;","// (a^2 - b^2) / b^2","const VINCENTY_SECOND_ECCENTRICITY_SQUARED: f32 = 0.006739496719092131;","const VINCENTY_ITERATIONS: u32 = 16u;","fn getReducedLatitudeGap(phi: f32) -> f32 {","  let sinPhi = sin(phi);","  let cosPhi = cos(phi);","  return atan(VINCENTY_F * sinPhi * cosPhi / (cosPhi * cosPhi + (1.0 - VINCENTY_F) * sinPhi * sinPhi));","// cos(U) as sin(colatitude of U) = sin((90 - |lat|) degrees + gap(|phi|)), exact near the poles.","fn getCosReducedLatitude(phi: f32, latitudeDegrees: f32) -> f32 {","  return sin((90.0 - abs(latitudeDegrees)) * GEODESIC_DEGREES_TO_RADIANS + getReducedLatitudeGap(abs(phi)));","fn getReducedLatitude(phi: f32) -> f32 {","  return phi - getReducedLatitudeGap(phi);","fn getVincentyDeltaSigma(bigB: f32, sinSigma: f32, cosSigma: f32, cos2SigmaM: f32) -> f32 {","  let cos2SigmaMSquared = cos2SigmaM * cos2SigmaM;","  return bigB * sinSigma * (cos2SigmaM + bigB / 4.0 * (cosSigma * (-1.0 + 2.0 * cos2SigmaMSquared) -","    bigB / 6.0 * cos2SigmaM * (-3.0 + 4.0 * sinSigma * sinSigma) * (-3.0 + 4.0 * cos2SigmaMSquared)));","fn getVincentyCoefficients(cosSquaredAlpha: f32) -> vec2<f32> {","  let uSquared = cosSquaredAlpha * VINCENTY_SECOND_ECCENTRICITY_SQUARED;","  let bigA = 1.0 + uSquared / 16384.0 * (4096.0 + uSquared * (-768.0 + uSquared * (320.0 - 175.0 * uSquared)));","  let bigB = uSquared / 1024.0 * (256.0 + uSquared * (-128.0 + uSquared * (74.0 - 47.0 * uSquared)));","  return vec2<f32>(bigA, bigB);","fn vincentyInverse(a: vec2<f32>, b: vec2<f32>) -> VincentyInverse {","  let reduced1 = getReducedLatitude(phi1);","  let reduced2 = getReducedLatitude(phi2);","  // U2 - U1: the midpoint derivative dU/dphi for short spans (the gap difference would lose","  // relative precision there), else deltaPhi minus the difference of the small gaps.","  var deltaReduced = deltaPhi - (getReducedLatitudeGap(phi2) - getReducedLatitudeGap(phi1));","  if (abs(deltaPhi) < 0.01) {","    let sinMid = sin(0.5 * (phi1 + phi2));","    let cosMid = cos(0.5 * (phi1 + phi2));","    deltaReduced = deltaPhi * (1.0 - VINCENTY_F) /","      (cosMid * cosMid + (1.0 - VINCENTY_F) * (1.0 - VINCENTY_F) * sinMid * sinMid);","  let sinU1 = sin(reduced1);","  let cosU1 = getCosReducedLatitude(phi1, a.y);","  let sinU2 = sin(reduced2);","  let cosU2 = getCosReducedLatitude(phi2, b.y);","  let sinDeltaU = sin(deltaReduced);","  let longitudeDelta = geodesicWrapLongitudeDelta(b.x - a.x) * GEODESIC_DEGREES_TO_RADIANS;","  var lambda = longitudeDelta;","  var result: VincentyInverse;","  result.converged = false;","  var sinSigma = 0.0;","  var cosSigma = 1.0;","  var sigma = 0.0;","  var cosSquaredAlpha = 1.0;","  var cos2SigmaM = 0.0;","  var sinLambda = 0.0;","  var halfVersine = 0.0;","  // Each pass evaluates the auxiliary sphere at lambda; the final pass after convergence (or the","  // cap) evaluates it at the converged lambda, so the distance never mixes two lambda values.","  for (var iteration = 0u; iteration <= VINCENTY_ITERATIONS; iteration++) {","    sinLambda = sin(lambda);","    let sinHalfLambda = sin(0.5 * lambda);","    halfVersine = 2.0 * sinHalfLambda * sinHalfLambda;","    let northTerm = sinDeltaU + sinU1 * cosU2 * halfVersine;","    let eastTerm = cosU2 * sinLambda;","    sinSigma = sqrt(eastTerm * eastTerm + northTerm * northTerm);","    if (sinSigma == 0.0) {","      result.distance = 0.0;","      result.initialBearing = 0.0;","      result.finalBearing = 0.0;","      result.converged = true;","      return result;","    }","    cosSigma = sinU1 * sinU2 + cosU1 * cosU2 * (1.0 - halfVersine);","    sigma = atan2(sinSigma, cosSigma);","    let sinAlpha = cosU1 * cosU2 * sinLambda / sinSigma;","    cosSquaredAlpha = 1.0 - sinAlpha * sinAlpha;","    cos2SigmaM = 0.0;","    if (cosSquaredAlpha != 0.0) {","      cos2SigmaM = cosSigma - 2.0 * sinU1 * sinU2 / cosSquaredAlpha;","    if (result.converged || iteration == VINCENTY_ITERATIONS) {","      break;","    let c = VINCENTY_F / 16.0 * cosSquaredAlpha * (4.0 + VINCENTY_F * (4.0 - 3.0 * cosSquaredAlpha));","    let previous = lambda;","    lambda = longitudeDelta + (1.0 - c) * VINCENTY_F * sinAlpha *","      (sigma + c * sinSigma * (cos2SigmaM + c * cosSigma * (-1.0 + 2.0 * cos2SigmaM * cos2SigmaM)));","    // Relative test: about four f32 ulps of lambda (exact zero for meridian lines).","    if (abs(lambda - previous) <= 4.8e-7 * abs(lambda)) {","  let coefficients = getVincentyCoefficients(cosSquaredAlpha);","  let deltaSigma = getVincentyDeltaSigma(coefficients.y, sinSigma, cosSigma, cos2SigmaM);","  result.distance = VINCENTY_B * coefficients.x * (sigma - deltaSigma);","  result.initialBearing = atan2(cosU2 * sinLambda, sinDeltaU + sinU1 * cosU2 * halfVersine) *","    GEODESIC_RADIANS_TO_DEGREES;","  result.finalBearing = atan2(cosU1 * sinLambda, sinDeltaU - cosU1 * sinU2 * halfVersine) *","  return result;","fn vincentyDirect(origin: vec2<f32>, bearingDegrees: f32, distance: f32) -> VincentyDirect {","  let alpha1 = bearingDegrees * GEODESIC_DEGREES_TO_RADIANS;","  let sinAlpha1 = sin(alpha1);","  let cosAlpha1 = cos(alpha1);","  let cosU1 = getCosReducedLatitude(phi1, origin.y);","  let sigma1 = atan2(sinU1, cosU1 * cosAlpha1);","  let sinAlpha = cosU1 * sinAlpha1;","  let cosSquaredAlpha = 1.0 - sinAlpha * sinAlpha;","  let baseSigma = distance / (VINCENTY_B * coefficients.x);","  var sigma = baseSigma;","  var sinSigma = sin(sigma);","  var cosSigma = cos(sigma);","  var cos2SigmaM = cos(2.0 * sigma1 + sigma);","  var result: VincentyDirect;","  for (var iteration = 0u; iteration < VINCENTY_ITERATIONS; iteration++) {","    cos2SigmaM = cos(2.0 * sigma1 + sigma);","    sinSigma = sin(sigma);","    cosSigma = cos(sigma);","    let previous = sigma;","    sigma = baseSigma + getVincentyDeltaSigma(coefficients.y, sinSigma, cosSigma, cos2SigmaM);","    if (abs(sigma - previous)