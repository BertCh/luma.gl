~0",32,"~a","~p","~p"],["~:p","~9","~0",32,"~a","~o","~7"]]]],"axes":{"axes":[{"id":"entity","label":"Income bin","kind":"data","keySpace":"bin","size":8}],"keySpaces":[{"id":"row","label":"Source row","size":791,"indexSpace":"1d"},{"id":"invocation","label":"Invocation","size":791,"indexSpace":"1d"},{"id":"bin","label":"Income bin","size":8,"indexSpace":"1d"}],"relations":[{"id":"invocation-row","from":"invocation","to":"row","cardinality":"1:1","kind":"function","ref":{"function":"identity","params":{"batchCount":1}},"timeDependent":false}]},"refs":{"formulas":[{"id":"gpu-dataframe:GPUDataFrameHistogramQuery","derivation":"curated","tex":"\\term{count}{c}_b = \\sum_{i:\\term{accepted}{a}_i}\\mathbb{1}[\\term{bin}{b}_i=b],\\quad \\text{equal-width float, }M>m:\\ b_i=\\min\\left(\\left\\lfloor\\term{binCount}{B}\\frac{\\term{value}{x}_i-\\term{minimum}{m}}{\\term{maximum}{M}-\\term{minimum}{m}}\\right\\rfloor,\\term{binCount}{B}-1\\right)","ascii":"count[b] = sum(1[bin[i] = b] for accepted rows); equal-width float bins use min(u32(((x-min)/(max-min))*B), B-1); max is included, a degenerate domain maps to bin 0; explicit edges use bisect-right with the last edge included; masked, null, nonfinite and out-of-domain rows are skipped","symbols":[{"id":"count","role":"output","binding":"wgsl:outputCounts"},{"id":"accepted","role":"intermediate","binding":"wgsl:accepted"},{"id":"bin","role":"intermediate","binding":"wgsl:binIndex"},{"id":"binCount","role":"parameter","binding":"wgsl:BIN_COUNT"},{"id":"value","role":"input","binding":"wgsl:inputValues"},{"id":"minimum","role":"parameter","binding":"wgsl:minimum"},{"id":"maximum","role":"parameter","binding":"wgsl:maximum"}]},{"id":"gpu-core.scan","tex":"\\term{y}{y_i}=\\left(\\sum_{j=s(i)}^{i-1+\\delta}\\term{x}{x_j}\\right)\\bmod 2^{32},\\quad s(i)=\\max(\\{0\\}\\cup\\{j\\le i:\\term{heads}{h_j}\\ne0\\})","ascii":"y[i] = sum(x[s(i)..i-1+delta]) mod 2^32; delta=0 exclusive (default), 1 inclusive; s(i) is the last nonzero segment flag or 0.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"y","role":"output","binding":"wgsl:outputValues"},{"id":"heads","role":"input","binding":"wgsl:segmentFlags"}],"derivation":"curated"},{"id":"gpu-core.mask","tex":"\\term{y}{y_i}=\\mathbf1[\\operatorname{op}(b_{0i},\\ldots,b_{mi})],\\quad b_{ji}=[x_{ji}\\ne0]","ascii":"y[i]=0 or 1 after booleanizing inputs by !=0; op is and, or, xor (odd parity), difference (first AND NOT every remaining input), or not (one input).","symbols":[{"id":"y","role":"output","binding":"wgsl:outputMask"}],"derivation":"curated"},{"id":"gpu-core.histogram","tex":"\\term{counts}{H_b}=\\sum_{i\\in S}\\mathbf1[\\operatorname{bin}(\\term{x}{x_i})=b],\\quad\\operatorname{bin}(v)=\\operatorname{min}(B-1,\\lfloor B(v-a)/(z-a)\\rfloor)","ascii":"H[b]=count of finite, mask-selected values in bin b. Reject outside [a,z]. Uniform bins use floor(B*(v-a)/(z-a)), with z in B-1; a=z sends equal values to bin 0. Explicit strictly increasing finite edges use [e[b],e[b+1]), final bin includes last edge; invalid GPU edges yield zeros. Integer uniform binning uses exact multiply/divide floor; float uses f32 arithmetic.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"counts","role":"output","binding":"wgsl:outputCounts"},{"id":"mask","role":"input","binding":"wgsl:selectionMask"},{"id":"edges","role":"parameter","binding":"wgsl:edgeValues"}],"derivation":"curated"},{"id":"gpu-core.compaction","tex":"\\term{offsets}{o_i}=\\sum_{j<i}\\term{flags}{f_j}\\bmod2^{32},\\quad\\term{y}{y_{o_i}}=\\term{x}{x_i}\\ (f_i\\ne0),\\quad\\term{count}{c}=o_{n-1}+\\operatorname{min}(f_{n-1},1)","ascii":"o[i]=exclusive uint32 scan(flags); if flags[i]!=0 and o[i] is in output capacity, y[o[i]]=x[i]. count=(o[n-1]+min(flags[n-1],1)) mod 2^32, empty=0. Dense stable compaction requires binary flags; raw nonbinary flags leave gaps.","symbols":[{"id":"x","role":"input","binding":"wgsl:inputValues"},{"id":"y","role":"output","binding":"wgsl:outputValues"},{"id":"flags","role":"input","binding":"wgsl:flags"},{"id":"offsets","role":"intermediate","binding":"wgsl:offsets"},{"id":"count","role":"output","binding":"wgsl:outputCount"}],"derivation":"curated"}],"sources":[{"id":"wgsl:23dd0e16","language":"wgsl","moduleId":"GPUDataFrameQuery/predicate","hash":"23dd0e16","bodyHash":"01f2d9c0","entryPoint":"main","textLines":[[0,4],0,[4,12],[15,3]]},{"id":"wgsl:f73a4980","language":"wgsl","moduleId":"GPUHistogram/clear","hash":"f73a4980","entryPoint":"main","textLines":[0,18,2,[19,2],[6,3],21,[10,2],22,17]},{"id":"wgsl:59891145","language":"wgsl","moduleId":"GPUScan/level-scan/subgroups","hash":"59891145","entryPoint":"main","textLines":[0,[23,2],[0,2],[25,2],2,[27,5],0,20,[32,3],[7,3],[35,6],14,0,[41,3],14,44,0,[45,8],14,44,0,[53,3],14,39,56,14,17]},{"id":"wgsl:af8e4ee9","language":"wgsl","moduleId":"GPUMask/and","hash":"af8e4ee9","entryPoint":"main","textLines":[[0,3],[57,5],0,[4,11],62,17]},{"id":"wgsl:34f2c0ea","language":"wgsl","moduleId":"GPUScan/level-scan/subgroups","hash":"34f2c0ea","entryPoint":"main","textLines":[0,[23,2],0,[63,2],26,2,0,[28,2],0,31,0,20,[32,3],[7,2],21,[35,6],14,0,[41,3],14,44,0,[45,8],14,44,0,[53,2],65,14,39,56,14,17]},{"id":"wgsl:2b5be09c","language":"wgsl","moduleId":"GPUHistogram/accumulate/local","hash":"2b5be09c","entryPoint":"main","textLines":[0,23,1,18,26,66,0,[67,2],2,69,0,[70,3],0,0,[73,6],17,0,[79,3],17,0,[82,9],17,0,20,6,[91,2],[8,4],[93,4],44,[97,16],52,[14,2],[113,10],52,123,14,44,[124,2],14,17]},{"id":"wgsl:fde66293","language":"wgsl","moduleId":"GPUScan/add-offsets","hash":"fde66293","entryPoint":"main","textLines":[[0,3],126,0,0,[127,2],0,0,0,20,[6,6],39,65,65,129,65,65,14,17]},{"id":"wgsl:8027afdf","language":"wgsl","moduleId":"GPUCompaction/scatter","hash":"8027afdf","entryPoint":"main","textLines":[[0,2],26,130,126,2,[131,3],28,[134,4],0,20,[6,6],[138,5],14,[143,2],14,17]}]},"decisions":[],"choices":[{"stage":"aggregate","name":"bins","value":8,"sweepable":true},{"stage":"aggregate","name":"domain","value":"0 to 256000","sweepable":false,"alternatives":["edges: strictly increasing literal boundaries"]}],"captures":{"schema":"luma.computation-captures/1","runId":"run-8336e281","snapshots":[{"id":"medianHouseholdIncome","name":"medianHouseholdIncome","keySpace":"row","role":"input","values":"b64:","elementType":"f32","meaning":"NaN marks a suppressed Census estimate (invalid sidecar); histograms skip it.","provenance":"gpu-readback"},{"id":"binId","name":"binId","keySpace":"bin","role":"output","values":"b64:AAAAAAEAAAACAAAAAwAAAAQAAAAFAAAABgAAAAcAAAA=","elementType":"u32","provenance":"gpu-readback"},{"id":"count","name":"count","keySpace":"bin","role":"output","values":"b64:OQAAAAUBAADvAAAAcwAAADoAAAAaAAAADAAAAAQAAAA=","elementType":"u32","provenance":"gpu-readback"}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","const ELEMENT_COUNT: u32 = 791u;","const OUTPUT_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputMask: array<u32>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 4u + workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= ELEMENT_COUNT) {","    return;","  }","  ","  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, true);","}","const BIN_COUNT: u32 = 8u;","@group(0) @binding(0) var<storage, read_write> outputCounts: array<atomic<u32>>;","@compute @workgroup_size(256) fn main(","  let workgroupIndex = (workgroupId.z * 1u + workgroupId.y) * 1u + workgroupId.x;","  if (index < BIN_COUNT) { atomicStore(&outputCounts[OUTPUT_OFFSET + index], 0u); }","enable subgroups;","requires subgroup_id;","const BLOCK_COUNT: u32 = 4u;","const INPUT_OFFSET: u32 = 0u;","const SUM_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> inputValues: array<u32>;","@group(0) @binding(1) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(2) var<storage, read_write> sumValues: array<u32>;","var<workgroup> subgroupOffsets: array<u32, 64>;","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32,","  @builtin(subgroup_size) subgroupSize: u32,","  @builtin(subgroup_id) subgroupId: u32,","  if (workgroupIndex >= 16777216u || workgroupIndex >= BLOCK_COUNT) { return; }","  let lane = subgroupId * subgroupSize + subgroupInvocationId;","  let index = workgroupIndex * 256u + lane;","  var inputValue = 0u;","  if (index < ELEMENT_COUNT) {","    inputValue = inputValues[INPUT_OFFSET + index];","  let subgroupPrefix = subgroupInclusiveAdd(inputValue);","  if (subgroupInvocationId == subgroupSize - 1u) {","    subgroupOffsets[subgroupId] = subgroupPrefix;","  workgroupBarrier();","  let subgroupCount = 256u / subgroupSize;","  if (lane == 0u) {","    var runningOffset = 0u;","    for (var subgroupIndex = 0u; subgroupIndex < subgroupCount; subgroupIndex++) {","      let subgroupSum = subgroupOffsets[subgroupIndex];","      subgroupOffsets[subgroupIndex] = runningOffset;","      runningOffset = runningOffset + subgroupSum;","    }","  let blockPrefix = subgroupOffsets[subgroupId] + subgroupPrefix;","  if (lane == 255u) {","    sumValues[SUM_OFFSET + workgroupIndex] = blockPrefix;","    outputValues[OUTPUT_OFFSET + index] = blockPrefix - inputValue;","const INPUT_0_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read> input0: array<u32>;","const INPUT_1_OFFSET: u32 = 0u;","@group(0) @binding(1) var<storage, read> input1: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputMask: array<u32>;","  outputMask[OUTPUT_OFFSET + index] = select(0u, 1u, (input0[INPUT_0_OFFSET + index] != 0u) && (input1[INPUT_1_OFFSET + index] != 0u));","const ELEMENT_COUNT: u32 = 4u;","const BLOCK_COUNT: u32 = 1u;","    ","const INPUT_STRIDE: u32 = 1u;","const MASK_OFFSET: u32 = 0u;","const MASK_STRIDE: u32 = 1u;","@group(0) @binding(0) var<storage, read> inputValues: array<f32>;","@group(0) @binding(1) var<storage, read> selectionMask: array<u32>;","@group(0) @binding(2) var<storage, read_write> outputCounts: array<atomic<u32>>;","var<workgroup> localCounts: array<atomic<u32>, 8>;","fn getFirstBallotLane(mask: vec4<u32>) -> u32 {","  if (mask.x != 0u) { return firstTrailingBit(mask.x); }","  if (mask.y != 0u) { return 32u + firstTrailingBit(mask.y); }","  if (mask.z != 0u) { return 64u + firstTrailingBit(mask.z); }","  if (mask.w != 0u) { return 96u + firstTrailingBit(mask.w); }","  return 0u;","fn getBallotLaneCount(mask: vec4<u32>) -> u32 {","  return countOneBits(mask.x) + countOneBits(mask.y) +","    countOneBits(mask.z) + countOneBits(mask.w);","fn getBallotPrefixLaneCount(mask: vec4<u32>, invocation: u32) -> u32 {","  let word = invocation >> 5u;","  let bit = invocation & 31u;","  var count = 0u;","  if (word > 0u) { count += countOneBits(mask.x); }","  if (word > 1u) { count += countOneBits(mask.y); }","  if (word > 2u) { count += countOneBits(mask.z); }","  let lowerBits = (1u << bit) - 1u;","  return count + countOneBits(mask[word] & lowerBits);","  @builtin(workgroup_id) workgroupId: vec3<u32>,","  @builtin(subgroup_invocation_id) subgroupInvocationId: u32","  let lane = localInvocationIndex;","  let minimum: f32 = 0.0;","  let maximum: f32 = 256000.0;","  if (lane < BIN_COUNT) { atomicStore(&localCounts[lane], 0u); }","  var accepted = false;","  var binIndex = 0u;","  if (index < ELEMENT_COUNT && maximum >= minimum && selectionMask[MASK_OFFSET + index * MASK_STRIDE] != 0u) {","    let value = inputValues[INPUT_OFFSET + index * INPUT_STRIDE];","    if (value == value && abs(value) <= 3.402823466e+38 && value >= minimum && value <= maximum) {","      if (maximum == minimum) {","        accepted = value == minimum;","      } else {","        accepted = true;","        if (value == maximum) {","          binIndex = BIN_COUNT - 1u;","        } else {","          let ratio = (value - minimum) / (maximum - minimum);","          binIndex = min(u32(ratio * f32(BIN_COUNT)), BIN_COUNT - 1u);","        }","      }","  var subgroupPending = accepted;","  for (var subgroupGroup = 0u; subgroupGroup < 8u; subgroupGroup++) {","    let pendingBallot = subgroupBallot(subgroupPending);","    let hasPending = any(pendingBallot != vec4<u32>(0u));","    let leaderInvocation = getFirstBallotLane(pendingBallot);","    let leaderKey = subgroupShuffle(binIndex, leaderInvocation);","    let matchingKey = hasPending && subgroupPending && binIndex == leaderKey;","    let matchingBallot = subgroupBallot(matchingKey);","    if (hasPending && subgroupInvocationId == leaderInvocation) {","      atomicAdd(&localCounts[leaderKey], getBallotLaneCount(matchingBallot));","    subgroupPending = subgroupPending && !matchingKey;","  if (lane < BIN_COUNT) {","    atomicAdd(&outputCounts[OUTPUT_OFFSET + lane], atomicLoad(&localCounts[lane]));","const OFFSETS_OFFSET: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(1) var<storage, read> offsets: array<u32>;","      outputValues[OUTPUT_OFFSET + index] = outputValues[OUTPUT_OFFSET + index] + offsets[OFFSETS_OFFSET + index / 256u];","const FLAGS_OFFSET: u32 = 0u;","const OUTPUT_START: u32 = 0u;","const OUTPUT_END: u32 = 791u;","const COUNT_OFFSET: u32 = 0u;","@group(0) @binding(1) var<storage, read> flags: array<u32>;","@group(0) @binding(2) var<storage, read> offsets: array<u32>;","@group(0) @binding(3) var<storage, read_write> outputValues: array<u32>;","@group(0) @binding(4) var<storage, read_write> outputCount: array<u32>;","  if (index >= ELEMENT_COUNT) { return; }","  let flag = min(flags[FLAGS_OFFSET + index], 1u);","  let outputIndex = offsets[OFFSETS_OFFSET + index];","  if (flag != 0u && outputIndex >= OUTPUT_START && outputIndex < OUTPUT_END) {","    outputValues[OUTPUT_OFFSET + outputIndex - OUTPUT_START] = inp