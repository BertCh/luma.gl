ce":"row","meaning":"Weekday of the local time, 0 is Monday."},{"id":"gpu-dataframe-calendar-buckets-snapshots-hour-0","name":"hour","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.calendar-buckets-compiled","resource":"hour","afterNode":"calendar-buckets-decode-0","role":"output","keySpace":"row","meaning":"Hour of the local time, 0 to 23."},{"id":"gpu-dataframe-calendar-buckets-snapshots-weekdayHourCounts-0","name":"weekdayHourCounts","iteration":0,"elementType":"u32","values":"b64:","provenance":"gpu-readback","graph":"gpu-dataframe.calendar-buckets-compiled","resource":"hourWeekdayCounts","afterNode":"calendar-buckets-decode-0","role":"output","keySpace":"weekdayHour","meaning":"Observations per bucket, index weekday * 24 + hour."}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const fillTargetOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read_write> fillTarget: array<u32>;","@compute @workgroup_size(256)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &fillTarget;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 16777216u) { return; }","  let index = workgroupIndex * 256u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  }","  fillTarget[fillTargetOffset + index] = 0u;","}","const timestampsOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> timestamps: array<u32>;","const paramsOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> params: array<i32>;","const monthOutOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read_write> monthOut: array<u32>;","const hourOutOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read_write> hourOut: array<u32>;","const weekdayOutOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> weekdayOut: array<u32>;","const hourWeekdayCountsOutOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> hourWeekdayCountsOut: array<atomic<u32>>;","const MILLISECONDS_PER_DAY: u32 = 86400000u;","const MAXIMUM_DAYS: u32 = 1000000000u;","struct CalendarFields {","  valid: bool,","  year: i32,","  month: u32,","  day: u32,","  hour: u32,","  minute: u32,","  weekday: u32,","  dayOfYear: u32,","  isoWeek: u32,","  isoWeekYear: i32,","  quarter: u32","fn invalidCalendar() -> CalendarFields {","  let invalidYear = bitcast<i32>(0x80000000u);","  return CalendarFields(false, invalidYear, 0xffffffffu, 0xffffffffu, 0xffffffffu, 0xffffffffu,","    0xffffffffu, 0xffffffffu, 0xffffffffu, invalidYear, 0xffffffffu);","fn isLeapYear(year: i32) -> bool {","  return (year % 4 == 0) && ((year % 100 != 0) || (year % 400 == 0));","// Hinnant civil_from_days: days since 1970-01-01 to (year, month, day).","fn civilFromDays(days: i32) -> vec3<i32> {","  let z = days + 719468;","  let era = select((z - 146096) / 146097, z / 146097, z >= 0);","  let dayOfEra = z - era * 146097;","  let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365;","  let dayOfMarchYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100);","  let monthPrime = (5 * dayOfMarchYear + 2) / 153;","  let day = dayOfMarchYear - (153 * monthPrime + 2) / 5 + 1;","  let month = select(monthPrime - 9, monthPrime + 3, monthPrime < 10);","  let year = yearOfEra + era * 400 + select(0, 1, month <= 2);","  return vec3<i32>(year, month, day);","fn getDayOfYear(date: vec3<i32>) -> i32 {","  let adjustment = select(select(-2, -1, isLeapYear(date.x)), 0, date.y <= 2);","  return (367 * date.y - 362) / 12 + date.z + adjustment;","struct DivideResult {","  quotientLow: u32,","  quotientHigh: u32,","  remainder: u32","// Exact unsigned 64-bit division by a divisor below 2^28, one nibble at a time so that","// remainder * 16 never overflows 32 bits.","fn divideUnsigned64(value: vec2<u32>, divisor: u32) -> DivideResult {","  var remainder = value.y % divisor;","  var quotientLow = 0u;","  for (var nibble = 7i; nibble >= 0i; nibble = nibble - 1i) {","    let shift = u32(nibble) * 4u;","    let current = (remainder << 4u) | ((value.x >> shift) & 0xfu);","    quotientLow = quotientLow | ((current / divisor) << shift);","    remainder = current % divisor;","  return DivideResult(quotientLow, value.y / divisor, remainder);","// Minutes to milliseconds; an offset beyond +-1440 minutes maps to a value the decode rejects.","fn minutesToMilliseconds(offsetMinutes: i32) -> i32 {","  return select(offsetMinutes * 60000, 0x7fffffff, offsetMinutes < -1440 || offsetMinutes > 1440);","fn decodeCalendar(time: vec2<u32>, offsetMilliseconds: i32, firstDay: u32) -> CalendarFields {","  let invalid = invalidCalendar();","  if (offsetMilliseconds < -86400000 || offsetMilliseconds > 86400000) {","    return invalid;","  // Signed 64-bit local time = time + offset, with overflow detection.","  let offsetLow = bitcast<u32>(offsetMilliseconds);","  let offsetHigh = select(0u, 0xffffffffu, offsetMilliseconds < 0);","  let low = time.x + offsetLow;","  let high = time.y + offsetHigh + select(0u, 1u, low < time.x);","  let timeSign = time.y >> 31u;","  let sumSign = high >> 31u;","  if (timeSign == (offsetHigh >> 31u) && sumSign != timeSign) {","  let isNegative = sumSign != 0u;","  var magnitude = vec2<u32>(low, high);","  if (isNegative) {","    let negatedLow = ~low + 1u;","    magnitude = vec2<u32>(negatedLow, ~high + select(0u, 1u, negatedLow == 0u));","  let division = divideUnsigned64(magnitude, MILLISECONDS_PER_DAY);","  if (division.quotientHigh != 0u || division.quotientLow > MAXIMUM_DAYS) {","  var days = i32(division.quotientLow);","  var millisecondsOfDay = division.remainder;","    // floor(-(q * D + r) / D) = -(q + 1) with D - r left over when r is not zero.","    if (millisecondsOfDay != 0u) {","      days = days + 1;","      millisecondsOfDay = MILLISECONDS_PER_DAY - millisecondsOfDay;","    }","    days = -days;","  let date = civilFromDays(days);","  let isoWeekday = u32(((days + 3) % 7 + 7) % 7);","  let thursday = days - i32(isoWeekday) + 3;","  let thursdayDate = civilFromDays(thursday);","  var fields = invalid;","  fields.valid = true;","  fields.year = date.x;","  fields.month = u32(date.y);","  fields.day = u32(date.z);","  fields.hour = millisecondsOfDay / 3600000u;","  fields.minute = (millisecondsOfDay % 3600000u) / 60000u;","  fields.weekday = (isoWeekday + 7u - firstDay) % 7u;","  fields.dayOfYear = u32(getDayOfYear(date));","  fields.isoWeek = u32((getDayOfYear(thursdayDate) - 1) / 7 + 1);","  fields.isoWeekYear = thursdayDate.x;","  fields.quarter = u32((date.y - 1) / 3 + 1);","  return fields;","  _ = &timestamps;","  _ = &params;","  _ = &monthOut;","  _ = &hourOut;","  _ = &weekdayOut;","  _ = &hourWeekdayCountsOut;","  let time = vec2<u32>(timestamps[timestampsOffset + 2u * index], timestamps[timestampsOffset + 2u * index + 1u]);","  let offsetMilliseconds = minutesToMilliseconds(params[paramsOffset]);","  let firstDay = u32(((params[paramsOffset + 1u] % 7) + 7) % 7);","  var fields = decodeCalendar(time, offsetMilliseconds, firstDay);","  ","  monthOut[monthOutOffset + index] = fields.month;","  hourOut[hourOutOffset + index] = fields.hour;","  weekdayOut[weekdayOutOffset + index] = fields.weekday;","  if (fields.valid) {","    atomicAdd(&hourWeekdayCountsOut[hourWeekdayCountsOutOffset + fields.weekday * 24u + fields.hour], 1u);"],"strings":["calendar-buckets-decode-0","hourWeekdayCounts","buffer","read_write","GPUCalendarBuckets","calendar-buckets-fill-matrix","hour","month","timestamps","transient","weekday","calendar-parameters","calendar-buckets","compute","imported","read"],"shapes":[["id","form","domain","label","nodes","edges","resources","attrs"],["id"