ion":0,"elementType":"f32","values":"b64:WmEtwjhZ/MJsLiLDWydWw7dA5MISauRBwz7TQcakfUFgNhFC3/vXQHXrx8INeUtC","provenance":"gpu-readback","graph":"gpu-terrain-terrain-line-of-sight-compiled","resource":"sightLineClearance","afterNode":"terrain-line-of-sight-line-of-sight","role":"intermediate","meaning":"target clearance above the highest intervening tangent (m)","keySpace":"sight-line-pairs"},{"id":"gpu-terrain-terrain-line-of-sight-snapshots-sightLineVisibilityGeometry-0","name":"sightLineVisibilityGeometry","iteration":0,"elementType":"f32","values":"same:snapshots.3","provenance":"gpu-readback","graph":"gpu-terrain-terrain-line-of-sight-compiled","resource":"sightLineCoordinates","afterNode":"terrain-line-of-sight-line-of-sight","role":"output","meaning":"input sight lines coloured by GPU visibility code","components":2,"geometry":{"kind":"lines","coordinateModel":"projected","unit":"m","offsetsCapture":"sightLineOffsets","valuesCapture":"sightLineVisibility"}},{"id":"gpu-terrain-terrain-line-of-sight-snapshots-sightLineClearanceGeometry-0","name":"sightLineClearanceGeometry","iteration":0,"elementType":"f32","values":"same:snapshots.3","provenance":"gpu-readback","graph":"gpu-terrain-terrain-line-of-sight-compiled","resource":"sightLineCoordinates","afterNode":"terrain-line-of-sight-line-of-sight","role":"output","meaning":"input sight lines coloured by GPU clearance (m)","components":2,"geometry":{"kind":"lines","coordinateModel":"projected","unit":"m","offsetsCapture":"sightLineOffsets","valuesCapture":"sightLineClearance"}}],"stamps":[],"replays":[]}},"encoding":{"sourceLines":["","override INVOCATION_COUNT: u32;","override WGSL_KERNEL_DISPATCH_X: u32;","override WGSL_KERNEL_DISPATCH_Y: u32;","const elevationValuesOffset: u32 = 0u;","@group(0) @binding(0) var<storage, read> elevationValues: array<f32>;","const elevationValidityOffset: u32 = 0u;","@group(0) @binding(1) var<storage, read> elevationValidity: array<u32>;","const settingsOffset: u32 = 0u;","@group(0) @binding(2) var<storage, read> settings: array<f32>;","const pairsOffset: u32 = 0u;","@group(0) @binding(3) var<storage, read> pairs: array<f32>;","const visibilityValuesOffset: u32 = 0u;","@group(0) @binding(4) var<storage, read_write> visibilityValues: array<u32>;","const clearanceValuesOffset: u32 = 0u;","@group(0) @binding(5) var<storage, read_write> clearanceValues: array<f32>;","const WIDTH: u32 = 64u;","const HEIGHT: u32 = 64u;","const HIDDEN: u32 = 0u;","const VISIBLE: u32 = 1u;","const OUT_OF_RANGE: u32 = 2u;","const NO_DATA: u32 = 3u;","const MARGINAL: u32 = 4u;","const MAXIMUM_FLOAT: f32 = 3.4028234663852886e38;","const SKIP_EPSILON: f32 = 0.00000762939453125;","fn isFiniteValue(value: f32) -> bool { return (bitcast<u32>(value) & 0x7f800000u) != 0x7f800000u; }","fn isValidPixel(column: u32, row: u32) -> bool {","  return elevationValidity[elevationValidityOffset + row * WIDTH + column] != 0u;","}","fn getElevation(column: u32, row: u32) -> f32 {","  return elevationValues[elevationValuesOffset + row * WIDTH + column];","// Bilinear elevation at a clamped pixel-center position; .y is 0 when any corner is invalid.","fn sampleElevation(position: vec2<f32>) -> vec2<f32> {","  let maximum = vec2<f32>(f32(WIDTH - 1u), f32(HEIGHT - 1u));","  let clamped = clamp(position, vec2<f32>(0.0), maximum);","  let base = vec2<u32>(floor(clamped));","  let next = min(base + vec2<u32>(1u), vec2<u32>(WIDTH - 1u, HEIGHT - 1u));","  let fraction = clamped - floor(clamped);","  // Canonical elevation is NaN exactly where a pixel is invalid, so one bit test per corner","  // replaces four validity loads; the interpolation below is unchanged.","  let corner00 = getElevation(base.x, base.y);","  let corner10 = getElevation(next.x, base.y);","  let corner01 = getElevation(base.x, next.y);","  let corner11 = getElevation(next.x, next.y);","  if (!isFiniteValue(corner00) || !isFiniteValue(corner10) ||","      !isFiniteValue(corner01) || !isFiniteValue(corner11)) {","    return vec2<f32>(0.0, 0.0);","  }","  let top = mix(corner00, corner10, fraction.x);","  let bottom = mix(corner01, corner11, fraction.x);","  return vec2<f32>(mix(top, bottom, fraction.y), 1.0);","fn rayPosition(observer: vec2<f32>, delta: vec2<f32>, sampleIndex: u32, count: u32) -> vec2<f32> {","  let fraction = f32(sampleIndex) / f32(count);","  return observer + delta * fraction;","fn rayDistance(targetDistance: f32, sampleIndex: u32, count: u32) -> f32 {","  return targetDistance * fraction;","struct SightLineResult {","  code: u32,","  clearance: f32","// Observer and target are pixel-center positions; eye is the observer elevation (ground + height);","// targetTop is the target elevation (ground + height) before the curvature drop;","// tolerance is [toleranceMeters, tolerancePerKilometer, targetIgnoreDistance, targetIgnoreFraction].","fn traceSightLine(","  observer: vec2<f32>,","  targetPosition: vec2<f32>,","  eye: f32,","  targetTop: f32,","  cellSize: vec2<f32>,","  curvature: f32,","  maxDistance: f32,","  tolerance: vec4<f32>",") -> SightLineResult {","  let delta = targetPosition - observer;","  let targetDistance = length(delta * cellSize);","  if (maxDistance > 0.0 && targetDistance > maxDistance) {","    return SightLineResult(OUT_OF_RANGE, 0.0);","  if (targetDistance == 0.0) {","    return SightLineResult(VISIBLE, MAXIMUM_FLOAT);","  let targetElevation = targetTop - curvature * targetDistance * targetDistance;","  let targetSlope = (targetElevation - eye) / targetDistance;","  let band = (tolerance.x + tolerance.y * targetDistance / 1000.0) / targetDistance;","  let highLimit = targetSlope + band;","  let lowLimit = targetSlope - band;","  let stopDistance = targetDistance - max(tolerance.z, tolerance.w * targetDistance);","  let stepCount = u32(ceil(max(abs(delta.x), abs(delta.y))));","  var maxSlope = -MAXIMUM_FLOAT;","  var tested = false;","  var sampleIndex = 1u;","  var skipLevel = 0u;","  loop {","    if (sampleIndex >= stepCount) { break; }","    if (rayDistance(targetDistance, sampleIndex, stepCount) > stopDistance) { break; }","    let current = sampleIndex;","    sampleIndex = sampleIndex + 1u;","    let elevationSample = sampleElevation(rayPosition(observer, delta, current, stepCount));","    // Invalid samples never block.","    if (elevationSample.y == 0.0) { continue; }","    let sampleDistance = rayDistance(targetDistance, current, stepCount);","    let sampleSlope =","      (elevationSample.x - curvature * sampleDistance * sampleDistance - eye) / sampleDistance;","    tested = true;","    if (sampleSlope > maxSlope) {","      maxSlope = sampleSlope;","    }","  var code = MARGINAL;","  if (maxSlope > highLimit) {","    code = HIDDEN;","  } else if (maxSlope <= lowLimit) {","    code = VISIBLE;","  return SightLineResult(code, select(MAXIMUM_FLOAT, (targetSlope - maxSlope) * targetDistance, tested));","fn isInsideGrid(position: vec2<f32>) -> bool {","  return isFiniteValue(position.x) && isFiniteValue(position.y) &&","    position.x >= 0.0 && position.y >= 0.0 &&","    position.x <= f32(WIDTH - 1u) && position.y <= f32(HEIGHT - 1u);","@compute @workgroup_size(32)","fn main(","  @builtin(local_invocation_index) localInvocationIndex: u32,","  @builtin(workgroup_id) workgroupId: vec3<u32>",") {","  _ = &elevationValues;","  _ = &elevationValidity;","  _ = &settings;","  _ = &pairs;","  _ = &visibilityValues;","  _ = &clearanceValues;","  _ = INVOCATION_COUNT;","  let workgroupIndex =","    (workgroupId.z * WGSL_KERNEL_DISPATCH_Y + workgroupId.y) * WGSL_KERNEL_DISPATCH_X +","    workgroupId.x;","  if (workgroupIndex >= 134217728u) { return; }","  let index = workgroupIndex * 32u + localInvocationIndex;","  if (index >= INVOCATION_COUNT) {","    return;","  let pairBase = pairsOffset + 4u * index;","  let observer = vec2<f32>(pairs[pairBase], pairs[pairBase + 1u]);","  let targetPosition = vec2<f32>(pairs[pairBase + 2u], pairs[pairBase + 3u]);","  let observerHeight = settings[settingsOffset];","  let targetHeight = settings[settingsOffset + 1u];","  let maxDistance = settings[settingsOffset + 2u];","  let cellSize = vec2<f32>(settings[settingsOffset + 3u], settings[settingsOffset + 4u]);","  let curvature = settings[settingsOffset + 5u];","  let tolerance = vec4<f32>(","    settings[settingsOffset + 6u], settings[settingsOffset + 7u],","    settings[settingsOffset + 8u], settings[settingsOffset + 9u]);","  let observerInside = isInsideGrid(observer);","  let targetInside = isInsideGrid(targetPosition);","  let observerSample = sampleElevation(select(vec2<f32>(0.0), observer, observerInside));","  let targetSample = sampleElevation(select(vec2<f32>(0.0), targetPosition, targetInside));","  var code = NO_DATA;","  // A runtime-dependent bit pattern: WGSL rejects constant-evaluated NaN.","  var clearance = bitcast<f32>(0x7fc00000u | (index & 0u));","  if (observerInside && targetInside && observerSample.y != 0.0 && targetSample.y != 0.0) {","    let result = traceSightLine(","      observer, targetPosition, observerSample.x + observerHeight, targetSample.x + targetHeight,","      cellSize, curvature, maxDistance, tolerance);","    code = result.code;","    if (result.code != OUT_OF_RANGE) {","      clearance = result.clearance;","  visibilityValues[visibilityValuesOffset + index] = code;","  clearanceValues[clearanceValuesOffset + index] = clearance;"],"strings":["terrain-line-of-sight-line-of-sight","buffer","terrain-line-of-sight-elevation","imported","terrain-line-of-sight-elevation-validity","terrain-line-of-sight-elevation-values","read","sightLineClearance","sightLineVisibility","GPUTerrainLineOfSight","sightLinePairs","terrain-line-of-sight-parameters","compute","read_write","terrain-line-of-sight","transient"],"shapes":[["id","form","domain","label","nodes","edges","resources"],["id","label","namespace","kind","op","reads","writes","attrs"],[],["id","label","namespace","kind","op","source","workgroupSize","bindings","dispatch","reads","writes","workload","attrs